  "scope": "Actual original Effect producer Runtime and Source acquisition feed the existing retained Transfer, committed receiver and live resident consumer holder. The typed Effect family shares journal, exclusive-start and formal Runtime cleanup; its receiver and producer remain independently owned.",
  "nativeCases": [
    {
      "name": "Effect consumer holder owns one borrow and separate receiver cleanup",
      "assertions": [
        "actual Source acquisition one, original producer entry one, original consumer entry one",
        "non-authorizing checked edge route names original producer dispatch",
        "one holder and one borrow for original saved consumer envelope; repeated execution returns same completion",
        "consumer Source path unavailable; independent [{id:3}] and schema match",
        "actual completed output file custody survives journal read-back",
        "live reader delays cleanup, preserving output file and receiver reservation",
        "consumer formal CleanupReleased returns borrow without reclaiming receiver holding",
        "existing Transfer reclamation confirms receiver capacity zero exactly once",
        "original producer remains held until its separate Runtime cleanup",
        "private computation has no Named Result definition; ordinary public Output admission refuses EffectNotSupported"
      ]
    },
    {
      "name": "Effect consumer holder cancellation before start retains independent cleanup",
      "assertions": [
        "consumer executor entry zero and borrow zero",
        "cancellation persisted in original journal; capacity retained before explicit cleanup",
        "holder close and receiver cleanup do not retire original producer Source responsibility",
        "no fabricated terminal from cancellation request alone"
      ]
    },
    {
      "name": "Effect consumer holder cancellation after borrow prevents exclusive start",
      "assertions": [
        "actual borrow one, consumer entry zero, no start claimant",
        "same holder returns borrow only through cleanup",
        "receiver remains separate and reserved until its owner reclaims it",
        "repeat execution after close cannot borrow or execute again"
      ]
    },
    {
      "name": "Effect consumer holder output failure does not acquire input or execute twice",
      "assertions": [
        "original consumer entry one",
        "same holder caches primary failure and pending Runtime where cleanup remains unconfirmed",
        "second call cannot enter Compute again",
        "receiver capacity remains until independent confirmed cleanup"
      ]
    }
  ],
  "additionalRefusals": [
    "original Run lifetime expired at preparation",
    "trusted Source differs from original checked Source",
    "another consumer attempt cannot replace existing holder",
    "foreign consumer input port refused by existing envelope issuer"
