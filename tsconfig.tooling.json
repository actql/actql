{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {"elkjs/lib/elk-api.js": ["./packages/explorer-ui/elk-layout-module.d.ts"]},
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "ESNext.Array",
      "ES2024.String",
      "DOM.AsyncIterable"
    ],
    "declaration": true
  },
  "include": [
    "scripts/**/*.mts",
    "packages/sdk/**/*.mts",
    "packages/provider-ai-sdk/**/*.mts",
    "packages/provider-http/**/*.mts",
    "adapters/host-common/**/*.mts",
    "adapters/host-node/**/*.mts",
    "adapters/connectors/duckdb/node/**/*.mts",
    "packages/client-wire/**/*.mts",
    "packages/explorer/**/*.mts",
    "packages/explorer-ui/**/*.mts",
    "packages/explorer-ui/elk-layout-module.d.ts"
  ],
  "exclude": [
    "**/*.typecheck.mts",
    "**/*.d.mts"
  ]
}
