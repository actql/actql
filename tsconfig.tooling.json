{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "moduleDetection": "legacy",
    "paths": {
      "@duckdb/node-api": [
        "./adapters/connectors/duckdb/node/node_modules/@duckdb/node-api/lib/index.d.ts",
        "./adapters/connectors/duckdb/node/neo-session-api.d.mts"
      ],
      "@duckdb/node-api/package.json": [
        "./adapters/connectors/duckdb/node/node_modules/@duckdb/node-api/package.json",
        "./adapters/connectors/duckdb/node/neo-package.d.mts"
      ],
      "@actql/explorer/browser-source": ["./packages/explorer/browser-source.d.ts"],
      "@actql/explorer/launcher": ["./packages/explorer/launcher.d.ts"],
      "@actql/local-node/_internal/compile-cache": ["./adapters/host-node/compile-cache.mts"],
      "@actql/local-node/runtime": ["./scripts/fixtures/installed-common-runtime.d.ts"],
      "elkjs/lib/elk-api.js": ["./packages/explorer-ui/elk-layout-module.d.ts"],
      "actql-explorer-test-contracts/*": ["./packages/explorer-ui/*.d.ts"]
    },
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "ES2023.Array",
    "ESNext.Array",
      "ES2024.String",
      "ES2024.Promise",
      "ES2024.ArrayBuffer",
      "DOM.AsyncIterable"
    ],
    "declaration": true
  },
