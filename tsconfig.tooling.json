{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "ESNext.Array",
      "ES2024.String",
      "DOM.AsyncIterable"
    ],
    "declaration": true
  },
  "include": [
    "scripts/**/*.mts",
    "packages/sdk/**/*.mts"
  ],
  "exclude": [
    "**/*.typecheck.mts",
    "**/*.d.mts"
  ]
}
