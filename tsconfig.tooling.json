{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "declaration": true
  },
  "include": [
    "scripts/**/*.mts",
    "packages/sdk/internal/**/*.mts"
  ],
  "exclude": [
    "scripts/fixtures/**/*.typecheck.mts",
    "**/*.d.mts"
  ]
}
