{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "moduleDetection": "legacy",
    "paths": {
      "@duckdb/node-api": [
        "./adapters/connectors/duckdb/node/node_modules/@duckdb/node-api/lib/index.d.ts",
        "./adapters/connectors/duckdb/node/neo-session-api.d.mts"
      ],
      "@duckdb/node-api/package.json": [
        "./adapters/connectors/duckdb/node/node_modules/@duckdb/node-api/package.json",
        "./adapters/connectors/duckdb/node/neo-package.d.mts"
      ],
      "@actql/explorer/browser-source": ["./packages/explorer/browser-source.d.ts"],
      "@actql/explorer/launcher": ["./packages/explorer/launcher.d.ts"],
      "@actql/local-node/_internal/compile-cache": ["./adapters/host-node/compile-cache.mts"],
      "@actql/local-node/runtime": ["./scripts/fixtures/installed-common-runtime.d.ts"],
      "elkjs/lib/elk-api.js": ["./packages/explorer-ui/elk-layout-module.d.ts"],
      "actql-explorer-test-contracts/*": ["./packages/explorer-ui/*.d.ts"]
    },
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "ES2023.Array",
    "ESNext.Array",
      "ES2024.String",
      "ES2024.Promise",
      "ES2024.ArrayBuffer",
      "DOM.AsyncIterable"
    ],
    "declaration": true
  },
  "include": [
    "scripts/**/*.mts",
    "reviews/2026-10-13-vector-scalar-installed-source/public-audit.mts",
    "reviews/2026-10-14-carrier-continuation-release-matrix/public-audit.mts",
    "reviews/2026-10-14-carrier-peer-scope-release-matrix/public-audit.mts",
    "packages/sdk/**/*.mts",
    "packages/run-host-core/**/*.mts",
    "packages/run-host-core/runtime-bridges.d.ts",
    "packages/node/**/*.mts",
    "packages/node/**/*.cts",
    "packages/local-node/**/*.cts",
    "packages/local-node/**/*.mts",
    "packages/local-node/staged-adapters.d.ts",
    "packages/native-cli/**/*.mts",
    "packages/provider-ai-sdk/**/*.mts",
    "packages/provider-http/**/*.mts",
    "adapters/host-common/**/*.mts",
    "adapters/host-node/**/*.mts",
    "adapters/host-node/process-retained-runtime.d.ts",
    "adapters/host-node/host-journal-native-image.cts",
    "adapters/host-node/host-journal-native-requests.cts",
    "adapters/host-node/ordinary-node-resource-runtime.cts",
    "adapters/site-node/**/*.mts",
    "adapters/store-local/**/*.mts",
    "adapters/local-node/**/*.mts",
    "adapters/reference-compute-node/**/*.mts",
    "adapters/workers/**/*.mts",
    "adapters/connectors/duckdb/node/**/*.mts",
    "adapters/connectors/local/host/**/*.mts",
    "adapters/connectors/local/site/**/*.mts",
    "packages/client-wire/**/*.mts",
    "packages/explorer/**/*.mts",
    "packages/explorer-ui/**/*.mts",
    "packages/explorer-ui/elk-layout-module.d.ts",
    "packages/explorer-ui/built-component-test-types.d.ts"
  ],
  "exclude": [
    "**/*.typecheck.mts",
    "**/*.d.mts",
    "**/*.d.cts"
  ]
}
