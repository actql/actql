{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@actql/sdk": ["./packages/sdk/index.mts"],
      "@actql/sdk/host-port": ["./packages/sdk/host-port.mts"]
    },
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable",
      "WebWorker.ImportScripts",
      "ScriptHost",
      "ES2024.String"
    ]
  },
  "files": [
    "packages/sdk/index.mts",
    "packages/sdk/host-port.mts",
    "packages/client-wire/index.d.ts",
    "scripts/fixtures/installed-connector-table.typecheck.mts"
  ],
  "include": [
    "packages/sdk/**/*.typecheck.*",
    "packages/client-wire/**/*.typecheck.*"
  ]
}
