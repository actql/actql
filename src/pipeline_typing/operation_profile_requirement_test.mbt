///|
test "profile obligations map to their declared module without discharging other requirements" {
  assert_eq(
    operation_profile_requirement(GraphRequirement(ResolveSgaProfile)),
    Some(SGA),
  )
  assert_eq(
    operation_profile_requirement(GraphRequirement(ValidateGraphData)),
    None,
  )
  assert_eq(
    operation_profile_requirement(MatchRequirement(ResolveMatchProfile)),
    Some(SGA),
  )
  assert_eq(
    operation_profile_requirement(MatchRequirement(AdmitMatchGraphData)),
    None,
  )
  assert_eq(
    operation_profile_requirement(ReachRequirement(ResolveReachProfile)),
    Some(SGA),
  )
  assert_eq(
    operation_profile_requirement(ReachRequirement(AdmitReachGraph)),
    None,
  )
  assert_eq(
    operation_profile_requirement(SubgraphRequirement(ResolveSubgraphProfile)),
    Some(SGA),
  )
  assert_eq(
    operation_profile_requirement(SubgraphRequirement(AdmitSubgraphInput)),
    None,
  )
  assert_eq(
    operation_profile_requirement(TraverseRequirement(ResolveTraversalProfile)),
    Some(SGA),
  )
  assert_eq(
    operation_profile_requirement(TraverseRequirement(AdmitTraversalGraph)),
    None,
  )
  assert_eq(
    operation_profile_requirement(ShortestRequirement(ResolveShortestProfile)),
    Some(SGA),
  )
  assert_eq(
    operation_profile_requirement(ShortestRequirement(AdmitShortestGraph)),
    None,
  )
  assert_eq(
    operation_profile_requirement(EqualityRequirement(ResolveSgaProfile)),
    Some(SGA),
  )
  assert_eq(
    operation_profile_requirement(EqualityRequirement(AdmitBothGraphs)),
    None,
  )
  assert_eq(
    operation_profile_requirement(DiffRequirement(ResolveSgaProfile)),
    Some(SGA),
  )
  assert_eq(
    operation_profile_requirement(DiffRequirement(EmitDeltaVersion)),
    None,
  )
  assert_eq(
    operation_profile_requirement(ApplyRequirement(ResolveSgaProfile)),
    Some(SGA),
  )
  assert_eq(
    operation_profile_requirement(ApplyRequirement(RequireExactlyOneDeltaRow)),
    None,
  )
  assert_eq(
    operation_profile_requirement(StructuralRequirement(ResolveSgaProfile)),
    Some(SGA),
  )
  assert_eq(
    operation_profile_requirement(
      StructuralRequirement(AdmitGraphsUnderCommonContract),
    ),
    None,
  )
  assert_eq(
    operation_profile_requirement(
      ConstructionRequirement(ResolvePropertyGraphProfile),
    ),
    Some(PropertyGraph),
  )
  assert_eq(
    operation_profile_requirement(ConstructionRequirement(AdmitGraphInputRows)),
    None,
  )
  assert_eq(
    operation_profile_requirement(VectorRequirement(ResolveVecaProfile)),
    Some(VecA),
  )
  assert_eq(
    operation_profile_requirement(VectorRequirement(ValidateVectorValues)),
    None,
  )
  assert_eq(
    operation_profile_requirement(NearestRequirement(ResolveNearestProfile)),
    Some(VecA),
  )
  assert_eq(
    operation_profile_requirement(NearestRequirement(MatchNearestDimensions)),
    None,
  )
  assert_eq(
    operation_profile_requirement(PoolRequirement(ResolvePoolProfile)),
    Some(VecA),
  )
  assert_eq(
    operation_profile_requirement(PoolRequirement(JournalPoolMemberIdentity)),
    None,
  )
  assert_eq(
    operation_profile_requirement(RankingRequirement(ResolveRankingProfile)),
    Some(VecA),
  )
  assert_eq(
    operation_profile_requirement(
      RankingRequirement(ValidateCompleteRankingInputs),
    ),
    None,
  )
  assert_eq(
    operation_profile_requirement(TextRankRequirement(ResolveTextRankProfile)),
    Some(TextRankProfile),
  )
  assert_eq(
    operation_profile_requirement(
      TextRankRequirement(ValidateCompleteTextInputs),
    ),
    None,
  )
  assert_eq(
    operation_profile_requirement(EventRequirement(ResolveTeaProfile)),
    Some(TEA),
  )
  assert_eq(
    operation_profile_requirement(EventRequirement(ValidateEventValues)),
    None,
  )
  assert_eq(
    operation_profile_requirement(SequenceRequirement(TeaProfile)),
    Some(TEA),
  )
  assert_eq(
    operation_profile_requirement(SequenceRequirement(ValidateEventValues)),
    None,
  )
  assert_eq(
    operation_profile_requirement(JoinRequirement(ResolveTeaProfile)),
    Some(TEA),
  )
  assert_eq(
    operation_profile_requirement(JoinRequirement(ResolveCardinality)),
    None,
  )
  assert_eq(
    operation_profile_requirement(CrossJoinRequirement(ResolveTeaProfile)),
    Some(TEA),
  )
  assert_eq(
    operation_profile_requirement(CrossJoinRequirement(ResolveCardinality)),
    None,
  )
  assert_eq(
    operation_profile_requirement(IntervalJoinRequirement(ResolveTeaProfile)),
    Some(TEA),
  )
  assert_eq(
    operation_profile_requirement(IntervalJoinRequirement(ResolveCardinality)),
    None,
  )
  assert_eq(
    operation_profile_requirement(AsOfRequirement(ResolveTeaProfile)),
    Some(TEA),
  )
  assert_eq(
    operation_profile_requirement(AsOfRequirement(ResolveCardinality)),
    None,
  )
}
