test "fixed numbers encoding vectors" {
  {
    let value = (0x0000000000000000UL).reinterpret_as_double()
    let exact = writer(1, 1, 0)
    number_value(exact, value)
    assert_eq(finish(exact), "0")
    let measured = measuring_writer(1, 1, 0)
    number_value(measured, value)
    assert_eq(finish_measurement(measured), 1)
    for measure in [false, true] {
      let short = if measure { measuring_writer(0, 1, 0) } else { writer(0, 1, 0) }
      let rejected = try { number_value(short, value); false } catch { OutputLimit => true; _ => false }
      assert_true(rejected)
      assert_encoding_closed(short)
    }
  }
