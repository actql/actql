///|
test "fixed strings encoding vectors" {
  {
    let value = String::from_array([])
    let exact = writer(2, 1, 0)
    string_value(exact, value)
    assert_eq(finish(exact), "\"\"")
    let measured = measuring_writer(2, 1, 0)
    string_value(measured, value)
    assert_eq(finish_measurement(measured), 2)
    for measure in [false, true] {
      let short = if measure { measuring_writer(1, 1, 0) } else { writer(1, 1, 0) }
      let rejected = try { string_value(short, value); false } catch { OutputLimit => true; _ => false }
      assert_true(rejected)
      assert_encoding_closed(short)
    }
  }
  {
    let value = String::from_array([(0x0).unsafe_to_char(), (0x1).unsafe_to_char(), (0x2).unsafe_to_char(), (0x3).unsafe_to_char(), (0x4).unsafe_to_char(), (0x5).unsafe_to_char(), (0x6).unsafe_to_char(), (0x7).unsafe_to_char(), (0x8).unsafe_to_char(), (0x9).unsafe_to_char(), (0xa).unsafe_to_char(), (0xb).unsafe_to_char(), (0xc).unsafe_to_char(), (0xd).unsafe_to_char(), (0xe).unsafe_to_char(), (0xf).unsafe_to_char(), (0x10).unsafe_to_char(), (0x11).unsafe_to_char(), (0x12).unsafe_to_char(), (0x13).unsafe_to_char(), (0x14).unsafe_to_char(), (0x15).unsafe_to_char(), (0x16).unsafe_to_char(), (0x17).unsafe_to_char(), (0x18).unsafe_to_char(), (0x19).unsafe_to_char(), (0x1a).unsafe_to_char(), (0x1b).unsafe_to_char(), (0x1c).unsafe_to_char(), (0x1d).unsafe_to_char(), (0x1e).unsafe_to_char(), (0x1f).unsafe_to_char()])
    let exact = writer(174, 1, 0)
    string_value(exact, value)
    assert_eq(finish(exact), "\"\\u0000\\u0001\\u0002\\u0003\\u0004\\u0005\\u0006\\u0007\\b\\t\\n\\u000b\\f\\r\\u000e\\u000f\\u0010\\u0011\\u0012\\u0013\\u0014\\u0015\\u0016\\u0017\\u0018\\u0019\\u001a\\u001b\\u001c\\u001d\\u001e\\u001f\"")
    let measured = measuring_writer(174, 1, 0)
    string_value(measured, value)
    assert_eq(finish_measurement(measured), 174)
    for measure in [false, true] {
      let short = if measure { measuring_writer(173, 1, 0) } else { writer(173, 1, 0) }
      let rejected = try { string_value(short, value); false } catch { OutputLimit => true; _ => false }
      assert_true(rejected)
      assert_encoding_closed(short)
    }
  }
  {
    let value = String::from_array([(0x22).unsafe_to_char(), (0x5c).unsafe_to_char(), (0x2f).unsafe_to_char()])
    let exact = writer(7, 1, 0)
    string_value(exact, value)
    assert_eq(finish(exact), "\"\\\"\\\\/\"")
    let measured = measuring_writer(7, 1, 0)
    string_value(measured, value)
    assert_eq(finish_measurement(measured), 7)
    for measure in [false, true] {
      let short = if measure { measuring_writer(6, 1, 0) } else { writer(6, 1, 0) }
      let rejected = try { string_value(short, value); false } catch { OutputLimit => true; _ => false }
      assert_true(rejected)
      assert_encoding_closed(short)
    }
  }
  {
    let value = String::from_array([(0x7f).unsafe_to_char(), (0x80).unsafe_to_char(), (0x7ff).unsafe_to_char(), (0x800).unsafe_to_char(), (0xd7ff).unsafe_to_char(), (0xe000).unsafe_to_char(), (0xffff).unsafe_to_char(), (0xd800).unsafe_to_char(), (0xdc00).unsafe_to_char(), (0xdbff).unsafe_to_char(), (0xdfff).unsafe_to_char()])
    let exact = writer(27, 1, 0)
    string_value(exact, value)
    assert_eq(finish(exact), "\"\u{7f}\u{80}\u{7ff}\u{800}\u{d7ff}\u{e000}\u{ffff}\u{10000}\u{10ffff}\"")
    let measured = measuring_writer(27, 1, 0)
    string_value(measured, value)
    assert_eq(finish_measurement(measured), 27)
    for measure in [false, true] {
      let short = if measure { measuring_writer(26, 1, 0) } else { writer(26, 1, 0) }
      let rejected = try { string_value(short, value); false } catch { OutputLimit => true; _ => false }
      assert_true(rejected)
      assert_encoding_closed(short)
    }
  }
  {
    let value = String::from_array([(0x85).unsafe_to_char(), (0x2028).unsafe_to_char(), (0x2029).unsafe_to_char(), (0xfeff).unsafe_to_char()])
    let exact = writer(13, 1, 0)
    string_value(exact, value)
    assert_eq(finish(exact), "\"\u{85}\u{2028}\u{2029}\u{feff}\"")
    let measured = measuring_writer(13, 1, 0)
    string_value(measured, value)
    assert_eq(finish_measurement(measured), 13)
    for measure in [false, true] {
      let short = if measure { measuring_writer(12, 1, 0) } else { writer(12, 1, 0) }
      let rejected = try { string_value(short, value); false } catch { OutputLimit => true; _ => false }
      assert_true(rejected)
      assert_encoding_closed(short)
    }
  }
  {
    let value = String::from_array([(0x65).unsafe_to_char(), (0x301).unsafe_to_char(), (0xd).unsafe_to_char(), (0xa).unsafe_to_char(), (0xd).unsafe_to_char(), (0xa).unsafe_to_char()])
    let exact = writer(13, 1, 0)
    string_value(exact, value)
    assert_eq(finish(exact), "\"e\u{301}\\r\\n\\r\\n\"")
    let measured = measuring_writer(13, 1, 0)
    string_value(measured, value)
    assert_eq(finish_measurement(measured), 13)
    for measure in [false, true] {
      let short = if measure { measuring_writer(12, 1, 0) } else { writer(12, 1, 0) }
      let rejected = try { string_value(short, value); false } catch { OutputLimit => true; _ => false }
      assert_true(rejected)
      assert_encoding_closed(short)
    }
  }
  {
    let value = String::from_array([(0xe9).unsafe_to_char()])
    let exact = writer(4, 1, 0)
    string_value(exact, value)
    assert_eq(finish(exact), "\"\u{e9}\"")
    let measured = measuring_writer(4, 1, 0)
    string_value(measured, value)
    assert_eq(finish_measurement(measured), 4)
    for measure in [false, true] {
      let short = if measure { measuring_writer(3, 1, 0) } else { writer(3, 1, 0) }
      let rejected = try { string_value(short, value); false } catch { OutputLimit => true; _ => false }
      assert_true(rejected)
      assert_encoding_closed(short)
    }
  }
  {
    let value = String::from_array([(0x65e5).unsafe_to_char(), (0x672c).unsafe_to_char(), (0xd83d).unsafe_to_char(), (0xde00).unsafe_to_char()])
    let exact = writer(12, 1, 0)
    string_value(exact, value)
    assert_eq(finish(exact), "\"\u{65e5}\u{672c}\u{1f600}\"")
    let measured = measuring_writer(12, 1, 0)
    string_value(measured, value)
    assert_eq(finish_measurement(measured), 12)
    for measure in [false, true] {
      let short = if measure { measuring_writer(11, 1, 0) } else { writer(11, 1, 0) }
      let rejected = try { string_value(short, value); false } catch { OutputLimit => true; _ => false }
      assert_true(rejected)
      assert_encoding_closed(short)
    }
  }
  {
    let value = String::from_array([(0xd800).unsafe_to_char()])
    for measure in [false, true] {
      let w = if measure { measuring_writer(4096, 1, 0) } else { writer(4096, 1, 0) }
      let rejected = try { string_value(w, value); false } catch { InvalidUnicode => true; _ => false }
      assert_true(rejected)
      assert_encoding_closed(w)
    }
  }
  {
    let value = String::from_array([(0xdfff).unsafe_to_char()])
    for measure in [false, true] {
      let w = if measure { measuring_writer(4096, 1, 0) } else { writer(4096, 1, 0) }
      let rejected = try { string_value(w, value); false } catch { InvalidUnicode => true; _ => false }
      assert_true(rejected)
      assert_encoding_closed(w)
    }
  }
  {
    let value = String::from_array([(0xd800).unsafe_to_char(), (0x41).unsafe_to_char()])
    for measure in [false, true] {
      let w = if measure { measuring_writer(4096, 1, 0) } else { writer(4096, 1, 0) }
      let rejected = try { string_value(w, value); false } catch { InvalidUnicode => true; _ => false }
      assert_true(rejected)
      assert_encoding_closed(w)
    }
  }
  {
    let value = String::from_array([(0xd800).unsafe_to_char(), (0xd800).unsafe_to_char()])
    for measure in [false, true] {
      let w = if measure { measuring_writer(4096, 1, 0) } else { writer(4096, 1, 0) }
      let rejected = try { string_value(w, value); false } catch { InvalidUnicode => true; _ => false }
      assert_true(rejected)
      assert_encoding_closed(w)
    }
  }
  {
    let value = String::from_array([(0xdc00).unsafe_to_char(), (0xd800).unsafe_to_char()])
    for measure in [false, true] {
      let w = if measure { measuring_writer(4096, 1, 0) } else { writer(4096, 1, 0) }
      let rejected = try { string_value(w, value); false } catch { InvalidUnicode => true; _ => false }
      assert_true(rejected)
      assert_encoding_closed(w)
    }
  }
  {
    let value = String::from_array([(0xd83d).unsafe_to_char(), (0xde00).unsafe_to_char(), (0xd800).unsafe_to_char()])
    for measure in [false, true] {
      let w = if measure { measuring_writer(4096, 1, 0) } else { writer(4096, 1, 0) }
      let rejected = try { string_value(w, value); false } catch { InvalidUnicode => true; _ => false }
      assert_true(rejected)
      assert_encoding_closed(w)
    }
  }
