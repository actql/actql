///|
/// Logical boxed constructor inventory for install_original_model_mock only.
/// Profile/declaration/normalization/typed answers and the supplied clock are
/// already constructed originals, borrowed without copying. Their complete
/// retained bodies and construction, parsing, execution/dependency admission,
/// later Model use and retirement are separate owners and phases.
///
/// This is opt-in DATA, not a Native allocation tariff, physical funding,
/// capacity reservation, installed selection or success/currentness verdict.
/// Targets may erase/reuse carriers. The caller separately funds this quote's
/// returned descriptor (1H3W); the quoted constructor never invokes this API.
pub fn original_model_mock_installation_construction_extent() -> @shape.CollectionConstructionExtent {
  // Successful retained graph below: 11H18R11W. Initial original/provider
  // None alternatives add 2H2W before their final Some links are installed.
  // The preflight predicates only borrow fields and return unboxed Bool;
  // they neither parse, copy, construct a closure nor consult the clock.
  //
  // ModelMockAnswers::require_original has two flat issue/Err alternatives
  // (Retired and ForeignOriginal): 4H2R4W, plus Ok(Unit): 1H2W
  // (Result tag and a conservative Unit payload word).
  // This constructor has its own ForeignOriginal/Err: 2H1R2W,
  // Answers(issue)/Err: 2H2R2W and successful Ok(original): 1H1R1W.
  // Co-count these fixed return sites once, not per borrowed child. This is
  // a conservative call-expanded envelope, not a measured live-allocation sum.
  { record_headers: 23L, reference_slots: 24L, scalar_words: 24L, }
}

///|
/// Only the new graph immediately after successful construction, excluding
/// the returned Ok carrier and all pre-existing borrowed child bodies. The
/// original remains cyclic until its existing retirement protocol completes;
/// this inventory is neither a close acknowledgment nor reclaimed storage.
pub fn original_model_mock_installation_retained_extent() -> @shape.CollectionConstructionExtent {
  // ModelMockInstallation: 1H8R2W (all eight optional slots, Bool and Int).
  // Seven Some links: original/profile/declaration/normalized/answers/now/
  // provider, 7H7R7W. The unbound task's None is bounded by 1H1W.
  // OriginalMock(original): 1H1R1W; ModelProvider: 1H2R. Its "mock" String
  // and the supplied clock closure stay borrowed; neither has copied backing.
  { record_headers: 11L, reference_slots: 18L, scalar_words: 11L, }
}
