///|
test "Check Environment preimage empty-unresolved" {
  let input = @json.parse([
    "{\"version\":\"actql-check-environment/0.1\",\"schema_snapshots\":[],\"connector_capabilities\":[],\"mapping_contracts\":[],\"source_views\":[],\"command_contracts\":[],\"model_task_contracts\":[],\"contract_registry\":[],\"connector_catalogs\":[],\"host_policy_profile\":{\"version\":\"actql-host-policy/0.1\",\"mode\":\"unresolved\"}}",
  ].join(""))
  let value = @canonical_json.from_json(input, 13, 2, 306)
  assert_eq(@canonical_json.cid_value(value, 306, 13, 2), "sha256:61d8d1281599c8a42c2bdd57c8a6902bf4f92cf63d806ba853c45261ab2f8211")
  assert_eq(@canonical_json.measure_value(value, 306, 13, 2), 306)
  assert_eq(@canonical_json.stringify_value(value, 306, 13, 2), "{\"command_contracts\":[],\"connector_capabilities\":[],\"connector_catalogs\":[],\"contract_registry\":[],\"host_policy_profile\":{\"mode\":\"unresolved\",\"version\":\"actql-host-policy/0.1\"},\"mapping_contracts\":[],\"model_task_contracts\":[],\"schema_snapshots\":[],\"source_views\":[],\"version\":\"actql-check-environment/0.1\"}")
}

