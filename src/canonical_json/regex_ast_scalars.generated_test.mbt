test "regex scalar AST identity: cr" {
  let json = @json.parse("{\"version\":\"actql-regex-ast/0.1\",\"root\":{\"kind\":\"literal\",\"codepoint\":13},\"capture_count\":0}")
  let value = @canonical_json.from_json(json, 10000, 100, 100000)
  assert_eq(@canonical_json.stringify_value(value, 100000, 10000, 100), "{\"capture_count\":0,\"root\":{\"codepoint\":13,\"kind\":\"literal\"},\"version\":\"actql-regex-ast/0.1\"}")
  assert_eq(@canonical_json.cid_value(value, 100000, 10000, 100), "sha256:984789471cfed92ae7405b3d14b856713b1cf6534b7e3d8b7ca30c309042dbce")
}

