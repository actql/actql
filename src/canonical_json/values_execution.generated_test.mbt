///|
test "REL.values params identity: ordinary" {
  let json = @json.parse("{\"schema\":{\"x\":{\"type\":\"number\",\"nullable\":false}},\"rows\":[{\"x\":1},{\"x\":2}]}")
  let value = @canonical_json.from_json(json, 10000, 100, 100000)
  assert_eq(@canonical_json.stringify_value(value, 100000, 10000, 100), "{\"rows\":[{\"x\":1},{\"x\":2}],\"schema\":{\"x\":{\"nullable\":false,\"type\":\"number\"}}}")
  assert_eq(@canonical_json.cid_value(value, 100000, 10000, 100), "sha256:f6481ad85d8ae3221553f71ee10d6e96c4cceddbf1dfeaf2dd64014a141e9aff")
}

