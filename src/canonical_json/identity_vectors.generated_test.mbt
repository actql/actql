    "uded_by_filter\",\"demand\":\"existing_checked_expression_demand_without_eager_undemanded_evaluation\",\"native\":\"preserve_mandatory_admission_and_demanded_failures_before_projection\",\"logical_guards\":\"max_rows_on_capture_output_max_value_bytes_on_admitted_records_and_demanded_roots\",\"physical_budget\":\"actual_received_bytes_rows_and_retention_independent_of_logical_output\",\"failure\":\"atomic_no_success_capture_or_consumer_on_failure_or_cancellation\",\"evidence\":\"verify_actual_execution_evidence_not_candidate_coverage_proposals_or_self_cid_only\",\"snapshot\":\"source_specific_no_universal_snapshot_token_or_isolation_requirement\",\"retention\":\"same_process_immutable_completed_observation_not_durable_run_or_recovery\",\"invocation\":\"existing_invocation_rules_retain_actual_observation_identity_not_result_identity_only\"}}",
