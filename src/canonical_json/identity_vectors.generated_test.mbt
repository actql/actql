    "{\"type\":\"object\",\"properties\":{\"version\":{\"const\":\"actql-lookup-raw-response/0.1\"},\"call_slot_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"network_attempt\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":9007199254740991},\"content_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"size_bytes\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991},\"media_type\":{\"type\":\"string\",\"minLength\":1},\"captured_at\":{\"type\":\"string\",\"pattern\":\"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\\\.[0-9]{3}Z$\"},\"effective_data_policy_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"effective_retention_policy_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"issuer_id\":{\"type\":\"string\",\"minLength\":1},\"authority_scope_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"self_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}},\"required\":[\"version\",\"call_slot_cid\",\"network_attempt\",\"content_cid\",\"size_bytes\",\"media_type\",\"captured_at\",\"effective_data_policy_cid\",\"effective_retenti",
    "on_policy_cid\",\"issuer_id\",\"authority_scope_cid\",\"self_cid\"],\"additionalProperties\":false}",
  ].join(""))
  let value = @canonical_json.from_json(input, 54, 3, 1114)
  assert_eq(@canonical_json.cid_value(value, 1114, 54, 3), "sha256:9cfcd5971b2ba28901bc41a75a00dac78f2b85e69b32a8dde6a7b34a8cc86b4e")
  assert_eq(@canonical_json.measure_value(value, 1114, 54, 3), 1114)
}

