  let input = @json.parse([
    "[\"finite-effect-free-sources\",\"exactly-once-slot-evidence\",\"closed-failure-allowlist\",\"required-and-all-unavailable-fail\",\"failed-attempt-budget-retained\",\"coverage-not-business-completeness\",\"no-nullification\",\"replay-without-dispatch\",\"sealed-admission-never-reorders\",\"coverage-preserves-observation-completeness\",\"execution-binds-scope-invocations-and-accounting\",\"reserve-before-dispatch-cas\",\"unresolved-consumption-remains-reserved\",\"recapture-retains-cumulative-usage\",\"homogeneous-union-with-explicit-coverage\",\"integration-admission-effect-free\"]",
  ].join(""))
  let value = @canonical_json.from_json(input, 17, 1, 556)
  assert_eq(@canonical_json.cid_value(value, 556, 17, 1), "sha256:017718057ac839a8db9727fff36302971a9e3e677faa70c591a5e6f027a46d0f")
  assert_eq(@canonical_json.measure_value(value, 556, 17, 1), 556)
}

