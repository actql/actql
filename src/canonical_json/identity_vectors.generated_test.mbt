  let value = @canonical_json.from_json(input, 240, 3, 3663)
  assert_eq(@canonical_json.cid_value(value, 3663, 240, 3), "sha256:00ac46baefe7fa34412ad83beb85cf1899b906e792d74fa89211a7c4972f0d5a")
