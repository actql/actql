    "ence_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"self_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}},\"required\":[\"version\",\"logical_request_scope_cid\",\"operation_contracts\",\"target_scope_cid\",\"permission_cid\",\"data_policy_cid\",\"item_count\",\"record_count\",\"amount_evidence_cid\",\"cost_evidence_cid\",\"write_bytes\",\"failure_guarantees_cid\",\"actor_authority_cid\",\"cumulative_allowance_evidence_cid\",\"self_cid\"],\"additionalProperties\":false}",
