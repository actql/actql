test "contract spec/contracts/actql-local-relation-snapshot.json#" {
  let input = @json.parse([
    "{\"version\":\"actql-local-relation-snapshot-contract/0.1\",\"dependencies\":{\"checked_type\":{\"path\":\"spec/contracts/actql-protocol-schemas.json\",\"pointer\":\"/schemas/canonical_value_contract\",\"cid\":\"sha256:02859499357530af0ae58e4f2958d1c8fa48f957b86b0a2976dad43bed99b551\"},\"source_reference\":{\"path\":\"spec/contracts/actql-local-source-reference.json\",\"pointer\":\"\",\"cid\":\"sha256:9be664306a6a91a8e5bfca53d579e6dac77baf4567eb241ceeedc3216ffe47d9\"}},\"schema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"version\",\"source_ref\",\"output_carrier\",\"schema\"],\"properties\":{\"version\":{\"const\":\"actql-local-input-schema/0.1\"},\"source_ref\":{\"type\":\"string\",\"pattern\":\"^source:local/(?:[^~/]|~[01])+/(?:[^~/]|~[01])+$\"},\"output_carrier\":{\"const\":\"relation\"},\"schema\":{\"allOf\":[{\"$ref\":\"#/$defs/value_contract\"},{\"type\":\"object\",\"required\":[\"type\",\"nullable\"],\"properties\":{\"type\":{\"const\":\"object\"},\"nullable\":{\"const\":false}}}]},\"column_presence\":{\"type\":\"object\",\"minProp",
    "erties\":1,\"propertyNames\":{\"pattern\":\"^(?!__cid$)(?!__actql_)(?![\\\\s\\\\S]*\\\\.)(?=[\\\\s\\\\S]*\\\\S)[\\\\s\\\\S]+$\"},\"additionalProperties\":{\"const\":\"conditional\"}},\"input_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"completeness\":{\"enum\":[\"complete\",\"partial\"]},\"integration_binding_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"score_contracts\":{\"type\":\"object\",\"propertyNames\":{\"pattern\":\"^(?!__cid$)(?!__actql_)(?![\\\\s\\\\S]*\\\\.)(?=[\\\\s\\\\S]*\\\\S)[\\\\s\\\\S]+$\"},\"additionalProperties\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"domain\",\"range\",\"normalization\"],\"properties\":{\"domain\":{\"type\":\"string\",\"minLength\":1},\"normalization\":{\"type\":\"string\",\"minLength\":1},\"higher_is_better\":{\"const\":true},\"range\":{\"type\":\"array\",\"minItems\":2,\"maxItems\":2,\"items\":{\"type\":\"number\"}}}}}},\"allOf\":[{\"if\":{\"required\":[\"input_cid\"]},\"then\":{\"required\":[\"completeness\"]}},{\"if\":{\"required\":[\"completeness\"]},\"then\":{\"required\":[\"input_cid\"]}},{\"if\":{\"required\":[\"integration_binding_cid\"]},\"then\":{\"required\":",
    "[\"input_cid\",\"completeness\"]}}],\"$defs\":{\"value_contract\":{\"oneOf\":[{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"type\",\"nullable\",\"precision\",\"scale\"],\"properties\":{\"type\":{\"const\":\"decimal\"},\"nullable\":{\"type\":\"boolean\"},\"precision\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":38},\"scale\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":38}},\"allOf\":[{\"if\":{\"properties\":{\"precision\":{\"const\":1}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":1}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":2}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":2}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":3}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":3}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":4}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":4}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":5}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":5}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":6}},\"required\":[\"precision\"]},\"th",
    "en\":{\"properties\":{\"scale\":{\"maximum\":6}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":7}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":7}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":8}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":8}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":9}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":9}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":10}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":10}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":11}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":11}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":12}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":12}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":13}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":13}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":14}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":14}}}},{\"if\":{\"properties",
    "\":{\"precision\":{\"const\":15}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":15}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":16}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":16}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":17}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":17}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":18}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":18}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":19}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":19}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":20}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":20}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":21}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":21}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":22}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":22}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":23}},\"required\":[\"precision\"]},\"",
    "then\":{\"properties\":{\"scale\":{\"maximum\":23}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":24}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":24}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":25}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":25}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":26}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":26}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":27}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":27}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":28}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":28}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":29}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":29}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":30}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":30}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":31}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":31}}}},{\"if\":{\"p",
    "roperties\":{\"precision\":{\"const\":32}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":32}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":33}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":33}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":34}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":34}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":35}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":35}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":36}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":36}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":37}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":37}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":38}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":38}}}}]},{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"type\",\"nullable\"],\"properties\":{\"type\":{\"const\":\"string\"},\"nullable\":{\"type\":\"boolean\"},\"min_length\":{\"type\":\"integer\",\"minim",
    "um\":0},\"max_codepoints\":{\"type\":\"integer\",\"minimum\":0},\"max_utf8_bytes\":{\"type\":\"integer\",\"minimum\":0}}},{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"type\",\"nullable\"],\"properties\":{\"type\":{\"enum\":[\"number\",\"boolean\",\"timestamp\",\"date\",\"json\"]},\"nullable\":{\"type\":\"boolean\"}}},{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"type\",\"nullable\",\"items\"],\"properties\":{\"type\":{\"const\":\"array\"},\"nullable\":{\"type\":\"boolean\"},\"items\":{\"$ref\":\"#/$defs/value_contract\"},\"max_items\":{\"type\":\"integer\",\"minimum\":0}}},{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"type\",\"nullable\",\"additional_properties\",\"fields\"],\"properties\":{\"type\":{\"const\":\"object\"},\"nullable\":{\"type\":\"boolean\"},\"additional_properties\":{\"const\":false},\"fields\":{\"type\":\"object\",\"propertyNames\":{\"pattern\":\"^(?!__cid$)(?!__actql_)(?![\\\\s\\\\S]*\\\\.)(?=[\\\\s\\\\S]*\\\\S)[\\\\s\\\\S]+$\"},\"additionalProperties\":{\"$ref\":\"#/$defs/value_contract\"}}}},{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"type\",\"nullable\",\"dimensions\",\"",
    "element_type\"],\"properties\":{\"type\":{\"const\":\"vector\"},\"nullable\":{\"type\":\"boolean\"},\"dimensions\":{\"type\":\"integer\",\"minimum\":1},\"element_type\":{\"const\":\"f32\"}}},{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"type\",\"nullable\",\"resource_kind\"],\"properties\":{\"type\":{\"const\":\"resource_ref\"},\"nullable\":{\"type\":\"boolean\"},\"resource_kind\":{\"type\":\"string\",\"minLength\":1}}},{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"type\",\"nullable\"],\"properties\":{\"type\":{\"const\":\"artifact_ref\"},\"nullable\":{\"type\":\"boolean\"},\"media_type\":{\"type\":\"string\",\"minLength\":1}}}]}}},\"semantics\":{\"identity\":\"canonical_json_utf8_sha256_of_entire_body_without_self_cid\",\"schema\":\"complete_checked_nonnullable_object_including_empty_fields\",\"presence\":\"finite_declared_columns; absent_column_presence_means_all_required; listed_existing_columns_are_conditional_independently_of_nullable; omission_is_not_null; reject_unknown_columns_and_empty_maps\",\"static_only\":\"absent_materialization_is_not_empty_data_or_complete_data\",\"m",
    "aterialization\":\"input_cid_and_completeness_are_paired_claims_not_verified_rows\",\"integration\":\"optional_integration_binding_cid_requires_materialization_claim\",\"admission\":\"exact_program_source_resolution_recursive_assertion_agreement_and_environment_membership\",\"authority\":\"content_integrity_does_not_establish_host_authorization_or_runtime_validation\",\"scores\":\"optional_field_scoped_static_score_assertions_require_nonnullable_number_fields_and_ordered_finite_ranges; authenticate_against_exact_captured_input_before_use; never_normalize_or_relabel_computed_scores\",\"score_projection\":\"canonical_snapshot_version_source_ref_output_carrier_schema_column_presence_and_complete_nonempty_score_contracts_map; exclude_materialization_completeness_integration; separate_from_row_type_projection\"}}",
  ].join(""))
  let value = @canonical_json.from_json(input, 683, 11, 10012)
  assert_eq(@canonical_json.cid_value(value, 10012, 683, 11), "sha256:0d1b824004f4e26bf3cadbfc437d000cd1d7cc6c218c0f0fc4276b483ba46701")
  assert_eq(@canonical_json.measure_value(value, 10012, 683, 11), 10012)
}

///|
test "contract spec/contracts/actql-local-source-reference.json#" {
  let input = @json.parse([
    "{\"version\":\"actql-local-source-reference/0.1\",\"schema\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"string\",\"pattern\":\"^source:local/(?:[^~/]|~[01])+/(?:[^~/]|~[01])+$\"},\"semantics\":{\"scope\":\"one_selected_staged_program\",\"components\":[\"stage_id\",\"local_input_name\"],\"escaping\":\"replace_tilde_with_tilde_zero_then_slash_with_tilde_one\",\"text\":\"nonempty_well_formed_nfc_lf_names_without_repair\",\"resolution\":\"exact_stage_and_local_non_connector_non_import_input\",\"identity\":\"selector_not_program_identity_or_authorization\",\"duplicates\":\"reject_repeated_schema_snapshot_source_refs\"}}",
  ].join(""))
  let value = @canonical_json.from_json(input, 16, 3, 602)
  assert_eq(@canonical_json.cid_value(value, 602, 16, 3), "sha256:9be664306a6a91a8e5bfca53d579e6dac77baf4567eb241ceeedc3216ffe47d9")
  assert_eq(@canonical_json.measure_value(value, 602, 16, 3), 602)
}

///|
test "contract spec/contracts/actql-bound-values-law.json#" {
  let input = @json.parse([
    "{\"version\":\"actql-bound-values-law/0.1\",\"law_id\":\"actql.bound.values\",\"unit\":\"rows\",\"subject\":\"The output of the owning checked values operation.\",\"derivation\":\"A constant equal to the authored rows array length. Every row occurrence counts once, including identical rows; an empty array contributes zero.\",\"inputs\":\"No input-carrier count witness is required. Cell Parameter binding and literal quotation do not change the row occurrence count.\",\"application\":\"The proof must refer to this exact Program operation occurrence, use the rows unit and source derivation (op: source), and have the same value as its authored row count. Equal counts do not make different operation subjects interchangeable.\",\"conditionality\":\"The bound applies if the operation succeeds. It does not discharge schema or cell validation, Parameter binding, resource enforcement, or permission to execute or publish. Failure does not produce a partial successful output.\"}",
  ].join(""))
  let value = @canonical_json.from_json(input, 9, 1, 949)
  assert_eq(@canonical_json.cid_value(value, 949, 9, 1), "sha256:0e0f9b4b6585ab7b17bafe484e82f44cd8f3acc9eec5ef9329cea200237a7971")
  assert_eq(@canonical_json.measure_value(value, 949, 9, 1), 949)
}

///|
test "contract spec/contracts/actql-bound-values-wire-law.json#" {
  let input = @json.parse([
    "{\"version\":\"actql-bound-values-wire-law/0.1\",\"law_id\":\"actql.bound.values-wire\",\"unit\":\"bytes\",\"subject\":\"The complete /rows value of the REL.values execution params for the owning checked values occurrence, after cell binding and quotation removal.\",\"derivation\":\"The exact UTF-8 byte length of canonical typed JSON wire encoding of that rows array. Include outer brackets, row objects, field names, separators and escaped values; exclude schema and the enclosing params object. Empty rows have length two. Retain every row and cell occurrence, including repetitions.\",\"values\":\"Use the declared typed wire representation, including canonical fixed-scale decimal strings. Do not use decimal coefficient text, typed identity tags, raw text byte totals, source quotation wrappers or a heap-size estimate. Do not reinterpret nested business keys as Parameter holes or quotation.\",\"inputs\":\"Use the owning occurrence's complete checked schema, admitted literal cells and exact resolved Parameter cell occurrences from the same ",
    "Program and binding owner. No input-carrier count witness is required. The local proof has source derivation and no input quantity witnesses.\",\"application\":\"Recompute the measurement from that exact owned occurrence before accepting the asserted value. Require actql-bound-proof/0.1 with matching semantic_ref, this law_id, unit bytes, the exact measured value and an empty inputs array. A matching self-CID or numeric value alone is not application evidence; retain the checked operation and binding owner with the applied proof.\",\"scope\":\"This is a wire-payload bound, not an Artifact byte bound, an output-row count, a per-cell bound, a recursive-depth ceiling or a total-memory bound. It does not select a Host ceiling. Consumers may use it only for this exact measured scope, or through a separately specified transfer law.\",\"limit_selection\":\"Under the closed values grammar and actql-capacity-host-policy/0.1 field set, the complete /rows wire scope has no authored byte guard or applicable Host ceiling. Its resolve",
    "d limit uses the applied Program proof as its sole candidate, effective_max equal to the exact byte count, author_guard_binding absent, breach fail and enforcement engine_atomic. The owner-relative subject is values:checked-step:<index>:wire, bound to the exact checked operation and selected policy; it is not a durable Program identity. Adding a scope-compatible ceiling requires updating this selection rule. Row, nested-value, Artifact and physical-resource limits remain independently applicable in their own scopes.\",\"conditionality\":\"Application does not discharge applicable ceiling selection, recursive-value limits, backend enforcement, registration, execution authority or atomic publication. Exceeding an applicable resolved limit fails the operation rather than truncating its rows. This law does not change Program or Unit identity projection.\"}",
  ].join(""))
  let value = @canonical_json.from_json(input, 12, 1, 2907)
  assert_eq(@canonical_json.cid_value(value, 2907, 12, 1), "sha256:b36a2c0087fa668e54b50e15ffae0985bda11bf4eab06b46c1b8a91f8750e750")
  assert_eq(@canonical_json.measure_value(value, 2907, 12, 1), 2907)
}

///|
test "contract spec/contracts/actql-bound-ranking-laws.json#" {
  let input = @json.parse([
    "{\"version\":\"actql-bound-ranking-laws/0.1\",\"law_ids\":[\"actql.bound.nearest\",\"actql.bound.text-rank\",\"actql.bound.merge-rankings\"],\"query_top_k\":\"For nearest and text_rank, query occurrence bound Q and positive k give output row bound Q * k. With a candidate occurrence bound C, use Q * min(C, k). The query side is the query operand, not the current candidate operand; both bindings retain actual input occurrences and producers. These bounds are conditional on successful identity and value admission, not permission to deduplicate invalid inputs.\",\"merge_global\":\"When by is empty, merge_rankings has one global group and output bound k without input count proofs. With input bounds, use min(k, sum(input bounds)). Evaluate this mathematical bound without requiring an unbounded intermediate sum: reaching the cap is not safe-integer overflow or output truncation, because the operation itself specifies top-k selection.\",\"merge_partitioned\":\"When by is nonempty, k is per query group and is not a global row bound. The sum",
    " of all input occurrence bounds is a conservative global bound; retain repeated operand occurrences. Unknown input bounds do not become zero, and no global k clamp is inferred.\",\"arithmetic\":\"Counts and k are nonnegative safe integers with k positive. Perform required products and uncapped sums exactly and reject overflow without rounding or saturation. An applicable zero query bound gives zero output rows, but never waives input or option validation.\",\"conditionality\":\"Bounds retain the selected operation, quantity, input dependencies and required ranking admission. They do not prove valid vectors, dimensions, scores, unique identities, contiguous ranks, lexical profile admission, completeness or authorization. Ranking semantics, total order and resource enforcement remain separate requirements.\"}",
  ].join(""))
  let value = @canonical_json.from_json(input, 11, 2, 1833)
  assert_eq(@canonical_json.cid_value(value, 1833, 11, 2), "sha256:655fa88f2d24a15794a12abdbdc967f51517f5f92aa1316f74f6df1617fcf0c7")
  assert_eq(@canonical_json.measure_value(value, 1833, 11, 2), 1833)
}

///|
test "contract spec/contracts/actql-bound-series-laws.json#" {
  let input = @json.parse([
    "{\"version\":\"actql-bound-series-laws/0.1\",\"law_ids\":[\"actql.bound.time-series\",\"actql.bound.calendar-series\"],\"time_series\":\"After admitting and binding UTC timestamp endpoints and a positive safe-integer millisecond step, start <= end is required. The half-open generated range has ceil((end_ms - start_ms) / step) rows; equal endpoints give zero. Use the specified proleptic Gregorian calendar, not Host timezone APIs. Compute quotient and remainder exactly without an overflowing duration + step - 1 intermediate. Empty ranges do not waive binding or step validation.\",\"calendar_series\":\"Calendar-series boundaries follow the selected calendar options and pinned timezone profile. A conservative row bound for the admitted years 0001..9999 is 3652061 for day, 521725 for week, 119990 for month, 39998 for quarter and 10001 for year. These are one start per civil unit plus two edge positions, not exact output counts. Equal admitted literal endpoints permit zero. Gap, fold and coincident-boundary handling cannot add more",
    " starts than this bound.\",\"application\":\"Generator bounds have no input row count dependency. Retain the actual generator occurrence, bound Parameter ownership and governing temporal or calendar profile. Concrete bound values do not replace the corresponding semantic contracts or become the local contract set. Calendar bucket preserves input count and is not a calendar-series source proof.\",\"arithmetic\":\"Derived counts are exact nonnegative safe integers or conservative bounds represented as such. Reject invalid endpoints, reversed ranges, unresolved required bindings and unsafe arithmetic; never round, saturate or silently generate a prefix.\",\"conditionality\":\"A count proof is conditional on successful value, option and profile validation. It does not generate rows, establish completed resource enforcement, grant execution authority or prove observed results.\"}",
  ].join(""))
  let value = @canonical_json.from_json(input, 10, 2, 1898)
  assert_eq(@canonical_json.cid_value(value, 1898, 10, 2), "sha256:c85b84631add903652807808fc4faa9015e59cf9bfd0fb11bf170c85139dcf05")
  assert_eq(@canonical_json.measure_value(value, 1898, 10, 2), 1898)
}

///|
test "contract spec/contracts/actql-bound-graph-laws.json#" {
  let input = @json.parse([
    "{\"version\":\"actql-bound-graph-laws/0.1\",\"law_ids\":[\"actql.bound.graph-nodes\",\"actql.bound.graph-edges\",\"actql.bound.graph-node-rows\",\"actql.bound.graph-edge-rows\",\"actql.bound.graph-degree\",\"actql.bound.components-input-nodes\",\"actql.bound.components-nodes\",\"actql.bound.match-nodes\",\"actql.bound.match-edges\",\"actql.bound.traverse-nodes\",\"actql.bound.shortest-path\"],\"quantities\":\"Node extents use nodes, edge extents use edges, and emitted Relation occurrences use rows. Every dependency retains its actual input occurrence, producer and quantity. A conversion between quantities is justified only by the selected rule, never by matching numeric values.\",\"construction\":\"With an explicit node Relation, node count is bounded by its rows and edge count by the edge Relation's rows. Without it, at most two endpoint nodes are created per edge row, so node count is bounded by twice edge rows and edge count by edge rows. Identity deduplication does not increase either bound. Endpoint and property validation remain required",
    ".\",\"combination\":\"Union and two-input structural combination may use the sum of the respective input node bounds and the sum of the respective edge bounds. Retain repeated input occurrences even when their producer or proof CID is the same. Subtraction may use the left bounds alone. These conservative bounds do not assert that intersections emit every input entity or discharge identity conflict checks.\",\"preservation\":\"Normalization and subgraph selection do not increase node or edge counts and may retain the corresponding input bounds. This does not authorize preserving counts through arbitrary Graph-producing operations such as union or applying a Delta.\",\"projection\":\"node_rows and degree emit at most the input node count in rows; edge_rows emits at most the edge count. Node matching emits at most the original node count and edge matching at most the original edge count, regardless of repeated authored selectors. Components retains its input node extent for internal work and bounds its component rows by th",
    "at extent.\",\"selectors\":\"A single endpoint has bound one. Explicit ID selectors use their admitted ID count. A Relation selector uses its corresponding Relation row bound; a node predicate uses the selected graph's node bound. These are conditional extents, not proofs of selector membership or uniqueness. Repeated Relation selector edges remain separate occurrences; sharing the graph node bound does not change their ownership.\",\"traverse_nodes\":\"For node emission, a graph node bound N and start extent S give at most min(S, N) * N rows. The clamp is justified by successful distinct graph-node start selection and one minimum eligible simple-path depth per start/end pair, after all hop and predicate conditions. It is applied before multiplication. This is not a path-emission bound; path multiplicity requires a separate finite bound and enforcement.\",\"shortest_path\":\"each_pair emits at most S * T rows for source and target extents. nearest_per_source emits at most S rows and does not need a target extent for this",
    " bound. nearest_pair emits at most one row and needs no endpoint count proof for that bound. These are upper bounds, including when no path exists, not assertions of nonempty output or successful endpoint admission.\",\"arithmetic\":\"Use exact nonnegative safe-integer arithmetic and reject addition or multiplication overflow. Do not round, saturate or replace unknown extents with zero. Select applicable clamps and operation-specific rules before arithmetic that the rule does not require.\",\"conditionality\":\"All derived bounds are conditional on operation success and retain validation dependencies. They do not establish observed input sizes, graph completeness, search-work or byte ceilings, authority, or completed resource enforcement. A failed check exposes no partial successful output.\"}",
  ].join(""))
  let value = @canonical_json.from_json(input, 24, 2, 3867)
  assert_eq(@canonical_json.cid_value(value, 3867, 24, 2), "sha256:ef1923fe948bed0d07a08bf339e75f0ca9749bde9f1590b31ff3e9317a1e7c48")
  assert_eq(@canonical_json.measure_value(value, 3867, 24, 2), 3867)
}

///|
test "contract spec/contracts/actql-bound-property-graph-laws.json#" {
  let input = @json.parse([
    "{\"version\":\"actql-bound-property-graph-laws/0.1\",\"law_ids\":[\"actql.bound.property-graph-nodes\",\"actql.bound.property-graph-edges\"],\"construction\":\"For the admitted independently keyed Property Graph constructor, the node upper bound is the sum of node-definition input row upper bounds and the edge upper bound is the sum of edge-definition input row upper bounds. A definition contributes once per actual ordered input occurrence, including repeated uses of the same producer. A family with no definitions has bound zero. An unknown required input is not zero. NULL-key and missing-endpoint exclusion do not increase either bound. No endpoint-derived nodes are added.\",\"ownership\":\"Each premise retains its actual pipeline owner, input target, quantity and data-edge occurrence. Node and edge premises cannot be interchanged even when their values or producer CIDs are equal. Canonically sorted proof references preserve repeated occurrences and do not replace applicability checks.\",\"selection\":\"Definition-local node MATC",
    "H emits at most the original graph node count in rows and definition-local edge MATCH emits at most the original graph edge count. Static label and predicate filtering cannot increase that extent. This reuses the existing match-nodes and match-edges quantity transfer, not the legacy graph identity or endpoint-deduplication semantics. Path emission does not follow from either selection bound and retains separate output enforcement.\",\"arithmetic\":\"Use exact nonnegative safe-integer addition and reject overflow before emitting a proof. Do not round, saturate or substitute policy ceilings as evidence of the input sum.\",\"conditionality\":\"These are bounds on successful output, not observed counts or execution authority. They retain duplicate-key, value admission, endpoint, resource, work, workspace, byte and cancellation obligations. The legacy Graph constructor and its count laws remain unchanged.\"}",
  ].join(""))
  let value = @canonical_json.from_json(input, 10, 2, 1931)
  assert_eq(@canonical_json.cid_value(value, 1931, 10, 2), "sha256:5302fcd9ffaddc5d0bc61bb64a5769ed435fd4cc7cb95765947b2c1ed27d9c08")
  assert_eq(@canonical_json.measure_value(value, 1931, 10, 2), 1931)
}

///|
test "contract spec/contracts/actql-bound-window-laws.json#" {
  let input = @json.parse([
    "{\"version\":\"actql-bound-window-laws/0.1\",\"law_ids\":[\"actql.bound.row-window\",\"actql.bound.window-events\"],\"application\":\"row_window applies to Relation row occurrences; window_events applies to Events occurrences. Retain the checked Carrier, actual input occurrence, count dependency and governing law. Equal numeric bounds do not permit substituting another producer or Carrier.\",\"options\":\"Resolve size, any supplied step and offset under their declared millisecond domains before applying the bound. Size and supplied step are positive safe integers; offset is a signed safe integer. Duration Parameters use their admitted millisecond value. Missing bindings or invalid values remain failures even when an option does not change the multiplier.\",\"fixed\":\"The multiplier is 1. An explicit step is validated and retained but does not participate in boundaries, memberships or the bound. An omitted step is not inserted.\",\"sliding\":\"Step is required. The multiplier is ceil(size / step), computed exactly as quotient plus on",
    "e when the remainder is nonzero. Closed-open membership and the offset grid imply at most this many memberships per input occurrence, including when step exceeds size.\",\"boundary_arithmetic\":\"Compute grid positions and closed-open membership from the exact admitted numeric or timestamp time and integer options. Do not round an intermediate grid value or reject it only because it lies outside binary64. Emit a boundary only when its exact integer value is representable in binary64; otherwise fail with the window arithmetic error. No rounded boundary may change window width or membership.\",\"bound\":\"Multiply the applicable input occurrence upper bound by the multiplier using exact nonnegative safe-integer arithmetic. Reject overflow without rounding or saturation. Unknown input bounds are not zero. A zero input bound gives zero memberships but does not waive option validation.\",\"identity_and_order\":\"Offset is not reduced modulo the grid for identity. Retain authored options and Parameter dependencies. Membership ",
    "occurrences preserve input logical order then ascending window start; this bound neither establishes input order nor proves ID uniqueness or window-role evidence after a later projection.\",\"conditionality\":\"The bound is conditional on operation success. Boundary arithmetic, input value validation and resource enforcement remain required. It does not prove acquisition completeness, authorize execution or permit truncation.\"}",
  ].join(""))
  let value = @canonical_json.from_json(input, 13, 2, 2475)
  assert_eq(@canonical_json.cid_value(value, 2475, 13, 2), "sha256:2ad08f2130caa35968ac9cdf660708693c5e14f021f7878d9965a5e1fff5ff78")
  assert_eq(@canonical_json.measure_value(value, 2475, 13, 2), 2475)
}

///|
test "contract spec/contracts/actql-bound-join-laws.json#" {
  let input = @json.parse([
    "{\"version\":\"actql-bound-join-laws/0.1\",\"unit\":\"rows\",\"law_ids\":[\"actql.bound.join-output\",\"actql.bound.asof-left\"],\"inputs\":\"L and R are nonnegative safe-integer upper bounds for the actual ordered left and right input occurrences of the checked operation. Repeated producers retain separate occurrences. Unknown counts are not zero. A numeric equality does not establish producer or quantity correspondence.\",\"unrefined\":{\"inner\":\"L * R\",\"cross_join\":\"L * R; a right_rows: one assertion is not permission to discard extra rows and remains subject to validation\",\"left\":\"L * max(1, R)\",\"full\":\"R if L = 0; L if R = 0; L + R if L = 1 or R = 1; otherwise L * R\",\"semi\":\"0 if R = 0; otherwise L\",\"anti\":\"L\",\"asof\":\"L, including unmatched left rows; no right count proof is required for this output bound\"},\"unique_refinement\":{\"eligibility\":\"Use only applicable checked join-key uniqueness evidence or a retained cardinality assertion with its required validation. At least one side must be unique. Equal row types, repeated co",
    "nditions and distinct producer names are not uniqueness evidence. For a zero input bound use the unrefined rules.\",\"inner\":\"min(L, R) if both sides are unique; L if only the right is unique; R if only the left is unique\",\"left\":\"L if the right is unique; otherwise L + R - 1 when only the left is unique\",\"full\":\"L + R\",\"semi_and_anti\":\"L; a smaller bound may follow separately from empty-input rules\"},\"application\":\"Equality and interval joins use the rule for their checked kind. Cross join uses the product rule. As-of join uses the left-preserving rule. Each proof retains its governing law, input occurrences and any uniqueness or cardinality validation dependencies; a tighter numeric result does not discharge those dependencies.\",\"arithmetic\":\"Compute addition and multiplication exactly and reject a result outside the nonnegative safe-integer range. Do not round, saturate or truncate. Empty-input cases are selected before arithmetic that is unnecessary for that case.\",\"conditionality\":\"These are output upper b",
    "ounds conditional on successful execution, not exact row counts, acquisition completeness, search-work bounds, order evidence, resource enforcement or permission to execute. Failed assertions or exceeded enforced ceilings expose no partial successful result.\"}",
  ].join(""))
  let value = @canonical_json.from_json(input, 24, 2, 2308)
  assert_eq(@canonical_json.cid_value(value, 2308, 24, 2), "sha256:75f9c5ce5188d28a2e3b42213e0fb3a479475c06e280eb02ef7b001a355d1600")
  assert_eq(@canonical_json.measure_value(value, 2308, 24, 2), 2308)
}

///|
test "contract spec/contracts/actql-bound-relation-laws.json#" {
  let input = @json.parse([
    "{\"version\":\"actql-bound-relation-laws/0.1\",\"unit\":\"rows\",\"scope\":\"Common Relation output upper-bound transfers. Operation-specific Carrier laws, input admission, ordering and resource enforcement remain separate. Selecting this body does not make every rule applicable to every operation.\",\"arithmetic\":\"Counts and resolved factors are nonnegative safe integers. Addition and multiplication are exact and reject overflow; they never truncate, round or saturate. An unknown input count or unresolved factor is not zero.\",\"application\":\"Each dependency identifies the actual ordered input occurrence of the owning checked operation and carries a rows bound. Repeated operands retain their multiplicity even when they refer to the same producer. A matching numeric value does not establish source, unit or producer correspondence.\",\"rules\":{\"preserve\":{\"meaning\":\"An operation known not to increase rows may retain an applicable input upper bound without claiming an exact output count. Parent/left-preserving operations retain",
    " the parent/left bound, not an unrelated operand. Global grouping that emits one row on empty input is not this rule.\",\"derivation\":\"Retain the input dependency through checked non-expanding transfers; do not invent a new source proof or remove its validation dependencies.\"},\"global_group\":{\"law_id\":\"actql.bound.global-group\",\"meaning\":\"A global group emits one aggregate row, including for empty input. Its output upper bound is one, independently of an input count proof.\",\"derivation\":\"source with value 1 and no count inputs\"},\"take_top_k\":{\"law_ids\":[\"actql.bound.take\",\"actql.bound.top-k\"],\"meaning\":\"After count binding, take and global top_k admit the requested count as an upper bound. With an applicable input bound N, the bound is min(N, count). Ignoring a take offset is conservative and does not claim exact output size. top_k_by with an empty partition is global; a nonempty partition does not admit count as a global output bound.\",\"derivation\":\"clamp with the actual bound count as maximum and zero or one ",
    "input count dependency\"},\"append\":{\"law_id\":\"actql.bound.append\",\"meaning\":\"For left and right row upper bounds L and R, append has upper bound L + R. Identical operands and duplicate rows are counted twice.\",\"derivation\":\"add with two ordered input count dependencies\"},\"unpivot\":{\"law_id\":\"actql.bound.unpivot\",\"meaning\":\"For input row bound N and K authored selected-column occurrences, the output bound is N * K. Repeated selected columns count separately; no candidate-key or distinct-name assertion follows.\",\"derivation\":\"multiply with one input count dependency and factor K\"},\"unnest\":{\"law_id\":\"actql.bound.unnest-array-items\",\"meaning\":\"For input row bound N and the checked unnest expansion bound K, the output bound is N * K. K follows the operation's array max_items and empty/null retention rules; a retained empty/null row contributes one, not zero. An unavailable expansion bound does not supply a finite derived result.\",\"derivation\":\"multiply with one input count dependency and the checked expansion fact",
    "or K\"}},\"conditionality\":\"All bounds apply if the owning operation succeeds. They do not discharge value validation, Parameter binding, order or uniqueness requirements, acquisition completeness, resource enforcement, or permission to execute or publish. Failure exposes no partial successful output.\"}",
  ].join(""))
  let value = @canonical_json.from_json(input, 33, 4, 3374)
  assert_eq(@canonical_json.cid_value(value, 3374, 33, 4), "sha256:163a0d75d56310803ac755d5f4f02069f442651711209037d6e3f512954c97ab")
  assert_eq(@canonical_json.measure_value(value, 3374, 33, 4), 3374)
}

