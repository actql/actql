  let input = @json.parse([
    "{\"surface_status\":\"adopted\",\"required_root_keys\":[\"version\",\"id\",\"stages\",\"results\"],\"optional_root_keys\":[\"meta\",\"params\",\"bindings\"],\"required_stage_keys\":[\"id\",\"inputs\",\"steps\",\"results\"],\"optional_stage_keys\":[\"meta\",\"from\",\"effects\",\"after\"],\"import_forms\":[\"{result:{stage,result}}\",\"{receipt:{stage,effect}}\"],\"export_form\":\"{from:{stage,result}}\",\"after\":{\"initial\":\"absent\",\"later_default\":\"completed\",\"later_values\":[\"completed\",\"accepted\"]},\"parameters\":{\"recursive_objects_arrays\":true,\"nullable_default\":false,\"nullable_default_scope\":\"all-recursive-parameter-type-positions\",\"recursive_constraints\":[\"integer\",\"minimum\",\"maximum\",\"format\",\"length\",\"max_items\"],\"declaration_only_members\":[\"default\",\"meta\"],\"literal_default_on_missing_only\":true,\"deep_merge\":false,\"bind_once_program_wide\":true},\"inputs\":{\"duplicates_default\":\"reject\",\"duplicates_forms\":[\"reject\",\"{first_by_order:{order_by:[OrderKey,...]}}\"]},\"root_constraints\":{\"rejected_keys\":[\"inputs\",\"from\",\"steps\",\"effects\"],\"diagnostic\":\"ACTQL_E_STAG",
    "E_LOCAL_ROOT_FIELD\",\"automatic_repair\":false},\"infer\":{\"on_non_success_default\":\"outcomes\",\"on_non_success_values\":[\"outcomes\",\"fail\"]},\"derive\":{\"map\":{\"scope\":\"input_snapshot\",\"shadow_input\":false,\"order\":\"canonical_utf16\"},\"array\":{\"shape\":\"nonempty singleton expression maps\",\"scope\":\"prior_slot_then_input\",\"shadow_input\":true,\"duplicate_outputs\":false,\"order\":\"authored\"},\"input_passthrough\":true,\"shape_preserved\":true,\"closed_output\":\"select\",\"failure_order\":[\"row\",\"binding\",\"expression-child\"]},\"unregistered_evaluation_operation\":\"project\"}",
