    "{\"version\":\"actql-result-import-observation/0.1\",\"consumer_unit_definition_cid\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"input_name\":\"rows\",\"import_interface_cid\":\"sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\",\"producer_local_manifest_cid\":\"sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\",\"result_artifact_cid\":\"sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd\"}",
  ].join(""))
  let value = @canonical_json.from_json(input, 7, 1, 471)
  assert_eq(@canonical_json.cid_value(value, 471, 7, 1), "sha256:2b0ab336dffc32daa305b80681050e3b269ae9915da6e2eee1da10c9153ee267")
  assert_eq(@canonical_json.measure_value(value, 471, 7, 1), 471)
}

