    "ngth\":1},\"authority_scope_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"self_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}},\"required\":[\"version\",\"barrier_cid\",\"batch_plan_cid\",\"call_slot_cid\",\"activation_cid\",\"network_attempt\",\"capture_event_cid\",\"raw_response_artifact_cid\",\"response_schema_cid\",\"page_value_cid\",\"previous_adoption_cid\",\"terminal\",\"next_token\",\"recorded_at\",\"issuer_id\",\"authority_scope_cid\",\"self_cid\"],\"additionalProperties\":false}",
  ].join(""))
