    "{\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"version\":{\"const\":\"actql-discovery/0.1\"},\"publication_snapshot_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},\"scope_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},\"query\":{\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"kind\":{\"enum\":[\"catalog\",\"model_task\",\"grammar\",\"program_schema\",\"host_capabilities\"]},\"selector\":{\"type\":\"string\",\"minLength\":1}},\"required\":[]},\"entries\":{\"type\":\"array\",\"minItems\":0,\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"kind\":{\"enum\":[\"catalog\",\"model_task\",\"grammar\",\"program_schema\",\"host_capabilities\"]},\"selector\":{\"type\":\"string\",\"minLength\":1},\"content_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"}},\"required\":[\"kind\",\"selector\",\"content_cid\"]}},\"complete\":{\"type\":\"boolean\"},\"next_cursor\":{\"type\":\"string\",\"minLength\":1},\"page_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"}},\"required\":[\"version\",\"publication_snapshot_cid\",\"scope_cid\",\"query\",\"en",
    "tries\",\"complete\",\"page_cid\"]}",
  ].join(""))
  let value = @canonical_json.from_json(input, 67, 7, 1054)
  assert_eq(@canonical_json.cid_value(value, 1054, 67, 7), "sha256:6c52fabd737a5ce26f6ac54c23d49c1c1c4b613d9620e4cbe2ada752b474b048")
  assert_eq(@canonical_json.measure_value(value, 1054, 67, 7), 1054)
}

