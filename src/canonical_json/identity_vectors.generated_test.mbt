    "{\"type\":\"object\",\"properties\":{\"version\":{\"const\":\"actql-acquisition-ordering/0.1\"},\"producer_contract_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"kind\":{\"enum\":[\"occurrence\",\"keys\"]},\"terms\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"field\":{\"type\":\"string\",\"minLength\":1},\"dir\":{\"enum\":[\"asc\",\"desc\"]},\"nulls\":{\"enum\":[\"first\",\"last\"]}},\"required\":[\"field\",\"dir\",\"nulls\"],\"additionalProperties\":false},\"minItems\":0},\"witness_evidence\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"kind\":{\"enum\":[\"source\",\"derivation\"]},\"cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}},\"required\":[\"kind\",\"cid\"],\"additionalProperties\":false},\"minItems\":1,\"uniqueItems\":true},\"self_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}},\"required\":[\"version\",\"producer_contract_cid\",\"kind\",\"terms\",\"witness_evidence\",\"self_cid\"],\"additionalProperties\":false}",
  ].join(""))
  let value = @canonical_json.from_json(input, 63, 7, 892)
  assert_eq(@canonical_json.cid_value(value, 892, 63, 7), "sha256:ff0b367507ede56d319fc041aacec38fa98f6683ec383b6c0475a2cbede64925")
  assert_eq(@canonical_json.measure_value(value, 892, 63, 7), 892)
}

