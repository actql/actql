    "{\"relation\":{\"ordering_evidence_cid\":\"ordering\",\"observation_scope_cid\":\"scope\",\"provenance_evidence/*\":\"kind-dispatched\"},\"ordering\":{\"witness_evidence/*\":\"kind-dispatched\"},\"batch_plan\":{\"request_key_set_cid\":\"key_set\",\"transport_plan_cid\":\"transport_plan\"},\"request\":{\"transport_plan_cid\":\"transport_plan\",\"request_schema_cid\":\"catalog-request\"},\"transport_plan\":{\"adapter_contract_cid\":\"checked-read-profile\",\"request_schema_cid\":\"catalog-request\",\"response_schema_cid\":\"catalog-response\"},\"key_set\":{\"request_schema_cid\":\"catalog-single-request\"},\"attempt_receipt\":{\"input_relation_artifact_cid\":\"relation\",\"request_key_set_cid\":\"key_set\",\"batch_plan_cid\":\"batch_plan\",\"previous_receipt_cid\":\"attempt_receipt?\",\"attempts/*/call_slot_cid\":\"call_slot\",\"attempts/*/semantic_request_cid\":\"request\",\"source_request_egress_admission_cid\":\"egress?\",\"attempts/*/raw_response_artifact_cid\":\"raw_response?\",\"attempts/*/runtime_error_cid\":\"runtime_error?\",\"lifecycle_evidence/*\":\"kind-dispatched\"},\"activation\":{\"batch_plan_cid\":\"",
    "batch_plan\",\"call_slot_cid\":\"call_slot\",\"previous_activation_cid\":\"activation?\",\"previous_attempt_event_cid\":\"attempt_event?\"},\"adoption\":{\"batch_plan_cid\":\"batch_plan\",\"call_slot_cid\":\"call_slot\",\"activation_cid\":\"activation\",\"capture_event_cid\":\"attempt_event\",\"raw_response_artifact_cid\":\"raw_response\",\"previous_adoption_cid\":\"adoption?\",\"response_schema_cid\":\"catalog-response\"},\"raw_response\":{\"call_slot_cid\":\"call_slot\"},\"egress\":{\"input_relation_artifact_cid\":\"relation\"},\"derivation\":{\"input_relation_cids/*\":\"relation\",\"scope_cid\":\"scope\"},\"accounting\":{\"batch_plan_cid\":\"batch_plan\",\"input_relation_artifact_cid\":\"relation\",\"previous_accounting_cid\":\"accounting?\",\"attempts/*/call_slot_cid\":\"call_slot\",\"attempts/*/usage_resolution_event_cid\":\"attempt_event?\"},\"attempt_event\":{\"batch_plan_cid\":\"batch_plan\",\"call_slot_cid\":\"call_slot\",\"previous_event_cid\":\"attempt_event?\",\"raw_response_artifact_cid\":\"raw_response?\",\"runtime_error_cid\":\"runtime_error?\"},\"call_slot\":{\"batch_plan_cid\":\"batch_plan\",\"semantic_req",
    "uest_cid\":\"request\"},\"scope\":{\"sources/*/request_key_set_cid\":\"key_set?\"}}",
  ].join(""))
  let value = @canonical_json.from_json(input, 67, 2, 2122)
  assert_eq(@canonical_json.cid_value(value, 2122, 67, 2), "sha256:24dd3184553911026820fbf87b96d32ac3ce4fb4d256f069fe3d1c9d5533240d")
  assert_eq(@canonical_json.measure_value(value, 2122, 67, 2), 2122)
}

