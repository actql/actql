///|
test "canonical null" {
  let input = @json.parse([
    "null",
  ].join(""))
  let value = @canonical_json.from_json(input, 1, 0, 4)
  assert_eq(@canonical_json.cid_value(value, 4, 1, 0), "sha256:74234e98afe7498fb5daf1f36ac2d78acc339464f950703b8c019892f982b90b")
  assert_eq(@canonical_json.measure_value(value, 4, 1, 0), 4)
  assert_eq(@canonical_json.stringify_value(value, 4, 1, 0), "null")
}

///|
test "canonical primitives" {
  let input = @json.parse([
    "[true,false,0,1.5,1e-7,1e+21]",
  ].join(""))
  let value = @canonical_json.from_json(input, 7, 1, 29)
