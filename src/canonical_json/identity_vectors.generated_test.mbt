    "{\"type\":\"object\",\"properties\":{\"version\":{\"const\":\"actql-graph-recovery-link/0.1\"},\"original_graph_run_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"new_graph_definition_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"retained_local_item_evidence_cids\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"minItems\":0},\"changed_unit_definition_cids\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"minItems\":0},\"reused_observation_preview_cids\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"minItems\":0},\"authority_evidence_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"authentication_evidence_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"self_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}},\"required\":[\"version\",\"original_graph_run_cid\",\"new_graph_definition_cid\",\"retained_local_item_evidence_cids\",\"changed_unit_definition_cids\",\"reused_observation_preview_cids\",\"authority_evide",
    "nce_cid\",\"authentication_evidence_cid\",\"self_cid\"],\"additionalProperties\":false}",
  ].join(""))
  let value = @canonical_json.from_json(input, 49, 4, 1104)
  assert_eq(@canonical_json.cid_value(value, 1104, 49, 4), "sha256:76a96bfbd35b3614ea8ae4cea96ec13953d164c8a8a36868d791d2fae41f7d85")
  assert_eq(@canonical_json.measure_value(value, 1104, 49, 4), 1104)
}

