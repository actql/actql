  let input = @json.parse([
    "{\"checked-read-profile\":{\"selection\":\"checked SourceView execution contract; HTTP binding resolves http_read_transport, not SourceReadPlan\",\"path\":\"spec/contracts/actql-production-profile-schemas.json\",\"pointer\":\"/schemas/http_read_transport\",\"self_field\":\"transport_cid\",\"schema_cid\":\"sha256:9d1b94d787b76a5e9ef6714bf9d44bc9c5edd42e3f9f60ffa106c9bc4ecb525c\"},\"runtime_error\":{\"path\":\"spec/contracts/actql-protocol-schemas.json\",\"pointer\":\"/artifact_schemas/runtime_error\",\"self_field\":\"error_cid\",\"schema_cid\":\"sha256:065e22b471b7e63c67061a75854e5ca3d1821841fcc07016742d6b715632608d\"},\"catalog-single-request\":{\"path\":\"spec/contracts/actql-protocol-schemas.json\",\"pointer\":\"/schemas/contract_envelope\",\"self_field\":\"cid\",\"schema_cid\":\"sha256:12b59aa2fd993c1d540f8cc80f658760f17ee9f179d8d12cb5f037127b8ae6fe\",\"selection\":\"checked Catalog member at SourceView.acquisition.request_schema; kind=request_schema\"},\"catalog-request\":{\"path\":\"spec/contracts/actql-protocol-schemas.json\",\"pointer\":\"/schemas/contract_envelope\",\"self",
    "_field\":\"cid\",\"schema_cid\":\"sha256:12b59aa2fd993c1d540f8cc80f658760f17ee9f179d8d12cb5f037127b8ae6fe\",\"selection\":\"single: acquisition.request_schema kind=request_schema; native: acquisition.batching.batch_request_schema kind=lookup_batch_request\"},\"catalog-response\":{\"path\":\"spec/contracts/actql-protocol-schemas.json\",\"pointer\":\"/schemas/contract_envelope\",\"self_field\":\"cid\",\"schema_cid\":\"sha256:12b59aa2fd993c1d540f8cc80f658760f17ee9f179d8d12cb5f037127b8ae6fe\",\"selection\":\"SourceView.output.schema kind=carrier_schema; extracted Relation row type, not raw HTTP wrapper\"},\"egress\":{\"schema\":\"egress\",\"self_field\":\"admission_cid\",\"owner\":\"SourceRequestEgressAdmission\"},\"raw_response\":{\"schema\":\"raw_response\",\"self_field\":\"self_cid\",\"bytes\":\"content_cid hashes exact decoded bytes, not JSON reserialization\"}}",
  ].join(""))
  let value = @canonical_json.from_json(input, 38, 2, 1837)
  assert_eq(@canonical_json.cid_value(value, 1837, 38, 2), "sha256:93c4120b39f30053b2713c6725675bc54c0c16dceefe82898fa8ba0d41f6fa1c")
  assert_eq(@canonical_json.measure_value(value, 1837, 38, 2), 1837)
}

///|
test "contract spec/contracts/actql-lookup-identities.json#/laws" {
  let input = @json.parse([
    "{\"cid\":\"AoA computeCid of the complete closed body excluding only self_cid; validate incoming shape, ordering and references without normalization\",\"logical_value\":\"computeCid({sort:\\\"relation\\\",value:canonical_rows}); ordered rows and multiplicity are semantic; exact captured bytes are a separate artifact\",\"key_set\":\"ResourceRef cell is its identity_cid string; ArtifactRef cell is its artifact_ref_cid string; no object expansion or capability bytes; canonical role and typed tuple order after null exclusion and dedupe\",\"request\":\"request_values must validate against the resolved closed request_schema_cid with unknown keys rejected; continuation.token must validate against transport_plan.pagination.token_contract; validate before hashing without coercion or repair\",\"catalog\":\"schema slots hash the complete Catalog ContractEnvelope excluding only cid, including schema/id/version/kind/body; validate exact SourceView role, Catalog membership and ownership; body uses ActQL value contracts, not raw JSON Schema; tra",
    "nsport mapping/extraction binds semantic input/output and no generated wire schema is mandatory\",\"lists\":\"typed evidence references sort by kind then cid; CID sets lexically; scope sources by canonical JSON UTF-8 bytes; tuples by typed key order; reject duplicates and unsorted sealed bodies, never normalize incoming artifacts\",\"completeness\":\"unknown acquisition completeness cannot become complete; publish Result partial or reject a consumer requiring complete coverage; keep original unknown evidence\",\"batch_plan\":\"ordered partition of canonical key indices; every index exactly once; no runtime page tokens; repartition changes identity\",\"attempt_receipt\":\"complete cumulative attempt table ordered by batch_index,page_index,network_attempt; immutable linked snapshots; real lifecycle evidence and no downstream relation/evidence/Invocation references\",\"attempt_transition\":\"preserve slot/request/batch/page/network_attempt and known evidence; immutable prior snapshots do not prohibit authenticated dispatched/unknow",
    "n settlement; exact matching event ancestry is required; captured payload and adoption cannot change\",\"accounting\":\"receipt and accounting have exactly the same slot/attempt key set; measured decoded usage includes captured response bytes, wire usage is separately measured; usage_final requires completed measurement evidence, not an outcome name; reservation settlement validates event/capture/measurement correspondence\",\"relation\":\"same envelope for input and validated output, checked by role; schema, logical order, scope, policy, retention and upstream provenance bind identity; no final Invocation or synthetic ResultDefinition\",\"closure\":\"typed resolution, hash validation, semantic cross-binding, authority and availability are required; valid self hashes alone are not admission\",\"adoption\":\"durably activate before dispatch; adopt once from the active captured attempt after logical page validation; continuation uses only the preceding adopted response and exact token; succeeded requires terminal adopted chain",
    "s for every batch, except zero keys requires no calls\",\"success_seal\":\"Lookup Evidence pins the immutable succeeded receipt and adopted pages; subsequent late capture or accounting snapshots cannot replace that receipt, validated Relation or Invocation\",\"reservations\":\"obsolete unknown reads may coexist with success only under admitted finite retry and durable worst-case outstanding reservations; measured plus reserved usage fits every ceiling; release only against authenticated final accounting or charge the full reservation at its fixed deadline\",\"raw_response\":\"self_cid hashes the closed metadata envelope; content_cid is sha256 of exact decoded response bytes, size_bytes their length; authenticated capture binds call slot, attempt, policy and retention before page admission; not a Result Artifact\",\"external_references\":\"egress reuses SourceRequestEgressAdmission, hashing all fields except admission_cid; bind barrier,input,request egress requirements,Ref availability,authority and current Host policy before",
    " dispatch; transport adapter resolves the checked SourceView read execution contract (HTTP http_read_transport transport_cid), never SourceReadPlan; source witnesses resolve evidence_kinds.source; runtime errors resolve the pinned protocol runtime_error schema; traverse registered reference roles only, never CID-shaped business strings\"}",
  ].join(""))
  let value = @canonical_json.from_json(input, 19, 1, 4435)
  assert_eq(@canonical_json.cid_value(value, 4435, 19, 1), "sha256:c56618640aa84af330359c39433472fcafb476bef1f94323c3934ff49a8d508f")
  assert_eq(@canonical_json.measure_value(value, 4435, 19, 1), 4435)
}

