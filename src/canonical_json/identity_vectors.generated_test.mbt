    "e_expression\"},\"pattern\":{\"$ref\":\"#/$defs/machine_expression\"},\"capture\":{\"$ref\":\"#/$defs/machine_expression\"},\"flags\":{\"type\":\"string\",\"enum\":[\"\",\"m\",\"s\",\"ms\",\"sm\"]}}}}},{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"op\",\"body\"],\"properties\":{\"op\":{\"const\":\"regex_replace\"},\"body\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"value\",\"pattern\",\"replacement\"],\"properties\":{\"value\":{\"$ref\":\"#/$defs/machine_expression\"},\"pattern\":{\"$ref\":\"#/$defs/machine_expression\"},\"replacement\":{\"$ref\":\"#/$defs/machine_expression\"},\"flags\":{\"type\":\"string\",\"enum\":[\"\",\"m\",\"s\",\"ms\",\"sm\"]}}}}},{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"op\",\"body\"],\"properties\":{\"op\":{\"const\":\"empty_array\"},\"body\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"items\"],\"properties\":{\"items\":{\"$ref\":\"#/$defs/value_contract\"}}}}},{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"op\",\"body\"],\"properties\":{\"op\":{\"const\":\"typed_null\"},\"body\":{\"type\":\"object\",\"additionalProperties\":false,\"requ",
    "ired\":[\"contract\"],\"properties\":{\"contract\":{\"allOf\":[{\"$ref\":\"#/$defs/value_contract\"},{\"properties\":{\"nullable\":{\"const\":true}}}]}}}}}]},\"fragment\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"version\",\"expression_contract_cid\",\"request\",\"graph\",\"limits\",\"roots\",\"evaluations\",\"output_schema\",\"output_open\",\"fragment_cid\"],\"properties\":{\"version\":{\"const\":\"actql-expression-fragment/0.1\"},\"expression_contract_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},\"request\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"pipeline\",\"source_schemas\",\"parameters\",\"max_rows\",\"max_value_bytes\"],\"properties\":{\"pipeline\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"version\",\"sources\",\"steps\",\"output\"],\"properties\":{\"version\":{\"const\":\"aoa-pipeline/0.1\"},\"sources\":{\"type\":\"object\",\"additionalProperties\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"sort\"],\"properties\":{\"sort\":{\"const\":\"relation\"}}}},\"steps\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"additionalPropert",
    "ies\":false,\"required\":[\"id\",\"op\",\"in\",\"params\"],\"properties\":{\"id\":{\"type\":\"string\",\"minLength\":1},\"op\":{\"enum\":[\"REL.derive\",\"REL.where\",\"REL.assert_all\",\"REL.groupBy\",\"REL.window.project\"]},\"in\":{\"type\":\"array\",\"minItems\":1,\"maxItems\":1,\"items\":{\"type\":\"string\",\"minLength\":1}},\"params\":{\"type\":\"object\"}}}},\"output\":{\"type\":\"string\",\"minLength\":1}}},\"source_schemas\":{\"type\":\"object\",\"additionalProperties\":{\"type\":\"object\",\"additionalProperties\":{\"$ref\":\"#/$defs/value_contract\"}}},\"parameters\":{\"type\":\"object\",\"additionalProperties\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"contract\",\"value\"],\"properties\":{\"contract\":{\"$ref\":\"#/$defs/value_contract\"},\"value\":{}}}},\"max_rows\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":9007199254740991},\"max_value_bytes\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":9007199254740991},\"text_time_policy\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"version\",\"max_input_codepoints\",\"max_input_utf8_bytes\",\"max_pattern_bytes\",\"max_output_bytes\",\"max_replacements",
    "\"],\"properties\":{\"version\":{\"const\":\"actql-text-time-host-policy/0.1\"},\"max_input_codepoints\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":9007199254740991},\"max_input_utf8_bytes\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":9007199254740991},\"max_pattern_bytes\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":9007199254740991},\"max_output_bytes\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":9007199254740991},\"max_replacements\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":9007199254740991}}},\"null_contexts\":{\"type\":\"object\",\"additionalProperties\":{\"type\":\"object\",\"additionalProperties\":{\"$ref\":\"#/$defs/value_contract\"}}},\"open_sources\":{\"type\":\"object\",\"additionalProperties\":{\"type\":\"array\",\"uniqueItems\":true,\"items\":{\"type\":\"string\",\"minLength\":1}}}}},\"graph\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"version\",\"sources\",\"steps\",\"output\"],\"properties\":{\"version\":{\"const\":\"aoa-pipeline/0.1\"},\"sources\":{\"type\":\"object\",\"additionalProperties\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"sort\"],\"properties\":{\"sor",
    "t\":{\"const\":\"relation\"}}}},\"steps\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"id\",\"op\",\"in\",\"params\"],\"properties\":{\"id\":{\"type\":\"string\",\"minLength\":1},\"op\":{\"enum\":[\"REL.derive\",\"REL.where\",\"REL.assert_all\",\"REL.groupBy\",\"REL.window.project\"]},\"in\":{\"type\":\"array\",\"minItems\":1,\"maxItems\":1,\"items\":{\"type\":\"string\",\"minLength\":1}},\"params\":{\"type\":\"object\"}}}},\"output\":{\"type\":\"string\",\"minLength\":1}}},\"limits\":{\"type\":\"array\",\"minItems\":2,\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"request_pointer\",\"resolved_limit\"],\"properties\":{\"request_pointer\":{\"type\":\"string\",\"pattern\":\"^/\"},\"resolved_limit\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"version\",\"subject_ref\",\"unit\",\"effective_max\",\"author_guard_binding\",\"enforcement\",\"breach\",\"resolved_limit_cid\",\"candidates\"],\"properties\":{\"version\":{\"const\":\"actql-resolved-limit/0.1\"},\"subject_ref\":{\"type\":\"string\",\"minLength\":1},\"unit\":{\"enum\":[\"rows\",\"bytes\",\"array_items\"]},\"effective_max\"",
    ":{\"type\":\"integer\",\"minimum\":1},\"author_guard_binding\":{\"const\":\"absent\"},\"enforcement\":{\"const\":\"engine_atomic\"},\"breach\":{\"const\":\"fail\"},\"resolved_limit_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},\"candidates\":{\"type\":\"array\",\"minItems\":1,\"maxItems\":1,\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"version\",\"unit\",\"value\",\"role\",\"source\",\"law_id\",\"derivation\",\"dependencies\",\"witness_cid\"],\"properties\":{\"version\":{\"const\":\"actql-bound-witness/0.1\"},\"unit\":{\"enum\":[\"rows\",\"bytes\",\"array_items\"]},\"value\":{\"type\":\"integer\",\"minimum\":1},\"role\":{\"const\":\"contract_ceiling\"},\"source\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"kind\",\"contract_cid\",\"field\"],\"properties\":{\"kind\":{\"const\":\"contract\"},\"contract_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},\"field\":{\"type\":\"string\",\"minLength\":1}}},\"law_id\":{\"const\":\"actql.expression-fragment.capacity\"},\"derivation\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"op\"],\"properties\":{\"op\":{\"const\":\"sour",
    "ce\"}}},\"dependencies\":{\"type\":\"array\",\"minItems\":1,\"maxItems\":1,\"items\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"}},\"witness_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"}}}}}}}}},\"roots\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"step_id\",\"parameter_pointer\",\"source\",\"node\",\"contract\",\"demand_paths\"],\"properties\":{\"step_id\":{\"type\":\"string\",\"minLength\":1},\"parameter_pointer\":{\"type\":\"string\",\"pattern\":\"^/\"},\"source\":{\"$ref\":\"#/$defs/source_expression\"},\"node\":{\"$ref\":\"#/$defs/machine_expression\"},\"contract\":{\"$ref\":\"#/$defs/value_contract\"},\"demand_paths\":{\"type\":\"object\",\"additionalProperties\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"pointer\",\"test\"],\"properties\":{\"pointer\":{\"type\":\"string\",\"pattern\":\"^/roots/\"},\"test\":{\"enum\":[\"true\",\"not_true\",\"null\"]}}}}}}}},\"evaluations\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"node_pointer\",\"envelope\"],\"properties\":{\"node_pointe",
    "r\":{\"type\":\"string\",\"pattern\":\"^/roots/[0-9]+/node(?:/|$)\"},\"envelope\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"version\",\"semantic_step_id\",\"operation\",\"arguments_cid\",\"input\",\"max_output_bytes\",\"verification\",\"host_policy_profile_cid\",\"envelope_cid\",\"expression_pointer\",\"demand_path\"],\"properties\":{\"version\":{\"const\":\"actql-text-time-evaluation-envelope/0.1\"},\"semantic_step_id\":{\"type\":\"string\",\"minLength\":1},\"operation\":{\"enum\":[\"split_part\",\"substring\",\"utf8_truncate\",\"try_number\",\"parse_timestamp\",\"format_timestamp\",\"regex_match\",\"regex_extract\",\"regex_replace\",\"nfkc\",\"case_fold\",\"try_timestamp\"]},\"arguments_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},\"input\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"source\",\"max_codepoints\",\"max_utf8_bytes\",\"evidence_cid\"],\"properties\":{\"source\":{\"enum\":[\"value_contract\",\"literal\",\"runtime_preflight\"]},\"max_codepoints\":{\"type\":\"integer\",\"minimum\":0},\"max_utf8_bytes\":{\"type\":\"integer\",\"minimum\":0},\"evidence_cid\":{\"type\":\"str",
    "ing\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"}}},\"pattern\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"ast_cid\",\"max_pattern_bytes\"],\"properties\":{\"ast_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},\"max_pattern_bytes\":{\"type\":\"integer\",\"minimum\":0}}},\"replacement\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"ast_cid\",\"literal_utf8_bytes\",\"capture_reference_count\",\"max_capture_index\"],\"properties\":{\"ast_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},\"literal_utf8_bytes\":{\"type\":\"integer\",\"minimum\":0},\"capture_reference_count\":{\"type\":\"integer\",\"minimum\":0},\"max_capture_index\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":99}}},\"max_replacements\":{\"type\":\"integer\",\"minimum\":0},\"max_output_bytes\":{\"type\":\"integer\",\"minimum\":0},\"verification\":{\"enum\":[\"plan\",\"unit_preflight\"]},\"host_policy_profile_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},\"envelope_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},\"expression_pointer\":{\"type\":\"string\",\"pattern\":\"^/\"},\"dem",
    "and_path\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"pointer\",\"test\"],\"properties\":{\"pointer\":{\"type\":\"string\",\"pattern\":\"^/\"},\"test\":{\"enum\":[\"true\",\"not_true\",\"null\",\"not_null\"]}}}}}}}}},\"output_schema\":{\"type\":\"object\",\"additionalProperties\":{\"$ref\":\"#/$defs/value_contract\"}},\"output_open\":{\"type\":\"boolean\"},\"fragment_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"}}}}}},\"laws\":{\"version\":\"actql-expression-laws/0.1\",\"consumer_capacity_contract_cid\":\"sha256:7d59718b965451d8a19ccf7095b92777ba0cdd8c3bb71f437ab387801fe7271f\",\"consumer_admission\":\"Supplied context contracts are checked even without roots. All known input fields, types and nullability are admitted before predicate demand, including unvisited graph elements. Open contexts do not infer additional field types. Whole-collection and raw-value ceilings are unconditional; evaluated root contract and canonical byte checks are shared with Relation fragments and run once per demanded root before strict-true ",
    "consumption.\",\"program_binding\":\"actql/0.1 uses this expression contract for every general computation position. The Program semantics envelope includes expression_contract_cid. No source revision inference or compatibility mode exists. Effect selectors retain their closed selector admission.\",\"pure_profile_admission\":\"A live AoA fragment containing any text/time evaluation envelope requires actql-text-time/0.1 with this exact contract CID in required_profiles. A pure_expression descriptor authorizes no acquisition or Artifact barrier. Revalidation derives this requirement from sealed Relation and Graph/temporal consumer fragments, including nonselected branches. Host capability admission is independent of expression demand; a missing profile rejects before execution.\",\"parameter_binding\":\"General expression parameter references remain in the bound request with their declared checked contracts and copied verified values, not untyped substituted strings or arrays. Invocation and selector values retain their se",
    "parate binding rules. Bound parameters lower to typed literal roots or typed_null without looking into opaque literal data.\",\"window_aggregate_binding\":\"REL.window.project uses the same expression root positions, filters, folds and aggregate limits as REL.groupBy. Its canonical by parameter contains authored grouping fields only. Group identity, enumeration and output fields prepend window_start and window_end exactly once; these fields must have checked KeyComparable contracts. It never evaluates an argument on a row rejected by that aggregate filter.\",\"null_context_binding\":\"Optional request.null_contexts maps derive step IDs and output names to nullable checked contracts. Each target is exactly a source literal NULL, which lowers to typed_null without changing its source tree. Program checking supplies a context only from independently typed append peers, propagated through field projection/rename and row-preserving steps, or an explicitly mapped nullable ModelTask input. All contributing contracts must ha",
    "ve a common join; otherwise checking fails. No arbitrary downstream computation or Effect supplies evidence. Fragment admission validates targets and regenerates typed nodes; Program admission rederives the contextual evidence from Program and admitted contracts.\",\"composition_binding\":\"In an AoA composition, ACTQL.expression_fragment/0.1 has one Relation input and one Relation output; params contains exactly fragment, whose request has the single local source input. ACTQL.predicate_consumer/0.1 params contains exactly consumer and has the signature of consumer.request.operation. Both artifacts are recompiled and compared before composition admission. The canonical composition retains these opcodes and their full sealed material. Sort-checking projections are neither semantic graphs nor executable replacements.\",\"partial_source_evidence\":\"source_schemas records checked field types, including compiler-generated left.name/right.name join provenance. open_sources optionally maps a source to its canonical sorted ",
    "required column set. Such a source admits additional fields, but no additional type is inferred. Every expression still requires its own type proofs. Pass-through operations preserve openness and unknown columns; derive rejects collision with known or actual input fields. groupBy closes the output field set. output_open is regenerated along with output_schema. Runtime validates all known contracts and required columns and applies value ceilings to all actual fields.\",\"predicate_consumers\":\"actql-predicate-consumer/0.1 self-CID excludes only consumer_cid. The body pins capacity_law and capacity_contract_cid; the registered capacity contract governs whole-input and publication checks independently of predicates, plus demanded context value checks. The request binds operation, closed operation parameters, context schemas and ceilings. Roots are sorted by RFC6901 pointer code-unit order: match_nodes /where uses nodes; match_edges /where uses edges; traverse /hops/i/edge_where and /hops/i/node_where, or homogeneou",
    "s /edge_where and /node_where, use edges and nodes; sequence /pattern/i/where uses events. Each root is a single REL.where fragment with source input and step condition. Required columns are the sorted context schema keys; no graph property is inferred. Recompile all roots and structural operation constraints before execution. Conditions use the pinned operation traversal/matching demand, never an unconditional prepass over unreachable graph elements. The graph/event carrier and output semantics otherwise remain the pinned AoA laws.\",\"profile_binding\":\"A request containing text-time calls requires text_time_policy, the closed actql-text-time-host-policy/0.1 value. Its canonical CID is host_policy_profile_cid. The fragment evaluations array, including an empty array when no profile calls exist, enumerates every profile call exactly once in expression_pointer code-unit order. node_pointer addresses its lowered node at /roots/index/node; envelope.expression_pointer addresses the source occurrence at /roots/index",
    "/source. Envelope semantic_step_id equals the root step_id; demand_path equals the regenerated root demand at that occurrence, including aggregate filters. Admission reconstructs envelopes, bounds, argument identities and both pointers. Literal and checked source extents prove bounds; otherwise expression-local input preflight enforces the selected Host ceiling on demanded evaluations only. Actual successful scalar results satisfy the output ceiling. No callback or provider access is introduced.\",\"aggregate_binding\":\"REL.groupBy admits count, count_if, sum, avg, min, max, array_agg, string_agg, first, last, percentile_disc, percentile_cont, var_pop, var_samp, stddev_pop and stddev_samp. Authored calls have exactly one field or expr, except row-count count may omit both. Each filter is a separate root and gates demand for that call only. distinct true is admitted only for count with an argument, sum, avg, array_agg and string_agg; explicit false is additionally admitted for row-count count, min and max. Other ",
    "functions reject the distinct member. Ordered functions use independent total orders, supplied by the analytic frame only in that context. avg requires number; decimal sum uses precision 38 and retains scale. array_agg excludes null and rejects recursively nonconstructible item contracts. Selected first/last values may retain reference and structured contracts. Percentile and statistical laws remain their own deterministic folds; binary64 sum/avg use numeric observation slots. Empty aggregate maps and repeated grouping references are retained; output keys occur once in first-occurrence order, and the empty global group emits one empty row even for empty input. Acceptance never authorizes operation deletion or preimage deduplication.\",\"normalization\":\"Decode without value evaluation. Normalize to_* to cast. Retain typed NULL, identity casts, nesting and array order. Literal payloads are opaque. Predicate is boolean Expression, not a separate value domain.\",\"normalization_fixed_point\":\"Text and structured input",
    "s share alias normalization and closed validation. Whole-field left.id/right.id, including quoted single tokens, normalize to join_field; quoted left/right followed by property access remain ordinary fields. N(N(x))=N(x) and N(print(N(x)))=N(x). Function lookup uses only registered own names. Source intake limits count bytes, tokens, nodes and actual AST depth, including postfix chains; failure is diagnostic, not truncation.\",\"local_type_evidence\":\"Literal NULL accepts the unique domain of its immediate fixed signature, explicit cast or independently typed peer. Overloads without a unique domain do not supply evidence. Independently typed arrays supply item evidence even when max_items is zero; only untyped NULL and untyped [] are excluded. No arbitrary downstream inference.\",\"canonical_omissions\":\"Canonical array nodes are nonempty. Canonical case nodes require else. Empty arrays use checked item contracts and typed_null requires a nullable checked contract. Coalesce remains its dedicated node, never a canon",
    "ical CASE macro.\",\"demand_derivation\":\"Inherit outer demand. if condition adds none; then adds condition true; else adds condition not_true. CASE condition i adds earlier conditions not_true; branch i additionally adds its condition true; else adds all conditions not_true. Coalesce operand i adds preceding operands null. Aggregate argument adds its own filter true; filter itself adds none. Eager children add none. Admission rederives exact paths from tree and consumer context; tests reuse already evaluated values in the same frame.\",\"representative_failure\":\"Within an expression use prescribed evaluation order. Derive chooses by logical input row order, canonical output field name order, then child evaluation order, never physical completion order. Operation output is atomic, not the entire Run or Effect Set.\",\"evaluation\":\"All branches receive syntax/name/arity/type/profile/static-signature checks. Positional operands are evaluated once in canonical array order; object/derive children in canonical field-name",
    " order. AND/OR are eager. if/case demand selected branches; coalesce stops at the first non-null. try_* catches only its own conversion-domain failure, never argument evaluation failure.\",\"boolean\":\"Three values: true,false,null. Conditions select only true; assert_rows requires true. IS TRUE/FALSE/UNKNOWN always returns non-null boolean. DISTINCT FROM uses KeyComparable equality with both-null equal. nullif eagerly evaluates both operands once and returns null only when equality is true.\",\"casts\":\"Closed target table in Language#casts. No implicit conversions. Conversion data is evaluated only on demand. Typed NULL supplies a type; same-type casts preserve their nodes. Decimal conversion from number requires a safe integer; no binary64 fractional approximation.\",\"access\":\"Static closed-object property names; unknown property is a check error, missing declared property an input-contract violation. Subscript evaluates receiver then index; index must be a non-null nonnegative safe-integer number even for null r",
    "eceiver. Valid out-of-range yields null. Reference/json inspection is forbidden.\",\"concat\":\"concat skips null strings, all-null yields empty string. concat_strict and template propagate null. No implicit non-string conversion.\",\"substring\":\"Unicode scalar positions j: 1<=j<=len(s) and start<=j<start+length, with exact interval arithmetic. start is a safe integer; length a nonnegative safe integer. Null propagates.\",\"split_part\":\"Preserve empty parts; one-based positive index and negative index from end; zero invalid. Empty delimiter is one whole-string part, including empty input. Out of range is empty string. Null propagates.\",\"lowering\":\"Each normalized expression lowers recursively to a closed actql-expression-node/0.1: op is its canonical tag, body is its normalized payload with expression children lowered. Structural fields and non-null literals are copied. Bound non-null parameters become literal nodes. Every typed NULL, including a null parameter and missing CASE ELSE, becomes typed_null with its nulla",
    "ble checked contract. Explicit casts remain cast nodes around the typed child. Template expands to ordered literal/cast-to-string children under concat_strict, or an empty-string literal for no segments. Empty array becomes empty_array with canonical checked item type. Profile envelopes are sorted by expression pointer. No unselected-expression hoisting or Host callbacks.\",\"envelopes\":\"actql-text-time-bound-laws/0.1 retains pinned Unicode/regex/time bound laws. split_part output ceiling equals input bytes. substring tightens input bytes to min(input bytes,4*length) only for a bound nonnegative safe-integer literal length; utf8_truncate similarly uses min(input bytes,max_bytes) for an admitted literal, otherwise input bytes. Bound arithmetic is exact. Parent expressions consume child checked extents. Envelope self-CID excludes only envelope_cid; arguments_cid binds canonical argument subtrees. Demand predicates are outer-to-inner, with earlier branch not_true, selected branch true and coalesce null tests; aggr",
    "egate arguments begin with their own filter true. No re-evaluation of demand values; no enforcement on undemanded rows; input admission and whole-unit scopes remain enforced.\",\"optimization\":\"Physical optimization preserves canonical identity, demand, first-failure order and logical limits. Failed constant evaluation is not a compilation failure. Physical allocation/CPU usage need not match a reference evaluator.\",\"authority\":\"Effect selectors keep their restricted operand/tree admission. Pure profile evaluation grants no provider access. New node contracts require explicit capability admission; old Plan/contract CIDs retain their prior meaning.\",\"fragment_capacity\":\"actql.expression-fragment.capacity is an extension-local contract-ceiling law. Its source is the canonical bound request CID and exact request pointer; dependencies contain only that CID. Resolved limits retain the existing witness/limit wire shape, engine_atomic enforcement and breach fail. This contract registers the law only for fragment reval",
    "idation, not in the shared bound-law registry. Limits are sorted by request pointer and regenerated, including all aggregate max_items guards.\",\"fragment_binding\":\"actql-expression-fragment/0.1 self-CID excludes only fragment_cid. expression_contract_cid pins this contract. request binds source schemas, canonical source pipeline, typed parameter values and ceilings. graph has inline expression nodes at REL.derive /exprs/name, REL.where and REL.assert_all /expr, REL.groupBy /aggs/name/expr and optional /aggs/name/filter. Pointers are relative to params and RFC6901 escaped. Roots are ordered by graph step order then pointer code-unit order; each root stores source, node, checked contract and demand paths rooted at /roots/index/source. Aggregate arguments prepend their own filter-root true test. Admission recompiles request and requires exact equality of graph, root list, types and demand. Schema/self-CID alone is insufficient. Other consumers require a separately admitted binding contract; this revision does no",
    "t grant them an implicit root position.\"}}",
  ].join(""))
  let value = @canonical_json.from_json(input, 22561, 18, 295978)
  assert_eq(@canonical_json.cid_value(value, 295978, 22561, 18), "sha256:2587ba927c08a797960ef083be3cf32cef56ce478c88df2cb12bcb306ba865e1")
  assert_eq(@canonical_json.measure_value(value, 295978, 22561, 18), 295978)
}

///|
