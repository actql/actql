    "$\"},\"run_graph_contract_manifest_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"conformance_claim_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"version_policy_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"protocol_schema_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"diagnostic_semantic_profile_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"diagnostic_catalog_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"artifact_schema_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"module_contract_cids\":{\"type\":\"object\",\"additionalProperties\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}},\"connector_spi_version\":{\"type\":\"string\",\"minLength\":1},\"inference_profile_version\":{\"const\":\"actql-infer/0.1\"},\"model_task_contract_cids\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"uniqueItems\":true},\"connectors\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"connector_id\",\"connector_ve",
    "rsion\",\"catalog_cid\",\"source_view_contract_cids\",\"command_contract_cids\",\"transitive_contract_cids\"],\"properties\":{\"connector_id\":{\"type\":\"string\",\"minLength\":1},\"connector_version\":{\"type\":\"string\",\"minLength\":1},\"catalog_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"source_view_contract_cids\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"uniqueItems\":true},\"command_contract_cids\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"uniqueItems\":true},\"transitive_contract_cids\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"uniqueItems\":true}}}},\"lock_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}}}",
  ].join(""))
  let value = @canonical_json.from_json(input, 124, 7, 2762)
  assert_eq(@canonical_json.cid_value(value, 2762, 124, 7), "sha256:02e3693c855d6137ac1fee89705a2a11824cf6607ea593b3ee7786263f49bdd4")
