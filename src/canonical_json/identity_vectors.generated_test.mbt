    "nulls\":{\"enum\":[\"first\",\"last\"]}}}}}},\"consistency_level\":{\"enum\":[\"immutable_fixture\",\"snapshot\",\"read_committed\",\"eventual\"]},\"source_evidence_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}}}",
