test "contract spec/contracts/actql-protocol-schemas.json#/artifact_schemas/approval_attestation" {
  let input = @json.parse([
    "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"$id\":\"https://smooth.dev/schemas/actql-approval-attestation-0.1.json\",\"title\":\"actql-approval-attestation-0.1\",\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"version\",\"effect_preview_cid\",\"review_projection_cid\",\"approver\",\"approved_at\",\"authority_scope_cid\",\"claims\",\"proof\",\"attestation_cid\"],\"properties\":{\"version\":{\"const\":\"actql-approval-attestation/0.1\"},\"effect_preview_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"review_projection_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"approver\":{\"type\":\"string\"},\"approved_at\":{\"type\":\"string\"},\"authority_scope_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"claims\":{\"type\":\"array\",\"minItems\":1,\"uniqueItems\":true,\"items\":{\"enum\":[\"effect_scope_approved\",\"partial_application_accepted\"]}},\"proof\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"scheme\",\"key_id\",\"signature\"],\"properties\":{\"scheme\":{\"const\":\"ed25519-v1\"},\"key_id\":{\"type\":\"string\",\"minLen",
    "gth\":1},\"signature\":{\"type\":\"string\",\"pattern\":\"^[A-Za-z0-9+/]+={0,2}$\"}}},\"attestation_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}}}",
  ].join(""))
  let value = @canonical_json.from_json(input, 59, 5, 1170)
  assert_eq(@canonical_json.cid_value(value, 1170, 59, 5), "sha256:482ee09bcbed57fd19edd49e01d81882a3bbeb398ea9176c09e1717883a21ba9")
  assert_eq(@canonical_json.measure_value(value, 1170, 59, 5), 1170)
}

