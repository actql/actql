    "{\"type\":\"object\",\"properties\":{\"version\":{\"const\":\"actql-lookup-attempt-event/0.1\"},\"barrier_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"batch_plan_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"call_slot_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"network_attempt\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":9007199254740991},\"previous_event_cid\":{\"anyOf\":[{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},{\"type\":\"null\"}]},\"recorded_at\":{\"type\":\"string\",\"pattern\":\"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\\\.[0-9]{3}Z$\"},\"outcome\":{\"enum\":[\"dispatched\",\"captured\",\"failed\",\"unknown\",\"unattempted\"]},\"raw_response_artifact_cid\":{\"anyOf\":[{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},{\"type\":\"null\"}]},\"runtime_error_cid\":{\"anyOf\":[{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},{\"type\":\"null\"}]},\"failure_code\":{\"anyOf\":[{\"type\":\"string\",\"minLength\":1},{\"type\":\"null\"}]},\"issuer_id\":{\"type\":\"string\",\"minLength\":1},\"authority_scope_cid\":{\"type\":\"string\",\"pat",
    "tern\":\"^sha256:[0-9a-f]{64}$\"},\"self_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}},\"required\":[\"version\",\"barrier_cid\",\"batch_plan_cid\",\"call_slot_cid\",\"network_attempt\",\"previous_event_cid\",\"recorded_at\",\"outcome\",\"raw_response_artifact_cid\",\"runtime_error_cid\",\"failure_code\",\"issuer_id\",\"authority_scope_cid\",\"self_cid\"],\"additionalProperties\":false,\"allOf\":[{\"if\":{\"properties\":{\"outcome\":{\"const\":\"captured\"}},\"required\":[\"outcome\"]},\"then\":{\"properties\":{\"raw_response_artifact_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"runtime_error_cid\":{\"type\":\"null\"},\"failure_code\":{\"type\":\"null\"}}}},{\"if\":{\"properties\":{\"outcome\":{\"enum\":[\"dispatched\",\"unknown\",\"unattempted\"]}},\"required\":[\"outcome\"]},\"then\":{\"properties\":{\"raw_response_artifact_cid\":{\"type\":\"null\"},\"runtime_error_cid\":{\"type\":\"null\"},\"failure_code\":{\"type\":\"null\"}}}},{\"if\":{\"properties\":{\"outcome\":{\"const\":\"failed\"}},\"required\":[\"outcome\"]},\"then\":{\"properties\":{\"failure_code\":{\"type\":\"string\",\"minLength\":1}}}}]}",
  ].join(""))
  let value = @canonical_json.from_json(input, 128, 7, 2035)
  assert_eq(@canonical_json.cid_value(value, 2035, 128, 7), "sha256:c9b5a6332e1bf918718bd4d5b58a34bcd7f420d4e55693f8f48ba28cb9067310")
  assert_eq(@canonical_json.measure_value(value, 2035, 128, 7), 2035)
}

