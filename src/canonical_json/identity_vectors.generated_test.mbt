test "lookup schema key_set" {
  let input = @json.parse([
    "{\"type\":\"object\",\"properties\":{\"version\":{\"const\":\"actql-lookup-key-set/0.1\"},\"source_view_contract_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"request_schema_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"key_roles\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"request_role\":{\"type\":\"string\",\"minLength\":1},\"value_contract\":{\"$ref\":\"#/$defs/value_contract\"}},\"required\":[\"request_role\",\"value_contract\"],\"additionalProperties\":false},\"minItems\":1,\"uniqueItems\":true},\"tuples\":{\"type\":\"array\",\"items\":{\"type\":\"array\",\"items\":{},\"minItems\":0},\"minItems\":0,\"uniqueItems\":true},\"self_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}},\"required\":[\"version\",\"source_view_contract_cid\",\"request_schema_cid\",\"key_roles\",\"tuples\",\"self_cid\"],\"additionalProperties\":false,\"$defs\":{\"value_contract\":{\"oneOf\":[{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"type\",\"nullable\",\"precision\",\"scale\"],\"properties\":{\"type\":{\"const\":\"decimal\"},\"nullable\":{\"type\":\"boolean\"},\"precision\":{",
    "\"type\":\"integer\",\"minimum\":1,\"maximum\":38},\"scale\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":38}},\"allOf\":[{\"if\":{\"properties\":{\"precision\":{\"const\":1}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":1}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":2}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":2}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":3}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":3}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":4}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":4}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":5}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":5}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":6}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":6}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":7}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":7}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":8}},\"required\":[\"precision\"]},\"then\":{\"prope",
    "rties\":{\"scale\":{\"maximum\":8}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":9}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":9}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":10}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":10}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":11}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":11}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":12}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":12}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":13}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":13}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":14}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":14}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":15}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":15}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":16}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":16}}}},{\"if\":{\"properties\":{\"pre",
    "cision\":{\"const\":17}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":17}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":18}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":18}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":19}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":19}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":20}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":20}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":21}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":21}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":22}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":22}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":23}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":23}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":24}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":24}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":25}},\"required\":[\"precision\"]},\"then\":{",
    "\"properties\":{\"scale\":{\"maximum\":25}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":26}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":26}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":27}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":27}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":28}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":28}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":29}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":29}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":30}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":30}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":31}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":31}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":32}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":32}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":33}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":33}}}},{\"if\":{\"properti",
    "es\":{\"precision\":{\"const\":34}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":34}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":35}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":35}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":36}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":36}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":37}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":37}}}},{\"if\":{\"properties\":{\"precision\":{\"const\":38}},\"required\":[\"precision\"]},\"then\":{\"properties\":{\"scale\":{\"maximum\":38}}}}]},{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"type\",\"nullable\"],\"properties\":{\"type\":{\"const\":\"string\"},\"nullable\":{\"type\":\"boolean\"},\"min_length\":{\"type\":\"integer\",\"minimum\":0},\"max_codepoints\":{\"type\":\"integer\",\"minimum\":0},\"max_utf8_bytes\":{\"type\":\"integer\",\"minimum\":0}}},{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"type\",\"nullable\"],\"properties\":{\"type\":{\"enum\":[\"number\",\"boolean\",\"timestamp\",\"date\"",
    ",\"json\"]},\"nullable\":{\"type\":\"boolean\"}}},{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"type\",\"nullable\",\"items\"],\"properties\":{\"type\":{\"const\":\"array\"},\"nullable\":{\"type\":\"boolean\"},\"items\":{\"$ref\":\"#/$defs/value_contract\"},\"max_items\":{\"type\":\"integer\",\"minimum\":0}}},{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"type\",\"nullable\",\"additional_properties\",\"fields\"],\"properties\":{\"type\":{\"const\":\"object\"},\"nullable\":{\"type\":\"boolean\"},\"additional_properties\":{\"const\":false},\"fields\":{\"type\":\"object\",\"propertyNames\":{\"pattern\":\"^(?!__cid$)(?!__actql_)(?![\\\\s\\\\S]*\\\\.)(?=[\\\\s\\\\S]*\\\\S)[\\\\s\\\\S]+$\"},\"additionalProperties\":{\"$ref\":\"#/$defs/value_contract\"}}}},{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"type\",\"nullable\",\"dimensions\",\"element_type\"],\"properties\":{\"type\":{\"const\":\"vector\"},\"nullable\":{\"type\":\"boolean\"},\"dimensions\":{\"type\":\"integer\",\"minimum\":1},\"element_type\":{\"const\":\"f32\"}}},{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"type\",\"nullable\",\"resource_k",
    "ind\"],\"properties\":{\"type\":{\"const\":\"resource_ref\"},\"nullable\":{\"type\":\"boolean\"},\"resource_kind\":{\"type\":\"string\",\"minLength\":1}}},{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"type\",\"nullable\"],\"properties\":{\"type\":{\"const\":\"artifact_ref\"},\"nullable\":{\"type\":\"boolean\"},\"media_type\":{\"type\":\"string\",\"minLength\":1}}}]}}}",
  ].join(""))
  let value = @canonical_json.from_json(input, 610, 10, 7503)
  assert_eq(@canonical_json.cid_value(value, 7503, 610, 10), "sha256:d7007ff64a153a1f9365ea1dc2c7191738017ea4bdc58ba87a736d6d41fcde35")
  assert_eq(@canonical_json.measure_value(value, 7503, 610, 10), 7503)
}

