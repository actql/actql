    "k_read_view_and_immutable_retention_not_wire_alone\",\"shape\":\"exactly_one_validation_scan_receipt_then_one_native_result_receipt_no_extra_row_receipts\",\"validation\":\"pinned_host_value_admission_of_all_known_fields_and_all_selected_scan_rows_before_native_filter_select\",\"native\":\"checked_query_equivalent_ordered_output_not_sql_success_or_coercion_alone\",\"binding\":\"both_receipts_all_three_records_and_observation_same_requirement_task_attempt_owned_consistent_read_view_and_applicable_snapshot\",\"identity\":\"receipt_role_is_in_preimage_native_rows_equal_output_rows_without_merging_roles\",\"accounting\":\"each_distinct_transfer_once_sum_received_rows_and_canonical_typed_wire_bytes_retention_copies_and_engine_work_separate\",\"lifetime\":\"issue_all_only_after_successful_validation_query_budgets_and_retention_failure_or_cancellation_is_terminal_no_durable_capture\",\"source_order\":\"null_only_preserve_input_relative_order_without_total_order_evidence\",\"compatibility\":\"separate_observation_version_single_receipt_and_requirement_",
    "contracts_unchanged_no_admission_by_old_verifier\"}}",
  ].join(""))
  let value = @canonical_json.from_json(input, 331, 9, 7219)
