}

///|
test "lookup schema relation" {
  let input = @json.parse([
    "{\"type\":\"object\",\"properties\":{\"version\":{\"const\":\"actql-acquisition-relation/0.1\"},\"producer_contract_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"relation_schema_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"logical_value_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"ordering_evidence_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"actual_row_count\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991},\"observation_scope_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"actual_completeness\":{\"enum\":[\"complete\",\"partial\",\"unknown\"]},\"effective_data_policy_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"effective_retention_policy_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"provenance_evidence\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"kind\":{\"enum\":[\"source\",\"derivation\",\"relation\",\"attempt_receipt\"]},\"cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}},\"required\":[\"kind\",\"cid\"],\"additionalProperties\":false}",
    ",\"minItems\":0,\"uniqueItems\":true},\"self_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}},\"required\":[\"version\",\"producer_contract_cid\",\"relation_schema_cid\",\"logical_value_cid\",\"ordering_evidence_cid\",\"actual_row_count\",\"observation_scope_cid\",\"actual_completeness\",\"effective_data_policy_cid\",\"effective_retention_policy_cid\",\"provenance_evidence\",\"self_cid\"],\"additionalProperties\":false}",
  ].join(""))
  let value = @canonical_json.from_json(input, 72, 7, 1423)
  assert_eq(@canonical_json.cid_value(value, 1423, 72, 7), "sha256:b00bc1456e19c3809adaf69774b2af1a1ee1ca6a98fd02fcb2f8cc9cb7344cc0")
  assert_eq(@canonical_json.measure_value(value, 1423, 72, 7), 1423)
}

