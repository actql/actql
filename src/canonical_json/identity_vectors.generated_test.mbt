    "sequence_output\":{\"field\":\"max_output_rows\",\"unit\":\"rows\",\"law_id\":\"actql.guard.sequence-output\"},\"components\":{\"field\":\"max_output_rows\",\"unit\":\"rows\",\"law_id\":\"actql.guard.components-output\"},\"traverse\":{\"field\":\"max_output_rows\",\"unit\":\"rows\",\"law_id\":\"actql.guard.traverse-output\"},\"shortest_path\":{\"field\":\"max_output_rows\",\"unit\":\"rows\",\"law_id\":\"actql.guard.shortest-output\"}}}",
