test "contract spec/contracts/actql-production-profile-schemas.json#/schemas/lookup_evidence" {
  let input = @json.parse([
    "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"$id\":\"https://smooth.dev/schemas/actql-lookup-evidence-0.1.json\",\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"version\",\"barrier_cid\",\"input_relation_artifact_cid\",\"input_artifact_ref_cids\",\"request_input_data_policy_cids\",\"effective_request_data_policy_cid\",\"effective_output_data_policy_cid\",\"request_key_set_cid\",\"excluded_null_key_row_count\",\"batch_plan_cid\",\"source_view_contract_cid\",\"source_request_egress_admission_cid\",\"attempts\",\"validated_lookup_relation_cid\",\"upstream_candidate_extent\",\"lookup_for_requested_keys\",\"attempt_receipt_cid\",\"observed_at\",\"evidence_cid\"],\"properties\":{\"version\":{\"const\":\"actql-lookup-evidence/0.1\"},\"barrier_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},\"input_relation_artifact_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},\"input_artifact_ref_cids\":{\"type\":\"array\",\"uniqueItems\":true,\"items\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"}},\"request_input_data_policy_cids\":{\"type\":\"",
    "array\",\"uniqueItems\":true,\"items\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"}},\"effective_request_data_policy_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},\"effective_output_data_policy_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},\"request_key_set_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},\"excluded_null_key_row_count\":{\"type\":\"integer\",\"minimum\":0},\"batch_plan_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},\"source_view_contract_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},\"source_request_egress_admission_cid\":{\"oneOf\":[{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},{\"type\":\"null\"}]},\"attempts\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"call_slot_cid\",\"semantic_request_cid\",\"batch_index\",\"page_index\",\"network_attempt\",\"outcome\"],\"properties\":{\"call_slot_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},\"semantic_request_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},\"batch_index\":{\"",
    "type\":\"integer\",\"minimum\":0},\"page_index\":{\"type\":\"integer\",\"minimum\":0},\"network_attempt\":{\"type\":\"integer\",\"minimum\":1},\"provider_request_id\":{\"type\":\"string\",\"minLength\":1},\"outcome\":{\"enum\":[\"planned\",\"dispatched\",\"captured\",\"failed\",\"unknown\",\"unattempted\"]},\"raw_response_artifact_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},\"runtime_error_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"}}}},\"validated_lookup_relation_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},\"upstream_candidate_extent\":{\"enum\":[\"complete\",\"incomplete\",\"unknown\"]},\"lookup_for_requested_keys\":{\"enum\":[\"complete\",\"incomplete\",\"unknown\"]},\"attempt_receipt_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},\"observed_at\":{\"type\":\"string\",\"format\":\"date-time\"},\"evidence_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"}}}",
  ].join(""))
  let value = @canonical_json.from_json(input, 138, 7, 2892)
  assert_eq(@canonical_json.cid_value(value, 2892, 138, 7), "sha256:9aca3664e28a690ef22c34a577e2089631b01a45a3b80df92ebae276db47b596")
  assert_eq(@canonical_json.measure_value(value, 2892, 138, 7), 2892)
}

