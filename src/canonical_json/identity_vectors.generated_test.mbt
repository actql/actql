///|
test "contract spec/contracts/actql-protocol-schemas.json#/artifact_schemas/normalization_journal" {
  let input = @json.parse([
    "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"$id\":\"https://smooth.dev/schemas/actql-normalization-journal-0.1.json\",\"title\":\"actql-normalization-journal-0.1\",\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"version\",\"rule_catalog_cid\",\"entries\",\"journal_cid\"],\"properties\":{\"version\":{\"const\":\"actql-normalization-journal/0.1\"},\"rule_catalog_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"entries\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"path\",\"rule\",\"authored\",\"canonical\"],\"properties\":{\"path\":{\"type\":\"string\",\"pattern\":\"^\\\\$\"},\"rule\":{\"type\":\"string\",\"minLength\":1},\"authored\":{\"type\":\"string\"},\"canonical\":{\"type\":\"string\"}}}},\"journal_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}}}",
  ].join(""))
  let value = @canonical_json.from_json(input, 41, 6, 776)
  assert_eq(@canonical_json.cid_value(value, 776, 41, 6), "sha256:485ccc0d3215dfc0d9f13101dbc7bc0d4a72b8eb28a346ab8122cafd635ae6f0")
  assert_eq(@canonical_json.measure_value(value, 776, 41, 6), 776)
}

