test "contract spec/contracts/actql-stage-contracts.json#/laws/identity" {
  let input = @json.parse([
    "{\"definition\":\"typed stable Program/node namespace and complete local body, used declarations, import interfaces, incoming gates; no parent revision or position\",\"observation\":\"local Invocation binds local definition, effective values, contract closure and exact required observations/issuer/policy/provenance\",\"recovery\":\"logical request/item locator before exact Preview dispatch key; physical Run identity excluded transitively\",\"self_cid\":\"canonical AoA JSON without self_cid; referenced evidence must resolve with kind, scope and semantic validation\",\"authentication\":\"detached authentication signs payload CID excluding self_cid and authentication_evidence_cid; verify pinned issuer and algorithm\",\"success\":\"graph_success precedes output index and final graph receipt; it cannot reference either future artifact\",\"membership\":\"global Program/lock/revision/Run links are separately authenticated; no transitive ancestry into local Preview/review/locator/dispatch\",\"keys\":\"target and item reuse existing typed values; n",
    "ew runtime keys are stable locator and exact dispatch; fingerprint detects changed intent\"}",
  ].join(""))
  let value = @canonical_json.from_json(input, 9, 1, 1115)
  assert_eq(@canonical_json.cid_value(value, 1115, 9, 1), "sha256:090d1c81f41bc0cbda07b62ade75d2fbd450d0a333fcf6a23d1c2483b43e213f")
  assert_eq(@canonical_json.measure_value(value, 1115, 9, 1), 1115)
}

