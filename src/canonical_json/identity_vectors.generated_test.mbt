test "contract spec/contracts/actql-protocol-schemas.json#/artifact_schemas/effect_reconciliation_receipt" {
  let input = @json.parse([
    "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"$id\":\"https://smooth.dev/schemas/actql-effect-reconciliation-receipt-0.1.json\",\"title\":\"actql-effect-reconciliation-receipt-0.1\",\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"version\",\"effect_id\",\"effect_set_receipt_cid\",\"prior_receipt_cid\",\"attempt_sequence\",\"terminal\",\"outcome\",\"reconciliation_receipt_cid\",\"run_identity_cid\",\"effect_preview_cid\",\"effect_member_preview_cid\",\"row_preview_cid\",\"dispatch_entry_cid\",\"dispatch_attempt_sequence\",\"prior_ledger_head_cid\"],\"properties\":{\"version\":{\"const\":\"actql-effect-reconciliation-receipt/0.1\"},\"effect_id\":{\"type\":\"string\",\"minLength\":1},\"effect_set_receipt_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"prior_receipt_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"attempt_sequence\":{\"type\":\"integer\",\"minimum\":1},\"terminal\":{\"type\":\"boolean\"},\"previous_reconciliation_receipt_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"operation_ref\":{\"type\":\"object\",\"additional",
    "Properties\":false,\"required\":[\"$actql_ref\",\"version\",\"resource_kind\",\"provider_namespace\",\"provider_identity_cid\",\"authority_scope_cid\",\"boundary_cid\",\"identity_cid\"],\"properties\":{\"$actql_ref\":{\"const\":\"resource\"},\"version\":{\"const\":\"actql-resource-ref/0.1\"},\"resource_kind\":{\"type\":\"string\",\"minLength\":1},\"provider_namespace\":{\"type\":\"string\",\"minLength\":1},\"provider_identity_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"authority_scope_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"boundary_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"identity_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}}},\"command_id\":{\"type\":\"string\",\"minLength\":1},\"idempotency_key\":{\"type\":\"string\",\"minLength\":1},\"outcome\":{\"oneOf\":[{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"state\",\"result\"],\"properties\":{\"state\":{\"const\":\"applied\"},\"result\":{}}},{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"state\",\"operation_ref\",\"poll_contract\",\"cancel_capability\",\"result_sche",
    "ma\",\"reconciliation_contract\"],\"properties\":{\"state\":{\"const\":\"accepted\"},\"operation_ref\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"$actql_ref\",\"version\",\"resource_kind\",\"provider_namespace\",\"provider_identity_cid\",\"authority_scope_cid\",\"boundary_cid\",\"identity_cid\"],\"properties\":{\"$actql_ref\":{\"const\":\"resource\"},\"version\":{\"const\":\"actql-resource-ref/0.1\"},\"resource_kind\":{\"type\":\"string\",\"minLength\":1},\"provider_namespace\":{\"type\":\"string\",\"minLength\":1},\"provider_identity_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"authority_scope_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"boundary_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"identity_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}}},\"poll_contract\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"id\",\"version\",\"cid\"],\"properties\":{\"id\":{\"type\":\"string\",\"minLength\":1},\"version\":{\"type\":\"string\",\"minLength\":1},\"cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}}},\"cancel_ca",
    "pability\":{\"enum\":[\"supported\",\"unsupported\"]},\"result_schema\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"id\",\"version\",\"cid\"],\"properties\":{\"id\":{\"type\":\"string\",\"minLength\":1},\"version\":{\"type\":\"string\",\"minLength\":1},\"cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}}},\"expiration\":{\"type\":\"string\",\"minLength\":1},\"reconciliation_contract\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"id\",\"version\",\"cid\"],\"properties\":{\"id\":{\"type\":\"string\",\"minLength\":1},\"version\":{\"type\":\"string\",\"minLength\":1},\"cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}}}}},{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"state\",\"error\"],\"properties\":{\"state\":{\"const\":\"failed\"},\"error\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"code\",\"message\"],\"properties\":{\"code\":{\"type\":\"string\",\"minLength\":1},\"message\":{\"type\":\"string\",\"minLength\":1},\"details\":{}}}}},{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"state\",\"command_id\",\"reconciliation_contract\",\"idem",
    "potency_key\",\"reason\"],\"properties\":{\"state\":{\"const\":\"unknown\"},\"command_id\":{\"type\":\"string\",\"minLength\":1},\"reconciliation_contract\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"id\",\"version\",\"cid\"],\"properties\":{\"id\":{\"type\":\"string\",\"minLength\":1},\"version\":{\"type\":\"string\",\"minLength\":1},\"cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}}},\"idempotency_key\":{\"type\":\"string\",\"minLength\":1},\"reason\":{\"enum\":[\"transport_timeout\",\"connection_lost\",\"provider_outcome_unknown\"]}}}]},\"reconciliation_receipt_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"run_identity_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"effect_preview_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"effect_member_preview_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"row_preview_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"dispatch_entry_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"prior_ledger_head_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]",
    "{64}$\"},\"outcome_receipt_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"dispatch_attempt_sequence\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":9007199254740991}},\"oneOf\":[{\"required\":[\"operation_ref\"],\"not\":{\"anyOf\":[{\"required\":[\"command_id\"]},{\"required\":[\"idempotency_key\"]}]}},{\"required\":[\"command_id\",\"idempotency_key\"],\"not\":{\"required\":[\"operation_ref\"]}}],\"allOf\":[{\"if\":{\"properties\":{\"attempt_sequence\":{\"const\":1}},\"required\":[\"attempt_sequence\"]},\"then\":{\"not\":{\"required\":[\"previous_reconciliation_receipt_cid\"]}},\"else\":{\"required\":[\"previous_reconciliation_receipt_cid\"]}},{\"if\":{\"properties\":{\"outcome\":{\"properties\":{\"state\":{\"const\":\"unknown\"}},\"required\":[\"state\"]}},\"required\":[\"outcome\"]},\"then\":{\"properties\":{\"terminal\":{\"const\":false}},\"not\":{\"required\":[\"outcome_receipt_cid\"]}},\"else\":{\"properties\":{\"terminal\":{\"const\":true}},\"required\":[\"outcome_receipt_cid\"]}}]}",
  ].join(""))
  let value = @canonical_json.from_json(input, 350, 9, 6019)
  assert_eq(@canonical_json.cid_value(value, 6019, 350, 9), "sha256:abcfcc932af4c63ae91e9670d0cd41d2cd23a0e3bec25044cfa018cd2b5f3fb2")
  assert_eq(@canonical_json.measure_value(value, 6019, 350, 9), 6019)
}

