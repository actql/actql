  ].join(""))
  let value = @canonical_json.from_json(input, 1139, 14, 23738)
  assert_eq(@canonical_json.cid_value(value, 23738, 1139, 14), "sha256:d10eba96fc9983ffe709fee16faab30c9912af109d4310acad64fc675360b0c7")
  assert_eq(@canonical_json.measure_value(value, 23738, 1139, 14), 23738)
}

