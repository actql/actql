test "contract spec/contracts/actql-protocol-schemas.json#/artifact_schemas/run_scope_approval" {
  let input = @json.parse([
    "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"$id\":\"https://smooth.dev/schemas/actql-run-scope-approval-0.1.json\",\"title\":\"actql-run-scope-approval-0.1\",\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"version\",\"prepared_invocation_cid\",\"review_projection_cid\",\"claim\",\"approver\",\"approved_at\",\"expires_at\",\"proof\",\"run_scope_approval_cid\"],\"properties\":{\"version\":{\"const\":\"actql-run-scope-approval/0.1\"},\"prepared_invocation_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"review_projection_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"claim\":{\"const\":\"invocation_scope_approved\"},\"approver\":{\"type\":\"string\",\"minLength\":1},\"approved_at\":{\"type\":\"string\",\"format\":\"date-time\"},\"expires_at\":{\"type\":\"string\",\"format\":\"date-time\"},\"proof\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"scheme\",\"key_id\",\"signature\"],\"properties\":{\"scheme\":{\"const\":\"ed25519-v1\"},\"key_id\":{\"type\":\"string\",\"minLength\":1},\"signature\":{\"type\":\"string\",\"pattern\":\"^[A-Za-z0-9+/]+={0,2}$\"}",
    "}},\"run_scope_approval_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}}}",
  ].join(""))
  let value = @canonical_json.from_json(input, 55, 5, 1105)
  assert_eq(@canonical_json.cid_value(value, 1105, 55, 5), "sha256:ab7aa04f5afe9b7479ab2bc1ad078b2df41bde6248fd6eae1d0f88a94ffaa3de")
  assert_eq(@canonical_json.measure_value(value, 1105, 55, 5), 1105)
}

