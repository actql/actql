    "{\"type\":\"object\",\"properties\":{\"version\":{\"const\":\"actql-graph-output-index/0.1\"},\"graph_definition_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"logical_request_scope_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"node_membership_cids\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"minItems\":1},\"exports\":{\"type\":\"object\",\"additionalProperties\":{\"type\":\"object\",\"properties\":{\"node_id\":{\"type\":\"string\",\"minLength\":1},\"result_name\":{\"type\":\"string\",\"minLength\":1},\"local_manifest_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"result_artifact_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}},\"required\":[\"node_id\",\"result_name\",\"local_manifest_cid\",\"result_artifact_cid\"],\"additionalProperties\":false}},\"flow_state\":{\"enum\":[\"succeeded\",\"failed\",\"needs_reconciliation\",\"cancelled\"]},\"flow_evidence_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"self_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}},\"required\":[\"version\",\"graph_d",
    "efinition_cid\",\"logical_request_scope_cid\",\"node_membership_cids\",\"exports\",\"flow_state\",\"flow_evidence_cid\",\"self_cid\"],\"additionalProperties\":false}",
  ].join(""))
  let value = @canonical_json.from_json(input, 62, 6, 1174)
  assert_eq(@canonical_json.cid_value(value, 1174, 62, 6), "sha256:d0bbdb49780ca608792eca708ae6bc7dfbf79b2b63dcf768ad9d7e3d47b4c5ce")
  assert_eq(@canonical_json.measure_value(value, 1174, 62, 6), 1174)
}

