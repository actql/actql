  assert_eq(@canonical_json.cid_value(value, 203, 8, 2), "sha256:5a79d6cb9b012d0c3871c72e496eec7183948ac81d8ebff91b4f7ee6a59ae19d")
  assert_eq(@canonical_json.measure_value(value, 203, 8, 2), 203)
}
