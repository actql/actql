test "Effect Preview row guarded update with approved field change" {
  let input = @json.parse([
    "{\"version\":\"actql-effect-preview-row/0.1\",\"program_definition_cid\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"invocation_cid\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"effect_identity_cid\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"resolved_contract_cid\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"operation\":\"update\",\"target_row_identity\":\"001000000000001\",\"preview_strength\":\"full_diff\",\"target_guard\":{\"state\":\"version\",\"version_cid\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"},\"intended_changes\":{\"state\":\"present\",\"value\":{\"Name\":\"After\"}},\"before\":{\"state\":\"present\",\"value\":{\"Name\":\"Before\"}},\"after\":{\"state\":\"present\",\"value\":{\"Name\":\"After\"}}}",
  ].join(""))
  let value = @canonical_json.from_json(input, 24, 3, 813)
  assert_eq(@canonical_json.cid_value(value, 813, 24, 3), "sha256:4531682e916a81a555998f41de7fef4c505a841b83d794d09d95db899d6e55c8")
  assert_eq(@canonical_json.measure_value(value, 813, 24, 3), 813)
  assert_eq(@canonical_json.stringify_value(value, 813, 24, 3), "{\"after\":{\"state\":\"present\",\"value\":{\"Name\":\"After\"}},\"before\":{\"state\":\"present\",\"value\":{\"Name\":\"Before\"}},\"effect_identity_cid\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"intended_changes\":{\"state\":\"present\",\"value\":{\"Name\":\"After\"}},\"invocation_cid\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"operation\":\"update\",\"preview_strength\":\"full_diff\",\"program_definition_cid\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"resolved_contract_cid\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"target_guard\":{\"state\":\"version\",\"version_cid\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"},\"target_row_identity\":\"001000000000001\",\"version\":\"actql-effect-preview-row/0.1\"}")
}

