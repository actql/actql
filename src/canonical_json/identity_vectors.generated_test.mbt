///|
test "contract spec/contracts/actql-interval-search.json#" {
  let input = @json.parse([
    "{\"version\":\"actql-interval-search/0.1\",\"unit\":\"pair_visits\",\"measurement\":\"One visit is one examination of an ordered pair of captured left and right row occurrences for equality-key or temporal matching. Re-examination counts again. Equal row values and repeated input targets do not collapse occurrences. Repeated authored on conditions within a visit do not multiply pair visits; their evaluation cost remains physical work.\",\"fallback\":\"L * R for checked nonnegative safe-integer operand row upper bounds, conditional on a selected implementation that examines each ordered occurrence pair at most once. The scope includes pairs rejected by equality keys, NULL keys or temporal predicates, not only matches or emitted rows. Semi and anti output bounds do not reduce this fallback.\",\"empty\":\"An established zero operand bound gives zero pair visits even if the other bound is unknown. This does not skip mandatory whole-input endpoint or clock validation. Unknown is not zero.\",\"arithmetic\":\"Validate supplied operand bou",
    "nds before multiplication. Compute exactly, rejecting overflow beyond 9007199254740991 without rounding or saturation. A missing or overflowing fallback is not a language prohibition: another admitted finite search bound with its applicability conditions may be used. Without one, search resolution remains incomplete.\",\"ownership\":\"Bind the ceiling and every operand-bound dependency to the same checked interval operation, ordered input occurrences, effective Parameter binding and producer contexts. Equal numbers, a foreign producer or an output-row guard cannot substitute for search evidence. Imported operands retain their original producer dependencies.\",\"enforcement\":\"Select a finite search ceiling before matching and count every pair visit within that scope. Equality with the ceiling is permitted; exceeding it fails atomically without a partial successful result. A tighter bound requires its own admitted applicability evidence. A strategy that can revisit pairs cannot claim the product fallback without boun",
    "ding those extra visits.\",\"separation\":\"Pair visits are not output rows, CPU instructions, elapsed time, endpoint-admission work, sorting or index-construction work, bytes or retained memory. Resolve output ceilings independently and retain separate physical preparation and execution budgets. A pair ceiling of zero is not permission to omit input validation or resource enforcement.\",\"authority\":\"This semantic contract is not an observed count, executable bound-proof registration, implementation conformance attestation or execution permit. An unresolved search obligation remains unresolved until its bound, dependencies and realization conditions are connected. No new authored option or implicit default is introduced.\",\"persistent_limit\":\"Hash the complete canonical limit body without a self CID. subject_ref identifies the owning interval operation as unit:<Unit Definition CID>#/steps/<authored source ordinal>. search_contract_cid equals this admitted contract's CID. Each operand array is the sorted unique set ",
    "of all applicable reidentified Program row-witness CIDs for that operand, not internal indices or output-row witnesses. Sharing a witness across left and right does not merge operand roles. Proof graphs and their source correspondence require separate admission against that checked Unit and its effective binding. Rebuild producer subjects and dependent CIDs before selecting these references. maximum equals the product of each side's minimum; one proved zero permits an empty opposite set, otherwise both sets are required. Host ceilings and observations are not candidates for this fallback. The schema checks shape, not ownership, arithmetic, dependency availability, single-visit conformance or actual enforcement. This limit supplements rather than changes generic resolved row/byte limits.\",\"schemas\":{\"limit\":{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"version\",\"subject_ref\",\"search_contract_cid\",\"unit\",\"maximum\",\"left_bounds\",\"right_bounds\"",
    ",\"condition\",\"enforcement\"],\"properties\":{\"version\":{\"const\":\"actql-interval-search-limit/0.1\"},\"subject_ref\":{\"type\":\"string\",\"pattern\":\"^unit:sha256:[0-9a-f]{64}#/steps/(0|[1-9][0-9]*)$\"},\"search_contract_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"unit\":{\"const\":\"pair_visits\"},\"maximum\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991},\"left_bounds\":{\"type\":\"array\",\"uniqueItems\":true,\"items\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}},\"right_bounds\":{\"type\":\"array\",\"uniqueItems\":true,\"items\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}},\"condition\":{\"const\":\"single_visit\"},\"enforcement\":{\"const\":\"engine_atomic\"}}}}}",
  ].join(""))
  let value = @canonical_json.from_json(input, 58, 6, 4760)
  assert_eq(@canonical_json.cid_value(value, 4760, 58, 6), "sha256:4a41fc2f6967ceecd95fcd2ae1f5accc722af3090a6db6a1405d8091a8bae3c3")
  assert_eq(@canonical_json.measure_value(value, 4760, 58, 6), 4760)
}

