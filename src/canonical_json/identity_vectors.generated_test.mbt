    "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"$id\":\"https://smooth.dev/schemas/actql-lookup-source-0.1.json\",\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"source\",\"on\",\"max_items\",\"response_fields\"],\"properties\":{\"source\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"connector\",\"resource\",\"view\"],\"properties\":{\"connector\":{\"type\":\"string\",\"minLength\":1},\"resource\":{\"type\":\"string\",\"minLength\":1},\"view\":{\"type\":\"string\",\"minLength\":1}}},\"on\":{\"oneOf\":[{\"type\":\"string\",\"minLength\":1},{\"type\":\"object\",\"minProperties\":2,\"propertyNames\":{\"type\":\"string\",\"minLength\":1},\"additionalProperties\":{\"type\":\"string\",\"minLength\":1}}]},\"args\":{\"type\":\"object\",\"minProperties\":1,\"additionalProperties\":{\"oneOf\":[{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"field\"],\"properties\":{\"field\":{\"type\":\"string\",\"minLength\":1}}},{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"literal\"],\"properties\":{\"literal\":{}}},{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"$pa",
    "ram\"],\"properties\":{\"$param\":{\"type\":\"string\",\"minLength\":1}}}]}},\"max_items\":{\"type\":\"integer\",\"minimum\":1},\"response_fields\":{\"type\":\"array\",\"minItems\":1,\"uniqueItems\":true,\"items\":{\"type\":\"string\",\"minLength\":1}}}}",
  ].join(""))
  let value = @canonical_json.from_json(input, 82, 8, 1241)
  assert_eq(@canonical_json.cid_value(value, 1241, 82, 8), "sha256:6730fdb00f7b0f21ae796bd55f686fb984cddac5b8da5325cec2114b82a37e1c")
  assert_eq(@canonical_json.measure_value(value, 1241, 82, 8), 1241)
}

