    "{\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"version\":{\"const\":\"actql-discovery/0.1\"},\"publication_snapshot_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},\"reference\":{\"type\":\"object\",\"additionalProperties\":false,\"properties\":{\"kind\":{\"enum\":[\"catalog\",\"model_task\",\"grammar\",\"program_schema\",\"host_capabilities\"]},\"selector\":{\"type\":\"string\",\"minLength\":1},\"content_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"}},\"required\":[\"kind\",\"selector\",\"content_cid\"]},\"artifact\":{\"type\":\"object\"}},\"required\":[\"version\",\"publication_snapshot_cid\",\"reference\",\"artifact\"]}",
  ].join(""))
  let value = @canonical_json.from_json(input, 37, 6, 600)
  assert_eq(@canonical_json.cid_value(value, 600, 37, 6), "sha256:60073d1039f5e7c21eda2b0d35b1afb638f156cf360b42e9c970d39325a23b78")
  assert_eq(@canonical_json.measure_value(value, 600, 37, 6), 600)
}

