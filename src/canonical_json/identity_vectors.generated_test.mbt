///|
test "contract spec/contracts/actql-stage-contracts.json#/laws/lifecycle" {
  let input = @json.parse([
    "{\"order\":\"stages lower to ordinary finite Run Graph nodes and explicit control edges; no stage runtime branch\",\"activation\":\"all control milestones AND verified bindings AND current node admission; applied satisfies accepted; no hoisting\",\"failure\":\"unit-wide success barrier; unknown reconciles; explicit general failure/token routing remains legal\",\"publication\":\"all local Results; graph output index references existing artifacts; no second Invocation\",\"extraction\":\"lower_stages and load(extract_stage_programs) have identical canonical typed graph and common execution laws\",\"commit\":\"common commit scope before capture; final valid accepted requires no undeclared provider completion\"}",
  ].join(""))
  let value = @canonical_json.from_json(input, 7, 1, 692)
  assert_eq(@canonical_json.cid_value(value, 692, 7, 1), "sha256:da02951b68ca4255a25ac5b3f60288dbde2a8f7b252f518d73247c9feca09c54")
  assert_eq(@canonical_json.measure_value(value, 692, 7, 1), 692)
}

