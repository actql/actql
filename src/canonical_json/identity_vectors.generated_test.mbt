///|
test "contract spec/contracts/actql-stage-contracts.json#/laws" {
  let input = @json.parse([
    "{\"lifecycle\":{\"order\":\"stages lower to ordinary finite Run Graph nodes and explicit control edges; no stage runtime branch\",\"activation\":\"all control milestones AND verified bindings AND current node admission; applied satisfies accepted; no hoisting\",\"failure\":\"unit-wide success barrier; unknown reconciles; explicit general failure/token routing remains legal\",\"publication\":\"all local Results; graph output index references existing artifacts; no second Invocation\",\"extraction\":\"lower_stages and load(extract_stage_programs) have identical canonical typed graph and common execution laws\",\"commit\":\"common commit scope before capture; final valid accepted requires no undeclared provider completion\"},\"identity\":{\"definition\":\"typed stable Program/node namespace and complete local body, used declarations, import interfaces, incoming gates; no parent revision or position\",\"observation\":\"local Invocation binds local definition, effective values, contract closure and exact required observations/issuer/policy/provenan",
    "ce\",\"recovery\":\"logical request/item locator before exact Preview dispatch key; physical Run identity excluded transitively\",\"self_cid\":\"canonical AoA JSON without self_cid; referenced evidence must resolve with kind, scope and semantic validation\",\"authentication\":\"detached authentication signs payload CID excluding self_cid and authentication_evidence_cid; verify pinned issuer and algorithm\",\"success\":\"graph_success precedes output index and final graph receipt; it cannot reference either future artifact\",\"membership\":\"global Program/lock/revision/Run links are separately authenticated; no transitive ancestry into local Preview/review/locator/dispatch\",\"keys\":\"target and item reuse existing typed values; new runtime keys are stable locator and exact dispatch; fingerprint detects changed intent\"},\"admission\":{\"schema\":\"JSON Schema is necessary, not sufficient; no incoming artifact normalization or default insertion\",\"stage\":\"unique stage IDs, prior-only imports, exact exports and contracts, immutable paramet",
    "ers and engine pins\",\"ledger\":\"fencing; same key/different request rejects; absent history does not prove initial dispatch\",\"authorization\":\"authenticated human/policy proposition; template eligibility and concrete substitution separate\",\"numeric\":\"finite number or typed empty NULL; exact contributors/count/group/filter; replay never recomputes\",\"model\":\"ok requires typed value, real response and response issuer; failure has no typed value, optional actual error response and mandatory outcome evidence; no response is null, not empty bytes; strict publishes no Relation\",\"normalization\":\"raw_count = normalized_count + excluded_count; first_by_order requires independent total order\",\"completion\":\"failed/cancelled/expired is not completed success; non-null results require availability and original OperationRef contract proof\",\"exceptional_commit\":\"separate operator claim, exact fenced state/batch/unmet list and generation CAS; cancelled/timed_out/budget_exhausted/rejected preserve original outcome and all item ev",
    "idence; unknown/accepted_pending descendants require durable handoff, never abandonment or success relabeling\",\"classification\":\"published default only for absent label; invalid/unmapped/conflicting policy rejects; issuer/Ref/capture policy agrees without relabeling\",\"stamp\":\"declared recipe/management writes plus business permissions and footprint; current denial means zero writes; overwritten last_stamp is not not_applied proof\",\"routing\":\"closed semantic facts, no AST/meta/count proxies; cumulative actual risk not reset per node; packaging alone cannot add review\",\"derive\":\"map snapshot/add-only, array prior-slot/input-preserving shadow, unique NFC outputs; common row frame and budgets; select closes fields\"},\"implementation\":{\"status\":\"specified-not-executed\",\"staged_runtime_claim\":false}}",
  ].join(""))
  let value = @canonical_json.from_json(input, 34, 2, 3876)
  assert_eq(@canonical_json.cid_value(value, 3876, 34, 2), "sha256:540d06456c7ddf166f5192dd1379b853e48791ca869a54abcc428b2210097325")
  assert_eq(@canonical_json.measure_value(value, 3876, 34, 2), 3876)
}

///|
test "contract spec/contracts/actql-stage-contracts.json#/schemas/ledger_entry" {
  let input = @json.parse([
    "{\"type\":\"object\",\"properties\":{\"version\":{\"const\":\"actql-logical-item-ledger-entry/0.1\"},\"logical_request_scope_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"logical_item_locator_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"unit_definition_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"original_membership_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"intent_fingerprint_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"effect_preview_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"dispatch_key\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"canonical_request_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"recovery_contract_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"capability\":{\"enum\":[\"native\",\"stamped\",\"natural_key\",\"unavailable\"]},\"state\":{\"enum\":[\"prepared\",\"dispatching\",\"applied\",\"accepted\",\"failed\",\"unknown\"]},\"fence\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":9007199254740991},\"attempt_sequence\":{\"type\":\"intege",
