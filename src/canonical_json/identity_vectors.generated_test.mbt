///|
test "lookup schema attempt_receipt" {
  let input = @json.parse([
    "{\"type\":\"object\",\"properties\":{\"version\":{\"const\":\"actql-lookup-attempt-receipt/0.1\"},\"barrier_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"input_relation_artifact_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"request_key_set_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"batch_plan_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"source_request_egress_admission_cid\":{\"anyOf\":[{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},{\"type\":\"null\"}]},\"started_at\":{\"type\":\"string\",\"pattern\":\"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\\\.[0-9]{3}Z$\"},\"recorded_at\":{\"type\":\"string\",\"pattern\":\"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\\\.[0-9]{3}Z$\"},\"previous_receipt_cid\":{\"anyOf\":[{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},{\"type\":\"null\"}]},\"state\":{\"enum\":[\"in_progress\",\"succeeded\",\"failed\",\"unknown\"]},\"attempts\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"call_slot_cid\",\"semantic_request_cid\",\"batch_",
    "index\",\"page_index\",\"network_attempt\",\"outcome\"],\"properties\":{\"call_slot_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},\"semantic_request_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},\"batch_index\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991},\"page_index\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991},\"network_attempt\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":9007199254740991},\"provider_request_id\":{\"type\":\"string\",\"minLength\":1},\"outcome\":{\"enum\":[\"planned\",\"dispatched\",\"captured\",\"failed\",\"unknown\",\"unattempted\"]},\"raw_response_artifact_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"},\"runtime_error_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[a-f0-9]{64}$\"}},\"allOf\":[{\"if\":{\"properties\":{\"outcome\":{\"const\":\"captured\"}},\"required\":[\"outcome\"]},\"then\":{\"required\":[\"raw_response_artifact_cid\"],\"not\":{\"required\":[\"runtime_error_cid\"]}}},{\"if\":{\"properties\":{\"outcome\":{\"enum\":[\"planned\",\"dispatched\",\"unknown\",\"unattempted\"]}},\"required\":[\"outcome\"]},\"then\":{\"not",
    "\":{\"anyOf\":[{\"required\":[\"raw_response_artifact_cid\"]},{\"required\":[\"runtime_error_cid\"]}]}}}]},\"uniqueItems\":true},\"lifecycle_evidence\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"kind\":{\"enum\":[\"accounting\",\"attempt_event\",\"activation\",\"adoption\"]},\"cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}},\"required\":[\"kind\",\"cid\"],\"additionalProperties\":false},\"minItems\":1,\"uniqueItems\":true},\"self_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}},\"required\":[\"version\",\"barrier_cid\",\"input_relation_artifact_cid\",\"request_key_set_cid\",\"batch_plan_cid\",\"source_request_egress_admission_cid\",\"started_at\",\"recorded_at\",\"previous_receipt_cid\",\"state\",\"attempts\",\"lifecycle_evidence\",\"self_cid\"],\"additionalProperties\":false,\"allOf\":[{\"properties\":{\"lifecycle_evidence\":{\"contains\":{\"properties\":{\"kind\":{\"const\":\"accounting\"}},\"required\":[\"kind\"]}}}},{\"if\":{\"properties\":{\"attempts\":{\"contains\":{\"properties\":{\"outcome\":{\"const\":\"failed\"}},\"required\":[\"outcome\"],\"not\":{\"required\":[\"runtime_error_ci",
    "d\"]}}}},\"required\":[\"attempts\"]},\"then\":{\"properties\":{\"lifecycle_evidence\":{\"contains\":{\"properties\":{\"kind\":{\"const\":\"attempt_event\"}},\"required\":[\"kind\"]}}}}}]}",
  ].join(""))
  let value = @canonical_json.from_json(input, 198, 11, 3235)
  assert_eq(@canonical_json.cid_value(value, 3235, 198, 11), "sha256:a48afadbe4bb2378a6bd3203f35c451081d84d316514f47e544a6c2c4f102620")
  assert_eq(@canonical_json.measure_value(value, 3235, 198, 11), 3235)
}

