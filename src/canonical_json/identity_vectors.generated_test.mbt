  let input = @json.parse([
    "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"version\",\"subject_ref\",\"search_contract_cid\",\"unit\",\"maximum\",\"left_bounds\",\"right_bounds\",\"condition\",\"enforcement\"],\"properties\":{\"version\":{\"const\":\"actql-asof-search-limit/0.1\"},\"subject_ref\":{\"type\":\"string\",\"pattern\":\"^unit:sha256:[0-9a-f]{64}#/steps/(0|[1-9][0-9]*)$\"},\"search_contract_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"unit\":{\"const\":\"pair_visits\"},\"maximum\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991},\"left_bounds\":{\"type\":\"array\",\"uniqueItems\":true,\"items\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}},\"right_bounds\":{\"type\":\"array\",\"uniqueItems\":true,\"items\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}},\"condition\":{\"const\":\"single_visit\"},\"enforcement\":{\"const\":\"engine_atomic\"}}}",
