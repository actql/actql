    "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"$id\":\"https://smooth.dev/schemas/actql-review-projection-0.1.json\",\"title\":\"actql-review-projection-0.1\",\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"version\",\"effect_preview_cid\",\"authority_scope_cid\",\"approval_claims\",\"authoring_context_cid\",\"redaction_policy_cid\",\"sensitivity\",\"retention_class\",\"encryption_required\",\"displayed_scope\",\"displayed_permissions\",\"displayed_rows\",\"displayed_authoring_context\",\"review_projection_cid\"],\"properties\":{\"version\":{\"const\":\"actql-review-projection/0.1\"},\"effect_preview_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"authority_scope_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"approval_claims\":{\"type\":\"array\",\"minItems\":1,\"uniqueItems\":true,\"items\":{\"enum\":[\"effect_scope_approved\",\"partial_application_accepted\"]}},\"authoring_context_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"redaction_policy_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"sensitivity\":",
    "{\"const\":\"restricted\"},\"retention_class\":{\"const\":\"approval-evidence\"},\"encryption_required\":{\"const\":true},\"displayed_scope\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"effects\"],\"properties\":{\"effects\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"effect_id\",\"kind\",\"target\",\"count\"],\"properties\":{\"effect_id\":{\"type\":\"string\",\"minLength\":1},\"kind\":{\"enum\":[\"create\",\"update\",\"upsert\",\"delete\",\"command\",\"store\"]},\"target\":{\"oneOf\":[{\"type\":\"string\",\"minLength\":1},{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"field\"],\"properties\":{\"field\":{\"type\":\"string\",\"minLength\":1}}}]},\"count\":{\"type\":\"integer\",\"minimum\":0}}}}}},\"displayed_permissions\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"displayed_rows\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"effect_id\",\"row_preview_cid\",\"target_row_identity\",\"before\",\"after\"],\"properties\":{\"effect_id\":{\"type\":\"string\",\"minLength\":1},\"row_preview_cid\":{\"type\":\"string\",\"patter",
    "n\":\"^sha256:[0-9a-f]{64}$\"},\"target_row_identity\":{\"oneOf\":[{\"type\":\"string\"},{\"type\":\"number\"},{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"content_cid\",\"occurrence\"],\"properties\":{\"content_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"occurrence\":{\"type\":\"integer\",\"minimum\":0}}}]},\"before\":{},\"after\":{}}}},\"displayed_authoring_context\":{\"type\":\"array\",\"items\":{\"type\":\"object\"}},\"review_projection_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}}}",
  ].join(""))
  let value = @canonical_json.from_json(input, 145, 12, 2534)
  assert_eq(@canonical_json.cid_value(value, 2534, 145, 12), "sha256:7585ae7f6737a8a0a196df98e64f496fbca271c910840f1116f6d7990caf39fb")
  assert_eq(@canonical_json.measure_value(value, 2534, 145, 12), 2534)
}

