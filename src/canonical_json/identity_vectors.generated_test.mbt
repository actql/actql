    ":\"actql-authoring-context/0.1\"},\"program_definition_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"annotations\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"target\",\"meta\"],\"properties\":{\"target\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"kind\",\"source_path\"],\"properties\":{\"kind\":{\"enum\":[\"program\",\"stage\",\"input\",\"parameter\",\"binding\",\"step\",\"result\",\"effect\"]},\"source_path\":{\"type\":\"string\",\"minLength\":1},\"name\":{\"type\":\"string\",\"minLength\":1}}},\"meta\":{\"type\":\"object\",\"minProperties\":1,\"propertyNames\":{\"not\":{\"pattern\":\"^actql_\"}},\"additionalProperties\":true}}}},\"authoring_context_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}}},\"barrier_provenance_cids\":{\"type\":\"array\",\"uniqueItems\":true,\"items\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}},\"model_derived\":{\"type\":\"boolean\"},\"model_task_contract_cids\":{\"type\":\"array\",\"uniqueItems\":true,\"items\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}},\"model_invocation_evidence_ci",
