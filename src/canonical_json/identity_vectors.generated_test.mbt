test "contract spec/contracts/actql-regex-ast.json#" {
  let input = @json.parse([
    "{\"version\":\"actql-regex-ast-contract/0.1\",\"ast_version\":\"actql-regex-ast/0.1\",\"schema\":{\"path\":\"spec/grammar/actql-regex-ast-0.1.schema.json\",\"pointer\":\"\",\"cid\":\"sha256:cc114653eb3db3bdf94bf233f34c0baa5f4c5bc305aeb07ed66283706054d3d9\"},\"scope\":\"Overrides inherited text-time regex AST representation and identity only; matching, grammar, flags and demand laws remain in force.\",\"semantics\":{\"scalar\":\"integer_0_to_1114111_excluding_55296_to_57343_assignment_not_required\",\"literal\":\"closed_kind_literal_and_codepoint_one_exact_scalar\",\"range\":\"closed_kind_range_and_integer_start_end_inclusive_start_le_end_over_scalar_universe\",\"escapes\":{\"n\":10,\"r\":13,\"t\":9},\"normalization\":\"source_text_obeys_NFC_LF_before_parsing_decoded_AST_scalars_are_not_text_normalized\",\"ordering\":\"retain_literal_sequence_class_item_branch_and_capture_occurrence_order\",\"identity\":\"ordinary_canonical_JSON_of_complete_AST_body_excluding_only_ast_cid\",\"compatibility\":\"old_string_literal_values_and_string_range_endpoints_rejected_no_silent_reinter",
    "pretation\",\"backend\":\"exact_expression_contract_and_local_AST_dependency_support_required_no_legacy_registry_relabeling\",\"semantic_checks\":\"range_order_capture_numbering_counts_and_quantifier_rules_require_separate_validation\"}}",
  ].join(""))
  let value = @canonical_json.from_json(input, 22, 3, 1252)
  assert_eq(@canonical_json.cid_value(value, 1252, 22, 3), "sha256:9c4e0107ad1e6a1eb374e8365c07615c74773416b0b43f9a1e02db5e551efc78")
  assert_eq(@canonical_json.measure_value(value, 1252, 22, 3), 1252)
}

///|
test "contract spec/contracts/actql-bound-transfer-laws.json#" {
  let input = @json.parse([
