    "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"$id\":\"https://smooth.dev/schemas/actql-result-plan-0.1.json\",\"title\":\"actql-result-plan-0.1\",\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"version\",\"result_name\",\"unit_definition_cid\",\"unit_result_name\",\"unit_result_ordinal\",\"projection\",\"order\",\"typed_output_port\",\"result_plan_logical_cid\"],\"properties\":{\"version\":{\"const\":\"actql-result-plan/0.1\"},\"result_name\":{\"type\":\"string\",\"minLength\":1},\"unit_definition_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"},\"unit_result_name\":{\"type\":\"string\",\"minLength\":1},\"unit_result_ordinal\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991},\"projection\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"input\",\"output\",\"value_contract_cid\"],\"properties\":{\"input\":{\"type\":\"string\",\"minLength\":1},\"output\":{\"type\":\"string\",\"minLength\":1},\"value_contract_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}}}},\"order\":{\"type\":\"object\",\"additionalProperties",
    "\":false,\"required\":[\"strategy\",\"terms\"],\"properties\":{\"strategy\":{\"enum\":[\"authored\",\"inherited\",\"candidate_key\",\"projected_fields\"]},\"terms\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"field\",\"direction\",\"nulls\",\"authored\"],\"properties\":{\"field\":{\"type\":\"string\",\"minLength\":1},\"direction\":{\"enum\":[\"asc\",\"desc\"]},\"nulls\":{\"enum\":[\"first\",\"last\"]},\"authored\":{\"type\":\"boolean\"}}}}}},\"typed_output_port\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"name\",\"carrier\",\"row_contract_cid\"],\"properties\":{\"name\":{\"type\":\"string\",\"minLength\":1},\"carrier\":{\"const\":\"relation\"},\"row_contract_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}}},\"result_plan_logical_cid\":{\"type\":\"string\",\"pattern\":\"^sha256:[0-9a-f]{64}$\"}}}",
  ].join(""))
  let value = @canonical_json.from_json(input, 107, 9, 1798)
  assert_eq(@canonical_json.cid_value(value, 1798, 107, 9), "sha256:d3648145cdf5de94730ce57ae3a35efa84812bdc67b5416137913550bee248c5")
  assert_eq(@canonical_json.measure_value(value, 1798, 107, 9), 1798)
}

