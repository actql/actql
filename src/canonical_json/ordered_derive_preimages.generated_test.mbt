///|
test "ordered derive closed-input-shape" {
  let value = @canonical_json.from_json(@json.parse("{\"additional_fields\":false,\"fields\":{\"x\":{\"nullable\":false,\"type\":\"number\"}},\"required_fields\":[\"x\"],\"version\":\"actql-derive-row-shape/0.1\"}"), 1000, 100, 100000)
  assert_eq(@canonical_json.stringify_value(value, 100000, 1000, 100), "{\"additional_fields\":false,\"fields\":{\"x\":{\"nullable\":false,\"type\":\"number\"}},\"required_fields\":[\"x\"],\"version\":\"actql-derive-row-shape/0.1\"}")
  assert_eq(@canonical_json.cid_value(value, 100000, 1000, 100), "sha256:df852841162540088655a397d2c0dc40feff2c8f2db0e50ae6e0d3891f123c46")
}

