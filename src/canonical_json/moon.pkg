supported_targets = "+js+wasm+native"

import {
  "actql/actql/encode_core" @encode,
  "actql/actql/canonical_value" @value,
}

import {
  "actql/actql/sha256",
  "moonbitlang/core/json",
} for "test"

formatter(
  ignore: [
    "check_environment.generated_test.mbt",
    "identity_vectors.generated_test.mbt",
    "values_execution.generated_test.mbt",
    "regex_ast_scalars.generated_test.mbt",
  ],
)
