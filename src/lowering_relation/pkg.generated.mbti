// Errors

// Types and methods
pub(all) enum AnalyticIssue {
  AnalyticNotFound
  InvalidAnalyticLimits
  AnalyticPreparationLimit
  AnalyticExpressionFailure(ExpressionIssue)
  MissingAnalyticParameter(String)
  InvalidAnalyticParameter(String)
  InvalidAnalyticCall(Int)
  AnalyticAggregateFailure(GroupIssue)
}

pub(all) enum AppendIssue {
  InvalidLimits
  PreparationLimit
  InvalidCheckedShape
} derive(Eq, @debug.Debug)

pub(all) enum BinaryOperator {
  Add
  Subtract
  Multiply
  Divide
  Modulo
  Equal
  NotEqual
  Less
  LessEqual
  Greater
  GreaterEqual
  NullIf
} derive(Eq, @debug.Debug)

pub struct BindingIssue {
  kind : BindingIssueKind
  source : @decode_core.Cursor
}

pub(all) enum BindingIssueKind {
  InvalidBindingLimits
  BindingOwnerMismatch
  MissingBindings
  BindingBudgetExceeded
} derive(Eq, @debug.Debug)

type BoundPrepared

pub struct CanonicalOccurrence {
  source_step : Int
  id : String
  operation : String
}

pub(all) enum CountGroupIssue {
  NotGroup
  UnsupportedAggregate(Int)
  InvalidLimits
  PreparationLimit
} derive(Eq, @debug.Debug)

pub struct CrossJoinField {
  output : @relation_schema.FieldName
  input : @relation_schema.FieldName
}

pub(all) enum CrossJoinIssue {
  InvalidLimits
  PreparationLimit
  InvalidCheckedShape
  InvalidGuard
} derive(Eq, @debug.Debug)

pub(all) enum DemandAddressIssue {
  InvalidAddressLimits
  InvalidRoot
  InvalidNode
  AddressLimit
  MissingConditionSource
}

type DemandIndex

pub(all) enum DemandIssue {
  InvalidDemandLimits
  DemandLimit
  InvalidTypedTopology
}

pub(all) struct DemandLimits {
  max_roots : Int
  max_nodes : Int
  max_work : Int
  max_text_bytes : Int
  max_links : Int
}

pub(all) struct DemandUsage {
  roots : Int
  nodes : Int
  work : Int
  text_bytes : Int
  links : Int
} derive(Eq, @debug.Debug)

pub(all) enum EventIssue {
  InvalidEventLimits
  InvalidEventWiring
  EventPreparationLimit
} derive(Eq, @debug.Debug)

type Expression

pub enum ExpressionBody {
  Field(String, @relation_typing.ReferenceTarget)
  Literal(@value_admission.CheckedValue)
  TypedNull
  Unary(UnaryOperator, Expression)
  Binary(BinaryOperator, Expression, Expression)
  Many(ManyOperator, Array[Expression])
  Conditional(Expression, Expression, Expression)
  Case(Array[(Expression, Expression)], Expression)
}

pub struct ExpressionIssue {
  kind : ExpressionIssueKind
  source : @decode_core.Cursor
}

pub(all) enum ExpressionIssueKind {
  InvalidExpressionLimits
  ExpressionBudgetExceeded
  MissingCheckedBinding
  MissingParameter(String)
  MissingTypeAnnotation
  MissingResolvedField(String)
  PendingValidation(@expression_typing.ObligationKind)
  ExpressionNotImplemented(String)
  LiteralAdmission(@value_admission.Issue)
} derive(Eq, @debug.Debug)

pub(all) struct ExpressionLimits {
  max_nodes : Int
  max_work : Int
