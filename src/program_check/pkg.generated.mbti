// Errors
pub suberror ConstructionFailure {
  InvalidLimits
  BudgetExceeded
  Operations(@pipeline_check_context.ProgramOperationResolutionIssue)
  Values(@pipeline_check_context.ValuesPublicationIssue)
  Joins(@pipeline_check_context.JoinRequirementIssue)
  IntervalSearch(@pipeline_check_context.IntervalSearchLimitIssue)
  AsOfSearch(@pipeline_check_context.AsOfSearchLimitIssue)
  WindowLimits(@pipeline_check_context.WindowMembershipBoundIssue)
  GroupLimits(@pipeline_check_context.GroupArrayLimitIssue)
  NestValues(@pipeline_check_context.NestValueIssue)
  GroupStringLimits(@pipeline_check_context.GroupStringLimitIssue)
  NumericSlots(@pipeline_check_context.NumericSlotsIssue)
  Incoming(@pipeline_check_context.IncomingIssue)
  Links(@pipeline_check_context.IncomingLinksIssue)
  Requirements(@pipeline_check_context.StageRequirementIssue)
  UnresolvedOperation(@pipeline_check_context.OperationRequirementSite)
  IncompleteInventory(Int)
  Gates(@pipeline_check_context.ProgramIncomingGatesIssue)
  Contracts(@pipeline_check_context.CoreContractIssue)
}

pub suberror EnvironmentFailure {
  BudgetExceeded
  Registry(@check_environment.ContractIssue)
  Catalog(@check_environment.CatalogIssue)
  References(@check_environment.ReferenceIssue)
  Policies(@check_environment.DataPolicyIssue)
  Values(@check_environment.ValueContractIssue)
  Shapes(@check_environment.SourceViewShapeIssue)
  Modes(@check_environment.SourceReadModeIssue)
  Carriers(@check_environment.CarrierSchemaIssue)
  Requests(@check_environment.SourceRequestIssue)
}

pub suberror LocalConstructionFailure {
  InvalidLimits
  Program(@stage_syntax.SyntaxError)
  CapacityInputs(@pipeline_check_context.CapacityInputsIssue)
  Environment(EnvironmentFailure)
  Source(SourceFailure)
  Closure(ConstructionFailure)
  Units(UnitBuildFailure)
}

pub suberror SourceFailure {
  DeclarationWorkLimit
  CapacityMetadataBudget
  UnsupportedBindings(@decode_core.Cursor)
  UnsupportedEffects(@decode_core.Cursor)
  Requests(@pipeline_check_context.PrepareSourcesIssue)
  Checks(@pipeline_check_context.PrepareChecksIssue)
  Identity(@pipeline_check_context.SourcePreparationIssue)
  Declarations(@stage_parameters.Issue)
  Registration(@pipeline_check_context.SourceRegistrationIssue)
  SourceView(@pipeline_check_context.SourceViewContextIssue)
}

pub suberror UnitBuildFailure {
  ForeignOwner
  UnresolvedProducer
  UnsupportedReceipt
  BudgetExceeded
  Encoding(@encode_core.EncodeFailure)
  ImportType(@pipeline_check_context.ResultImportTypeIssue)
  PublicationRows(@pipeline_check_context.PublicationRowLimitIssue)
  PublicationWire(@capacity_witness.Issue)
  PublicationArithmetic(@capacity_witness.ClosureIssue)
  PublicationHost(@capacity_host_witness.Issue)
  Expressions(@pipeline_check_context.ExpressionClosureIssue)
  UnconvertedProofInput
  AmbiguousProofInput
  ProofConversion(Error)
  PublicationMixed(@capacity_witness.MixedIssue)
  UnsupportedStaticPath(@decode_core.Cursor)
  UnclosedSourceExecution(Int, Int)
  UnclosedPublicationPolicy(Int, Int)
}

