  CapabilityDisabled
  Selection(@check_environment.CalendarSelectionIssue)
  Artifact(@calendar_profile.Issue)
}

type CheckDiagnostic

type CheckEnvironment

pub(all) struct CheckLimits {
  input : @stage_syntax.Limits
  compilation : CompileLimits
} derive(Eq, @debug.Debug)

pub enum CheckOutcome {
  Checked(CheckedProgram)
  NeedsInputs(InputRequests)
  Rejected(CheckDiagnostic)
}

pub(all) struct CheckProfileSelection {
  expressions : @pipeline_check_context.ExpressionProfiles
  operations : @pipeline_check_context.PureOperationProfiles
  graph : Bool
  model_tasks : Bool
  numeric_profile_cid : String?
  calendar_profile_cid : String?
