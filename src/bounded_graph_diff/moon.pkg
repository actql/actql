supported_targets = "+js+wasm+native"

import {
  "actql/actql/bounded_graph_snapshot" @snapshot,
  "actql/actql/carrier_contract" @carrier,
  "actql/actql/managed_graph_storage" @storage,
  "actql/actql/managed_carrier_runtime" @lifecycle,
  "actql/actql/value_admission" @value,
  "actql/actql/value_contract" @contract,
  "actql/actql/graph_contract",
  "actql/actql/source_value" @source,
  "actql/actql/decode_core" @decode,
  "actql/actql/canonical_value" @canonical,
  "actql/actql/encode_core" @encode,
  "actql/actql/decode_scalar" @scalar,
}

import {
  "actql/actql/managed_graph_runtime" @graph_runtime,
  "actql/actql/lowering_relation" @lower,
  "actql/actql/pipeline_typing" @pipeline,
  "actql/actql/relation_schema" @schema,
  "actql/actql/local_sga" @sga,
  "actql/actql/bounded_execution" @bounded,
} for "wbtest"
