// Independent canonical envelope cases, not compiler/Host output.

///|
test "original Run Plan envelope 0" {
  assert_true(
    parse_interactive_run_control_shape(
      "run_plan_view", "{\"plan_view\":{\"capabilities\":{\"cost_guard\":false,\"durable_control\":false,\"execution_batch\":false,\"full_intermediate_retention\":[],\"inspect\":false,\"policy_revision_cid\":\"sha256:9999999999999999999999999999999999999999999999999999999999999999\",\"sample_capture\":[],\"static_plan\":true},\"compiled_plan_cid\":\"sha256:e601408109081ed6fef39782d17940a2a216d9166ba0e249f370769410fe6c22\",\"logical_map\":{\"compiled_plan_cid\":\"sha256:e601408109081ed6fef39782d17940a2a216d9166ba0e249f370769410fe6c22\",\"program_definition_cid\":\"sha256:3333333333333333333333333333333333333333333333333333333333333333\",\"self_cid\":\"sha256:867d5e152bedc53aa4d4015b25da927eef2589c59d127040ee7b4f6af16fbf14\",\"steps\":[{\"can_stop_after\":false,\"can_stop_before\":false,\"key\":{\"compiled_plan_cid\":\"sha256:e601408109081ed6fef39782d17940a2a216d9166ba0e249f370769410fe6c22\",\"occurrence\":{\"input_port_ordinal\":0,\"kind\":\"input_output\"},\"self_cid\":\"sha256:783641dbc77abc7291465c218c6270228415f6d432d50aff0d4b19a2c080e82b\",\"stage_ordinal\":1,\"version\":\"actql-logical-step-key/0.1\"},\"names\":[\"answer\"],\"operator\":null,\"ports\":[{\"can_sample\":false,\"carrier\":\"relation\",\"carrier_contract_cid\":\"sha256:7777777777777777777777777777777777777777777777777777777777777777\",\"port_id\":\"sha256:abbcfe1695d0131a6ea1bce21d849de09b3f861fd66a7456ff8274ac1faa0ce2\",\"port_ordinal\":0,\"role\":\"input\",\"sample_reason\":\"not_installed\",\"source\":{\"input_port_ordinal\":0,\"kind\":\"stage_input\",\"stage_ordinal\":1}},{\"can_sample\":false,\"carrier\":\"relation\",\"carrier_contract_cid\":\"sha256:7777777777777777777777777777777777777777777777777777777777777777\",\"port_id\":\"sha256:a231373ceaedc02373d14b4ed788390f5f0961e1b1d561085b7fea28278821b4\",\"port_ordinal\":0,\"role\":\"output\",\"sample_reason\":\"not_installed\",\"source\":{\"input_port_ordinal\":0,\"kind\":\"stage_input\",\"stage_ordinal\":1}}],\"step_id\":\"sha256:783641dbc77abc7291465c218c6270228415f6d432d50aff0d4b19a2c080e82b\",\"stop_reason\":\"not_installed\"}],\"version\":\"actql-logical-map/0.1\"},\"observation\":\"static\",\"provider_io\":0,\"quantities\":[{\"kind\":\"unknown\",\"reason\":\"not_observed\",\"unit\":\"work\"}],\"version\":\"actql-plan-view/0.1\"},\"run_ref\":{\"authorityScopeCid\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"namespaceId\":\"workspace:test\",\"runDefinitionCid\":\"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"},\"version\":\"actql-run-plan-view/0.1\"}",
      65536, 4096, 64,
    )
    is Ok(_),
  )
}

