  let saved = read_model_capture_bundle("{\"barrier_receipts\":[],\"bundle_cid\":\"sha256:179c20ec5e89d02ea39a46ec809b4b3221343d0f6fa8052c6664959a7f607f92\",\"captures\":[{\"evidence\":{\"attempt\":1,\"authored_model_selector\":\"configured-selector\",\"finish_reason\":\"stop\",\"input_result_artifact_cid\":\"sha256:4444444444444444444444444444444444444444444444444444444444444444\",\"input_row_identity\":[\"key\",7],\"input_row_identity_cid\":\"sha256:5555555555555555555555555555555555555555555555555555555555555555\",\"input_tokens\":0,\"model_call_slot_cid\":\"sha256:3333333333333333333333333333333333333333333333333333333333333333\",\"model_invocation_evidence_cid\":\"sha256:40bf2cab544ebfcf515f9bfd23918a66be40437c6aed3e693d2c9167a40b811e\",\"model_task_contract_cid\":\"sha256:1111111111111111111111111111111111111111111111111111111111111111\",\"observed_at\":\"2026-10-11T00:00:00.000Z\",\"output_tokens\":11,\"provider_reported_model_id\":\"historical-model\",\"provider_request_id\":\"historical-request\",\"semantic_request_cid\":\"sha256:2222222222222222222222222222222222222222222222222222222222222222\",\"structured_response_artifact_cid\":\"sha256:6666666666666666666666666666666666666666666666666666666666666666\",\"validated_structured_output_cid\":\"sha256:7777777777777777777777777777777777777777777777777777777777777777\",\"version\":\"actql-model-invocation-evidence/0.1\"},\"model_call_slot_cid\":\"sha256:3333333333333333333333333333333333333333333333333333333333333333\",\"semantic_request_cid\":\"sha256:2222222222222222222222222222222222222222222222222222222222222222\",\"structured_response\":{\"answer\":\"original-é\\r\\n\"}}],\"version\":\"actql-model-capture-bundle/0.2\"}", "sha256:179c20ec5e89d02ea39a46ec809b4b3221343d0f6fa8052c6664959a7f607f92", 16384, 1024, 20).unwrap()
  assert_eq(model_capture_bundle_count(saved), 1)
  let record_0 = model_capture_bundle_record(saved, 0).unwrap()
  assert_eq(run_evidence_value_json(model_capture_record_evidence(record_0)), "{\"attempt\":1,\"authored_model_selector\":\"configured-selector\",\"finish_reason\":\"stop\",\"input_result_artifact_cid\":\"sha256:4444444444444444444444444444444444444444444444444444444444444444\",\"input_row_identity\":[\"key\",7],\"input_row_identity_cid\":\"sha256:5555555555555555555555555555555555555555555555555555555555555555\",\"input_tokens\":0,\"model_call_slot_cid\":\"sha256:3333333333333333333333333333333333333333333333333333333333333333\",\"model_invocation_evidence_cid\":\"sha256:40bf2cab544ebfcf515f9bfd23918a66be40437c6aed3e693d2c9167a40b811e\",\"model_task_contract_cid\":\"sha256:1111111111111111111111111111111111111111111111111111111111111111\",\"observed_at\":\"2026-10-11T00:00:00.000Z\",\"output_tokens\":11,\"provider_reported_model_id\":\"historical-model\",\"provider_request_id\":\"historical-request\",\"semantic_request_cid\":\"sha256:2222222222222222222222222222222222222222222222222222222222222222\",\"structured_response_artifact_cid\":\"sha256:6666666666666666666666666666666666666666666666666666666666666666\",\"validated_structured_output_cid\":\"sha256:7777777777777777777777777777777777777777777777777777777777777777\",\"version\":\"actql-model-invocation-evidence/0.1\"}")
  assert_eq(run_evidence_value_identity(model_capture_record_evidence(record_0)), "sha256:40bf2cab544ebfcf515f9bfd23918a66be40437c6aed3e693d2c9167a40b811e")
  assert_eq(model_capture_record_observation(record_0).unwrap().origin, HistoricalAdmitted)
  assert_true(release_model_capture_bundle_read(saved))
}

