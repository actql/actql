  let original = seal_run_evidence_value("model_invocation_evidence", "{\"attempt\":1,\"authored_model_selector\":\"configured-selector\",\"finish_reason\":\"provider-complete\",\"gateway_request_id\":\"gateway-1\",\"input_result_artifact_cid\":\"sha256:4444444444444444444444444444444444444444444444444444444444444444\",\"input_row_identity\":[\"key\",7],\"input_row_identity_cid\":\"sha256:5555555555555555555555555555555555555555555555555555555555555555\",\"input_tokens\":13,\"model_call_slot_cid\":\"sha256:3333333333333333333333333333333333333333333333333333333333333333\",\"model_task_contract_cid\":\"sha256:1111111111111111111111111111111111111111111111111111111111111111\",\"observed_at\":\"2026-10-11T00:00:00.000Z\",\"output_tokens\":null,\"provider_metadata\":{\"provider\":{\"nested\":{\"complete\":false,\"precision\":99,\"retry\":true},\"unknown_extension\":[null,0,false,\"\",\"raw-é\\r\\n\"]}},\"provider_reported_model_id\":\"raw-é\\r\\nmodel\",\"provider_reported_revision\":\"revision-1\",\"provider_request_id\":\"raw-request\",\"raw_response_artifact_cid\":\"sha256:9999999999999999999999999999999999999999999999999999999999999999\",\"response_complete\":true,\"response_profile_cid\":\"sha256:8888888888888888888888888888888888888888888888888888888888888888\",\"semantic_request_cid\":\"sha256:2222222222222222222222222222222222222222222222222222222222222222\",\"structured_response_artifact_cid\":\"sha256:6666666666666666666666666666666666666666666666666666666666666666\",\"validated_structured_output_cid\":\"sha256:7777777777777777777777777777777777777777777777777777777777777777\",\"version\":\"actql-model-invocation-evidence/0.2\"}", 16384, 1024, 20).unwrap()
  let changed = seal_run_evidence_value("model_invocation_evidence", "{\"attempt\":1,\"authored_model_selector\":\"configured-selector\",\"finish_reason\":\"provider-complete\",\"gateway_request_id\":\"gateway-1\",\"input_result_artifact_cid\":\"sha256:4444444444444444444444444444444444444444444444444444444444444444\",\"input_row_identity\":[\"key\",7],\"input_row_identity_cid\":\"sha256:5555555555555555555555555555555555555555555555555555555555555555\",\"input_tokens\":13,\"model_call_slot_cid\":\"sha256:3333333333333333333333333333333333333333333333333333333333333333\",\"model_task_contract_cid\":\"sha256:1111111111111111111111111111111111111111111111111111111111111111\",\"observed_at\":\"2026-10-11T00:00:00.000Z\",\"output_tokens\":null,\"provider_metadata\":{\"provider\":{\"nested\":{\"complete\":false,\"precision\":99,\"retry\":true},\"unknown_extension\":[null,0,false,\"\",\"raw-é\\r\\n\"]}},\"provider_reported_model_id\":\"raw-é\\r\\nmodel\",\"provider_reported_revision\":\"revision-1\",\"provider_request_id\":\"raw-request\",\"raw_response_artifact_cid\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"response_complete\":true,\"response_profile_cid\":\"sha256:8888888888888888888888888888888888888888888888888888888888888888\",\"semantic_request_cid\":\"sha256:2222222222222222222222222222222222222222222222222222222222222222\",\"structured_response_artifact_cid\":\"sha256:6666666666666666666666666666666666666666666666666666666666666666\",\"validated_structured_output_cid\":\"sha256:7777777777777777777777777777777777777777777777777777777777777777\",\"version\":\"actql-model-invocation-evidence/0.2\"}", 16384, 1024, 20).unwrap()
  assert_false(run_evidence_value_identity(original) == run_evidence_value_identity(changed))
  let saved = read_model_capture_bundle("{\"barrier_receipts\":[],\"bundle_cid\":\"sha256:93a147d07c8a5de494a595b69acfae9233b077982148fc9b657e26f6cfbdd35d\",\"captures\":[{\"evidence\":{\"attempt\":1,\"authored_model_selector\":\"configured-selector\",\"finish_reason\":\"provider-complete\",\"gateway_request_id\":\"gateway-1\",\"input_result_artifact_cid\":\"sha256:4444444444444444444444444444444444444444444444444444444444444444\",\"input_row_identity\":[\"key\",7],\"input_row_identity_cid\":\"sha256:5555555555555555555555555555555555555555555555555555555555555555\",\"input_tokens\":13,\"model_call_slot_cid\":\"sha256:3333333333333333333333333333333333333333333333333333333333333333\",\"model_invocation_evidence_cid\":\"sha256:062bd3a5fd48b4906177248757293d3c6e24edc4097abe08a436821f9c23b689\",\"model_task_contract_cid\":\"sha256:1111111111111111111111111111111111111111111111111111111111111111\",\"observed_at\":\"2026-10-11T00:00:00.000Z\",\"output_tokens\":null,\"provider_metadata\":{\"provider\":{\"nested\":{\"complete\":false,\"precision\":99,\"retry\":true},\"unknown_extension\":[null,0,false,\"\",\"raw-é\\r\\n\"]}},\"provider_reported_model_id\":\"raw-é\\r\\nmodel\",\"provider_reported_revision\":\"revision-1\",\"provider_request_id\":\"raw-request\",\"raw_response_artifact_cid\":\"sha256:9999999999999999999999999999999999999999999999999999999999999999\",\"response_complete\":true,\"response_profile_cid\":\"sha256:8888888888888888888888888888888888888888888888888888888888888888\",\"semantic_request_cid\":\"sha256:2222222222222222222222222222222222222222222222222222222222222222\",\"structured_response_artifact_cid\":\"sha256:6666666666666666666666666666666666666666666666666666666666666666\",\"validated_structured_output_cid\":\"sha256:7777777777777777777777777777777777777777777777777777777777777777\",\"version\":\"actql-model-invocation-evidence/0.2\"},\"model_call_slot_cid\":\"sha256:3333333333333333333333333333333333333333333333333333333333333333\",\"semantic_request_cid\":\"sha256:2222222222222222222222222222222222222222222222222222222222222222\",\"structured_response\":{\"answer\":\"original-é\\r\\n\"}}],\"version\":\"actql-model-capture-bundle/0.2\"}", "sha256:93a147d07c8a5de494a595b69acfae9233b077982148fc9b657e26f6cfbdd35d", 16384, 1024, 20).unwrap()
  let observed = model_capture_record_observation(model_capture_bundle_record(saved, 0).unwrap()).unwrap()
  assert_eq(observed.raw_response_artifact_cid, Some("sha256:9999999999999999999999999999999999999999999999999999999999999999"))
  assert_eq(observed.response_profile_cid, Some("sha256:8888888888888888888888888888888888888888888888888888888888888888"))
  assert_true(release_model_capture_bundle_read(saved))
}

///|
test "Model replay preserves current observation instead of historical stop" {
  let original = seal_run_evidence_value("model_invocation_evidence", "{\"attempt\":1,\"authored_model_selector\":\"configured-selector\",\"finish_reason\":\"provider-complete\",\"gateway_request_id\":\"gateway-1\",\"input_result_artifact_cid\":\"sha256:4444444444444444444444444444444444444444444444444444444444444444\",\"input_row_identity\":[\"key\",7],\"input_row_identity_cid\":\"sha256:5555555555555555555555555555555555555555555555555555555555555555\",\"input_tokens\":13,\"model_call_slot_cid\":\"sha256:3333333333333333333333333333333333333333333333333333333333333333\",\"model_task_contract_cid\":\"sha256:1111111111111111111111111111111111111111111111111111111111111111\",\"observed_at\":\"2026-10-11T00:00:00.000Z\",\"output_tokens\":11,\"provider_metadata\":{\"provider\":{\"nested\":{\"complete\":false,\"precision\":99,\"retry\":true},\"unknown_extension\":[null,0,false,\"\",\"raw-é\\r\\n\"]}},\"provider_reported_model_id\":\"raw-é\\r\\nmodel\",\"provider_reported_revision\":\"revision-1\",\"provider_request_id\":\"raw-request\",\"raw_response_artifact_cid\":\"sha256:9999999999999999999999999999999999999999999999999999999999999999\",\"response_complete\":true,\"response_profile_cid\":\"sha256:8888888888888888888888888888888888888888888888888888888888888888\",\"semantic_request_cid\":\"sha256:2222222222222222222222222222222222222222222222222222222222222222\",\"structured_response_artifact_cid\":\"sha256:6666666666666666666666666666666666666666666666666666666666666666\",\"validated_structured_output_cid\":\"sha256:7777777777777777777777777777777777777777777777777777777777777777\",\"version\":\"actql-model-invocation-evidence/0.2\"}", 16384, 1024, 20).unwrap()
  let reconstructed = seal_run_evidence_value("model_invocation_evidence", "{\"attempt\":1,\"authored_model_selector\":\"configured-selector\",\"finish_reason\":\"stop\",\"input_result_artifact_cid\":\"sha256:4444444444444444444444444444444444444444444444444444444444444444\",\"input_row_identity\":[\"key\",7],\"input_row_identity_cid\":\"sha256:5555555555555555555555555555555555555555555555555555555555555555\",\"input_tokens\":13,\"model_call_slot_cid\":\"sha256:3333333333333333333333333333333333333333333333333333333333333333\",\"model_task_contract_cid\":\"sha256:1111111111111111111111111111111111111111111111111111111111111111\",\"observed_at\":\"2026-10-11T00:00:00.000Z\",\"output_tokens\":11,\"provider_reported_model_id\":\"raw-é\\r\\nmodel\",\"provider_request_id\":\"raw-request\",\"semantic_request_cid\":\"sha256:2222222222222222222222222222222222222222222222222222222222222222\",\"structured_response_artifact_cid\":\"sha256:6666666666666666666666666666666666666666666666666666666666666666\",\"validated_structured_output_cid\":\"sha256:7777777777777777777777777777777777777777777777777777777777777777\",\"version\":\"actql-model-invocation-evidence/0.1\"}", 16384, 1024, 20).unwrap()
  assert_true(check_model_replayed_observation(original, reconstructed) is Ok(_))
  assert_true(check_model_replayed_observation(reconstructed, reconstructed) is Ok(_))
  assert_false(run_evidence_value_identity(original) == run_evidence_value_identity(reconstructed))
  assert_eq(run_evidence_value_json(original), "{\"attempt\":1,\"authored_model_selector\":\"configured-selector\",\"finish_reason\":\"provider-complete\",\"gateway_request_id\":\"gateway-1\",\"input_result_artifact_cid\":\"sha256:4444444444444444444444444444444444444444444444444444444444444444\",\"input_row_identity\":[\"key\",7],\"input_row_identity_cid\":\"sha256:5555555555555555555555555555555555555555555555555555555555555555\",\"input_tokens\":13,\"model_call_slot_cid\":\"sha256:3333333333333333333333333333333333333333333333333333333333333333\",\"model_invocation_evidence_cid\":\"sha256:501dd91439362a7522d0eab31965ed260d694540ed29525ad1f9005b2f7c1734\",\"model_task_contract_cid\":\"sha256:1111111111111111111111111111111111111111111111111111111111111111\",\"observed_at\":\"2026-10-11T00:00:00.000Z\",\"output_tokens\":11,\"provider_metadata\":{\"provider\":{\"nested\":{\"complete\":false,\"precision\":99,\"retry\":true},\"unknown_extension\":[null,0,false,\"\",\"raw-é\\r\\n\"]}},\"provider_reported_model_id\":\"raw-é\\r\\nmodel\",\"provider_reported_revision\":\"revision-1\",\"provider_request_id\":\"raw-request\",\"raw_response_artifact_cid\":\"sha256:9999999999999999999999999999999999999999999999999999999999999999\",\"response_complete\":true,\"response_profile_cid\":\"sha256:8888888888888888888888888888888888888888888888888888888888888888\",\"semantic_request_cid\":\"sha256:2222222222222222222222222222222222222222222222222222222222222222\",\"structured_response_artifact_cid\":\"sha256:6666666666666666666666666666666666666666666666666666666666666666\",\"validated_structured_output_cid\":\"sha256:7777777777777777777777777777777777777777777777777777777777777777\",\"version\":\"actql-model-invocation-evidence/0.2\"}")
}

