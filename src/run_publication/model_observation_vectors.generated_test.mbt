  let saved = read_model_capture_bundle("{\"barrier_receipts\":[],\"bundle_cid\":\"sha256:18a23b7f5de7b3a27d9ecaaa076467a4f5a51816738f8eed1be5558ec7af2f99\",\"captures\":[{\"evidence\":{\"attempt\":1,\"authored_model_selector\":\"configured-selector\",\"finish_reason\":null,\"gateway_request_id\":null,\"input_result_artifact_cid\":\"sha256:4444444444444444444444444444444444444444444444444444444444444444\",\"input_row_identity\":[\"key\",7],\"input_row_identity_cid\":\"sha256:5555555555555555555555555555555555555555555555555555555555555555\",\"input_tokens\":null,\"model_call_slot_cid\":\"sha256:3333333333333333333333333333333333333333333333333333333333333333\",\"model_invocation_evidence_cid\":\"sha256:22ce3985fb325c7ccf3d4bb38634303e69ae371827e60f23c9b30d7fa3b03364\",\"model_task_contract_cid\":\"sha256:1111111111111111111111111111111111111111111111111111111111111111\",\"observed_at\":\"2026-10-11T00:00:00.000Z\",\"output_tokens\":0,\"provider_metadata\":null,\"provider_reported_model_id\":null,\"provider_reported_revision\":null,\"provider_request_id\":null,\"raw_response_artifact_cid\":null,\"response_complete\":true,\"response_profile_cid\":\"sha256:8888888888888888888888888888888888888888888888888888888888888888\",\"semantic_request_cid\":\"sha256:2222222222222222222222222222222222222222222222222222222222222222\",\"structured_response_artifact_cid\":\"sha256:6666666666666666666666666666666666666666666666666666666666666666\",\"validated_structured_output_cid\":\"sha256:7777777777777777777777777777777777777777777777777777777777777777\",\"version\":\"actql-model-invocation-evidence/0.2\"},\"model_call_slot_cid\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"semantic_request_cid\":\"sha256:2222222222222222222222222222222222222222222222222222222222222222\",\"structured_response\":{\"answer\":\"original-é\\r\\n\"}}],\"version\":\"actql-model-capture-bundle/0.2\"}", "sha256:18a23b7f5de7b3a27d9ecaaa076467a4f5a51816738f8eed1be5558ec7af2f99", 16384, 1024, 20).unwrap()
  assert_true(model_capture_bundle_record(saved, 0) is Err(_))
  assert_true(release_model_capture_bundle_read(saved))
}

