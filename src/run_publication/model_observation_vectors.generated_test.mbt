// Generated from independent scripts/fixtures/model-observation.mjs.

///|
test "Model observation: historical admitted metadata" {
  let evidence = seal_run_evidence_value("model_invocation_evidence", "{\"attempt\":1,\"authored_model_selector\":\"configured-selector\",\"finish_reason\":\"stop\",\"input_result_artifact_cid\":\"sha256:4444444444444444444444444444444444444444444444444444444444444444\",\"input_row_identity\":[\"key\",7],\"input_row_identity_cid\":\"sha256:5555555555555555555555555555555555555555555555555555555555555555\",\"input_tokens\":0,\"model_call_slot_cid\":\"sha256:3333333333333333333333333333333333333333333333333333333333333333\",\"model_task_contract_cid\":\"sha256:1111111111111111111111111111111111111111111111111111111111111111\",\"observed_at\":\"2026-10-11T00:00:00.000Z\",\"output_tokens\":11,\"provider_reported_model_id\":\"historical-model\",\"provider_request_id\":\"historical-request\",\"semantic_request_cid\":\"sha256:2222222222222222222222222222222222222222222222222222222222222222\",\"structured_response_artifact_cid\":\"sha256:6666666666666666666666666666666666666666666666666666666666666666\",\"validated_structured_output_cid\":\"sha256:7777777777777777777777777777777777777777777777777777777777777777\",\"version\":\"actql-model-invocation-evidence/0.1\"}", 16384, 1024, 20).unwrap()
  assert_eq(run_evidence_value_identity(evidence), "sha256:40bf2cab544ebfcf515f9bfd23918a66be40437c6aed3e693d2c9167a40b811e")
  assert_eq(run_evidence_value_json(admit_run_evidence_value("model_invocation_evidence", run_evidence_value_json(evidence), 16384, 1024, 20).unwrap()), run_evidence_value_json(evidence))
  let saved = read_model_capture_bundle("{\"barrier_receipts\":[],\"bundle_cid\":\"sha256:25f2d119434f42cc30f5cc8cc7f34ee5dfc3ee283d70db0a9ea4fc50d5c45a81\",\"captures\":[{\"evidence\":{\"attempt\":1,\"authored_model_selector\":\"configured-selector\",\"finish_reason\":\"stop\",\"input_result_artifact_cid\":\"sha256:4444444444444444444444444444444444444444444444444444444444444444\",\"input_row_identity\":[\"key\",7],\"input_row_identity_cid\":\"sha256:5555555555555555555555555555555555555555555555555555555555555555\",\"input_tokens\":0,\"model_call_slot_cid\":\"sha256:3333333333333333333333333333333333333333333333333333333333333333\",\"model_invocation_evidence_cid\":\"sha256:40bf2cab544ebfcf515f9bfd23918a66be40437c6aed3e693d2c9167a40b811e\",\"model_task_contract_cid\":\"sha256:1111111111111111111111111111111111111111111111111111111111111111\",\"observed_at\":\"2026-10-11T00:00:00.000Z\",\"output_tokens\":11,\"provider_reported_model_id\":\"historical-model\",\"provider_request_id\":\"historical-request\",\"semantic_request_cid\":\"sha256:2222222222222222222222222222222222222222222222222222222222222222\",\"structured_response_artifact_cid\":\"sha256:6666666666666666666666666666666666666666666666666666666666666666\",\"validated_structured_output_cid\":\"sha256:7777777777777777777777777777777777777777777777777777777777777777\",\"version\":\"actql-model-invocation-evidence/0.1\"},\"model_call_slot_cid\":\"sha256:3333333333333333333333333333333333333333333333333333333333333333\",\"semantic_request_cid\":\"sha256:2222222222222222222222222222222222222222222222222222222222222222\",\"structured_response\":{\"answer\":\"original-é\\r\\n\"}}],\"version\":\"actql-model-capture-bundle/0.1\"}", "sha256:25f2d119434f42cc30f5cc8cc7f34ee5dfc3ee283d70db0a9ea4fc50d5c45a81", 16384, 1024, 20).unwrap()
  let value = model_capture_record_observation(model_capture_bundle_record(saved, 0).unwrap()).unwrap()
  assert_eq(value.origin, HistoricalAdmitted)
  assert_eq(value.input_tokens, Some(0L))
  assert_eq(value.output_tokens, Some(11L))
  assert_eq(value.provider_finish_reason, None)
  assert_eq(value.historical_finish_reason, Some("stop"))
  assert_eq(value.response_complete, None)
  assert_eq(value.provider_model, Some("historical-model"))
  assert_true(value.provider_metadata is None)
  assert_true(release_model_capture_bundle_read(saved))
  assert_false(release_model_capture_bundle_read(saved))
}

