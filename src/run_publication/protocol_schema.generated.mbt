///|
fn generated_protocol_schema_root(name : String, complete : Bool) -> Int? {
  match (name, complete) {
    ("run_receipt", false) => Some(136)
    ("run_receipt", true) => Some(274)
    ("captured_run", false) => Some(466)
    ("captured_run", true) => Some(659)
    ("result_delivery_receipt", false) => Some(671)
    ("result_delivery_receipt", true) => Some(684)
    _ => None
  }
}
