///|
fn generated_protocol_schema_root(name : String, complete : Bool) -> Int? {
  match (name, complete) {
    ("bound_invocation_template", false) => Some(12)
    ("bound_invocation_template", true) => Some(26)
    ("prepared_invocation", false) => Some(38)
    ("prepared_invocation", true) => Some(51)
    ("run_authorization", false) => Some(58)
    ("run_authorization", true) => Some(66)
    ("observation_set", false) => Some(87)
    ("observation_set", true) => Some(109)
    ("normalization_journal", false) => Some(118)
    ("normalization_journal", true) => Some(128)
    ("source_evidence", false) => Some(154)
    ("source_evidence", true) => Some(181)
    ("authoring_context", false) => Some(191)
    ("authoring_context", true) => Some(202)
    ("model_invocation_evidence", false) => Some(230)
    ("model_invocation_evidence", true) => Some(259)
    ("run_receipt", false) => Some(407)
    ("run_receipt", true) => Some(556)
    ("captured_run", false) => Some(759)
    ("captured_run", true) => Some(963)
    ("result_delivery_receipt", false) => Some(975)
