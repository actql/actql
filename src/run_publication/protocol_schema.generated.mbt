///|
fn generated_protocol_schema_root(name : String, complete : Bool) -> Int? {
  match (name, complete) {
    ("result_plan", false) => Some(22)
    ("result_plan", true) => Some(46)
    ("bound_invocation_template", false) => Some(59)
    ("bound_invocation_template", true) => Some(73)
    ("prepared_invocation", false) => Some(85)
    ("prepared_invocation", true) => Some(98)
    ("run_authorization", false) => Some(105)
    ("run_authorization", true) => Some(113)
    ("observation_set", false) => Some(134)
    ("observation_set", true) => Some(156)
    ("normalization_journal", false) => Some(165)
    ("normalization_journal", true) => Some(175)
    ("source_evidence", false) => Some(201)
    ("source_evidence", true) => Some(228)
    ("authoring_context", false) => Some(238)
    ("authoring_context", true) => Some(249)
    ("model_invocation_evidence", false) => Some(277)
    ("model_invocation_evidence", true) => Some(306)
    ("run_receipt", false) => Some(454)
    ("run_receipt", true) => Some(603)
    ("captured_run", false) => Some(824)
    ("captured_run", true) => Some(1046)
    ("result_delivery_receipt", false) => Some(1058)
    ("result_delivery_receipt", true) => Some(1071)
    ("effect_preview", false) => Some(1163)
    ("effect_preview", true) => Some(1269)
    ("effect_source_artifact", false) => Some(1283)
    ("effect_source_artifact", true) => Some(1298)
    ("effect_row_outcome_receipt", false) => Some(1344)
    ("effect_row_outcome_receipt", true) => Some(1391)
    ("effect_apply_receipt", false) => Some(1444)
    ("effect_apply_receipt", true) => Some(1498)
    ("effect_set_apply_receipt", false) => Some(1516)
    ("effect_set_apply_receipt", true) => Some(1535)
    ("effect_reconciliation_receipt", false) => Some(1636)
    ("effect_reconciliation_receipt", true) => Some(1738)
    ("effect_outcome", true) => Some(1782)
    _ => None
  }
