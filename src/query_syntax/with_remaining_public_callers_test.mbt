    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , combined AS (FROM g |> union_graphs(with: [g, g], merge: {`Node_Properties`: {P: 'number_sum'}, `Edge_Properties`: {W: 'number_sum'}})) FROM combined |> node_rows() |> SELECT p, part, node_key, labels |> RESULT nodes",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , combined AS (FROM g |> union_graphs(with: [g, g], merge: {`Node_Properties`: {P: 'number_sum'}, `Edge_Properties`: {W: 'number_sum'}})) FROM combined |> edge_rows() |> SELECT w, part, edge_key, labels |> ORDER BY edge_key |> RESULT edges",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , combined AS (FROM g |> union_graphs(with: g, merge: {node_properties: {p: 'number_sum'}, edge_properties: {w: 'number_sum'}})) FROM combined |> node_rows() |> SELECT p, part, node_key, labels |> RESULT nodes",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , combined AS (FROM g |> union_graphs(with: g, merge: {node_properties: {p: 'number_sum'}, edge_properties: {w: 'number_sum'}})) FROM combined |> edge_rows() |> SELECT w, part, edge_key, labels |> ORDER BY edge_key |> RESULT edges",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , `peer graph` AS (FROM g) , combined AS (FROM g |> union_graphs(with: `peer graph`, merge: {node_properties: {p: 'number_sum'}, edge_properties: {w: 'number_sum'}})) FROM combined |> node_rows() |> SELECT p, part, node_key, labels |> RESULT nodes",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , `peer graph` AS (FROM g) , combined AS (FROM g |> union_graphs(with: `peer graph`, merge: {node_properties: {p: 'number_sum'}, edge_properties: {w: 'number_sum'}})) FROM combined |> edge_rows() |> SELECT w, part, edge_key, labels |> ORDER BY edge_key |> RESULT edges",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , doubled AS (FROM g |> union_graphs(with: g, merge: {node_properties: {p: 'number_sum'}, edge_properties: {w: 'number_sum'}})) , combined AS (FROM g |> union_graphs(with: [doubled, g], merge: {node_properties: {p: 'number_mean'}, edge_properties: {w: 'number_mean'}})) FROM combined |> node_rows() |> SELECT p, part, node_key, labels |> RESULT nodes",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , doubled AS (FROM g |> union_graphs(with: g, merge: {node_properties: {p: 'number_sum'}, edge_properties: {w: 'number_sum'}})) , combined AS (FROM g |> union_graphs(with: [doubled, g], merge: {node_properties: {p: 'number_mean'}, edge_properties: {w: 'number_mean'}})) FROM combined |> edge_rows() |> SELECT w, part, edge_key, labels |> ORDER BY edge_key |> RESULT edges",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , doubled AS (FROM g |> union_graphs(with: g, merge: {node_properties: {p: 'number_sum'}, edge_properties: {w: 'number_sum'}})) , combined AS (FROM g |> union_graphs(with: [g, doubled], merge: {node_properties: {p: 'number_mean'}, edge_properties: {w: 'number_mean'}})) FROM combined |> node_rows() |> SELECT p, part, node_key, labels |> RESULT nodes",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , doubled AS (FROM g |> union_graphs(with: g, merge: {node_properties: {p: 'number_sum'}, edge_properties: {w: 'number_sum'}})) , combined AS (FROM g |> union_graphs(with: [g, doubled], merge: {node_properties: {p: 'number_mean'}, edge_properties: {w: 'number_mean'}})) FROM combined |> edge_rows() |> SELECT w, part, edge_key, labels |> ORDER BY edge_key |> RESULT edges",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) FROM g |> union_graphs(with: [g, g], merge: {node_properties: {p: 'number_sum'}, edge_properties: {w: 'number_sum'}}) |> edge_rows(definition: 'E') |> WHERE w > 10 |> SELECT edge_key, w |> ORDER BY edge_key |> LIMIT 1 |> RESULT selected",
  ] {
    let script = parse_query_script(text, query_limits()).unwrap()
    assert_true(query_binding_count(script_query(script)) > 0)
  }
}

///|
test "WITH current group-property public source parses" {
  for text in [
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score, COUNT(*) AS n FROM objects GROUP BY payload.score HAVING score > 10 ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score, COUNT(*) AS n FROM objects GROUP BY score HAVING score + 1 > 11 ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT objects.payload.score, COUNT(*) AS n FROM objects GROUP BY score HAVING score > 10 ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT (payload).score, COUNT(*) AS n FROM objects GROUP BY score HAVING score > 10 ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT `objects`.`payload`.`score`, COUNT(*) AS n FROM objects GROUP BY `SCORE` HAVING `SCORE` > 10 ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score, COUNT(*) AS n FROM objects GROUP BY score HAVING COUNT(score) > 1 ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) (WITH summary AS (SELECT payload.score, COUNT(*) AS n FROM objects GROUP BY score HAVING score > 10) SELECT score, n FROM summary ORDER BY score)",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT l.payload.score, COUNT(*) AS n FROM objects AS l JOIN objects AS r ON l.id = r.id MAX_OUTPUT_ROWS 10 GROUP BY score HAVING score > 10 ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, (@wrapper).payload, COUNT(*) AS n FROM objects GROUP BY objects.payload.score + 1 HAVING payload.score + 1 > 12 ORDER BY bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, (@wrapper).payload, COUNT(*) AS n FROM objects GROUP BY objects.payload.score + 1 HAVING objects.payload.score + 1 > 12 ORDER BY bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score, COUNT(*) AS n FROM objects WHERE FALSE GROUP BY score HAVING score > 10 ORDER BY score",
    "WITH colliding AS (SELECT 1 AS id, 100 AS score, @a AS payload UNION ALL SELECT 2 AS id, 0 AS score, @b AS payload) SELECT payload.score, COUNT(*) AS n FROM colliding GROUP BY score, colliding.score HAVING score > 10 ORDER BY score",
    "WITH colliding AS (SELECT 1 AS id, 100 AS score, @a AS payload UNION ALL SELECT 2 AS id, 0 AS score, @b AS payload) SELECT payload.score, COUNT(*) AS n FROM colliding GROUP BY score, colliding.score HAVING colliding.score > 10 ORDER BY score",
    "WITH colliding AS (SELECT 1 AS id, 100 AS score, @a AS payload UNION ALL SELECT 2 AS id, 0 AS score, @b AS payload) SELECT payload.score, COUNT(*) AS n FROM colliding WHERE score > 10 GROUP BY score ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score, COUNT(*) AS n FROM objects GROUP BY payload.score HAVING score > 10 ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score, COUNT(*) AS n FROM objects GROUP BY score HAVING score + 1 > 11 ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT objects.payload.score, COUNT(*) AS n FROM objects GROUP BY score HAVING score > 10 ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT (payload).score, COUNT(*) AS n FROM objects GROUP BY score HAVING score > 10 ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT `objects`.`payload`.`score`, COUNT(*) AS n FROM objects GROUP BY `SCORE` HAVING `SCORE` > 10 ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score, COUNT(*) AS n FROM objects GROUP BY score HAVING COUNT(score) > 1 ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) (WITH summary AS (SELECT payload.score, COUNT(*) AS n FROM objects GROUP BY score HAVING score > 10) SELECT score, n FROM summary ORDER BY score)",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT l.payload.score, COUNT(*) AS n FROM objects AS l JOIN objects AS r ON l.id = r.id MAX_OUTPUT_ROWS 10 GROUP BY score HAVING score > 10 ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, (@wrapper).payload, COUNT(*) AS n FROM objects GROUP BY objects.payload.score + 1 HAVING payload.score + 1 > 12 ORDER BY bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, (@wrapper).payload, COUNT(*) AS n FROM objects GROUP BY objects.payload.score + 1 HAVING objects.payload.score + 1 > 12 ORDER BY bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score, COUNT(*) AS n FROM objects WHERE FALSE GROUP BY score HAVING score > 10 ORDER BY score",
    "WITH colliding AS (SELECT 1 AS id, 100 AS score, @a AS payload UNION ALL SELECT 2 AS id, 0 AS score, @b AS payload) SELECT payload.score, COUNT(*) AS n FROM colliding GROUP BY score, colliding.score HAVING score > 10 ORDER BY score",
    "WITH colliding AS (SELECT 1 AS id, 100 AS score, @a AS payload UNION ALL SELECT 2 AS id, 0 AS score, @b AS payload) SELECT payload.score, COUNT(*) AS n FROM colliding GROUP BY score, colliding.score HAVING colliding.score > 10 ORDER BY score",
    "WITH colliding AS (SELECT 1 AS id, 100 AS score, @a AS payload UNION ALL SELECT 2 AS id, 0 AS score, @b AS payload) SELECT payload.score, COUNT(*) AS n FROM colliding WHERE score > 10 GROUP BY score ORDER BY score",
    "WITH samples AS (SELECT 1 AS x UNION ALL SELECT 2 AS x UNION ALL SELECT 1 AS x UNION ALL SELECT 1 AS x UNION ALL SELECT 1 AS x) SELECT x + 1 AS bucket, COUNT(*) AS n FROM samples GROUP BY x + 1 ORDER BY n + (samples.x + 1)",
    "WITH samples AS (SELECT 1 AS x UNION ALL SELECT 2 AS x UNION ALL SELECT 1 AS x UNION ALL SELECT 1 AS x UNION ALL SELECT 1 AS x) SELECT COUNT(*) AS n FROM samples GROUP BY x + 1 ORDER BY n + (samples.x + 1)",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, COUNT(*) AS n FROM objects GROUP BY payload.score + 1 ORDER BY COUNT(*) - (`objects`.`payload`.`score` + 1) NULLS FIRST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT DISTINCT payload.score + 1 AS bucket, COUNT(*) AS n FROM objects GROUP BY payload.score + 1 ORDER BY n - (objects.payload.score + 1) NULLS FIRST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, @b AS payload, COUNT(*) AS n FROM objects GROUP BY objects.payload.score + 1 ORDER BY payload.score + 1 NULLS LAST, bucket DESC NULLS LAST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, @b AS payload, COUNT(*) AS n FROM objects GROUP BY objects.payload.score + 1 ORDER BY objects.payload.score + 1 NULLS LAST, bucket DESC NULLS LAST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT l.payload.score + 1 AS bucket, COUNT(*) AS n FROM objects AS l JOIN objects AS r ON l.id = r.id MAX_OUTPUT_ROWS 10 GROUP BY l.payload.score + 1 ORDER BY n - (l.payload.score + 1) NULLS FIRST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) , shaped AS (SELECT id AS score, other AS payload FROM objects) SELECT (payload).score, COUNT(*) AS n FROM shaped GROUP BY (payload).score, score + 1 ORDER BY score + 1",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, COUNT(*) AS n FROM objects WHERE FALSE GROUP BY payload.score + 1 ORDER BY n + (objects.payload.score + 1)",
    "WITH samples AS (SELECT 2 AS x UNION ALL SELECT 1 AS x) SELECT -x AS x, COUNT(*) AS n FROM samples GROUP BY samples.x ORDER BY x + 1",
    "WITH samples AS (SELECT 2 AS x UNION ALL SELECT 1 AS x) SELECT -x AS x, COUNT(*) AS n FROM samples GROUP BY samples.x ORDER BY samples.x + 1",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score, COUNT(*) AS n FROM objects GROUP BY payload.score ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT objects.payload.score, COUNT(*) AS n FROM objects GROUP BY payload.score ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT `objects`.`payload`.`SCORE`, COUNT(*) AS n FROM objects GROUP BY objects.payload.score ORDER BY `SCORE` NULLS LAST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT id, payload.score, COUNT(*) AS n, ROW_NUMBER() OVER (ORDER BY id) AS rank FROM objects GROUP BY id, payload.score QUALIFY score > 10 AND rank > 0 ORDER BY id",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT l.id, l.payload.score, COUNT(*) AS n, ROW_NUMBER() OVER (ORDER BY l.id) AS rank FROM objects AS l JOIN objects AS r ON l.id = r.id MAX_OUTPUT_ROWS 10 GROUP BY l.id, l.payload.score QUALIFY score > 10 AND rank > 0 ORDER BY id",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) (WITH summary AS (SELECT payload.score, COUNT(*) AS n FROM objects GROUP BY payload.score) SELECT score, n FROM summary ORDER BY score)",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT l.payload.score, COUNT(*) AS n FROM objects AS l JOIN objects AS r ON l.id = r.id MAX_OUTPUT_ROWS 10 GROUP BY l.payload.score ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score, COUNT(*) AS n FROM objects WHERE id > @cut GROUP BY payload.score ORDER BY score DESC NULLS LAST LIMIT 1",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score, COUNT(*) AS n FROM objects WHERE FALSE GROUP BY payload.score ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, COUNT(*) AS n FROM objects GROUP BY payload.score + 1 HAVING n + (objects.payload.score + 1) > 12 ORDER BY bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, COUNT(*) AS n FROM objects GROUP BY objects.payload.score + 1 HAVING COUNT(*) + (`objects`.`payload`.`score` + 1) > 12 ORDER BY bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS payload, COUNT(*) AS n FROM objects GROUP BY objects.payload.score + 1 HAVING payload + 1 > 12 ORDER BY payload",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, @b AS payload, COUNT(*) AS n FROM objects GROUP BY objects.payload.score + 1 HAVING payload.score + 1 > 12 ORDER BY bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, @b AS payload, COUNT(*) AS n FROM objects GROUP BY objects.payload.score + 1 HAVING objects.payload.score + 1 > 12 ORDER BY bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT l.payload.score + 1 AS bucket, COUNT(*) AS n FROM objects AS l JOIN objects AS r ON l.id = r.id MAX_OUTPUT_ROWS 10 GROUP BY l.payload.score + 1 HAVING n + (l.payload.score + 1) > 12 ORDER BY bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, COUNT(*) AS n FROM objects WHERE FALSE GROUP BY payload.score + 1 HAVING n + (payload.score + 1) > 12 ORDER BY bucket",
    "WITH samples AS (SELECT 2 AS x UNION ALL SELECT 1 AS x) SELECT -x AS x, COUNT(*) AS n FROM samples GROUP BY samples.x HAVING x + 1 > 0 ORDER BY x",
    "WITH samples AS (SELECT 2 AS x UNION ALL SELECT 1 AS x) SELECT -x AS x, COUNT(*) AS n FROM samples GROUP BY samples.x HAVING samples.x + 1 > 0 ORDER BY x",
    "WITH samples AS (SELECT 100 AS aql_having_aggregate_0) SELECT COUNT(*) AS n FROM samples GROUP BY aql_having_aggregate_0 + 1 HAVING COUNT(*) + 1 > 10",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, COUNT(*) + (objects.payload.score + 1) AS n FROM objects GROUP BY payload.score + 1 ORDER BY bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score AS bucket, COUNT(*) + objects.payload.score AS n FROM objects GROUP BY payload.score ORDER BY bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS payload, COUNT(*) + (objects.payload.score + 1) AS n FROM objects GROUP BY objects.payload.score + 1 ORDER BY payload NULLS LAST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, COUNT(*) + (objects.payload.score + 1) AS n FROM objects WHERE id < 5 GROUP BY payload.score + 1 HAVING n > 11 ORDER BY bucket DESC NULLS LAST LIMIT 1",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT objects.payload.score + 1 AS bucket, COUNT(*) + (objects.payload.score + 1) AS n FROM objects JOIN objects AS matched ON objects.id = matched.id MAX_OUTPUT_ROWS 10 GROUP BY objects.payload.score + 1 ORDER BY bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) (WITH summary AS (SELECT payload.score + 1 AS bucket, COUNT(*) + (objects.payload.score + 1) AS n FROM objects GROUP BY payload.score + 1) SELECT bucket, n FROM summary ORDER BY bucket)",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, COUNT(*) + (objects.payload.score + 1) AS n FROM objects WHERE FALSE GROUP BY payload.score + 1 ORDER BY bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, COUNT(*) + (payload.score + 1) + (objects.payload.score + 1) AS n FROM objects GROUP BY payload.score + 1 ORDER BY bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) + 1 AS n GROUP AND ORDER BY payload.score AS bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) + COUNT(*) AS n GROUP AND ORDER BY payload.score AS bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) + objects.payload.score AS n GROUP AND ORDER BY payload.score AS bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) + (objects.payload.score + 1) AS n GROUP AND ORDER BY payload.score + 1 AS bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) + id AS id GROUP AND ORDER BY id AS original",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) AS id GROUP AND ORDER BY id AS original",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) + 1 AS n DESC GROUP BY payload.score AS bucket DESC NULLS LAST |> WHERE n > 2 |> LIMIT 1",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> WHERE FALSE |> AGGREGATE COALESCE(SUM(id), 0) + 1 AS n",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> WHERE FALSE |> AGGREGATE COUNT(*) + 1 AS n GROUP BY id AS original",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) AS n GROUP AND ORDER BY payload.score AS bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) AS n GROUP BY payload.score AS bucket NULLS LAST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) AS n GROUP AND ORDER BY payload.score AS bucket DESC NULLS FIRST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) AS n DESC GROUP BY payload.score AS bucket ASC NULLS LAST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) AS n GROUP AND ORDER BY payload.score + 1 AS bucket DESC NULLS LAST |> WHERE bucket > 10 |> LIMIT 1",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> WHERE FALSE |> AGGREGATE GROUP AND ORDER BY payload.score AS bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) AS n GROUP AND ORDER BY payload.score AS first DESC NULLS LAST, payload.score AS second",
    "WITH samples AS (SELECT 2 AS x UNION ALL SELECT 1 AS x UNION ALL SELECT 2 AS x UNION ALL SELECT 3 AS x UNION ALL SELECT 2 AS x UNION ALL SELECT 1 AS x) FROM samples |> AGGREGATE COUNT(*) AS n DESC GROUP BY x",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) AS n GROUP BY payload.score AS bucket |> ORDER BY bucket NULLS FIRST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) AS n GROUP BY payload.score `GROUP` |> ORDER BY `GROUP` NULLS FIRST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> WHERE FALSE |> AGGREGATE GROUP BY payload.score AS bucket |> ORDER BY bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) AS n GROUP BY payload.score AS id, id AS original_id |> ORDER BY original_id",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) AS n GROUP BY payload.score AS first, payload.score AS second |> ORDER BY first NULLS FIRST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects AS before |> SET payload = other |> AGGREGATE COUNT(*) AS n GROUP BY before.payload.score AS bucket |> ORDER BY bucket NULLS FIRST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) AS n GROUP BY payload.score + 1 AS bucket |> WHERE bucket > 15 |> ORDER BY bucket |> LIMIT 1",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE GROUP BY () |> EXTEND 1 AS marker",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> WHERE FALSE |> AGGREGATE GROUP BY () |> EXTEND 1 AS marker",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE GROUP BY payload.score |> ORDER BY score NULLS FIRST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects AS original |> AGGREGATE GROUP BY original.payload.score |> WHERE score > 10 |> ORDER BY score DESC |> LIMIT 1",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> WHERE FALSE |> AGGREGATE GROUP BY payload.score |> ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE GROUP BY id, payload.score |> ORDER BY id",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score AS score, COUNT(*) AS n FROM objects GROUP BY payload.score ORDER BY score NULLS FIRST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT objects.payload.score AS score, COUNT(*) AS n FROM objects GROUP BY payload.score HAVING score IS NOT NULL ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects AS before |> AGGREGATE COUNT(*) AS n GROUP BY before.payload.score |> ORDER BY score NULLS FIRST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects AS before |> SET payload = other |> AGGREGATE COUNT(*) AS n GROUP BY before.payload.score |> ORDER BY score NULLS FIRST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects AS before |> SET payload = other |> AGGREGATE COUNT(*) AS n GROUP BY payload.score |> ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score AS score, COUNT(*) AS n FROM objects WHERE id > 99 GROUP BY score ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT `objects`.`payload`.`score` AS score, COUNT(*) AS n FROM objects WHERE id > @cut GROUP BY 1 ORDER BY score NULLS LAST LIMIT 2 OFFSET 1",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) AS n GROUP BY (payload).score |> ORDER BY score NULLS FIRST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects AS before |> AGGREGATE COUNT(*) AS n GROUP BY (before.`payload`).`score` |> ORDER BY score NULLS FIRST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) AS n GROUP BY (IF(TRUE, payload, NULL)).score |> ORDER BY score NULLS FIRST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects AS before |> SET payload = other |> AGGREGATE COUNT(*) AS n GROUP BY (before.payload).score |> ORDER BY score NULLS FIRST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects AS before |> SET payload = other |> AGGREGATE COUNT(*) AS n GROUP BY (payload).score |> ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) AS n GROUP BY (payload).score |> WHERE score > 10 |> ORDER BY score DESC |> LIMIT 1 |> SELECT score, n",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> WHERE FALSE |> AGGREGATE COUNT(*) AS n GROUP BY (payload).score |> ORDER BY score NULLS FIRST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score, COUNT(*) AS n FROM objects GROUP BY payload.score ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT objects.payload.score, COUNT(*) AS n FROM objects GROUP BY payload.score ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT `objects`.`payload`.`SCORE`, COUNT(*) AS n FROM objects GROUP BY objects.payload.score ORDER BY `SCORE` NULLS LAST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT id, payload.score, COUNT(*) AS n, ROW_NUMBER() OVER (ORDER BY id) AS rank FROM objects GROUP BY id, payload.score QUALIFY score > 10 AND rank > 0 ORDER BY id",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT l.id, l.payload.score, COUNT(*) AS n, ROW_NUMBER() OVER (ORDER BY l.id) AS rank FROM objects AS l JOIN objects AS r ON l.id = r.id MAX_OUTPUT_ROWS 10 GROUP BY l.id, l.payload.score QUALIFY score > 10 AND rank > 0 ORDER BY id",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) (WITH summary AS (SELECT payload.score, COUNT(*) AS n FROM objects GROUP BY payload.score) SELECT score, n FROM summary ORDER BY score)",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT l.payload.score, COUNT(*) AS n FROM objects AS l JOIN objects AS r ON l.id = r.id MAX_OUTPUT_ROWS 10 GROUP BY l.payload.score ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score, COUNT(*) AS n FROM objects WHERE id > @cut GROUP BY payload.score ORDER BY score DESC NULLS LAST LIMIT 1",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score, COUNT(*) AS n FROM objects WHERE FALSE GROUP BY payload.score ORDER BY score",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, COUNT(*) AS n FROM objects GROUP BY payload.score + 1 HAVING n + (objects.payload.score + 1) > 12 ORDER BY bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, COUNT(*) AS n FROM objects GROUP BY objects.payload.score + 1 HAVING COUNT(*) + (`objects`.`payload`.`score` + 1) > 12 ORDER BY bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS payload, COUNT(*) AS n FROM objects GROUP BY objects.payload.score + 1 HAVING payload + 1 > 12 ORDER BY payload",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, @b AS payload, COUNT(*) AS n FROM objects GROUP BY objects.payload.score + 1 HAVING payload.score + 1 > 12 ORDER BY bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, @b AS payload, COUNT(*) AS n FROM objects GROUP BY objects.payload.score + 1 HAVING objects.payload.score + 1 > 12 ORDER BY bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT l.payload.score + 1 AS bucket, COUNT(*) AS n FROM objects AS l JOIN objects AS r ON l.id = r.id MAX_OUTPUT_ROWS 10 GROUP BY l.payload.score + 1 HAVING n + (l.payload.score + 1) > 12 ORDER BY bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, COUNT(*) AS n FROM objects WHERE FALSE GROUP BY payload.score + 1 HAVING n + (payload.score + 1) > 12 ORDER BY bucket",
    "WITH samples AS (SELECT 2 AS x UNION ALL SELECT 1 AS x) SELECT -x AS x, COUNT(*) AS n FROM samples GROUP BY samples.x HAVING x + 1 > 0 ORDER BY x",
    "WITH samples AS (SELECT 2 AS x UNION ALL SELECT 1 AS x) SELECT -x AS x, COUNT(*) AS n FROM samples GROUP BY samples.x HAVING samples.x + 1 > 0 ORDER BY x",
    "WITH samples AS (SELECT 100 AS aql_having_aggregate_0) SELECT COUNT(*) AS n FROM samples GROUP BY aql_having_aggregate_0 + 1 HAVING COUNT(*) + 1 > 10",
    "WITH samples AS (SELECT 1 AS x UNION ALL SELECT 2 AS x UNION ALL SELECT 1 AS x UNION ALL SELECT 1 AS x UNION ALL SELECT 1 AS x) SELECT x + 1 AS bucket, COUNT(*) AS n FROM samples GROUP BY x + 1 ORDER BY n + (samples.x + 1)",
    "WITH samples AS (SELECT 1 AS x UNION ALL SELECT 2 AS x UNION ALL SELECT 1 AS x UNION ALL SELECT 1 AS x UNION ALL SELECT 1 AS x) SELECT COUNT(*) AS n FROM samples GROUP BY x + 1 ORDER BY n + (samples.x + 1)",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, COUNT(*) AS n FROM objects GROUP BY payload.score + 1 ORDER BY COUNT(*) - (`objects`.`payload`.`score` + 1) NULLS FIRST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT DISTINCT payload.score + 1 AS bucket, COUNT(*) AS n FROM objects GROUP BY payload.score + 1 ORDER BY n - (objects.payload.score + 1) NULLS FIRST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, @b AS payload, COUNT(*) AS n FROM objects GROUP BY objects.payload.score + 1 ORDER BY payload.score + 1 NULLS LAST, bucket DESC NULLS LAST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, @b AS payload, COUNT(*) AS n FROM objects GROUP BY objects.payload.score + 1 ORDER BY objects.payload.score + 1 NULLS LAST, bucket DESC NULLS LAST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT l.payload.score + 1 AS bucket, COUNT(*) AS n FROM objects AS l JOIN objects AS r ON l.id = r.id MAX_OUTPUT_ROWS 10 GROUP BY l.payload.score + 1 ORDER BY n - (l.payload.score + 1) NULLS FIRST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) , shaped AS (SELECT id AS score, other AS payload FROM objects) SELECT (payload).score, COUNT(*) AS n FROM shaped GROUP BY (payload).score, score + 1 ORDER BY score + 1",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, COUNT(*) AS n FROM objects WHERE FALSE GROUP BY payload.score + 1 ORDER BY n + (objects.payload.score + 1)",
    "WITH samples AS (SELECT 2 AS x UNION ALL SELECT 1 AS x) SELECT -x AS x, COUNT(*) AS n FROM samples GROUP BY samples.x ORDER BY x + 1",
    "WITH samples AS (SELECT 2 AS x UNION ALL SELECT 1 AS x) SELECT -x AS x, COUNT(*) AS n FROM samples GROUP BY samples.x ORDER BY samples.x + 1",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) + 1 AS n GROUP AND ORDER BY payload.score AS bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) + COUNT(*) AS n GROUP AND ORDER BY payload.score AS bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) + objects.payload.score AS n GROUP AND ORDER BY payload.score AS bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) + (objects.payload.score + 1) AS n GROUP AND ORDER BY payload.score + 1 AS bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) + id AS id GROUP AND ORDER BY id AS original",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) AS id GROUP AND ORDER BY id AS original",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) + 1 AS n DESC GROUP BY payload.score AS bucket DESC NULLS LAST |> WHERE n > 2 |> LIMIT 1",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> WHERE FALSE |> AGGREGATE COALESCE(SUM(id), 0) + 1 AS n",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> WHERE FALSE |> AGGREGATE COUNT(*) + 1 AS n GROUP BY id AS original",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) AS n GROUP AND ORDER BY payload.score AS bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) AS n GROUP BY payload.score AS bucket NULLS LAST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) AS n GROUP AND ORDER BY payload.score AS bucket DESC NULLS FIRST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) AS n DESC GROUP BY payload.score AS bucket ASC NULLS LAST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) AS n GROUP AND ORDER BY payload.score + 1 AS bucket DESC NULLS LAST |> WHERE bucket > 10 |> LIMIT 1",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> WHERE FALSE |> AGGREGATE GROUP AND ORDER BY payload.score AS bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) FROM objects |> AGGREGATE COUNT(*) AS n GROUP AND ORDER BY payload.score AS first DESC NULLS LAST, payload.score AS second",
    "WITH samples AS (SELECT 2 AS x UNION ALL SELECT 1 AS x UNION ALL SELECT 2 AS x UNION ALL SELECT 3 AS x UNION ALL SELECT 2 AS x UNION ALL SELECT 1 AS x) FROM samples |> AGGREGATE COUNT(*) AS n DESC GROUP BY x",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, COUNT(*) + (objects.payload.score + 1) AS n FROM objects GROUP BY payload.score + 1 ORDER BY bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score AS bucket, COUNT(*) + objects.payload.score AS n FROM objects GROUP BY payload.score ORDER BY bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS payload, COUNT(*) + (objects.payload.score + 1) AS n FROM objects GROUP BY objects.payload.score + 1 ORDER BY payload NULLS LAST",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, COUNT(*) + (objects.payload.score + 1) AS n FROM objects WHERE id < 5 GROUP BY payload.score + 1 HAVING n > 11 ORDER BY bucket DESC NULLS LAST LIMIT 1",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT objects.payload.score + 1 AS bucket, COUNT(*) + (objects.payload.score + 1) AS n FROM objects JOIN objects AS matched ON objects.id = matched.id MAX_OUTPUT_ROWS 10 GROUP BY objects.payload.score + 1 ORDER BY bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) (WITH summary AS (SELECT payload.score + 1 AS bucket, COUNT(*) + (objects.payload.score + 1) AS n FROM objects GROUP BY payload.score + 1) SELECT bucket, n FROM summary ORDER BY bucket)",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, COUNT(*) + (objects.payload.score + 1) AS n FROM objects WHERE FALSE GROUP BY payload.score + 1 ORDER BY bucket",
    "WITH objects AS (SELECT 2 AS id, @a AS payload, @oa AS other UNION ALL SELECT 1 AS id, @b AS payload, @ob AS other UNION ALL SELECT 3 AS id, @c AS payload, @oc AS other UNION ALL SELECT 4 AS id, @d AS payload, @od AS other UNION ALL SELECT 5 AS id, @e AS payload, @oe AS other) SELECT payload.score + 1 AS bucket, COUNT(*) + (payload.score + 1) + (objects.payload.score + 1) AS n FROM objects GROUP BY payload.score + 1 ORDER BY bucket",
  ] {
    let script = parse_query_script(text, query_limits()).unwrap()
    assert_true(query_binding_count(script_query(script)) > 0)
  }
}

///|
test "WITH current group-select-scope public source parses" {
  for text in [
    "WITH colliding AS (SELECT amount AS x, id AS aql_group_key_0 FROM records WHERE id > 0) SELECT x + 1 AS bucket, COUNT(*) AS n FROM colliding GROUP BY x + 1 ORDER BY bucket",
    "WITH colliding AS (SELECT amount AS x, id AS `AQL_GROUP_KEY_0` FROM records WHERE id > 0) SELECT x + 1 AS bucket, COUNT(*) AS n FROM colliding GROUP BY x + 1 ORDER BY bucket",
    "WITH colliding AS (SELECT amount AS x, id AS aql_group_key_0 FROM records WHERE id > 0) SELECT x + 1 AS bucket, COUNT(*) AS n FROM colliding GROUP BY ALL ORDER BY bucket",
    "WITH colliding AS (SELECT amount AS x, id AS aql_group_key_0 FROM records WHERE id > 0) FROM colliding AS original |> AGGREGATE COUNT(*) AS n GROUP BY x + 1 AS bucket |> ORDER BY bucket",
    "WITH colliding AS (SELECT amount AS x FROM records WHERE id > 0) SELECT x + 1 AS bucket, COUNT(*) AS aql_group_key_0 FROM colliding GROUP BY x + 1 ORDER BY bucket",
    "WITH colliding AS (SELECT amount AS x, id AS aql_group_key_0 FROM records WHERE id > 0) SELECT x + 1 AS bucket, COUNT(*) AS n FROM colliding GROUP BY x + 1 ORDER BY bucket",
  ] {
    let script = parse_query_script(text, query_limits()).unwrap()
    assert_true(query_binding_count(script_query(script)) > 0)
  }
}

///|
test "WITH current join-property public source parses" {
  for text in [
    "WITH seed AS (SELECT 1 AS unit) , objects AS (SELECT 2 AS id, @a AS payload FROM seed UNION ALL SELECT 1 AS id, @b AS payload FROM seed UNION ALL SELECT 3 AS id, @c AS payload FROM seed) , others AS (SELECT 1 AS id, @oa AS other FROM seed UNION ALL SELECT 2 AS id, @ob AS other FROM seed UNION ALL SELECT 3 AS id, @oc AS other FROM seed UNION ALL SELECT 2 AS id, @od AS other FROM seed) SELECT l.id, l.payload.score FROM objects AS l JOIN others AS r ON l.id = r.id MAX_OUTPUT_ROWS 12 ORDER BY l.id",
    "WITH seed AS (SELECT 1 AS unit) , objects AS (SELECT 2 AS id, @a AS payload FROM seed UNION ALL SELECT 1 AS id, @b AS payload FROM seed UNION ALL SELECT 3 AS id, @c AS payload FROM seed) , others AS (SELECT 1 AS id, @oa AS other FROM seed UNION ALL SELECT 2 AS id, @ob AS other FROM seed UNION ALL SELECT 3 AS id, @oc AS other FROM seed UNION ALL SELECT 2 AS id, @od AS other FROM seed) FROM objects AS l |> JOIN others AS r ON l.id = r.id MAX_OUTPUT_ROWS 12 |> SELECT l.id, l.`payload`.`score` |> ORDER BY id",
    "WITH seed AS (SELECT 1 AS unit) , objects AS (SELECT 2 AS id, @a AS payload FROM seed UNION ALL SELECT 1 AS id, @b AS payload FROM seed UNION ALL SELECT 3 AS id, @c AS payload FROM seed) , others AS (SELECT 1 AS id, @oa AS other FROM seed UNION ALL SELECT 2 AS id, @ob AS other FROM seed UNION ALL SELECT 3 AS id, @oc AS other FROM seed UNION ALL SELECT 2 AS id, @od AS other FROM seed) SELECT l.id, r.other AS payload FROM objects AS l JOIN others AS r ON l.id = r.id MAX_OUTPUT_ROWS 12 WHERE payload.score > 15 ORDER BY payload.score",
    "WITH seed AS (SELECT 1 AS unit) , objects AS (SELECT 2 AS id, @a AS payload FROM seed UNION ALL SELECT 1 AS id, @b AS payload FROM seed UNION ALL SELECT 3 AS id, @c AS payload FROM seed) , others AS (SELECT 1 AS id, @oa AS other FROM seed UNION ALL SELECT 2 AS id, @ob AS other FROM seed UNION ALL SELECT 3 AS id, @oc AS other FROM seed UNION ALL SELECT 2 AS id, @od AS other FROM seed) SELECT l.id, payload.score AS original_score, r.other AS payload FROM objects AS l JOIN others AS r ON l.id = r.id MAX_OUTPUT_ROWS 12 ORDER BY payload.score NULLS LAST",
    "WITH seed AS (SELECT 1 AS unit) , objects AS (SELECT 2 AS id, @a AS payload FROM seed UNION ALL SELECT 1 AS id, @b AS payload FROM seed UNION ALL SELECT 3 AS id, @c AS payload FROM seed) , others AS (SELECT 1 AS id, @oa AS other FROM seed UNION ALL SELECT 2 AS id, @ob AS other FROM seed UNION ALL SELECT 3 AS id, @oc AS other FROM seed UNION ALL SELECT 2 AS id, @od AS other FROM seed) SELECT l.id, payload.score AS original_score, r.other AS payload FROM objects AS l JOIN others AS r ON l.id = r.id MAX_OUTPUT_ROWS 12 ORDER BY l.payload.score NULLS LAST, r.other.score",
    "WITH seed AS (SELECT 1 AS unit) , objects AS (SELECT 2 AS id, @a AS payload FROM seed UNION ALL SELECT 1 AS id, @b AS payload FROM seed UNION ALL SELECT 3 AS id, @c AS payload FROM seed) , others AS (SELECT 1 AS id, @oa AS other FROM seed UNION ALL SELECT 2 AS id, @ob AS other FROM seed UNION ALL SELECT 3 AS id, @oc AS other FROM seed UNION ALL SELECT 2 AS id, @od AS other FROM seed) SELECT DISTINCT l.payload.score AS a, l.payload.score AS b FROM objects AS l JOIN others AS r ON l.id = r.id MAX_OUTPUT_ROWS 12 ORDER BY l.payload.score NULLS LAST",
    "WITH seed AS (SELECT 1 AS unit) , objects AS (SELECT 2 AS id, @a AS payload FROM seed UNION ALL SELECT 1 AS id, @b AS payload FROM seed UNION ALL SELECT 3 AS id, @c AS payload FROM seed) , others AS (SELECT 1 AS id, @oa AS other FROM seed UNION ALL SELECT 2 AS id, @ob AS other FROM seed UNION ALL SELECT 3 AS id, @oc AS other FROM seed UNION ALL SELECT 2 AS id, @od AS other FROM seed) , filtered AS (FROM others |> WHERE id <> 3 |> SELECT id, other) SELECT l.id, r.other.score FROM objects AS l LEFT JOIN filtered AS r ON l.id = r.id MAX_OUTPUT_ROWS 12 ORDER BY l.id, r.other.score",
    "WITH seed AS (SELECT 1 AS unit) , objects AS (SELECT 2 AS id, @a AS payload FROM seed UNION ALL SELECT 1 AS id, @b AS payload FROM seed UNION ALL SELECT 3 AS id, @c AS payload FROM seed) , others AS (SELECT 1 AS id, @oa AS other FROM seed UNION ALL SELECT 2 AS id, @ob AS other FROM seed UNION ALL SELECT 3 AS id, @oc AS other FROM seed UNION ALL SELECT 2 AS id, @od AS other FROM seed) SELECT l.id, l.payload.score FROM objects AS l JOIN others AS r ON l.id = r.id MAX_OUTPUT_ROWS 12 WHERE r.other.score < 0 ORDER BY l.id",
    "WITH seed AS (SELECT 1 AS unit) , objects AS (SELECT 2 AS id, @a AS payload FROM seed UNION ALL SELECT 1 AS id, @b AS payload FROM seed UNION ALL SELECT 3 AS id, @c AS payload FROM seed) , others AS (SELECT 1 AS id, @oa AS other FROM seed UNION ALL SELECT 2 AS id, @ob AS other FROM seed UNION ALL SELECT 3 AS id, @oc AS other FROM seed UNION ALL SELECT 2 AS id, @od AS other FROM seed) FROM objects AS l |> WHERE l.payload.score > 15 |> JOIN others AS r ON l.id = r.id MAX_OUTPUT_ROWS 12 |> SELECT l.id, r.other.score",
  ] {
    let script = parse_query_script(text, query_limits()).unwrap()
    assert_true(query_binding_count(script_query(script)) > 0)
  }
}

///|
test "WITH current limit-parameter public source parses" {
  for text in [
    "WITH selected AS (SELECT amount, id FROM records WHERE id > 0) SELECT amount, id FROM selected UNION ALL SELECT amount, id FROM selected ORDER BY id LIMIT @count OFFSET @skip",
    "WITH selected AS (SELECT amount, id FROM records WHERE id > 0) , keys AS (SELECT 1 AS id UNION ALL SELECT 2 AS id UNION ALL SELECT 3 AS id) SELECT l.amount AS amount, l.id AS id FROM selected AS l JOIN keys AS r ON l.id = r.id MAX_OUTPUT_ROWS 10 ORDER BY id LIMIT @count OFFSET @skip",
  ] {
    let script = parse_query_script(text, query_limits()).unwrap()
    assert_true(query_binding_count(script_query(script)) > 0)
  }
}

///|
test "WITH current subgraph public source parses" {
  for text in [
    "WITH n AS (SELECT 2 AS node_key, 20 AS p UNION ALL SELECT 1 AS node_key, IF(TRUE, 10, CAST(NULL AS FLOAT64)) AS p) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 2 AS dst_key, 20 AS w UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 2 AS dst_key, 10 AS w UNION ALL SELECT 13 AS edge_key, 2 AS src_key, 2 AS dst_key, 30 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node PROPERTIES (p)) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , selected AS (FROM g |> node_rows() |> WHERE node_key <= 2 |> SELECT id) FROM g |> subgraph(nodes: {from: selected, id: \"id\"}) |> node_rows() |> SELECT node_key, p |> ORDER BY node_key |> RESULT answer",
    "WITH n AS (SELECT 2 AS node_key, 20 AS p UNION ALL SELECT 1 AS node_key, IF(TRUE, 10, CAST(NULL AS FLOAT64)) AS p) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 2 AS dst_key, 20 AS w UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 2 AS dst_key, 10 AS w UNION ALL SELECT 13 AS edge_key, 2 AS src_key, 2 AS dst_key, 30 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node PROPERTIES (p)) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , selected AS (FROM g |> node_rows() |> WHERE node_key <= 2 |> SELECT id) , slice AS (FROM g |> subgraph(nodes: {from: selected, id: \"id\"})) FROM slice |> edge_rows() |> SELECT edge_key, w |> ORDER BY edge_key |> RESULT answer",
    "WITH n AS (SELECT 2 AS node_key, 20 AS p UNION ALL SELECT 1 AS node_key, IF(TRUE, 10, CAST(NULL AS FLOAT64)) AS p) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 2 AS dst_key, 20 AS w UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 2 AS dst_key, 10 AS w UNION ALL SELECT 13 AS edge_key, 2 AS src_key, 2 AS dst_key, 30 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node PROPERTIES (p)) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , selected AS (FROM g |> node_rows() |> WHERE node_key <= 2 |> SELECT id) , `chosen ids` AS (FROM selected) , `slice` AS (FROM g |> normalize_graph() |> subgraph(nodes: {from: `chosen ids`, id: \"id\"}, edges: {gt: [{field: \"w\"}, {literal: 10}]})) FROM `slice` |> edge_rows() |> SELECT edge_key, w |> ORDER BY edge_key |> RESULT answer",
    "WITH n AS (SELECT 3 AS node_key, CAST(NULL AS FLOAT64) AS p UNION ALL SELECT 2 AS node_key, 20 AS p) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 2 AS dst_key, 20 AS w UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 2 AS dst_key, 10 AS w UNION ALL SELECT 13 AS edge_key, 2 AS src_key, 2 AS dst_key, 30 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node PROPERTIES (p)) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , selected AS (FROM g |> node_rows() |> WHERE node_key >= 2 |> SELECT id) FROM g |> subgraph(nodes: {from: selected, id: \"id\"}) |> node_rows() |> SELECT node_key, p |> ORDER BY node_key |> RESULT answer",
    "WITH n AS (SELECT 2 AS node_key, 20 AS p UNION ALL SELECT 1 AS node_key, IF(TRUE, 10, CAST(NULL AS FLOAT64)) AS p) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 2 AS dst_key, 20 AS w UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 2 AS dst_key, 10 AS w UNION ALL SELECT 13 AS edge_key, 2 AS src_key, 2 AS dst_key, 30 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node PROPERTIES (p)) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , selected AS (FROM g |> node_rows() |> WHERE node_key <= 2 |> SELECT id) FROM GRAPH g |> subgraph(nodes: {from: selected, id: \"id\"}) |> MATCH WALK (a:Node) |> SELECT a.p AS p |> ORDER BY p |> RESULT answer",
    "WITH n AS (SELECT 2 AS node_key, 20 AS p UNION ALL SELECT 1 AS node_key, IF(TRUE, 10, CAST(NULL AS FLOAT64)) AS p) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 2 AS dst_key, 20 AS w UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 2 AS dst_key, 10 AS w UNION ALL SELECT 13 AS edge_key, 2 AS src_key, 2 AS dst_key, 30 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node PROPERTIES (p)) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , selected AS (FROM g |> node_rows() |> WHERE FALSE |> SELECT id) FROM g |> subgraph(nodes: {from: selected, id: \"id\"}) |> node_rows() |> SELECT node_key, p |> ORDER BY node_key |> RESULT answer",
    "WITH n AS (SELECT 2 AS node_key, 20 AS p UNION ALL SELECT 1 AS node_key, IF(TRUE, 10, CAST(NULL AS FLOAT64)) AS p) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 2 AS dst_key, 20 AS w UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 2 AS dst_key, 10 AS w UNION ALL SELECT 13 AS edge_key, 2 AS src_key, 2 AS dst_key, 30 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node PROPERTIES (p)) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , selected AS (FROM g |> node_rows() |> WHERE FALSE |> SELECT id) FROM g |> subgraph(nodes: {from: selected, id: \"id\"}) |> edge_rows() |> SELECT edge_key, w |> ORDER BY edge_key |> RESULT answer",
    "WITH n AS (SELECT 2 AS node_key, 20 AS p UNION ALL SELECT 1 AS node_key, IF(TRUE, 10, CAST(NULL AS FLOAT64)) AS p) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 2 AS dst_key, 20 AS w UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 2 AS dst_key, 10 AS w UNION ALL SELECT 13 AS edge_key, 2 AS src_key, 2 AS dst_key, 30 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node PROPERTIES (p)) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , selected AS (FROM g |> node_rows() |> WHERE node_key = 2 |> SELECT id) FROM g |> subgraph(nodes: {from: selected, id: \"id\"}) |> edge_rows() |> SELECT edge_key, w |> ORDER BY edge_key |> RESULT answer",
    "WITH n AS (SELECT 2 AS node_key, 20 AS p UNION ALL SELECT 1 AS node_key, IF(TRUE, 10, CAST(NULL AS FLOAT64)) AS p) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 2 AS dst_key, 20 AS w UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 2 AS dst_key, 10 AS w UNION ALL SELECT 13 AS edge_key, 2 AS src_key, 2 AS dst_key, 30 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node PROPERTIES (p)) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , selected AS (FROM g |> node_rows() |> WHERE node_key <= 2 |> SELECT id) FROM g |> subgraph(nodes: {from: selected, id: \"id\"}, edges: {gt: [{field: \"w\"}, @minimum]}) |> edge_rows() |> SELECT edge_key, w |> ORDER BY edge_key |> RESULT answer",
    "WITH n AS (SELECT 2 AS node_key, 20 AS p UNION ALL SELECT 1 AS node_key, IF(TRUE, 10, CAST(NULL AS FLOAT64)) AS p) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 2 AS dst_key, 20 AS w UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 2 AS dst_key, 10 AS w ) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node PROPERTIES (p)) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , chosen AS (FROM g |> node_rows() |> WHERE node_key <= 2 |> SELECT id) , selected AS (SELECT id FROM chosen UNION ALL SELECT id FROM chosen) FROM g |> subgraph(nodes: {from: selected, id: \"id\"}) |> edge_rows() |> SELECT edge_key, w |> ORDER BY edge_key |> RESULT answer",
    "WITH n AS (SELECT 1 AS node_key, 7 AS p) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node PROPERTIES (p)))) FROM g |> subgraph(nodes: {ids: [{definition: \"N\", domain: \"sha256:ab0669136910007a19ecef7c70e8cb975c8b68b0760ae1fd00216d346f35ccf0\", key: [1], key_types: [{kind: \"number\"}]}]}) |> node_rows() |> SELECT node_key, p |> ORDER BY node_key |> RESULT answer",
  ] {
    let script = parse_query_script(text, query_limits()).unwrap()
    assert_true(query_binding_count(script_query(script)) > 0)
  }
}

///|
test "WITH current traversal-join public source parses" {
  for text in [
    "WITH n AS (SELECT 1 AS node_key) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 1 AS dst_key UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 1 AS dst_key) , r AS (SELECT 2 AS depth, 20 AS tag UNION ALL SELECT 2 AS depth, 10 AS tag) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R NO PROPERTIES))) , seeds AS (FROM g |> node_rows() |> SELECT id AS element) FROM g |> traverse(start: {from: seeds, id: 'element'}, direction: 'out', min_hops: 2, max_hops: 2, path_mode: 'trail', emit: 'nodes', max_output_rows: 10) |> AS v |> JOIN r AS rr ON v.depth = rr.depth MAX_OUTPUT_ROWS 10 |> SELECT v.depth AS depth, rr.tag AS tag |> ORDER BY depth, tag",
    "WITH n AS (SELECT 1 AS node_key) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 1 AS dst_key UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 1 AS dst_key) , r AS (SELECT 2 AS depth, 20 AS tag UNION ALL SELECT 2 AS depth, 10 AS tag) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R NO PROPERTIES))) , seeds AS (FROM g |> node_rows() |> SELECT id AS element) FROM g |> traverse(start: {from: seeds, id: 'element'}, direction: 'out', min_hops: 2, max_hops: 2, path_mode: 'trail', emit: 'paths', max_output_rows: 10) |> AS v |> JOIN r AS rr ON v.hop_count = rr.depth MAX_OUTPUT_ROWS 10 |> SELECT v.hop_count AS depth, rr.tag AS tag |> ORDER BY depth, tag",
    "WITH n AS (SELECT 1 AS node_key) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 1 AS dst_key UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 1 AS dst_key) , r AS (SELECT 2 AS depth, 20 AS tag UNION ALL SELECT 2 AS depth, 10 AS tag) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R NO PROPERTIES))) , seeds AS (FROM g |> node_rows() |> SELECT id AS element) FROM g |> traverse(start: {from: seeds, id: 'element'}, direction: 'out', min_hops: 2, max_hops: 2, path_mode: 'trail', emit: 'paths', max_output_rows: 10) |> WHERE hop_count = 2 |> AS v |> JOIN r AS rr ON v.hop_count = rr.depth MAX_OUTPUT_ROWS 10 |> SELECT v.hop_count AS depth, rr.tag AS tag |> ORDER BY depth, tag |> LIMIT 3",
    "WITH n AS (SELECT 1 AS node_key) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 1 AS dst_key UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 1 AS dst_key) , r AS (SELECT 2 AS depth, 20 AS tag UNION ALL SELECT 2 AS depth, 10 AS tag) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R NO PROPERTIES))) , seeds AS (FROM g |> node_rows() |> SELECT id AS element) FROM g |> traverse(start: {from: seeds, id: 'element'}, direction: 'out', min_hops: 2, max_hops: 2, path_mode: 'trail', emit: 'nodes', max_output_rows: 10) |> SELECT depth AS level |> AS v |> JOIN r AS rr ON v.level = rr.depth MAX_OUTPUT_ROWS 10 |> SELECT v.level AS depth, rr.tag AS tag |> ORDER BY depth, tag",
    "WITH n AS (SELECT 1 AS node_key) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 1 AS dst_key UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 1 AS dst_key) , r AS (SELECT 2 AS depth, 20 AS tag UNION ALL SELECT 2 AS depth, 10 AS tag) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R NO PROPERTIES))) , seeds AS (FROM g |> node_rows() |> WHERE node_key > 1 |> SELECT id AS element) FROM g |> traverse(start: {from: seeds, id: 'element'}, direction: 'out', min_hops: 2, max_hops: 2, path_mode: 'trail', emit: 'nodes', max_output_rows: 10) |> AS v |> JOIN r AS rr ON v.depth = rr.depth MAX_OUTPUT_ROWS 10 |> SELECT v.depth AS depth, rr.tag AS tag |> ORDER BY depth, tag",
    "WITH n AS (SELECT 1 AS node_key) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 1 AS dst_key UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 1 AS dst_key) , r AS (SELECT 2 AS depth, 20 AS tag UNION ALL SELECT 2 AS depth, 10 AS tag) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R NO PROPERTIES))) , seeds AS (FROM g |> node_rows() |> SELECT id AS element) FROM g |> traverse(start: {from: seeds, id: 'element'}, direction: 'out', min_hops: 2, max_hops: 2, path_mode: 'trail', emit: 'nodes', max_output_rows: 10) |> AS v |> JOIN r AS rr ON v.depth = rr.depth MAX_OUTPUT_ROWS 10 |> SELECT v.depth AS depth, rr.tag AS tag |> ORDER BY depth, tag |> SELECT tag, depth",
  ] {
    let script = parse_query_script(text, query_limits()).unwrap()
    assert_true(query_binding_count(script_query(script)) > 0)
  }
}
