// Exact authored current callers; expected values remain in independent fixtures.

///|
test "WITH current computed-object-property public source parses" {
  for text in [
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, COALESCE(payload, other).score AS score FROM objects ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) FROM objects |> SELECT id, (CASE WHEN payload IS NULL THEN other ELSE payload END).`score`, (@p1).nested.score AS nested_score |> ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, COALESCE(payload, other).score AS original_score, other AS payload FROM objects ORDER BY COALESCE(payload, other).score NULLS LAST, id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, COALESCE(payload, other).SCORE AS original_score, other AS payload FROM objects ORDER BY COALESCE(payload, other).SCORE NULLS LAST, id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, COALESCE(payload, other).score AS original_score, other AS payload FROM objects ORDER BY COALESCE(objects.payload, objects.other).score NULLS LAST, id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, COALESCE(payload, other).SCORE AS original_score, other AS payload FROM objects ORDER BY COALESCE(`objects`.`payload`, `objects`.`other`).`score` NULLS LAST, id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) FROM objects AS before |> SET payload = other |> SELECT id, COALESCE(before.payload, before.other).score AS original_score, COALESCE(payload, other).score AS score |> ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT l.id AS id, COALESCE(l.payload, r.other).score AS score FROM objects AS l JOIN objects AS r ON l.id = r.id ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, COALESCE(payload, other).score AS score FROM objects ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, ((o)).payload.score AS score FROM objects o ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, (payload).score AS score FROM objects payload ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, payload.* FROM objects ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) FROM objects AS o |> SELECT id, o.payload.* |> ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, `o`.`PaYlOaD`.* FROM objects `o` ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, payload.* FROM objects ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) FROM objects AS old |> SET payload = other |> SELECT id, payload.* |> ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) FROM objects AS old |> SET payload = other |> SELECT id, old.payload.* |> ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, payload.* EXCEPT (nested) REPLACE (payload.score + 1 AS score) FROM objects ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT payload.* EXCEPT (nested), COUNT(*) AS n FROM objects GROUP BY payload.score ORDER BY score NULLS LAST",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, COALESCE(payload, other).* FROM objects ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) FROM objects |> SELECT id, (CASE WHEN payload IS NULL THEN other ELSE payload END).* |> ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, COALESCE(payload, other).* FROM objects ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, (CASE WHEN id = 2 THEN other ELSE payload END).* FROM objects ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) FROM objects AS old |> SET payload = other |> SELECT id, COALESCE(payload, old.payload).* |> ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, COALESCE(payload, other).* EXCEPT (nested) REPLACE (id + 1 AS score) FROM objects ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT DISTINCT COALESCE(payload, other).* EXCEPT (nested) FROM objects ORDER BY score",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT COALESCE(payload, other).* EXCEPT (nested), COUNT(*) AS n FROM objects GROUP BY COALESCE(payload, other).score ORDER BY score",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, COALESCE(payload, other).* FROM objects ORDER BY COALESCE(payload, other).score, id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) (WITH chosen AS (SELECT id, payload FROM objects INTERSECT DISTINCT SELECT id, payload FROM objects WHERE id <> 1) SELECT id, payload.SCORE AS score FROM chosen ORDER BY id)",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) , chosen AS (FROM objects |> SELECT id, payload |> INTERSECT DISTINCT (FROM objects |> WHERE id <> 1 |> SELECT id, payload)) FROM chosen |> SELECT id, payload.`SCORE` AS score |> ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) (WITH chosen AS (SELECT id, payload FROM objects INTERSECT DISTINCT SELECT id, payload FROM objects WHERE id <> 1) SELECT id, payload.SCORE AS score FROM chosen ORDER BY id)",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) (WITH chosen AS (SELECT id, payload FROM objects EXCEPT DISTINCT SELECT id, payload FROM objects WHERE id <> 1) SELECT id, payload.SCORE AS score FROM chosen ORDER BY id)",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) , chosen AS (FROM objects |> SELECT id, payload |> EXCEPT DISTINCT (FROM objects |> WHERE id <> 1 |> SELECT id, payload)) FROM chosen |> SELECT id, payload.`SCORE` AS score |> ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) (WITH chosen AS (SELECT id, payload FROM objects EXCEPT DISTINCT SELECT id, payload FROM objects WHERE id <> 1) SELECT id, payload.SCORE AS score FROM chosen ORDER BY id)",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, COALESCE(payload, other).* FROM objects ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) FROM objects |> SELECT id, (CASE WHEN payload IS NULL THEN other ELSE payload END).* |> ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, COALESCE(payload, other).* FROM objects ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, (CASE WHEN id = 2 THEN other ELSE payload END).* FROM objects ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) FROM objects AS old |> SET payload = other |> SELECT id, COALESCE(payload, old.payload).* |> ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, COALESCE(payload, other).* EXCEPT (nested) REPLACE (id + 1 AS score) FROM objects ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT DISTINCT COALESCE(payload, other).* EXCEPT (nested) FROM objects ORDER BY score",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT COALESCE(payload, other).* EXCEPT (nested), COUNT(*) AS n FROM objects GROUP BY COALESCE(payload, other).score ORDER BY score",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, COALESCE(payload, other).* FROM objects ORDER BY COALESCE(payload, other).score, id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, payload.* FROM objects ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) FROM objects AS o |> SELECT id, o.payload.* |> ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, `o`.`PaYlOaD`.* FROM objects `o` ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, payload.* FROM objects ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) FROM objects AS old |> SET payload = other |> SELECT id, payload.* |> ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) FROM objects AS old |> SET payload = other |> SELECT id, old.payload.* |> ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, payload.* EXCEPT (nested) REPLACE (payload.score + 1 AS score) FROM objects ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT payload.* EXCEPT (nested), COUNT(*) AS n FROM objects GROUP BY payload.score ORDER BY score NULLS LAST",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, ((o)).payload.score AS score FROM objects o ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) SELECT id, (payload).score AS score FROM objects payload ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) (WITH chosen AS (SELECT id, payload FROM objects INTERSECT DISTINCT SELECT id, payload FROM objects WHERE id <> 1) SELECT id, payload.SCORE AS score FROM chosen ORDER BY id)",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) , chosen AS (FROM objects |> SELECT id, payload |> INTERSECT DISTINCT (FROM objects |> WHERE id <> 1 |> SELECT id, payload)) FROM chosen |> SELECT id, payload.`SCORE` AS score |> ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) (WITH chosen AS (SELECT id, payload FROM objects INTERSECT DISTINCT SELECT id, payload FROM objects WHERE id <> 1) SELECT id, payload.SCORE AS score FROM chosen ORDER BY id)",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) (WITH chosen AS (SELECT id, payload FROM objects EXCEPT DISTINCT SELECT id, payload FROM objects WHERE id <> 1) SELECT id, payload.SCORE AS score FROM chosen ORDER BY id)",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) , chosen AS (FROM objects |> SELECT id, payload |> EXCEPT DISTINCT (FROM objects |> WHERE id <> 1 |> SELECT id, payload)) FROM chosen |> SELECT id, payload.`SCORE` AS score |> ORDER BY id",
    "WITH objects AS (SELECT id, CASE WHEN id = 1 THEN @p1 WHEN id = 2 THEN @p2 WHEN id = 3 THEN @p3 ELSE @p4 END AS payload, CASE WHEN id = 1 THEN @o1 WHEN id = 2 THEN @o2 WHEN id = 3 THEN @o3 ELSE @o4 END AS other FROM records WHERE id > 0) (WITH chosen AS (SELECT id, payload FROM objects EXCEPT DISTINCT SELECT id, payload FROM objects WHERE id <> 1) SELECT id, payload.SCORE AS score FROM chosen ORDER BY id)",
  ] {
    let script = parse_query_script(text, query_limits()).unwrap()
    assert_true(query_binding_count(script_query(script)) > 0)
  }
}

///|
test "WITH current distinct-aggregate-order public source parses" {
  for text in [
    "WITH labels AS (SELECT id, CAST(amount AS STRING) AS name FROM records WHERE id > 0) SELECT STRING_AGG(DISTINCT name, '|' ORDER BY name) AS names FROM labels",
    "WITH labels AS (SELECT id, CAST(amount AS STRING) AS name FROM records WHERE id > 0) SELECT STRING_AGG(DISTINCT name, '|' ORDER BY l.name) AS names FROM labels AS l",
    "WITH labels AS (SELECT id, CAST(amount AS STRING) AS name FROM records WHERE id > 0) SELECT STRING_AGG(DISTINCT l.name, '|' ORDER BY (`l`.`NAME`)) AS names FROM labels AS l",
    "WITH labels AS (SELECT id, CAST(amount AS STRING) AS name FROM records WHERE id > 0) FROM labels |> AGGREGATE STRING_AGG(DISTINCT name, '|' ORDER BY name DESC NULLS LAST) AS names",
    "WITH labels AS (SELECT id, CAST(amount AS STRING) AS name FROM records WHERE id > 0) FROM labels AS old |> SET name = 'changed' |> AGGREGATE STRING_AGG(DISTINCT old.name, '|' ORDER BY old.name) AS names",
    "WITH labels AS (SELECT id, CAST(amount AS STRING) AS name FROM records WHERE id > 0) SELECT STRING_AGG(name, '|' ORDER BY id) AS names FROM labels",
    "WITH labels AS (SELECT id, CAST(amount AS STRING) AS name FROM records WHERE id > 0) SELECT STRING_AGG(DISTINCT name, '|' ORDER BY name) AS names FROM labels",
    "WITH objects AS (SELECT id, @payload AS payload FROM records WHERE id > 0) SELECT STRING_AGG(DISTINCT (payload).name, '|' ORDER BY objects.payload.`NAME`) AS names FROM objects",
    "WITH limited AS (FROM records |> WHERE id > 0 |> ASSERT UNIQUE BY (id) |> ORDER BY id |> LIMIT 4) , pair AS (SELECT id, COALESCE(amount, 0) AS x FROM limited) SELECT ARRAY_AGG(DISTINCT x IGNORE NULLS ORDER BY p.x DESC) AS items FROM pair AS p",
    "WITH limited AS (FROM records |> WHERE id > 0 |> ASSERT UNIQUE BY (id) |> ORDER BY id |> LIMIT 4) , pair AS (SELECT id, COALESCE(amount, 0) AS x FROM limited) SELECT ARRAY_AGG(DISTINCT p.x IGNORE NULLS ORDER BY x DESC) AS items FROM pair AS p",
    "WITH limited AS (FROM records |> WHERE id > 0 |> ASSERT UNIQUE BY (id) |> ORDER BY id |> LIMIT 4) , pair AS (SELECT id, COALESCE(amount, 0) AS x FROM limited) SELECT ARRAY_AGG(DISTINCT ((x)) IGNORE NULLS ORDER BY (`p`.`X`) DESC) AS items FROM pair AS p",
    "WITH limited AS (FROM records |> WHERE id > 0 |> ASSERT UNIQUE BY (id) |> ORDER BY id |> LIMIT 4) , pair AS (SELECT id, COALESCE(amount, 0) AS x FROM limited) FROM pair AS p |> AGGREGATE ARRAY_AGG(DISTINCT x IGNORE NULLS ORDER BY p.x DESC) AS items",
    "WITH limited AS (FROM records |> WHERE id > 0 |> ASSERT UNIQUE BY (id) |> ORDER BY id |> LIMIT 4) , pair AS (SELECT id, COALESCE(amount, 0) AS x FROM limited) SELECT ARRAY_AGG(DISTINCT p.x IGNORE NULLS ORDER BY (x) ASC) AS items FROM pair AS p",
    "WITH limited AS (FROM records |> WHERE id > 0 |> ASSERT UNIQUE BY (id) |> ORDER BY id |> LIMIT 4) , pair AS (SELECT id, COALESCE(amount, 0) AS x FROM limited) SELECT ARRAY_AGG(DISTINCT x IGNORE NULLS ORDER BY p.x DESC) AS items FROM pair AS p WHERE x >= 10",
  ] {
    let script = parse_query_script(text, query_limits()).unwrap()
    assert_true(query_binding_count(script_query(script)) > 0)
  }
}

///|
test "WITH current distinct-array-reference-key public source parses" {
  for text in [
    "WITH limited AS (FROM records |> WHERE id > 0 |> ASSERT UNIQUE BY (id) |> ORDER BY id |> LIMIT 4) , pair AS (SELECT id, COALESCE(amount, 0) AS x FROM limited) SELECT ARRAY_AGG(DISTINCT x IGNORE NULLS ORDER BY p.x DESC) AS items FROM pair AS p",
    "WITH limited AS (FROM records |> WHERE id > 0 |> ASSERT UNIQUE BY (id) |> ORDER BY id |> LIMIT 4) , pair AS (SELECT id, COALESCE(amount, 0) AS x FROM limited) SELECT ARRAY_AGG(DISTINCT p.x IGNORE NULLS ORDER BY x DESC) AS items FROM pair AS p",
    "WITH limited AS (FROM records |> WHERE id > 0 |> ASSERT UNIQUE BY (id) |> ORDER BY id |> LIMIT 4) , pair AS (SELECT id, COALESCE(amount, 0) AS x FROM limited) SELECT ARRAY_AGG(DISTINCT ((x)) IGNORE NULLS ORDER BY (`p`.`X`) DESC) AS items FROM pair AS p",
    "WITH limited AS (FROM records |> WHERE id > 0 |> ASSERT UNIQUE BY (id) |> ORDER BY id |> LIMIT 4) , pair AS (SELECT id, COALESCE(amount, 0) AS x FROM limited) FROM pair AS p |> AGGREGATE ARRAY_AGG(DISTINCT x IGNORE NULLS ORDER BY p.x DESC) AS items",
    "WITH limited AS (FROM records |> WHERE id > 0 |> ASSERT UNIQUE BY (id) |> ORDER BY id |> LIMIT 4) , pair AS (SELECT id, COALESCE(amount, 0) AS x FROM limited) SELECT ARRAY_AGG(DISTINCT p.x IGNORE NULLS ORDER BY (x) ASC) AS items FROM pair AS p",
    "WITH limited AS (FROM records |> WHERE id > 0 |> ASSERT UNIQUE BY (id) |> ORDER BY id |> LIMIT 4) , pair AS (SELECT id, COALESCE(amount, 0) AS x FROM limited) SELECT ARRAY_AGG(DISTINCT x IGNORE NULLS ORDER BY p.x DESC) AS items FROM pair AS p WHERE x >= 10",
  ] {
    let script = parse_query_script(text, query_limits()).unwrap()
    assert_true(query_binding_count(script_query(script)) > 0)
  }
}

///|
test "WITH current full-join-scope public source parses" {
  for text in [
    "WITH base AS (FROM records |> ASSERT UNIQUE BY (id)) , lefts AS (FROM base |> WHERE id <= 2) , rights AS (FROM base |> WHERE id >= 2) SELECT l.*, r.id AS rid FROM lefts AS l FULL JOIN rights AS r ON l.id = r.id MAX_OUTPUT_ROWS 10 ORDER BY id NULLS LAST, rid NULLS LAST",
    "WITH base AS (FROM records |> ASSERT UNIQUE BY (id)) , lefts AS (FROM base |> WHERE id <= 2) , rights AS (FROM base |> WHERE id >= 2) SELECT l.amount, l.id, r.id AS rid FROM lefts AS l FULL JOIN rights AS r ON l.id = r.id MAX_OUTPUT_ROWS 10 ORDER BY id NULLS LAST, rid NULLS LAST",
    "WITH base AS (FROM records |> ASSERT UNIQUE BY (id)) , lefts AS (FROM base |> WHERE id <= 2) , rights AS (FROM base |> WHERE id >= 2) FROM lefts AS l |> FULL JOIN rights AS r ON l.id = r.id MAX_OUTPUT_ROWS 10 |> SELECT l.amount, l.id, r.id AS rid |> ORDER BY id NULLS LAST, rid NULLS LAST",
    "WITH base AS (FROM records |> ASSERT UNIQUE BY (id)) (WITH lefts AS (FROM base |> WHERE id <= 2), rights AS (FROM base |> WHERE id >= 2) SELECT l.amount, l.id, r.id AS rid FROM lefts AS l FULL JOIN rights AS r ON l.id = r.id MAX_OUTPUT_ROWS 10 ORDER BY id NULLS LAST, rid NULLS LAST)",
    "WITH base AS (FROM records |> ASSERT UNIQUE BY (id)) , lefts AS (FROM base |> WHERE id <= 2) , rights AS (FROM base |> WHERE id >= 2) SELECT l.amount, l.id, r.id AS rid FROM lefts AS l FULL JOIN rights AS r ON l.id = r.id MAX_OUTPUT_ROWS 10 ORDER BY id NULLS LAST, rid NULLS LAST",
    "WITH base AS (FROM records |> ASSERT UNIQUE BY (id)) , lefts AS (FROM base |> WHERE id <= 2) , rights AS (FROM base |> WHERE id >= 2) SELECT DISTINCT l.amount AS amount FROM lefts AS l FULL JOIN rights AS r ON l.id = r.id MAX_OUTPUT_ROWS 10 ORDER BY amount + 1 NULLS LAST",
    "WITH base AS (FROM records |> ASSERT UNIQUE BY (id)) , lefts AS (FROM base |> WHERE id <= 2) , rights AS (FROM base |> WHERE id >= 2) SELECT -l.id AS id, r.id AS rid FROM lefts AS l FULL JOIN rights AS r ON l.id = r.id MAX_OUTPUT_ROWS 10 ORDER BY id + 1 NULLS LAST",
    "WITH base AS (FROM records |> ASSERT UNIQUE BY (id)) , lefts AS (FROM base |> WHERE id <= 2) , rights AS (FROM base |> WHERE id >= 2) SELECT -l.id AS id, r.id AS rid FROM lefts AS l FULL JOIN rights AS r ON l.id = r.id MAX_OUTPUT_ROWS 10 ORDER BY l.id + 1 NULLS LAST",
    "WITH base AS (FROM records |> ASSERT UNIQUE BY (id)) , lefts AS (FROM base |> WHERE id <= 2) , rights AS (FROM base |> WHERE id >= 2) FROM lefts AS l |> FULL JOIN rights AS r ON l.id = r.id MAX_OUTPUT_ROWS 10 |> SELECT l.*, r.id AS rid |> ORDER BY id NULLS LAST, rid NULLS LAST",
    "WITH base AS (FROM records |> ASSERT UNIQUE BY (id)) , lefts AS (FROM base |> WHERE id <= 2) , rights AS (FROM base |> WHERE id >= 2) SELECT l.*, r.id AS rid FROM lefts AS l FULL JOIN rights AS r ON l.amount = r.amount MAX_OUTPUT_ROWS 10 ORDER BY id NULLS LAST, rid NULLS LAST",
    "WITH base AS (FROM records |> ASSERT UNIQUE BY (id)) , lefts AS (FROM base |> WHERE id <= 2) , rights AS (FROM base |> WHERE id >= 2) SELECT l.*, r.id AS rid FROM lefts AS l FULL JOIN rights AS r ON l.id = r.id MAX_OUTPUT_ROWS 10 ORDER BY id NULLS LAST, rid NULLS LAST",
    "WITH base AS (FROM records |> ASSERT UNIQUE BY (id)) , lefts AS (FROM base |> WHERE id <= 2) , rights AS (FROM base |> WHERE id >= 2) SELECT * EXCEPT (amount), l.id AS lid, r.id AS rid FROM lefts AS l FULL JOIN rights AS r USING (id) MAX_OUTPUT_ROWS 10 ORDER BY id",
    "WITH base AS (FROM records |> ASSERT UNIQUE BY (id)) , lefts AS (FROM base |> WHERE id <= 2) , rights AS (FROM base |> WHERE id >= 2) FROM lefts AS l |> FULL JOIN rights AS r USING (id) MAX_OUTPUT_ROWS 10 |> SELECT id, l.id AS lid, r.id AS rid |> ORDER BY id",
    "WITH base AS (FROM records |> ASSERT UNIQUE BY (id)) , lefts AS (FROM base |> WHERE id <= 2) , rights AS (FROM base |> WHERE id >= 2) SELECT -id AS id, l.id AS lid, r.id AS rid FROM lefts AS l FULL JOIN rights AS r USING (id) MAX_OUTPUT_ROWS 10 ORDER BY id",
    "WITH base AS (FROM records |> ASSERT UNIQUE BY (id)) , lefts AS (FROM base |> WHERE id <= 2) , rights AS (FROM base |> WHERE id >= 2) SELECT -id AS id, l.id AS lid, r.id AS rid FROM lefts AS l FULL JOIN rights AS r USING (id) MAX_OUTPUT_ROWS 10 ORDER BY l.id NULLS LAST",
    "WITH base AS (FROM records |> ASSERT UNIQUE BY (id)) , lefts AS (FROM base |> WHERE id <= 2) , rights AS (FROM base |> WHERE id >= 2) SELECT *, l.id AS lid, r.id AS rid FROM lefts AS l FULL JOIN rights AS r USING (`AMOUNT`, id) MAX_OUTPUT_ROWS 10 ORDER BY id, lid NULLS LAST",
    "WITH base AS (FROM records |> ASSERT UNIQUE BY (id)) , lefts AS (FROM base |> WHERE id <= 2) , rights AS (FROM base |> WHERE id >= 2) SELECT id, l.id AS lid, r.id AS rid FROM lefts AS l FULL JOIN rights AS r USING (id) MAX_OUTPUT_ROWS 10 JOIN base AS s USING (id) MAX_OUTPUT_ROWS 10 ORDER BY id",
    "WITH base AS (FROM records |> ASSERT UNIQUE BY (id)) , lefts AS (FROM base |> WHERE id <= 2) , rights AS (FROM base |> WHERE id >= 2) SELECT id, l.id AS lid, r.id AS rid FROM lefts AS l FULL JOIN rights AS r USING (id) MAX_OUTPUT_ROWS 10 ORDER BY id",
    "WITH base AS (FROM records |> ASSERT UNIQUE BY (id)) , lefts AS (FROM base |> WHERE id <= 2) , rights AS (FROM base |> WHERE id >= 2) SELECT * EXCEPT (amount), l.id AS lid, r.id AS rid FROM lefts AS l FULL JOIN rights AS r USING (id) MAX_OUTPUT_ROWS 10 ORDER BY id",
    "WITH base AS (FROM records |> ASSERT UNIQUE BY (id)) , lefts AS (FROM base |> WHERE id <= 2) , rights AS (FROM base |> WHERE id >= 2) FROM lefts AS l |> FULL JOIN rights AS r USING (id) MAX_OUTPUT_ROWS 10 |> SELECT id, l.id AS lid, r.id AS rid |> ORDER BY id",
    "WITH base AS (FROM records |> ASSERT UNIQUE BY (id)) , lefts AS (FROM base |> WHERE id <= 2) , rights AS (FROM base |> WHERE id >= 2) SELECT -id AS id, l.id AS lid, r.id AS rid FROM lefts AS l FULL JOIN rights AS r USING (id) MAX_OUTPUT_ROWS 10 ORDER BY id",
    "WITH base AS (FROM records |> ASSERT UNIQUE BY (id)) , lefts AS (FROM base |> WHERE id <= 2) , rights AS (FROM base |> WHERE id >= 2) SELECT -id AS id, l.id AS lid, r.id AS rid FROM lefts AS l FULL JOIN rights AS r USING (id) MAX_OUTPUT_ROWS 10 ORDER BY l.id NULLS LAST",
    "WITH base AS (FROM records |> ASSERT UNIQUE BY (id)) , lefts AS (FROM base |> WHERE id <= 2) , rights AS (FROM base |> WHERE id >= 2) SELECT *, l.id AS lid, r.id AS rid FROM lefts AS l FULL JOIN rights AS r USING (`AMOUNT`, id) MAX_OUTPUT_ROWS 10 ORDER BY id, lid NULLS LAST",
    "WITH base AS (FROM records |> ASSERT UNIQUE BY (id)) , lefts AS (FROM base |> WHERE id <= 2) , rights AS (FROM base |> WHERE id >= 2) SELECT id, l.id AS lid, r.id AS rid FROM lefts AS l FULL JOIN rights AS r USING (id) MAX_OUTPUT_ROWS 10 JOIN base AS s USING (id) MAX_OUTPUT_ROWS 10 ORDER BY id",
    "WITH base AS (FROM records |> ASSERT UNIQUE BY (id)) , lefts AS (FROM base |> WHERE id <= 2) , rights AS (FROM base |> WHERE id >= 2) SELECT id, l.id AS lid, r.id AS rid FROM lefts AS l FULL JOIN rights AS r USING (id) MAX_OUTPUT_ROWS 10 ORDER BY id",
  ] {
    let script = parse_query_script(text, query_limits()).unwrap()
    assert_true(query_binding_count(script_query(script)) > 0)
  }
}

///|
test "WITH current graph-abbreviated-edge public source parses" {
  for text in [
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@rEdges) AS link) , other_links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@sEdges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES, other_links AS F KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL S NO PROPERTIES))) FROM GRAPH g |> MATCH p =  (a:Node WHERE id = 1)-[]->(b:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@rEdges) AS link) , other_links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@sEdges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES, other_links AS F KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL S NO PROPERTIES))) FROM GRAPH g |> MATCH p =  (a:Node WHERE id = 1)->(b:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@rEdges) AS link) , other_links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@sEdges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES, other_links AS F KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL S NO PROPERTIES))) FROM GRAPH g |> MATCH p =  (a:Node WHERE id = 1)<-[]-(b:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@rEdges) AS link) , other_links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@sEdges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES, other_links AS F KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL S NO PROPERTIES))) FROM GRAPH g |> MATCH p =  (a:Node WHERE id = 1)<-(b:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@rEdges) AS link) , other_links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@sEdges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES, other_links AS F KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL S NO PROPERTIES))) FROM GRAPH g |> MATCH p =  (a:Node WHERE id = 1)-[]-(b:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@rEdges) AS link) , other_links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@sEdges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES, other_links AS F KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL S NO PROPERTIES))) FROM GRAPH g |> MATCH p =  (a:Node WHERE id = 1)-(b:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@rEdges) AS link) , other_links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@sEdges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES, other_links AS F KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL S NO PROPERTIES))) FROM GRAPH g |> MATCH p =  (a:Node WHERE id = 1)-(`b`:Node WHERE `B`.`PAYLOAD`.`score` > 15) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@rEdges) AS link) , other_links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@sEdges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES, other_links AS F KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL S NO PROPERTIES))) FROM GRAPH g |> MATCH p =  (a:Node WHERE id = 1)-(b:Node WHERE payload.score IS NULL) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@rEdges) AS link) , other_links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@sEdges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES, other_links AS F KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL S NO PROPERTIES))) FROM GRAPH g |> MATCH p =  (a:Node WHERE id = 1)->(b:Node WHERE payload.score > 100) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@rEdges) AS link) , other_links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@sEdges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES, other_links AS F KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL S NO PROPERTIES))) FROM GRAPH g |> MATCH p = WALK (a:Node WHERE id = 1)-(b:Node WHERE id = 2)<-[]-(c:Node WHERE id = 1) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@rEdges) AS link) , other_links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@sEdges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES, other_links AS F KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL S NO PROPERTIES))) FROM GRAPH g |> MATCH p = WALK (a:Node WHERE id = 1)-{0,2}(b:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@rEdges) AS link) , other_links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@sEdges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES, other_links AS F KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL S NO PROPERTIES))) FROM GRAPH g |> MATCH p = TRAIL (a:Node WHERE id = 1)-{0,2}(b:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@rEdges) AS link) , other_links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@sEdges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES, other_links AS F KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL S NO PROPERTIES))) FROM GRAPH g |> MATCH p = ACYCLIC (a:Node WHERE id = 1)-{0,2}(b:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
  ] {
    let script = parse_query_script(text, query_limits()).unwrap()
    assert_true(query_binding_count(script_query(script)) > 0)
  }
}

///|
test "WITH current graph-any-direction public source parses" {
  for text in [
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@edges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (key)))) FROM GRAPH g |> MATCH p = WALK (a:Node WHERE id = 1)-[:R]->(b:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@edges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (key)))) FROM GRAPH g |> MATCH p = WALK (a:Node WHERE id = 1)<-[:R]-(b:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@edges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (key)))) FROM GRAPH g |> MATCH p = WALK (a:Node WHERE id = 1)-[:R]-(b:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@edges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (key)))) FROM GRAPH g |> MATCH p = WALK (a:Node WHERE id = 1)-[:R WHERE key > 10]-(b:Node WHERE b.payload.score > 10) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@edges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (key)))) FROM GRAPH g |> MATCH p = WALK (a:Node WHERE id = 1)-[:`r`]-(`b`:Node WHERE `B`.`PAYLOAD`.`score` > 10) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@edges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (key)))) FROM GRAPH g |> MATCH p = WALK (a:Node WHERE id = 1)-[:R]-(b:Node WHERE payload.score IS NULL) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@edges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (key)))) FROM GRAPH g |> MATCH p = WALK (a:Node WHERE id = 1)-[:R]-(b:Node WHERE payload.score > 100) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@edges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (key)))) FROM GRAPH g |> MATCH p = WALK (a:Node WHERE id = 1)-[:R]-{0,2}(b:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@edges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (key)))) FROM GRAPH g |> MATCH p = TRAIL (a:Node WHERE id = 1)-[:R]-{0,2}(b:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@edges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (key)))) FROM GRAPH g |> MATCH p = ACYCLIC (a:Node WHERE id = 1)-[:R]-{0,2}(b:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
  ] {
    let script = parse_query_script(text, query_limits()).unwrap()
    assert_true(query_binding_count(script_query(script)) > 0)
  }
}

///|
test "WITH current graph-difference public source parses" {
  for text in [
    "WITH n AS (SELECT 1 AS node_key) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES))) FROM g |> graph_diff(with: g) |> SELECT delta |> RESULT changes",
    "WITH n AS (SELECT 1 AS node_key) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES))) , `peer graph` AS (FROM g) , changes AS (FROM g |> normalize_graph() |> graph_diff(with: `peer graph`)) FROM changes |> SELECT delta |> RESULT changes",
    "WITH n AS (SELECT 1 AS node_key) , e AS (SELECT 10 AS edge_key, 1 AS src_key, 1 AS dst_key) , f AS (SELECT 11 AS edge_key, 1 AS src_key, 1 AS dst_key) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R NO PROPERTIES, f AS F KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R NO PROPERTIES))) , selected AS (FROM g |> node_rows() |> WHERE FALSE |> SELECT id) , empty AS (FROM g |> subgraph(nodes: {from: selected, id: \"id\"})) FROM g |> graph_diff(with: empty) |> SELECT delta |> RESULT changes",
    "WITH n AS (SELECT 1 AS node_key) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES))) FROM g |> graph_diff(with: g) |> WHERE FALSE |> SELECT delta |> RESULT changes",
  ] {
    let script = parse_query_script(text, query_limits()).unwrap()
    assert_true(query_binding_count(script_query(script)) > 0)
  }
}

///|
test "WITH current graph-edge-predicate public source parses" {
  for text in [
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload)))) FROM GRAPH g |> MATCH p = WALK (:Node)-[:R WHERE weight > 10]->(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload)))) FROM GRAPH g |> MATCH p = WALK (:Node)-[:R WHERE weight > 10]->()-[:R WHERE weight IS NULL]->(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload)))) FROM GRAPH g |> MATCH p = WALK (:Node)-[:R {weight: 20}]->(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload)))) FROM GRAPH g |> MATCH p = WALK (:Node)-[:`r` WHERE `WEIGHT` > 10]->(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload)))) FROM GRAPH g |> MATCH p = WALK (:Node)-[:R WHERE weight IS NULL]->(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload)))) FROM GRAPH g |> MATCH p = WALK (:Node)-[:R WHERE payload.score IS NULL]->(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload)))) FROM GRAPH g |> MATCH p = WALK (:Node)-[:R WHERE payload.score > 10]->(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload)))) FROM GRAPH g |> MATCH p = WALK (:Node)-[:R WHERE weight > @minimum]->(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload)))) FROM GRAPH g |> MATCH p = WALK (:Node)-[:R WHERE weight > 100]->(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , empty_edges AS (FROM e |> WHERE edge_key < 0) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload), empty_edges AS F KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL S NO PROPERTIES))) FROM GRAPH g |> MATCH p = WALK (:Node)-[:R WHERE weight > 10]->(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload) LABEL Other NO PROPERTIES))) FROM GRAPH g |> MATCH p = WALK (:Node)-[:Other WHERE weight > 10]->(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload)))) FROM GRAPH g |> MATCH p = WALK (:Node)-[:R WHERE weight > 10]->{0,2}(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload)))) FROM GRAPH g |> MATCH p = TRAIL (:Node)-[:R WHERE weight > 10]->{0,2}(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload)))) FROM GRAPH g |> MATCH p = ACYCLIC (:Node)-[:R WHERE weight > 10]->{0,2}(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
  ] {
    let script = parse_query_script(text, query_limits()).unwrap()
    assert_true(query_binding_count(script_query(script)) > 0)
  }
}

///|
test "WITH current graph-equality public source parses" {
  for text in [
    "WITH n AS (SELECT 1 AS node_key, 7 AS p) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Person PROPERTIES (p)))) FROM g |> graphs_equal(with: g) |> SELECT equal |> RESULT comparison",
    "WITH n AS (SELECT 1 AS node_key, 7 AS p) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Person PROPERTIES (p)))) , `peer graph` AS (FROM g) , same AS (FROM g |> normalize_graph() |> graphs_equal(with: `peer graph`)) FROM same |> WHERE equal |> SELECT equal |> RESULT comparison",
    "WITH n AS (SELECT 1 AS node_key, 7 AS p) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Person PROPERTIES (p)))) , m AS (SELECT 2 AS node_key, 7 AS p) , h AS (GRAPH (NODE TABLES (m AS N KEY (node_key) LABEL Person PROPERTIES (p)))) FROM g |> graphs_equal(with: h) |> WHERE NOT equal |> SELECT equal |> RESULT comparison",
    "WITH n AS (SELECT CAST(NULL AS FLOAT64) AS node_key, 7 AS p) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Person PROPERTIES (p)))) FROM g |> graphs_equal(with: g) |> SELECT equal |> RESULT comparison",
    "WITH n AS (SELECT 1 AS node_key, 7 AS p) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Person PROPERTIES (p)))) FROM g |> graphs_equal(with: g) |> WHERE FALSE |> SELECT equal |> RESULT comparison",
  ] {
    let script = parse_query_script(text, query_limits()).unwrap()
    assert_true(query_binding_count(script_query(script)) > 0)
  }
}

///|
test "WITH current graph-graft public source parses" {
  for text in [
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , combined AS (FROM g |> graft_graph(with: g)) FROM combined |> node_rows() |> SELECT p, part, node_key, labels |> RESULT nodes",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , combined AS (FROM g |> graft_graph(with: g)) FROM combined |> edge_rows() |> SELECT w, part, edge_key, labels |> ORDER BY edge_key |> RESULT edges",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) FROM g |> graft_graph(with: g) |> edge_rows() |> WHERE w > 2 |> SELECT edge_key, w |> ORDER BY edge_key |> RESULT selected",
  ] {
    let script = parse_query_script(text, query_limits()).unwrap()
    assert_true(query_binding_count(script_query(script)) > 0)
  }
}

///|
test "WITH current graph-hop-node-predicate public source parses" {
  for text in [
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@edges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) FROM GRAPH g |> MATCH p = WALK (a:Node WHERE id = 1)-[:R]->(b:Node WHERE b.payload.score > 10) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@edges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) FROM GRAPH g |> MATCH p = WALK (a:Node WHERE id = 1)-[:R]->(b:Node WHERE payload.score > 10) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@edges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) FROM GRAPH g |> MATCH p = WALK (a:Node WHERE id = 1)-[:R]->(b:Node WHERE `B`.`PAYLOAD`.`score` > 10) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@edges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) FROM GRAPH g |> MATCH p = WALK (a:Node WHERE id = 1)-[:R]->(:Node WHERE payload.score > 10) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@edges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) FROM GRAPH g |> MATCH p = WALK (a:Node WHERE id = 1)-[:R]->(b:Node {id: 3}) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@edges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (key)))) FROM GRAPH g |> MATCH p = WALK (a:Node WHERE id = 1)-[:R WHERE key = 10]->(b:Node WHERE payload.score > 10) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@edges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) FROM GRAPH g |> MATCH p = WALK (a:Node WHERE id = 1)-[:R]->(b:Node WHERE payload.score > 10)-[:R]->(c:Node {id: 2}) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@edges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) FROM GRAPH g |> MATCH p = WALK (a:Node WHERE id = 2)<-[:R]-(b:Node WHERE payload.score > 10) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@edges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) FROM GRAPH g |> MATCH p = WALK (a:Node WHERE id = 1)-[:R]->(b:Node WHERE payload.score IS NULL) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@edges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) FROM GRAPH g |> MATCH p = WALK (a:Node WHERE id = 1)-[:R]->(b:Node WHERE payload.score > 100) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT item.id AS id, item.payload AS payload FROM UNNEST(@nodes) AS item) , links AS (SELECT link.key AS key, link.src AS src, link.dst AS dst FROM UNNEST(@edges) AS link) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Node PROPERTIES ALL COLUMNS) EDGE TABLES (links AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) FROM GRAPH g |> MATCH p = WALK (a:Node WHERE id = 1)-[:R]->(b:Node WHERE payload.score > @min) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH n AS (SELECT 1 AS id, 20 AS score) , e AS (SELECT 10 AS key, 1 AS src, 1 AS dst) , g AS (GRAPH (NODE TABLES (n AS S KEY (id) LABEL Start NO PROPERTIES, n AS T KEY (id) LABEL Target PROPERTIES (score)) EDGE TABLES (e AS E KEY (key) SOURCE KEY (src) REFERENCES S DESTINATION KEY (dst) REFERENCES T LABEL R NO PROPERTIES))) FROM GRAPH g |> MATCH p = WALK (:Start)-[:R]->(b:Target WHERE b.score > 10) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
  ] {
    let script = parse_query_script(text, query_limits()).unwrap()
    assert_true(query_binding_count(script_query(script)) > 0)
  }
}

///|
test "WITH current graph-match public source parses" {
  for text in [
    "WITH n AS (SELECT 2 AS node_key, @a AS p UNION ALL SELECT 1 AS node_key, @b AS p UNION ALL SELECT 3 AS node_key, @c AS p) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 2 AS dst_key, 10 AS weight UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 2 AS dst_key, 20 AS weight) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Person PROPERTIES (node_key, p)) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R PROPERTIES (edge_key, weight)))) FROM g |> MATCH_NODES(DEFINITION: 'N', LABEL: 'Person', BINDINGS: {IDENTITY: 'Element'}, WHERE: {literal: true}, FIELDS: ['Element', 'p', 'node_key']) |> SELECT node_key, p, Element IS NOT NULL AS bound |> ORDER BY node_key |> RESULT matched",
    "WITH n AS (SELECT 2 AS node_key, @a AS p UNION ALL SELECT 1 AS node_key, @b AS p UNION ALL SELECT 3 AS node_key, @c AS p) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 2 AS dst_key, 10 AS weight UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 2 AS dst_key, 20 AS weight) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Person PROPERTIES (node_key, p)) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R PROPERTIES (edge_key, weight)))) FROM g |> MATCH_EDGES(DEFINITION: 'E', LABEL: 'R', BINDINGS: {`Identity`: 'Edge', `Source`: 'Source', `Target`: 'Target'}, FIELDS: ['Edge', 'Source', 'Target', 'weight', 'edge_key']) |> SELECT edge_key, weight, Edge IS NOT NULL AS bound, Source IS NOT NULL AS source_bound, Target IS NOT NULL AS target_bound |> ORDER BY edge_key |> RESULT matched",
    "WITH n AS (SELECT 2 AS node_key, @a AS p UNION ALL SELECT 1 AS node_key, @b AS p UNION ALL SELECT 3 AS node_key, @c AS p) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 2 AS dst_key, 10 AS weight UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 2 AS dst_key, 20 AS weight) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Person PROPERTIES (node_key, p)) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R PROPERTIES (edge_key, weight)))) FROM g |> MATCH_NODES(DEFINITION: 'N', LABEL: 'Person', BINDINGS: {`Identity`: 'Element'}, WHERE: {gt: [{field: 'p'}, {literal: 100}]}, FIELDS: ['Element', 'p', 'node_key']) |> SELECT node_key, p, Element IS NOT NULL AS bound |> ORDER BY node_key |> RESULT matched",
    "WITH n AS (SELECT 2 AS node_key, @a AS p UNION ALL SELECT 1 AS node_key, @b AS p UNION ALL SELECT 3 AS node_key, @c AS p) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 2 AS dst_key, 10 AS weight UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 2 AS dst_key, 20 AS weight) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Person PROPERTIES (node_key, p)) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R PROPERTIES (edge_key, weight)))) , endpoints AS (FROM g |> MATCH_EDGES(DEFINITION: 'E', BINDINGS: {SOURCE: 'Source', `Target`: 'Target'}, FIELDS: ['Source', 'Target'])) FROM g |> subgraph(nodes: {from: endpoints, id: 'Source'}) |> match_nodes(definition: 'N', where: {literal: true}, fields: ['p', 'node_key']) |> SELECT p, node_key |> ORDER BY node_key |> RESULT matched",
    "WITH n AS (SELECT 2 AS node_key, @a AS p UNION ALL SELECT 1 AS node_key, @b AS p UNION ALL SELECT 3 AS node_key, @c AS p) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 2 AS dst_key, 10 AS weight UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 2 AS dst_key, 20 AS weight) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Person PROPERTIES (node_key, p)) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R PROPERTIES (edge_key, weight)))) , endpoints AS (FROM g |> MATCH_EDGES(DEFINITION: 'E', BINDINGS: {SOURCE: 'Source', `Target`: 'Target'}, FIELDS: ['Source', 'Target'])) FROM g |> subgraph(nodes: {from: endpoints, id: 'Target'}) |> match_nodes(definition: 'N', where: {literal: true}, fields: ['p', 'node_key']) |> SELECT p, node_key |> ORDER BY node_key |> RESULT matched",
    "WITH n AS (SELECT 2 AS node_key, @a AS p UNION ALL SELECT 1 AS node_key, @b AS p UNION ALL SELECT 3 AS node_key, @c AS p) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 2 AS dst_key, 10 AS weight UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 2 AS dst_key, 20 AS weight) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Person PROPERTIES (node_key, p)) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R PROPERTIES (edge_key, weight)))) FROM g |> match_nodes(definition: 'N', label: 'Person', where: {gt: [{field: 'p'}, {literal: 10}]}, fields: ['p', 'node_key']) |> SELECT p, node_key |> ORDER BY node_key |> RESULT matched",
    "WITH n AS (SELECT 2 AS node_key, @a AS p UNION ALL SELECT 1 AS node_key, @b AS p UNION ALL SELECT 3 AS node_key, @c AS p) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 2 AS dst_key, 10 AS weight UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 2 AS dst_key, 20 AS weight) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Person PROPERTIES (node_key, p)) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R PROPERTIES (edge_key, weight)))) FROM g |> match_nodes(definition: 'N', label: 'Person', where: {is_null: {field: 'p'}}, fields: ['p', 'node_key']) |> SELECT p, node_key |> ORDER BY node_key |> RESULT matched",
    "WITH n AS (SELECT 2 AS node_key, @a AS p UNION ALL SELECT 1 AS node_key, @b AS p UNION ALL SELECT 3 AS node_key, @c AS p) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 2 AS dst_key, 10 AS weight UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 2 AS dst_key, 20 AS weight) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Person PROPERTIES (node_key, p)) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R PROPERTIES (edge_key, weight)))) FROM g |> match_nodes(definition: 'N', label: 'Person', where: {gt: [{field: 'p'}, {literal: 100}]}, fields: ['p', 'node_key']) |> SELECT p, node_key |> ORDER BY node_key |> RESULT matched",
    "WITH n AS (SELECT 2 AS node_key, @a AS p UNION ALL SELECT 1 AS node_key, @b AS p UNION ALL SELECT 3 AS node_key, @c AS p) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 2 AS dst_key, 10 AS weight UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 2 AS dst_key, 20 AS weight) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Person PROPERTIES (node_key, p)) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R PROPERTIES (edge_key, weight)))) FROM g |> match_nodes(definition: 'N', label: 'Person', where: {gt: [{field: 'p'}, @minimum]}, fields: ['p', 'node_key']) |> SELECT p, node_key |> ORDER BY node_key |> RESULT matched",
    "WITH n AS (SELECT 2 AS node_key, @a AS p UNION ALL SELECT 1 AS node_key, @b AS p UNION ALL SELECT 3 AS node_key, @c AS p) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 2 AS dst_key, 10 AS weight UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 2 AS dst_key, 20 AS weight) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Person PROPERTIES (node_key, p)) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R PROPERTIES (edge_key, weight)))) , `selected rows` AS (FROM `g` |> match_nodes(definition: 'n', label: 'person', where: {gt: [{field: 'p'}, {literal: 10}]}, fields: ['p', 'node_key']) |> SELECT p AS score, node_key AS key) FROM `selected rows` |> WHERE key > 0 |> ORDER BY key |> RESULT matched",
    "WITH n AS (SELECT 2 AS node_key, @a AS p UNION ALL SELECT 1 AS node_key, @b AS p UNION ALL SELECT 3 AS node_key, @c AS p) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 2 AS dst_key, 10 AS weight UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 2 AS dst_key, 20 AS weight) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Person PROPERTIES (node_key, p)) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R PROPERTIES (edge_key, weight)))) FROM g |> match_edges(definition: 'E', label: 'R', fields: ['weight', 'edge_key']) |> SELECT weight, edge_key |> ORDER BY edge_key |> RESULT matched",
    "WITH n AS (SELECT 2 AS node_key, @a AS p UNION ALL SELECT 1 AS node_key, @b AS p UNION ALL SELECT 3 AS node_key, @c AS p) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 2 AS dst_key, 10 AS weight UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 2 AS dst_key, 20 AS weight) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Person PROPERTIES (node_key, p)) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R PROPERTIES (edge_key, weight)))) FROM g |> match_edges(definition: 'E', label: 'R', types: [], fields: ['weight', 'edge_key']) |> SELECT weight, edge_key |> ORDER BY edge_key |> RESULT matched",
    "WITH n AS (SELECT 2 AS node_key, @a AS p UNION ALL SELECT 1 AS node_key, @b AS p UNION ALL SELECT 3 AS node_key, @c AS p) , e AS (SELECT 11 AS edge_key, 1 AS src_key, 2 AS dst_key, 10 AS weight UNION ALL SELECT 10 AS edge_key, 1 AS src_key, 2 AS dst_key, 20 AS weight) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Person PROPERTIES (node_key, p)) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src_key) REFERENCES N DESTINATION KEY (dst_key) REFERENCES N LABEL R PROPERTIES (edge_key, weight)))) FROM g |> match_edges(definition: 'E', label: 'R', where: {gt: [{field: 'weight'}, {literal: 10}]}, fields: ['weight', 'edge_key']) |> SELECT weight, edge_key |> ORDER BY edge_key |> RESULT matched",
  ] {
    let script = parse_query_script(text, query_limits()).unwrap()
    assert_true(query_binding_count(script_query(script)) > 0)
  }
}

///|
test "WITH current graph-projection-property public source parses" {
  for text in [
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person) |> SELECT a.id AS id, a.payload.score AS score |> ORDER BY id |> RESULT matched",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person) |> SELECT id, payload.score AS score |> ORDER BY id |> RESULT matched",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person) |> SELECT `A`.`ID` AS id, `A`.`PAYLOAD`.`score` AS score |> ORDER BY id |> RESULT matched",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person) |> WHERE NODE_ID(a) IS NOT NULL AND a.payload.score > @min |> SELECT a.id AS id, a.payload.score AS score |> ORDER BY id |> RESULT matched",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person) |> WHERE NODE_ID((a)) IS NOT NULL AND a.payload.score > @min |> SELECT a.id AS id, a.payload.score AS score |> ORDER BY id |> RESULT matched",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person) |> WHERE NODE_ID((((a)))) IS NOT NULL AND a.payload.score > @min |> SELECT a.id AS id, a.payload.score AS score |> ORDER BY id |> RESULT matched",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person) |> WHERE NODE_ID((`A`)) IS NOT NULL AND a.payload.score > @min |> SELECT a.id AS id, a.payload.score AS score |> ORDER BY id |> RESULT matched",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person) |> WHERE NODE_ID((a)) IS NOT NULL AND a.payload.score > 100 |> SELECT a.id AS id, a.payload.score AS score |> ORDER BY id |> RESULT matched",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS key, 1 AS src, 1 AS dst UNION ALL SELECT 11 AS key, 1 AS src, 1 AS dst) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) FROM GRAPH g |> MATCH p = WALK (a:Node)-[:R]->(b:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS key, 1 AS src, 1 AS dst UNION ALL SELECT 11 AS key, 1 AS src, 1 AS dst) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) FROM GRAPH g |> MATCH p = WALK (a:Node)-[:R]->(b:Node) |> SELECT PATH_LENGTH(((p))) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS key, 1 AS src, 1 AS dst UNION ALL SELECT 11 AS key, 1 AS src, 1 AS dst) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) FROM GRAPH g |> MATCH p = WALK (a:Node)-[:R]->(b:Node) |> SELECT PATH_LENGTH((`P`)) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person) |> WHERE `NODE_ID`(`A`) IS NOT NULL AND a.payload.score > @min |> SELECT a.id AS id, a.payload.score AS score |> ORDER BY id |> RESULT matched",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person) |> WHERE `nOdE_iD`(`A`) IS NOT NULL AND a.payload.score > @min |> SELECT a.id AS id, a.payload.score AS score |> ORDER BY id |> RESULT matched",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person) |> WHERE `\\x4eODE_ID`(`A`) IS NOT NULL AND a.payload.score > @min |> SELECT a.id AS id, a.payload.score AS score |> ORDER BY id |> RESULT matched",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person) |> WHERE `NODE_ID`(a) IS NOT NULL AND a.payload.score > 100 |> SELECT a.id AS id, a.payload.score AS score |> ORDER BY id |> RESULT matched",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS key, 1 AS src, 1 AS dst UNION ALL SELECT 11 AS key, 1 AS src, 1 AS dst) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) FROM GRAPH g |> MATCH p = WALK (a:Node)-[:R]->(b:Node) |> SELECT PATH_LENGTH(`P`) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS key, 1 AS src, 1 AS dst UNION ALL SELECT 11 AS key, 1 AS src, 1 AS dst) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) FROM GRAPH g |> MATCH p = WALK (a:Node)-[:R]->(b:Node) |> SELECT `pAtH_lEnGtH`(`P`) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS key, 1 AS src, 1 AS dst UNION ALL SELECT 11 AS key, 1 AS src, 1 AS dst) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) FROM GRAPH g |> MATCH p = WALK (a:Node)-[:R]->(b:Node) |> SELECT `\\x50ATH_LENGTH`(`P`) AS depth |> ORDER BY depth |> RESULT matched",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person) |> WHERE a.payload.score IS NULL |> SELECT a.id AS id, a.payload.score AS score |> ORDER BY id |> RESULT matched",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person) |> WHERE a.payload.score > 100 |> SELECT a.id AS id, a.payload.score AS score |> ORDER BY id |> RESULT matched",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person) |> SELECT a.id AS id, a.payload AS kept |> SELECT id, kept.score AS score |> ORDER BY id |> RESULT matched",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person) |> SELECT a.id AS id, a.payload.SCORE AS score |> ORDER BY id |> RESULT matched",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person) |> SELECT `A`.`ID` AS id, `A`.`PAYLOAD`.`ScOrE` AS score |> ORDER BY id |> RESULT matched",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person) |> SELECT a.id AS id, a.payload AS kept |> SELECT id, kept.SCORE AS score |> ORDER BY id |> RESULT matched",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person) |> WHERE a.payload.SCORE IS NULL |> SELECT a.id AS id, a.payload.SCORE AS score |> ORDER BY id |> RESULT matched",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person) |> WHERE a.payload.SCORE > 100 |> SELECT a.id AS id, a.payload.SCORE AS score |> ORDER BY id |> RESULT matched",
  ] {
    let script = parse_query_script(text, query_limits()).unwrap()
    assert_true(query_binding_count(script_query(script)) > 0)
  }
}

///|
test "WITH current graph-property-predicate public source parses" {
  for text in [
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload)))) FROM GRAPH g |> MATCH p = WALK (:Node)-[:R WHERE weight > 10]->(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload)))) FROM GRAPH g |> MATCH p = WALK (:Node)-[:R WHERE weight > 10]->()-[:R WHERE weight IS NULL]->(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload)))) FROM GRAPH g |> MATCH p = WALK (:Node)-[:R {weight: 20}]->(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload)))) FROM GRAPH g |> MATCH p = WALK (:Node)-[:`r` WHERE `WEIGHT` > 10]->(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload)))) FROM GRAPH g |> MATCH p = WALK (:Node)-[:R WHERE weight IS NULL]->(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload)))) FROM GRAPH g |> MATCH p = WALK (:Node)-[:R WHERE payload.score IS NULL]->(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload)))) FROM GRAPH g |> MATCH p = WALK (:Node)-[:R WHERE payload.score > 10]->(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload)))) FROM GRAPH g |> MATCH p = WALK (:Node)-[:R WHERE weight > @minimum]->(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload)))) FROM GRAPH g |> MATCH p = WALK (:Node)-[:R WHERE weight > 100]->(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , empty_edges AS (FROM e |> WHERE edge_key < 0) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload), empty_edges AS F KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL S NO PROPERTIES))) FROM GRAPH g |> MATCH p = WALK (:Node)-[:R WHERE weight > 10]->(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload) LABEL Other NO PROPERTIES))) FROM GRAPH g |> MATCH p = WALK (:Node)-[:Other WHERE weight > 10]->(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload)))) FROM GRAPH g |> MATCH p = WALK (:Node)-[:R WHERE weight > 10]->{0,2}(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload)))) FROM GRAPH g |> MATCH p = TRAIL (:Node)-[:R WHERE weight > 10]->{0,2}(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH n AS (SELECT 1 AS id) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst, 10 AS weight, @a AS payload UNION ALL SELECT 11 AS edge_key, 1 AS src, 1 AS dst, 20 AS weight, @b AS payload UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst, CAST(NULL AS FLOAT64) AS weight, @c AS payload) , g AS (GRAPH (NODE TABLES (n AS N KEY (id) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R PROPERTIES (weight, payload)))) FROM GRAPH g |> MATCH p = ACYCLIC (:Node)-[:R WHERE weight > 10]->{0,2}(:Node) |> SELECT PATH_LENGTH(p) AS depth |> ORDER BY depth |> RESULT paths",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person WHERE a.payload.score > 10) |> SELECT a.id AS id |> ORDER BY id |> RESULT matched",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person WHERE payload.score > 10) |> SELECT a.id AS id |> ORDER BY id |> RESULT matched",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person WHERE `A`.`PAYLOAD`.`score` > 10) |> SELECT a.id AS id |> ORDER BY id |> RESULT matched",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (:Person WHERE payload.score > 10) |> SELECT id AS id |> ORDER BY id |> RESULT matched",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person WHERE payload.score IS NULL) |> SELECT a.id AS id |> ORDER BY id |> RESULT matched",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person WHERE payload.score IS NULL OR payload.score > 10) |> SELECT a.id AS id |> ORDER BY id |> RESULT matched",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person WHERE payload.score > 100) |> SELECT a.id AS id |> ORDER BY id |> RESULT matched",
    "WITH objects AS (SELECT 2 AS id, @a AS payload UNION ALL SELECT 1 AS id, @b AS payload UNION ALL SELECT 3 AS id, @c AS payload UNION ALL SELECT 4 AS id, @d AS payload) , g AS (GRAPH (NODE TABLES (objects AS N KEY (id) LABEL Person PROPERTIES (id, payload)))) FROM GRAPH g |> MATCH WALK (a:Person WHERE payload.score > @min) |> SELECT a.id AS id |> ORDER BY id |> RESULT matched",
  ] {
    let script = parse_query_script(text, query_limits()).unwrap()
    assert_true(query_binding_count(script_query(script)) > 0)
  }
}

///|
test "WITH current graph-reach public source parses" {
  for text in [
    "WITH n AS (SELECT 1 AS node_key) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES))) , seeds AS (FROM g |> node_rows() |> SELECT id AS element) FROM g |> reach(start: {from: seeds, id: 'element'}, direction: 'out', max_depth: 1) |> SELECT start_id, node_id, depth |> WHERE depth >= 0 |> ORDER BY depth |> RESULT reached",
    "WITH n AS (SELECT 1 AS node_key) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES))) , reached AS (FROM g |> reach(start: {where: 'true'}, direction: 'both', max_depth: 2)) FROM reached |> SELECT start_id, node_id, depth |> WHERE depth >= 0 |> ORDER BY depth |> RESULT reached",
    "WITH n AS (SELECT 1 AS node_key) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES))) FROM g |> reach(start: {where: 'false'}, direction: 'in', max_depth: 1) |> SELECT start_id, node_id, depth |> WHERE depth >= 0 |> ORDER BY depth |> RESULT reached",
    "WITH n AS (SELECT 1 AS node_key) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES))) , seeds AS (FROM g |> node_rows() |> WHERE node_key > 1 |> SELECT id AS element) FROM g |> reach(start: {from: seeds, id: 'element'}, direction: 'out', max_depth: 1) |> SELECT start_id, node_id, depth |> WHERE depth >= 0 |> ORDER BY depth |> RESULT reached",
    "WITH n AS (SELECT node_key, node_key AS seed FROM UNNEST([3, 2, 1]) node_key) , e AS (SELECT 13 AS edge_key, 2 AS src, 3 AS dst UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst UNION ALL SELECT 11 AS edge_key, 1 AS src, 2 AS dst UNION ALL SELECT 10 AS edge_key, 1 AS src, 2 AS dst) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node PROPERTIES (seed)) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) , reached AS (FROM g |> reach(start: {where: 'seed = 1'}, direction: 'out', max_depth: 2)) FROM reached |> SELECT depth |> ORDER BY depth |> RESULT reached",
    "WITH n AS (SELECT node_key, node_key AS seed FROM UNNEST([3, 2, 1]) node_key) , e AS (SELECT 13 AS edge_key, 2 AS src, 3 AS dst UNION ALL SELECT 12 AS edge_key, 1 AS src, 1 AS dst UNION ALL SELECT 11 AS edge_key, 1 AS src, 2 AS dst UNION ALL SELECT 10 AS edge_key, 1 AS src, 2 AS dst) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node PROPERTIES (seed)) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) , reached AS (FROM g |> reach(start: {where: 'seed = 1'}, direction: 'in', max_depth: 2)) FROM reached |> SELECT depth |> ORDER BY depth |> RESULT reached",
  ] {
    let script = parse_query_script(text, query_limits()).unwrap()
    assert_true(query_binding_count(script_query(script)) > 0)
  }
}

///|
test "WITH current graph-relation-join public source parses" {
  for text in [
    "WITH n AS (SELECT 1 AS node_key, 7 AS p) , r AS (SELECT 20 AS tag UNION ALL SELECT 10 AS tag) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node PROPERTIES (p)) EDGE TABLES (n AS E KEY (node_key) SOURCE KEY (node_key) REFERENCES N DESTINATION KEY (node_key) REFERENCES N LABEL R PROPERTIES (p)))) FROM g |> degree(direction: 'out') |> AS l |> CROSS JOIN r AS rr MAX_OUTPUT_ROWS 10 |> SELECT l.degree AS value, rr.tag AS tag |> ORDER BY tag",
    "WITH n AS (SELECT 1 AS node_key, 7 AS p) , r AS (SELECT 20 AS tag UNION ALL SELECT 10 AS tag) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node PROPERTIES (p)) EDGE TABLES (n AS E KEY (node_key) SOURCE KEY (node_key) REFERENCES N DESTINATION KEY (node_key) REFERENCES N LABEL R PROPERTIES (p)))) FROM g |> components(kind: 'weak', max_output_rows: 10) |> AS l |> CROSS JOIN r AS rr MAX_OUTPUT_ROWS 10 |> SELECT l.component_size AS value, rr.tag AS tag |> ORDER BY tag",
    "WITH n AS (SELECT 1 AS node_key, 7 AS p) , r AS (SELECT 20 AS tag UNION ALL SELECT 10 AS tag) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node PROPERTIES (p)) EDGE TABLES (n AS E KEY (node_key) SOURCE KEY (node_key) REFERENCES N DESTINATION KEY (node_key) REFERENCES N LABEL R PROPERTIES (p)))) FROM g |> graph_bounds(max_nodes: 0) |> AS l |> CROSS JOIN r AS rr MAX_OUTPUT_ROWS 10 |> SELECT l.actual AS value, rr.tag AS tag |> ORDER BY tag",
    "WITH n AS (SELECT 1 AS node_key, 7 AS p) , r AS (SELECT 20 AS tag UNION ALL SELECT 10 AS tag) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node PROPERTIES (p)) EDGE TABLES (n AS E KEY (node_key) SOURCE KEY (node_key) REFERENCES N DESTINATION KEY (node_key) REFERENCES N LABEL R PROPERTIES (p)))) FROM g |> graphs_equal(with: g) |> AS l |> CROSS JOIN r AS rr MAX_OUTPUT_ROWS 10 |> SELECT l.equal AS value, rr.tag AS tag |> ORDER BY tag",
    "WITH n AS (SELECT 1 AS node_key, 7 AS p) , r AS (SELECT 20 AS tag UNION ALL SELECT 10 AS tag) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node PROPERTIES (p)) EDGE TABLES (n AS E KEY (node_key) SOURCE KEY (node_key) REFERENCES N DESTINATION KEY (node_key) REFERENCES N LABEL R PROPERTIES (p)))) FROM g |> match_nodes(definition: 'N', where: {literal: true}, fields: ['p']) |> AS l |> CROSS JOIN r AS rr MAX_OUTPUT_ROWS 10 |> SELECT l.p AS value, rr.tag AS tag |> ORDER BY tag",
    "WITH n AS (SELECT 1 AS node_key, 7 AS p) , r AS (SELECT 20 AS tag UNION ALL SELECT 10 AS tag) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node PROPERTIES (p)) EDGE TABLES (n AS E KEY (node_key) SOURCE KEY (node_key) REFERENCES N DESTINATION KEY (node_key) REFERENCES N LABEL R PROPERTIES (p)))) FROM g |> match_edges(definition: 'E', fields: ['p']) |> AS l |> CROSS JOIN r AS rr MAX_OUTPUT_ROWS 10 |> SELECT l.p AS value, rr.tag AS tag |> ORDER BY tag",
    "WITH n AS (SELECT 1 AS node_key, 7 AS p) , r AS (SELECT 20 AS tag UNION ALL SELECT 10 AS tag) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node PROPERTIES (p)) EDGE TABLES (n AS E KEY (node_key) SOURCE KEY (node_key) REFERENCES N DESTINATION KEY (node_key) REFERENCES N LABEL R PROPERTIES (p)))) FROM g |> normalize_graph() |> degree(direction: 'out') |> AS l |> CROSS JOIN r AS rr MAX_OUTPUT_ROWS 10 |> SELECT l.degree AS value, rr.tag AS tag |> ORDER BY tag",
    "WITH n AS (SELECT 1 AS node_key, 7 AS p) , r AS (SELECT 20 AS tag UNION ALL SELECT 10 AS tag) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node PROPERTIES (p)) EDGE TABLES (n AS E KEY (node_key) SOURCE KEY (node_key) REFERENCES N DESTINATION KEY (node_key) REFERENCES N LABEL R PROPERTIES (p)))) FROM g |> graph_bounds(max_nodes: @p) |> AS l |> CROSS JOIN r AS rr MAX_OUTPUT_ROWS 10 |> SELECT l.actual AS value, rr.tag AS tag |> ORDER BY tag",
    "WITH n AS (SELECT 1 AS node_key, 7 AS p) , r AS (SELECT 20 AS tag UNION ALL SELECT 10 AS tag) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node PROPERTIES (p)) EDGE TABLES (n AS E KEY (node_key) SOURCE KEY (node_key) REFERENCES N DESTINATION KEY (node_key) REFERENCES N LABEL R PROPERTIES (p)))) FROM g |> match_nodes(definition: 'N', where: {gt: [{field: 'p'}, {literal: 7}]}, fields: ['p']) |> AS l |> CROSS JOIN r AS rr MAX_OUTPUT_ROWS 10 |> SELECT l.p AS value, rr.tag AS tag |> ORDER BY tag",
    "WITH n AS (SELECT 1 AS node_key, 7 AS p) , r AS (SELECT 20 AS tag UNION ALL SELECT 10 AS tag) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node PROPERTIES (p)) EDGE TABLES (n AS E KEY (node_key) SOURCE KEY (node_key) REFERENCES N DESTINATION KEY (node_key) REFERENCES N LABEL R PROPERTIES (p)))) FROM g |> degree(direction: 'out') |> WHERE degree = 1 |> AS l |> CROSS JOIN r AS rr MAX_OUTPUT_ROWS 10 |> SELECT l.degree AS value, rr.tag AS tag |> ORDER BY tag |> LIMIT 1",
    "WITH n AS (SELECT 1 AS node_key) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES))) , r AS (SELECT 20 AS tag UNION ALL SELECT 10 AS tag) FROM g |> graph_diff(with: g) |> AS l |> CROSS JOIN r AS rr MAX_OUTPUT_ROWS 10 |> SELECT l.delta AS value, rr.tag AS tag |> ORDER BY tag",
  ] {
    let script = parse_query_script(text, query_limits()).unwrap()
    assert_true(query_binding_count(script_query(script)) > 0)
  }
}

///|
test "WITH current graph-subtraction public source parses" {
  for text in [
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) FROM g |> SUBTRACT_GRAPHS(WITH: g, MERGE: {NODE_PROPERTIES: {p: 'number_sum'}, EDGE_PROPERTIES: {w: 'number_sum'}}) |> node_rows() |> SELECT p, part, node_key, labels |> ORDER BY node_key |> RESULT nodes",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) FROM g |> SUBTRACT_GRAPHS(WITH: g, MERGE: {NODE_PROPERTIES: {p: 'number_sum'}, EDGE_PROPERTIES: {w: 'number_sum'}}) |> edge_rows() |> SELECT w, part, edge_key, labels |> ORDER BY edge_key |> RESULT edges",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) FROM g |> subtract_graphs(with: g, merge: {`Node_Properties`: {P: 'number_sum'}, `Edge_Properties`: {W: 'number_sum'}}) |> node_rows() |> SELECT p, part, node_key, labels |> ORDER BY node_key |> RESULT nodes",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) FROM g |> subtract_graphs(with: g, merge: {`Node_Properties`: {P: 'number_sum'}, `Edge_Properties`: {W: 'number_sum'}}) |> edge_rows() |> SELECT w, part, edge_key, labels |> ORDER BY edge_key |> RESULT edges",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) FROM g |> subtract_graphs(with: g) |> node_rows() |> SELECT p, part, node_key, labels |> ORDER BY node_key |> RESULT nodes",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) FROM g |> subtract_graphs(with: g) |> edge_rows() |> SELECT w, part, edge_key, labels |> ORDER BY edge_key |> RESULT edges",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) FROM g |> subtract_graphs(with: g, merge: {node_properties: {p: 'exact_equal'}}) |> node_rows() |> SELECT p, part, node_key, labels |> ORDER BY node_key |> RESULT nodes",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) FROM g |> subtract_graphs(with: g, merge: {node_properties: {p: 'exact_equal'}}) |> edge_rows() |> SELECT w, part, edge_key, labels |> ORDER BY edge_key |> RESULT edges",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) FROM g |> subtract_graphs(with: g, merge: {edge_properties: {w: 'exact_equal'}}) |> edge_rows() |> SELECT w, part, edge_key, labels |> ORDER BY edge_key |> RESULT edges",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , `peer graph` AS (FROM g) , remaining AS (FROM g |> subtract_graphs(with: `peer graph`, merge: {node_properties: {p: 'number_sum'}, edge_properties: {w: 'number_sum'}})) FROM remaining |> node_rows() |> SELECT p, part, node_key, labels |> ORDER BY node_key |> RESULT nodes",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , `peer graph` AS (FROM g) , remaining AS (FROM g |> subtract_graphs(with: `peer graph`, merge: {node_properties: {p: 'number_sum'}, edge_properties: {w: 'number_sum'}})) FROM remaining |> edge_rows() |> SELECT w, part, edge_key, labels |> ORDER BY edge_key |> RESULT edges",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p UNION ALL SELECT 7 AS part, 2 AS node_key, 9 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 2 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 2 AS src_key, 2 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , selected AS (FROM g |> node_rows() |> WHERE node_key = 1 |> SELECT id) , peer AS (FROM g |> subgraph(nodes: {from: selected, id: \"id\"})) FROM g |> subtract_graphs(with: peer) |> node_rows() |> SELECT p, part, node_key, labels |> ORDER BY node_key |> RESULT nodes",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p UNION ALL SELECT 7 AS part, 2 AS node_key, 9 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 2 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 2 AS src_key, 2 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , selected AS (FROM g |> node_rows() |> WHERE node_key = 1 |> SELECT id) , peer AS (FROM g |> subgraph(nodes: {from: selected, id: \"id\"})) FROM g |> subtract_graphs(with: peer) |> edge_rows() |> SELECT w, part, edge_key, labels |> ORDER BY edge_key |> RESULT edges",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 0 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) FROM g |> subtract_graphs(with: g, merge: {node_properties: {p: 'number_sum'}}) |> node_rows() |> SELECT p, part, node_key, labels |> ORDER BY node_key |> RESULT nodes",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, CAST(NULL AS FLOAT64) AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) FROM g |> subtract_graphs(with: g) |> node_rows() |> SELECT p, part, node_key, labels |> ORDER BY node_key |> RESULT nodes",
  ] {
    let script = parse_query_script(text, query_limits()).unwrap()
    assert_true(query_binding_count(script_query(script)) > 0)
  }
}

///|
test "WITH current graph-traverse-path public source parses" {
  for text in [
    "WITH n AS (SELECT 1 AS node_key) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst) , f AS (SELECT 11 AS edge_key, 1 AS src, 1 AS dst) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES, f AS F KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) , seeds AS (FROM g |> match_nodes(definition: 'N', bindings: {identity: 'id'}, where: {literal: true}, fields: ['id']) |> SELECT id AS element) FROM g |> traverse(start: {from: seeds, id: 'element'}, direction: 'out', min_hops: 2, max_hops: 2, path_mode: 'trail', emit: 'paths', max_output_rows: 10) |> SELECT start_id, end_id, hop_count, node_ids, edge_ids |> RESULT paths",
    "WITH n AS (SELECT 1 AS node_key) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst) , f AS (SELECT 11 AS edge_key, 1 AS src, 1 AS dst) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES, f AS F KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) , seeds AS (FROM g |> node_rows() |> SELECT id AS element) FROM g |> traverse(start: {from: seeds, id: 'element'}, direction: 'out', min_hops: 2, max_hops: 2, path_mode: 'walk', emit: 'paths', max_output_rows: 10) |> SELECT start_id, end_id, hop_count, node_ids, edge_ids |> RESULT paths",
    "WITH n AS (SELECT 1 AS node_key) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst) , f AS (SELECT 11 AS edge_key, 1 AS src, 1 AS dst) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES, f AS F KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) , seeds AS (FROM g |> node_rows() |> SELECT id AS element) FROM g |> traverse(start: {from: seeds, id: 'element'}, direction: 'out', min_hops: 2, max_hops: 2, path_mode: 'trail', emit: 'paths', max_output_rows: 10) |> SELECT start_id, end_id, hop_count, node_ids, edge_ids |> RESULT paths",
    "WITH n AS (SELECT 1 AS node_key) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst) , f AS (SELECT 11 AS edge_key, 1 AS src, 1 AS dst) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES, f AS F KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) , seeds AS (FROM g |> node_rows() |> SELECT id AS element) FROM g |> traverse(start: {from: seeds, id: 'element'}, direction: 'out', min_hops: 0, max_hops: 2, path_mode: 'acyclic', emit: 'paths', max_output_rows: 10) |> SELECT start_id, end_id, hop_count, node_ids, edge_ids |> RESULT paths",
    "WITH n AS (SELECT 1 AS node_key) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst) , f AS (SELECT 11 AS edge_key, 1 AS src, 1 AS dst) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES, f AS F KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) , seeds AS (FROM g |> node_rows() |> SELECT id AS element) FROM g |> traverse(start: {from: seeds, id: 'element'}, direction: 'out', min_hops: 1, max_hops: 2, path_mode: 'acyclic', emit: 'paths', max_output_rows: 10) |> SELECT start_id, end_id, hop_count, node_ids, edge_ids |> RESULT paths",
    "WITH n AS (SELECT 1 AS node_key) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst) , f AS (SELECT 11 AS edge_key, 1 AS src, 1 AS dst) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES, f AS F KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) , `seed set` AS (FROM g |> node_rows() |> SELECT id AS element) , visited AS (FROM g |> traverse(start: {from: `seed set`, id: 'element'}, direction: 'out', min_hops: 2, max_hops: 2, path_mode: 'trail', emit: 'paths', max_output_rows: 10)) FROM visited |> WHERE hop_count > 1 |> SELECT edge_ids, node_ids, hop_count |> ORDER BY hop_count |> RESULT paths",
    "WITH n AS (SELECT 1 AS node_key) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst) , f AS (SELECT 11 AS edge_key, 1 AS src, 1 AS dst) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES, f AS F KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) , seeds AS (FROM g |> node_rows() |> WHERE node_key > 1 |> SELECT id AS element) FROM g |> traverse(start: {from: seeds, id: 'element'}, direction: 'out', min_hops: 2, max_hops: 2, path_mode: 'trail', emit: 'paths', max_output_rows: 10) |> SELECT start_id, end_id, hop_count, node_ids, edge_ids |> RESULT paths",
    "WITH n AS (SELECT 1 AS node_key) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst) , f AS (SELECT 11 AS edge_key, 1 AS src, 1 AS dst) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES, f AS F KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) , seeds AS (FROM g |> node_rows() |> SELECT id AS element) FROM g |> traverse(start: {from: seeds, id: 'element'}, hops: [{direction: 'out', edge_types: []}], path_mode: 'walk', emit: 'paths') |> SELECT start_id, end_id, hop_count, node_ids, edge_ids |> RESULT paths",
    "WITH n AS (SELECT 1 AS node_key) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst) , f AS (SELECT 11 AS edge_key, 1 AS src, 1 AS dst) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES, f AS F KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) , seeds AS (FROM g |> node_rows() |> SELECT id AS element) FROM g |> TRAVERSE(START: {FROM: seeds, ID: 'element'}, HOPS: [{DIRECTION: 'out', EDGE_TYPES: ['R'], NODE_WHERE: {literal: true}}, {DIRECTION: 'out', EDGE_WHERE: {literal: true}}], PATH_MODE: 'trail', EMIT: 'paths', MAX_OUTPUT_ROWS: 10) |> SELECT start_id, end_id, hop_count, node_ids, edge_ids |> RESULT paths",
    "WITH n AS (SELECT 1 AS node_key) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst) , f AS (SELECT 11 AS edge_key, 1 AS src, 1 AS dst) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES, f AS F KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) , seeds AS (FROM g |> node_rows() |> SELECT id AS element) FROM g |> TRAVERSE(START: {FROM: seeds, ID: 'element'}, HOPS: [{`DiReCtIoN`: 'out', EDGE_TYPES: ['R'], `NoDe_WhErE`: {literal: true}}, {`DiReCtIoN`: 'out', EDGE_WHERE: {literal: true}}], PATH_MODE: 'trail', EMIT: 'paths', MAX_OUTPUT_ROWS: 10) |> SELECT start_id, end_id, hop_count, node_ids, edge_ids |> RESULT paths",
    "WITH n AS (SELECT 1 AS node_key) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst) , f AS (SELECT 11 AS edge_key, 1 AS src, 1 AS dst) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES, f AS F KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) , seeds AS (FROM g |> node_rows() |> SELECT id AS element) FROM g |> TRAVERSE(START: {FROM: seeds, ID: 'element'}, HOPS: [{DIRECTION: 'out', EDGE_TYPES: ['R'], NODE_WHERE: {literal: true}}, {DIRECTION: 'out', EDGE_WHERE: {literal: true}}], PATH_MODE: 'trail', EMIT: 'nodes', MAX_OUTPUT_ROWS: 10) |> SELECT start_id, node_id, depth |> ORDER BY depth |> RESULT nodes",
    "WITH n AS (SELECT 1 AS node_key) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst) , f AS (SELECT 11 AS edge_key, 1 AS src, 1 AS dst) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES, f AS F KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) , seeds AS (FROM g |> node_rows() |> SELECT id AS element) FROM g |> TRAVERSE(START: {FROM: seeds, ID: 'element'}, HOPS: [{DIRECTION: 'out', EDGE_TYPES: [], NODE_WHERE: {literal: true}}, {DIRECTION: 'out', EDGE_WHERE: {literal: true}}], PATH_MODE: 'trail', EMIT: 'paths', MAX_OUTPUT_ROWS: 10) |> SELECT start_id, end_id, hop_count, node_ids, edge_ids |> RESULT paths",
    "WITH n AS (SELECT 1 AS node_key) , e AS (SELECT 10 AS edge_key, 1 AS src, 1 AS dst) , f AS (SELECT 11 AS edge_key, 1 AS src, 1 AS dst) , g AS (GRAPH (NODE TABLES (n AS N KEY (node_key) LABEL Node NO PROPERTIES) EDGE TABLES (e AS E KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES, f AS F KEY (edge_key) SOURCE KEY (src) REFERENCES N DESTINATION KEY (dst) REFERENCES N LABEL R NO PROPERTIES))) , seeds AS (FROM g |> node_rows() |> SELECT id AS element) FROM g |> TRAVERSE(START: {FROM: seeds, ID: 'element'}, HOPS: [{DIRECTION: 'out', EDGE_TYPES: ['R'], NODE_WHERE: {literal: true}}, {DIRECTION: 'out', EDGE_WHERE: {literal: false}}], PATH_MODE: 'trail', EMIT: 'paths', MAX_OUTPUT_ROWS: 10) |> SELECT start_id, end_id, hop_count, node_ids, edge_ids |> RESULT paths",
  ] {
    let script = parse_query_script(text, query_limits()).unwrap()
    assert_true(query_binding_count(script_query(script)) > 0)
  }
}

///|
test "WITH current graph-union public source parses" {
  for text in [
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , combined AS (FROM g |> union_graphs(with: [g, g], merge: {node_properties: {p: 'number_sum'}, edge_properties: {w: 'number_sum'}})) FROM combined |> node_rows() |> SELECT p, part, node_key, labels |> RESULT nodes",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , combined AS (FROM g |> union_graphs(with: [g, g], merge: {node_properties: {p: 'number_sum'}, edge_properties: {w: 'number_sum'}})) FROM combined |> edge_rows() |> SELECT w, part, edge_key, labels |> ORDER BY edge_key |> RESULT edges",
    "WITH n AS (SELECT 7 AS part, 1 AS node_key, 7 AS p) , e AS (SELECT 7 AS part, 11 AS edge_key, 1 AS src_key, 1 AS dst_key, 5 AS w UNION ALL SELECT 7 AS part, 10 AS edge_key, 1 AS src_key, 1 AS dst_key, 2 AS w) , g AS (GRAPH (NODE TABLES (n AS N KEY (part, node_key) LABEL Person PROPERTIES (p)) EDGE TABLES (e AS E KEY (part, edge_key) SOURCE KEY (part, src_key) REFERENCES N DESTINATION KEY (part, dst_key) REFERENCES N LABEL R PROPERTIES (w)))) , combined AS (FROM g |> UNION_GRAPHS(WITH: [g, g], MERGE: {NODE_PROPERTIES: {p: 'number_sum'}, EDGE_PROPERTIES: {w: 'number_sum'}})) FROM combined |> node_rows() |> SELECT p, part, node_key, labels |> RESULT nodes",
