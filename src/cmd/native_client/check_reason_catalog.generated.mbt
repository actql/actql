// Generated by scripts/generate-check-reason-catalog.mjs --write.
// Presentation only; never determines validity or authorizes execution.

///|
fn local_check_reason_presentation(
  code : String,
  facts : Map[String, Json],
) -> (String, String)? {
  match code {
    "analysis_budget_exhausted" =>
      Some(
        (
          "The analysis budget was exhausted.", "Ask the checking-context owner to review the analysis budget.",
        ),
      )
    "binding_json_invalid" => {
      if (
          facts.get("document") == Some(Json::string("parameters")) ||
          facts.get("document") == Some(Json::string("parameter_declarations"))
        ) &&
        facts.get("issue") == Some(Json::string("invalid_unicode")) {
        return Some(
          (
            "The binding JSON contains invalid Unicode text.", "Use valid Unicode scalar values in member names and string values.",
          ),
        )
      }
      if (
          facts.get("document") == Some(Json::string("parameters")) ||
          facts.get("document") == Some(Json::string("parameter_declarations"))
        ) &&
        facts.get("issue") == Some(Json::string("unexpected_end")) {
        return Some(
          (
            "The binding JSON ends before a value is complete.", "Complete the JSON value and its closing delimiters.",
          ),
        )
      }
      if (
          facts.get("document") == Some(Json::string("parameters")) ||
          facts.get("document") == Some(Json::string("parameter_declarations"))
        ) &&
        facts.get("issue") == Some(Json::string("unexpected_token")) {
        return Some(
          (
            "The binding JSON contains an unexpected token.", "Use a token allowed by JSON at the reported input location.",
          ),
        )
      }
      if (
          facts.get("document") == Some(Json::string("parameters")) ||
          facts.get("document") == Some(Json::string("parameter_declarations"))
        ) &&
        facts.get("issue") == Some(Json::string("invalid_string")) {
        return Some(
          (
            "A binding JSON string is invalid.", "Quote the string and escape control characters using JSON syntax.",
          ),
        )
      }
      if (
          facts.get("document") == Some(Json::string("parameters")) ||
          facts.get("document") == Some(Json::string("parameter_declarations"))
        ) &&
        facts.get("issue") == Some(Json::string("invalid_escape")) {
        return Some(
          (
            "A binding JSON escape is invalid.", "Use an escape sequence allowed by JSON.",
          ),
        )
      }
      if (
          facts.get("document") == Some(Json::string("parameters")) ||
          facts.get("document") == Some(Json::string("parameter_declarations"))
        ) &&
        facts.get("issue") == Some(Json::string("invalid_number")) {
        return Some(
          (
            "A binding JSON number has invalid spelling.", "Use a valid JSON number, including a complete exponent when present.",
          ),
        )
      }
      if (
          facts.get("document") == Some(Json::string("parameters")) ||
          facts.get("document") == Some(Json::string("parameter_declarations"))
        ) &&
        facts.get("issue") == Some(Json::string("number_out_of_range")) {
        return Some(
          (
            "A binding JSON number is outside the admitted numeric range.", "Use a number within the selected input numeric contract.",
          ),
        )
      }
      if (
          facts.get("document") == Some(Json::string("parameters")) ||
          facts.get("document") == Some(Json::string("parameter_declarations"))
        ) &&
        facts.get("issue") == Some(Json::string("negative_zero")) {
        return Some(
          (
            "The binding JSON contains inadmissible negative zero.", "Use an admitted numeric value; negative zero is not admitted.",
          ),
        )
      }
      if (
          facts.get("document") == Some(Json::string("parameters")) ||
          facts.get("document") == Some(Json::string("parameter_declarations"))
        ) &&
        facts.get("issue") == Some(Json::string("expected_colon")) {
        return Some(
          (
            "A binding JSON member is missing its colon.", "Separate the member name and value with a colon.",
          ),
        )
      }
      if (
          facts.get("document") == Some(Json::string("parameters")) ||
          facts.get("document") == Some(Json::string("parameter_declarations"))
        ) &&
        facts.get("issue") == Some(Json::string("expected_array_separator")) {
        return Some(
          (
            "Binding JSON array elements are not separated correctly.", "Use commas between array elements and a closing bracket.",
          ),
        )
      }
      if (
          facts.get("document") == Some(Json::string("parameters")) ||
          facts.get("document") == Some(Json::string("parameter_declarations"))
        ) &&
        facts.get("issue") == Some(Json::string("expected_object_separator")) {
        return Some(
          (
            "Binding JSON object members are not separated correctly.", "Use commas between object members and a closing brace.",
          ),
        )
      }
      if (
          facts.get("document") == Some(Json::string("parameters")) ||
          facts.get("document") == Some(Json::string("parameter_declarations"))
        ) &&
        facts.get("issue") == Some(Json::string("duplicate_key")) {
        return Some(
          (
            "Two binding JSON member names compare equal under the admitted key rules.",
            "Choose distinct member names under the input normalization rules.",
          ),
        )
      }
      if (
          facts.get("document") == Some(Json::string("parameters")) ||
          facts.get("document") == Some(Json::string("parameter_declarations"))
        ) &&
        facts.get("issue") == Some(Json::string("trailing_content")) {
        return Some(
          (
            "Unexpected content follows the binding JSON value.", "Submit one complete JSON value without trailing content.",
          ),
        )
      }
      None
    }
    "bound_values_missing" =>
      Some(
        (
          "Required bound inputs are missing.", "Supply the declared inputs and check again.",
        ),
      )
    "carrier_mismatch" => {
      if facts.get("expected_carrier") == Some(Json::string("relation")) {
        return Some(
          (
            "This operation requires Relation input.", "Provide a Relation before this operation; the current carrier is not a Relation.",
          ),
        )
      }
      if facts.get("expected_carrier") == Some(Json::string("vectors")) {
        return Some(
          (
            "This operation requires Vectors input.", "Provide Vectors before this operation, for example by converting a compatible Relation with to_vectors.",
          ),
        )
      }
      None
    }
    "check_unclassified" =>
      Some(
        (
          "The checker could not establish a classified conclusion.", "Ask the checking-context owner to investigate.",
        ),
      )
    "checking_context_missing" =>
      Some(
        (
          "Required checking-context inputs are missing.", "Review the disclosed Requirement with the checking-context owner; supplying an unrelated parameter does not fulfill it.",
        ),
      )
    "expression_domain_mismatch" => {
      if facts.get("domain") == Some(Json::string("key_comparable_operands")) {
        return Some(
          (
            "The expression operands have incompatible types.", "Use mutually compatible operand types for this operation.",
          ),
        )
      }
      if facts.get("domain") == Some(Json::string("matching_numeric_domains")) {
        return Some(
          (
            "The arithmetic operands do not share a supported numeric domain.", "Use operands from the same supported numeric domain.",
          ),
        )
      }
      None
    }
    "expression_type_mismatch" => {
      if facts.get("expected_type") == Some(Json::string("number")) {
        return Some(
          (
            "An expression argument must have number type.", "Use an expression with number type for the rejected argument.",
          ),
        )
      }
      if facts.get("expected_type") == Some(Json::string("boolean")) {
        return Some(
          (
            "An expression argument must have boolean type.", "Use an expression with boolean type for the rejected argument.",
          ),
        )
      }
      if facts.get("expected_type") == Some(Json::string("string")) {
        return Some(
          (
            "An expression argument must have string type.", "Use an expression with string type for the rejected argument.",
          ),
        )
      }
      Some(
        (
          "An expression violates its required argument type.", "Use an argument with the required type.",
        ),
      )
    }
    "graph_operation_invalid" => {
      if facts.get("operation") == Some(Json::string("components")) &&
        facts.get("issue") == Some(Json::string("invalid_kind")) {
        return Some(
          (
            "The components kind is invalid.", "Choose weak or strong for components kind.",
          ),
        )
      }
      if facts.get("operation") == Some(Json::string("components")) &&
        facts.get("issue") == Some(Json::string("invalid_output_rows")) {
        return Some(
          (
            "The components output row limit is invalid.", "Supply a positive safe integer for components max_output_rows.",
          ),
        )
      }
      if facts.get("operation") == Some(Json::string("subgraph")) &&
        facts.get("issue") == Some(Json::string("invalid_node_selector")) {
        return Some(
          (
            "The Subgraph node selector is invalid.", "Provide one selector: nonempty ids, a named Relation with an id field, or a node where predicate.",
          ),
        )
      }
      None
    }
    "host_capacity_policy_required" =>
      Some(
        (
          "The checking context has no selected Host capacity policy.", "Ask the checking-context owner to supply a policy admitted by the referenced schema, then check the complete bound input again.",
        ),
      )
    "implementation_limit" => {
      if facts.get("issue") ==
        Some(Json::string("function_lowering_unresolved")) {
        return Some(
          (
            "The expression lowerer cannot classify or support this function form.",
            "Ask the checking-context owner to review function support at the original expression; this is not a proven function-name violation.",
          ),
        )
      }
      Some(
        (
          "This checking implementation cannot discharge an obligation.", "Ask the checking-context owner to review support for the submitted construct.",
        ),
      )
    }
    "numeric_reduction_profile_required" =>
      Some(
        (
          "The checking context has no admitted numeric reduction profile for this aggregate.",
          "Ask the checking-context owner to install the referenced pinned profile, then check the complete bound input again. Profile membership does not select a reduction member or authorize execution.",
        ),
      )
    "operation_parameter_invalid" => {
      if facts.get("domain") == Some(Json::string("positive_safe_integer")) {
        return Some(
          (
            "An operation parameter must be a positive safe integer.", "Supply an integer from 1 through 9007199254740991.",
          ),
        )
      }
      if facts.get("domain") == Some(Json::string("nonnegative_safe_integer")) {
        return Some(
          (
            "An operation parameter must be a nonnegative safe integer.", "Supply an integer from 0 through 9007199254740991; negative zero is not admitted.",
          ),
        )
      }
      if facts.get("domain") == Some(Json::string("unit_fraction")) {
        return Some(
          (
            "An operation parameter must be a finite fraction between 0 and 1.",
            "Supply a number from 0 through 1, inclusive; negative zero is not admitted.",
          ),
        )
      }
      if facts.get("domain") == Some(Json::string("finite_number")) {
        return Some(
          (
            "An operation parameter must be a finite number.", "Supply a finite number; negative zero is not admitted.",
          ),
        )
      }
      if facts.get("domain") == Some(Json::string("duration")) {
        return Some(
          (
            "An operation parameter must be an admitted duration.", "Supply positive ASCII digits followed by ms, s, m, h or d, without whitespace; the milliseconds must fit a safe integer.",
          ),
        )
      }
      if facts.get("domain") == Some(Json::string("positive_milliseconds")) {
        return Some(
          (
            "An operation parameter must be positive safe milliseconds or an admitted duration.",
            "Supply a positive safe integer of milliseconds, or a positive duration string with ms, s, m, h or d.",
          ),
        )
      }
      if facts.get("domain") == Some(Json::string("signed_milliseconds")) {
        return Some(
          (
            "An operation parameter must be signed safe milliseconds or an admitted duration.",
            "Supply integer milliseconds from -9007199254740991 through 9007199254740991 without negative zero, or a positive duration string.",
          ),
        )
      }
      if facts.get("domain") == Some(Json::string("timestamp")) {
        return Some(
          (
            "An operation parameter must be an admitted timestamp value.", "Supply a non-null timestamp value admitted by the timestamp declaration contract.",
          ),
        )
      }
      Some(
        (
          "A parameter violates an operation scalar domain.", "Correct the supplied value or selected default under the reported operation domain.",
        ),
      )
    }
    "parameter_consumer_condition" =>
      Some(
        (
          "A parameter must satisfy its operation-specific binding condition.", "Supply a value within the stated safe-integer range and check the complete bound input again.",
        ),
      )
    "parameter_declarations_invalid" =>
      Some(
        (
          "The parameter declarations are invalid.", "Correct the supplied declarations.",
        ),
      )
    "parameter_default_type_mismatch" =>
      Some(
        (
          "A parameter default does not match its declared type.", "Correct the default to match the declared type, then check again.",
        ),
      )
    "parameter_undeclared" =>
      Some(
        (
          "The query refers to an undeclared parameter.", "Declare the parameter or correct its reference; a value alone cannot declare it.",
        ),
      )
    "parameter_unused" =>
      Some(
        (
          "A declared parameter is not used by the complete Program.", "Remove the unused declaration or reference the parameter in the Program, then check again.",
        ),
      )
    "parameter_value_required" =>
      Some(
        (
          "A declared parameter value is missing.", "Supply the declared value and check the complete bound input again.",
        ),
      )
    "program_invalid" =>
      Some(
        (
          "The input violates the checked Program contract.", "Correct the input under the selected contract.",
        ),
      )
    "program_structure_invalid" => {
      if facts.get("issue") == Some(Json::string("missing_field")) {
        return Some(
          (
            "A required Program field is missing.", "Add the required field to the indicated enclosing node.",
          ),
        )
      }
      if facts.get("issue") == Some(Json::string("wrong_type")) {
        return Some(
          (
            "A Program field has the wrong JSON type.", "Use the JSON type required by the Program contract.",
          ),
        )
      }
      if facts.get("issue") == Some(Json::string("unexpected_null")) {
        return Some(
          (
            "A required Program field cannot be null.", "Provide the required field value; null is distinct from absence.",
          ),
        )
      }
      Some(
        (
          "The structured Program violates its input contract.", "Correct the indicated Program node and submit an explicitly new intent.",
        ),
      )
    }
    "query_alias_absent" =>
      Some(
        (
          "No query alias matching this reference is registered in the checked namespace.",
          "Correct the reference or ask the Host administrator to check the namespace registrations, then check again. This does not establish Provider Resource absence or grant execution.",
        ),
      )
    "query_expression_invalid" => {
      if facts.get("issue") == Some(Json::string("expected_boolean")) {
        return Some(
          (
            "A predicate must have Boolean type.", "Use a Boolean condition, such as a comparison, in the predicate.",
          ),
        )
      }
      if facts.get("issue") == Some(Json::string("unknown_reference")) {
        return Some(
          (
            "An expression reference cannot be resolved in the checked scope.", "Use a declared reference from the disclosed query context.",
          ),
        )
      }
      if facts.get("issue") == Some(Json::string("invalid_arguments")) {
        return Some(
          (
            "Expression arguments violate the selected operation contract.", "Correct the argument count or form required by the selected operation.",
          ),
        )
      }
      if facts.get("issue") == Some(Json::string("invalid_number")) {
        return Some(
          (
            "A numeric expression is outside the admitted numeric domain.", "Use a finite number in the admitted precision and signed-zero domain.",
          ),
        )
      }
      Some(
        (
          "An expression violates its reference, argument or numeric contract.",
          "Correct the expression under the selected query contract.",
        ),
      )
    }
    "query_frame_invalid" =>
      Some(
        (
          "The analytic ROWS frame boundaries do not form a valid interval.", "For two PRECEDING boundaries, the start distance must be at least the end distance; for two FOLLOWING boundaries, it must be at most the end distance.",
        ),
      )
    "query_invalid" =>
      Some(
        (
          "The query violates its language or name-resolution contract.", "Correct the query using its declared names and visible context.",
        ),
      )
    "query_lexical_invalid" => {
      if facts.get("issue") == Some(Json::string("unexpected_end")) {
        return Some(
          (
            "The input ends before a token is complete.", "Complete the quoted token or escape sequence at the reported position.",
          ),
        )
      }
      if facts.get("issue") == Some(Json::string("unexpected_token")) {
        return Some(
          (
            "A token is not valid in this lexical context.", "Correct the token spelling or delimiter at the reported position.",
          ),
        )
      }
      if facts.get("issue") == Some(Json::string("invalid_escape")) {
        return Some(
          (
            "An escape sequence is invalid.", "Use an escape allowed by the selected string or identifier syntax.",
          ),
        )
      }
      if facts.get("issue") == Some(Json::string("invalid_scalar")) {
        return Some(
          (
            "A token contains a scalar forbidden by its lexical context.", "Correct the scalar escape or quoted identifier under the selected lexical syntax.",
          ),
        )
      }
      if facts.get("issue") == Some(Json::string("empty_identifier")) {
        return Some(
          (
            "A quoted identifier is empty.", "Provide a non-empty identifier inside the quoting delimiters.",
          ),
        )
      }
      if facts.get("issue") == Some(Json::string("unterminated_comment")) {
        return Some(
          (
            "A block comment is not terminated.", "Add the closing block-comment delimiter.",
          ),
        )
      }
      if facts.get("issue") == Some(Json::string("invalid_number")) {
        return Some(
          (
            "A numeric token has invalid spelling.", "Correct the numeric token, including any exponent.",
          ),
        )
      }
      if facts.get("issue") == Some(Json::string("invalid_parameter")) {
        return Some(
          (
            "A parameter reference lacks a valid name.", "Provide a valid parameter name after @.",
          ),
        )
      }
      Some(
        (
          "A query token violates its lexical syntax.", "Correct the token at the reported location when available.",
        ),
      )
    }
    "query_syntax_invalid" =>
      Some(
        (
          "The query syntax is invalid.", "Correct the query syntax at the reported location when available.",
        ),
      )
    "source_selector_unregistered" =>
      Some(
        (
          "The submitted Source selector has no matching installed registration in the inspected namespace.",
          "Check the selector and the Host registration configuration, then recheck the original input. This does not prove that a Provider Resource is absent or authorize execution.",
        ),
      )
    "supplied_parameters_invalid" =>
      Some(
        (
          "The supplied parameter input is invalid.", "Correct the supplied parameter map.",
        ),
      )
    "supplied_value_constraint_violation" => {
      if facts.get("constraint") == Some(Json::string("numeric")) {
        return Some(
          (
            "A supplied value violates a declared constraint.", "Supply a number satisfying the declared integer, minimum and maximum constraints.",
          ),
        )
      }
      if facts.get("constraint") == Some(Json::string("duration")) {
        return Some(
          (
            "A supplied value violates a declared constraint.", "Supply a string in the admitted duration format.",
          ),
        )
      }
      if facts.get("constraint") == Some(Json::string("array_length")) {
        return Some(
          (
            "A supplied value violates a declared constraint.", "Supply an array with the declared exact length.",
          ),
        )
      }
      if facts.get("constraint") == Some(Json::string("array_size")) {
        return Some(
          (
            "A supplied value violates a declared constraint.", "Supply an array within the declared maximum item count.",
          ),
        )
      }
      Some(
        (
          "A supplied value violates a declared constraint.", "Correct the value to satisfy the declared constraint family.",
        ),
      )
    }
    "supplied_value_invalid" =>
      Some(
        (
          "A supplied value violates its declaration.", "Correct the value to satisfy its declared contract.",
        ),
      )
    "supplied_value_type_mismatch" =>
      Some(
        (
          "A supplied value has the wrong type.", "Supply a value of the declared type.",
        ),
      )
    "unresolved_protected" =>
      Some(
        (
          "Source resolution cannot be established from the disclosed context.",
          "Ask the Source or checking-context owner to review the published context.",
        ),
      )
    _ => None
  }
}
