supported_targets = "native"

pkgtype(kind: "executable")

import {
  "actql/actql/platform_native/bounded_files" @files,
  "actql/actql/platform_native/http_client" @http,
  "actql/actql/source_value" @source,
  "actql/actql/encode_core" @encode,
  "actql/actql/run_publication" @publication,
  "actql/actql/run_publication_host" @run_host,
  "actql/actql/client_local_host" @local_values,
  "actql/actql/logical_request_scope" @request_scope,
  "actql/actql/platform_native/client_host" @local_host,
  "actql/actql/platform_native/credential_resource" @raw_resource,
  "actql/actql/platform_native/signature" @local_crypto,
  "actql/actql/platform_native/sqlite" @local_sqlite,
  "actql/actql/platform_native/filesystem" @local_filesystem,
  "actql/actql/platform_native/result_access" @local_result,
  "actql/actql/platform_native/publication_store" @local_store,
  "actql/actql/platform_native/run_publication" @local_publication,
  "actql/actql/platform_native/remote_resident_host" @source_owner,
  "actql/actql/connectors/duckdb/adapters/native" @duckdb,
  "actql/actql/connectors/duckdb/standard_host" @dispatch,
  "actql/actql/execution_relation" @execution,
  "actql/actql/physical_cost" @cost,
  "actql/actql/source_frontend" @frontend,
  "actql/actql/program_check" @checked,
  "actql/actql/stage_syntax" @syntax,
  "actql/actql/check_environment" @compiler_environment,
  "actql/actql/physical_strategy" @strategy,
  "actql/actql/decode_core" @decode,
  "actql/actql/parameter_binding" @parameters,
  "moonbitlang/core/argparse",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "actql/actql/sha256" @sha,
}

options(
  "native-stub": [ "stdout_stub.c" ],
  link: { "native": { "cc-flags": "-O1" } },
)
