supported_targets = "native"

pkgtype(kind: "executable")

import {
  "actql/actql/client_local_host" @local_values,
  "actql/actql/platform_native/remote_agent" @agent,
  "actql/actql/platform_native/host_bootstrap" @bootstrap,
  "actql/actql/physical_resources" @resources,
  "moonbitlang/core/encoding/utf8",
  "actql/actql/check_environment" @environment,
  "actql/actql/client_local_host" @local_values,
  "actql/actql/decode_core" @decode,
  "actql/actql/execution_relation" @execution,
  "actql/actql/execution_authorization" @authorization,
  "actql/actql/execution_site" @site,
  "actql/actql/platform_native/bounded_files",
  "actql/actql/platform_native/executor_slot" @slot,
  "actql/actql/platform_native/http_client" @http,
  "actql/actql/platform_native/filesystem",
  "actql/actql/platform_native/process_image",
  "actql/actql/platform_native/publication_store",
  "actql/actql/publication_payload" @payload,
  "actql/actql/platform_native/remote_standard_host" @output,
  "actql/actql/platform_native/remote_transfer_client" @transfer_client,
  "actql/actql/platform_native/remote_transfer_journal" @transfer_journal,
  "actql/actql/platform_native/remote_client" @client,
  "actql/actql/platform_native/remote_journal" @journal,
  "actql/actql/platform_native/remote_resident_host" @resident_host,
  "actql/actql/platform_native/salesforce_effect_preview" @effect_review,
  "actql/actql/platform_native/runtime_bundle" @bundle,
  "actql/actql/platform_native/signature",
  "actql/actql/platform_native/credential_resource" @effect_resource,
  "actql/actql/remote_credential" @effect_credential,
  "actql/actql/connectors/salesforce/catalog" @effect_catalog,
  "actql/actql/platform_native/sqlite",
  "actql/actql/remote_resident_site" @resident,
  "actql/actql/remote_bundle" @bundle_protocol,
  "actql/actql/remote_site_protocol" @remote,
  "actql/actql/run_publication_host" @host,
  "actql/actql/run_publication" @publication,
  "actql/actql/checkpoint_runtime" @checkpoint,
  "actql/actql/connectors/duckdb/adapters/native" @duckdb,
  "actql/actql/connectors/duckdb/host" @acquisition_host,
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "actql/actql/platform_native/remote_runtime" @runtime,
}

import {
  "actql/actql/physical_manifest" @output_manifest,
  "moonbitlang/core/encoding/utf8",
} for "wbtest"

options(
  "native-stub": [ "initial_control_stub.c" ],
)
