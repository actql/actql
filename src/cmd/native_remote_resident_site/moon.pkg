  "actql/actql/remote_site_protocol" @remote,
  "actql/actql/run_publication_host" @host,
  "actql/actql/connectors/duckdb/adapters/native" @duckdb,
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "actql/actql/platform_native/remote_runtime" @runtime,
