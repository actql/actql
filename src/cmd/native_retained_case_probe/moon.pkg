supported_targets = "native"

pkgtype(kind: "executable")

import {
  "actql/actql/sha256" @sha,
  "actql/actql/execution_query" @query,
  "actql/actql/decode_core" @decode,
  "actql/actql/source_value" @source,
  "moonbitlang/core/encoding/utf8",
  "actql/actql/platform_native/trusted_clock" @clock,
  "actql/actql/platform_native/sqlite",
  "actql/actql/platform_native/bounded_files" @files,
  "actql/actql/platform_native/remote_application_profile" @application,
  "actql/actql/physical_strategy_example" @example,
  "actql/actql/connectors/duckdb/host_native" @host,
  "actql/actql/connectors/duckdb/standard_host",
  "actql/actql/connectors/duckdb/host" @acquisition_host,
  "actql/actql/connectors/duckdb/acquisition" @duckdb_acquisition,
  "actql/actql/connectors/duckdb/adapter",
  "actql/actql/connectors/duckdb/adapters/native" @duckdb,
  "actql/actql/physical_strategy_host" @strategy,
  "actql/actql/query_planning" @planning,
  "actql/actql/physical_cost" @cost,
  "actql/actql/physical_resources" @resources,
  "actql/actql/connector_sdk" @connector,
  "actql/actql/execution_relation" @execution,
  "actql/actql/encode_core" @encode,
  "moonbitlang/core/argparse",
  "moonbitlang/core/string",
  "moonbitlang/core/env",
  "moonbitlang/core/bench",
  "moonbitlang/core/json",
}

options(
  "native-stub": [ "cleanup_access_stub.c" ],
)
