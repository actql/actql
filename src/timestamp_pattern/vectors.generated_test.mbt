// Generated by scripts/check-timestamp-pattern.mjs --write. Do not edit.

///|
test "timestamp pattern: date" {
  let value = parse("yyyy-MM-dd", Parse, limits()).unwrap()
  assert_eq(cid(value), "sha256:cf77592823088ed49287e7cc1b85df60aaa0718d32753155c140dea46f0e9447")
  let writer = @encode.writer(10000, 1000, 3)
  emit(value, writer)
  assert_eq(@encode.finish(writer), "{\"ast_cid\":\"sha256:cf77592823088ed49287e7cc1b85df60aaa0718d32753155c140dea46f0e9447\",\"components\":[{\"kind\":\"token\",\"value\":\"yyyy\"},{\"kind\":\"literal\",\"value\":\"-\"},{\"kind\":\"token\",\"value\":\"MM\"},{\"kind\":\"literal\",\"value\":\"-\"},{\"kind\":\"token\",\"value\":\"dd\"}],\"full_input_match\":true,\"mode\":\"parse\",\"timezone\":\"UTC\",\"version\":\"actql-timestamp-pattern-ast/0.1\"}")
  let preimage = @encode.writer(10000, 1000, 3)
  emit_preimage(value, preimage)
  assert_eq(@encode.finish(preimage), "{\"components\":[{\"kind\":\"token\",\"value\":\"yyyy\"},{\"kind\":\"literal\",\"value\":\"-\"},{\"kind\":\"token\",\"value\":\"MM\"},{\"kind\":\"literal\",\"value\":\"-\"},{\"kind\":\"token\",\"value\":\"dd\"}],\"full_input_match\":true,\"mode\":\"parse\",\"timezone\":\"UTC\",\"version\":\"actql-timestamp-pattern-ast/0.1\"}")
  assert_eq(value_width(value), 10)
  assert_eq(component_count(value), 5)
  assert_eq(component_at(value, 0), Some(Token("yyyy")))
  assert_eq(component_at(value, 1), Some(Literal("-")))
  assert_eq(component_at(value, 2), Some(Token("MM")))
  assert_eq(component_at(value, 3), Some(Literal("-")))
  assert_eq(component_at(value, 4), Some(Token("dd")))
}

