///|
test "timestamp pattern rejects: empty" {
  assert_true(parse("", Format, limits()) is Err(EmptyPattern))
}

///|
test "timestamp pattern rejects: parse-literal-only" {
  assert_true(parse("--", Parse, limits()) is Err(MissingDate))
}

///|
test "timestamp pattern rejects: parse-year" {
  assert_true(parse("yyyy", Parse, limits()) is Err(MissingDate))
}

///|
test "timestamp pattern rejects: duplicate" {
  assert_true(parse("yyyyyyyy", Format, limits()) is Err(DuplicateToken("yyyy")))
}

///|
test "timestamp pattern rejects: hour-alone" {
  assert_true(parse("HH", Format, limits()) is Err(InvalidTimeDependencies))
}

///|
test "timestamp pattern rejects: minute-alone" {
  assert_true(parse("mm", Format, limits()) is Err(InvalidTimeDependencies))
}

///|
test "timestamp pattern rejects: seconds-alone" {
  assert_true(parse("ss", Format, limits()) is Err(InvalidTimeDependencies))
}

///|
test "timestamp pattern rejects: millis-without-seconds" {
  assert_true(parse("HHmmSSS", Format, limits()) is Err(InvalidTimeDependencies))
}

///|
test "timestamp pattern rejects: partial-token" {
  assert_true(parse("yyy", Format, limits()) is Err(InvalidComponent(0)))
}

///|
test "timestamp pattern rejects: unknown-suffix" {
  assert_true(parse("yyyyZ", Format, limits()) is Err(InvalidComponent(4)))
}

///|
test "timestamp pattern rejects: quoted-literal" {
  assert_true(parse("yyyy'T'", Format, limits()) is Err(InvalidComponent(4)))
}

///|
test "timestamp pattern rejects: timezone" {
  assert_true(parse("yyyy-MM-ddXXX", Parse, limits()) is Err(InvalidComponent(10)))
}

///|
test "timestamp pattern rejects: newline" {
  assert_true(parse("yyyy\u{a}", Format, limits()) is Err(InvalidComponent(4)))
}

///|
test "timestamp pattern rejects: tab" {
  assert_true(parse("yyyy\u{9}", Format, limits()) is Err(InvalidComponent(4)))
}

///|
test "timestamp pattern rejects: nbsp" {
  assert_true(parse("yyyy\u{a0}", Format, limits()) is Err(InvalidComponent(4)))
}

///|
test "timestamp pattern rejects: non-ascii" {
  assert_true(parse("yyyy\u{5e74}", Format, limits()) is Err(InvalidComponent(4)))
}

///|
test "timestamp pattern rejects: token-case" {
  assert_true(parse("YYYY", Format, limits()) is Err(InvalidComponent(0)))
}
