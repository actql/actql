test "timestamp pattern: literal-occurrences" {
  let value = parse(" --yyyy.. ", Format, limits()).unwrap()
  assert_eq(cid(value), "sha256:c16d841d06375e7700c789c0030ee9582ea9a60fdf92f8e785d2a494ba618e39")
  let writer = @encode.writer(10000, 1000, 3)
  emit(value, writer)
  assert_eq(@encode.finish(writer), "{\"ast_cid\":\"sha256:c16d841d06375e7700c789c0030ee9582ea9a60fdf92f8e785d2a494ba618e39\",\"components\":[{\"kind\":\"literal\",\"value\":\" \"},{\"kind\":\"literal\",\"value\":\"-\"},{\"kind\":\"literal\",\"value\":\"-\"},{\"kind\":\"token\",\"value\":\"yyyy\"},{\"kind\":\"literal\",\"value\":\".\"},{\"kind\":\"literal\",\"value\":\".\"},{\"kind\":\"literal\",\"value\":\" \"}],\"full_input_match\":true,\"mode\":\"format\",\"timezone\":\"UTC\",\"version\":\"actql-timestamp-pattern-ast/0.1\"}")
  let preimage = @encode.writer(10000, 1000, 3)
  emit_preimage(value, preimage)
  assert_eq(@encode.finish(preimage), "{\"components\":[{\"kind\":\"literal\",\"value\":\" \"},{\"kind\":\"literal\",\"value\":\"-\"},{\"kind\":\"literal\",\"value\":\"-\"},{\"kind\":\"token\",\"value\":\"yyyy\"},{\"kind\":\"literal\",\"value\":\".\"},{\"kind\":\"literal\",\"value\":\".\"},{\"kind\":\"literal\",\"value\":\" \"}],\"full_input_match\":true,\"mode\":\"format\",\"timezone\":\"UTC\",\"version\":\"actql-timestamp-pattern-ast/0.1\"}")
  assert_eq(value_width(value), 10)
  assert_eq(component_count(value), 7)
  assert_eq(component_at(value, 0), Some(Literal(" ")))
  assert_eq(component_at(value, 1), Some(Literal("-")))
  assert_eq(component_at(value, 2), Some(Literal("-")))
  assert_eq(component_at(value, 3), Some(Token("yyyy")))
  assert_eq(component_at(value, 4), Some(Literal(".")))
  assert_eq(component_at(value, 5), Some(Literal(".")))
  assert_eq(component_at(value, 6), Some(Literal(" ")))
}

