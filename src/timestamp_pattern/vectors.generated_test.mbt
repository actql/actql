  assert_eq(@encode.finish(preimage), "{\"components\":[{\"kind\":\"token\",\"value\":\"mm\"},{\"kind\":\"token\",\"value\":\"HH\"},{\"kind\":\"token\",\"value\":\"dd\"},{\"kind\":\"token\",\"value\":\"MM\"},{\"kind\":\"token\",\"value\":\"yyyy\"}],\"full_input_match\":true,\"mode\":\"parse\",\"timezone\":\"UTC\",\"version\":\"actql-timestamp-pattern-ast/0.1\"}")
