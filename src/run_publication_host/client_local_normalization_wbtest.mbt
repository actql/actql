,"id":"fixture-1","version":"fixture"}},"pushdown":{"contract":{"cid":"sha256:b1632a74e9ccd886ba08fb5082e7e053fe9cc1b141e8a48da7fec928a2e9fc24","id":"fixture-4","version":"fixture"},"operations":[]},"request_processing":{"mutates_business_state":false},"resource_kind":"record","schema":"actql.source_view/0.1","view_id":"v","view_version":"fixture"},{"acquisition":{"authority":"read_metadata","default_mode":"snapshot","kind":"scan","modes":[{"bounded":true,"mode":"snapshot"}],"request_schema":{"cid":"sha256:bcb09919b8eef2947328d975739353f2717a7781b6ae42617da071a54930aa74","id":"fixture-0","version":"fixture"}},"connector_id":"crm/main","connector_version":"fixture","contract_cid":"sha256:ffa240d28d8b7253cd0f9750544576ab92aac05eee6ee95626210b41978e5eb3","output":{"carrier":"relation","data_policy":{"cid":"sha256:e29dbae5d01c451177772ccd55550b9ec4be9b47eb12e56afffea74cfdd879bf","id":"fixture-2","version":"fixture"},"facts":{"cid":"sha256:804b56a824b1f2249b87fefa25e45e7e327d3aaf519b264df52bc6296d86c905","id":"fixture-3","version":"fixture"},"schema":{"cid":"sha256:2fe8005dbfa26b68a2e50a3fc86a54b14f4d845275acfd3770b09ba7d4316bc4","id":"fixture-1","version":"fixture"}},"pushdown":{"contract":{"cid":"sha256:b1632a74e9ccd886ba08fb5082e7e053fe9cc1b141e8a48da7fec928a2e9fc24","id":"fixture-4","version":"fixture"},"operations":[]},"request_processing":{"mutates_business_state":false},"resource_kind":"record","schema":"actql.source_view/0.1","view_id":"v","view_version":"fixture"}],"version":"actql-check-environment/0.1"}

  let limits : @environment.Limits = {
    max_bytes: 65536,
    max_nodes: 4096,
    max_depth: 64,
    max_members: 256,
  }
  assert_true(
    @environment.read(
      @utf8.encode(client_composed_acquired_effect_environment),
      "sha256:7d396c299e58a85fec0efdfecd0801c94a4cded4b29215a75291428a32aee0aa",
      limits,
    )
    is Err(@environment.UnsortedEvidence(@environment.ConnectorCapabilities)),
  )
  assert_true(
    @environment.read(
      @utf8.encode(local_normalization_environment_wire),
      "sha256:7d396c299e58a85fec0efdfecd0801c94a4cded4b29215a75291428a32aee0aa",
      limits,
    )
    is Err(@environment.IdentityMismatch),
  )
  assert_true(
    @environment.read(
      @utf8.encode(local_normalization_environment_wire),
      "sha256:9882e5f1412beaf650b0fdaf55035b198b7b87e8e9e3c3a0f07730953b0a72ed",
      limits,
    )
    is Ok(_),
  )
}

///|
fn local_sort_normalization_journal_body(
  inventory : @checked.LocalSortNormalizationInventory,
  catalog_cid : String,
) -> Result[String, ClientLocalNormalizationIssue] {
  try {
    let writer = @encode.writer(1024, 32, 8)
    @encode.begin_object(writer)
    @encode.key(writer, "entries")
    @encode.begin_array(writer)
    for index in 0..<@checked.local_sort_normalization_entry_count(inventory) {
      guard @checked.local_sort_normalization_entry_at(inventory, index)
        is Some((path, authored, canonical)) else {
        return Err(ForeignPreparation)
      }
      @encode.begin_object(writer)
      @encode.key(writer, "authored")
      @encode.string_value(writer, authored)
      @encode.key(writer, "canonical")
      @encode.string_value(writer, canonical)
      @encode.key(writer, "path")
      @encode.string_value(writer, path)
      @encode.key(writer, "rule")
      guard @checked.local_sort_normalization_entry_rule_at(inventory, index)
        is Some(rule) else {
        return Err(ForeignPreparation)
      }
      @encode.string_value(writer, rule)
      @encode.end_object(writer)
    }
    @encode.end_array(writer)
    @encode.key(writer, "rule_catalog_cid")
    @encode.string_value(writer, catalog_cid)
    @encode.key(writer, "version")
    @encode.string_value(writer, "actql-normalization-journal/0.1")
    @encode.end_object(writer)
    Ok(@encode.finish(writer))
  } catch {
    _ => Err(Evidence(@publication.RunEvidenceEncoding))
  }
}

///|
/// Issue only from the inventory retained by the original checked preparation.
/// No parse, compile, Source acquisition or physical Effect operation occurs.
fn _issue_prepared_client_legacy_local_normalization(
  owner : PreparedClientProgram,
) -> Result[ClientLocalNormalization, ClientLocalNormalizationIssue] {
  if owner.local_normalization is Some(original) {
    match prepared_client_local_normalization_evidence(owner, original) {
      Err(issue) => return Err(issue)
      Ok(_) => ()
    }
    return Ok(original)
  }
  let program = @strategy.graph_program(owner.graph)
  let inventory : ClientLocalNormalizationInventory = match
    @checked.local_program_sort_normalization_inventory(program) {
    Ok(Some(value)) => SortCompletion(value)
    Ok(None) =>
      match @checked.local_program_completion_free_inventory(program) {
        Ok(value) => CompletionFree(value)
        Err(issue) => return Err(Inventory(issue))
      }
    Err(issue) => return Err(Inventory(issue))
  }
  let catalog_cid = local_normalization_catalog_cid(inventory)
  let wire = match inventory {
    Common(_) => return Err(ForeignPreparation)
    CompletionFree(_) =>
      "{\"entries\":[],\"rule_catalog_cid\":\"" +
      catalog_cid +
      "\",\"version\":\"actql-normalization-journal/0.1\"}"
    SortCompletion(value) =>
      match local_sort_normalization_journal_body(value, catalog_cid) {
        Ok(wire) => wire
        Err(issue) => return Err(issue)
      }
  }
  let journal = match
    @publication.seal_run_evidence_value(
      "normalization_journal", wire, 1024, 32, 8,
    ) {
    Ok(value) => value
    Err(issue) => return Err(Evidence(issue))
  }
  let issued : ClientLocalNormalization = {
    preparation: owner,
    audit: inventory,
    evidence: journal,
  }
  owner.local_normalization = Some(issued)
  Ok(issued)
}
