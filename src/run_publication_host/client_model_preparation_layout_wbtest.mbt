///|
fn client_node_layout_test_profile() -> @environment.ModelResponseProfile {
  // Fixed, independently sealed vector already owned by the response-profile
  // reader tests. Its 4096/2048 declarations are SUPPORT bounds, not a normal
  // Node layout policy. No expected value is generated by the supplier.
  let wire =
    #|{"adapter":{"build_artifact_cid":"sha256:12b1a34ce23743c38303cc50fb4eb040689c50f37c1a594b1382d754a4c578a2","builder_id":"fixture/http-builder","builder_revision":"1","codec_id":"fixture/chat-one","codec_revision":"1","port_abi":"model-physical-port/1","sdk":null},"completion":{"basis":"generation_finish","endpoint_envelope":true,"output_contract":true,"transport_eof":true,"validator_artifact_cid":"sha256:9dde7d7e6c108739d709824371c425f8d26afd8451d470d7477ef2ac8ecffacd","validator_id":"fixture/chat-envelope","validator_revision":"1"},"controls":{"cache":false,"fallback":false,"hedging":false,"media_fetch":false,"model_requests":1,"redirect":false,"repair":false,"retry":false,"sdk_telemetry":false,"tools":false,"workflow_restore":false},"limits":{"active_slots":4,"adapter_holding_bytes":4096,"adapter_workspace_bytes":2048,"chunk_bytes":512,"chunks":16,"header_bytes":256,"metadata_bytes":128,"metadata_depth":4,"metadata_nodes":16,"parse_depth":16,"parse_nodes":256,"parse_work":8192,"request_bytes":1024,"response_bytes":2048,"unsettled_slots":4},"observations":["provider_request_id","provider_reported_model_id","finish_reason","input_tokens","output_tokens","provider_metadata"],"operation":{"endpoint":"https://fixture.invalid/v1/chat/completions","method":"POST","streaming":false},"probability":null,"self_cid":"sha256:e5d56780055a27fdfc4c522d9afb38403887afeae671fb93c4ebee8a872f7d86","task":{"contract_cid":"sha256:cfb4c49389dd5ecbcd97d4b60276549dcf6fd2ce62584707b5c661d94dce4560","input_schema_cid":"sha256:57887e29c270383ae1e005ba3476a81c8b0012a8b566db860c75abba9c786dd7","kind":"structured_generate","output_schema_cid":"sha256:d67003c78c0eb8b7ab0499bbed57bc8d5895c43ed0b3ce27755b656a65fd49f3"},"version":"actql-model-response-profile/0.1"}
  @environment.read_model_response_profile(
    @utf8.encode(wire),
    "sha256:e5d56780055a27fdfc4c522d9afb38403887afeae671fb93c4ebee8a872f7d86",
    { max_bytes: 10000, max_nodes: 1000, max_depth: 30, max_members: 1000, },
    100000,
  ).unwrap()
}

///|
fn client_node_layout_test_installation() -> @environment.ModelResponseProfileInstallation {
  {
    builder_id: "fixture/http-builder",
    builder_revision: "1",
    codec_id: "fixture/chat-one",
    codec_revision: "1",
    build_artifact_cid: "sha256:12b1a34ce23743c38303cc50fb4eb040689c50f37c1a594b1382d754a4c578a2",
    sdk: None,
    endpoint: "https://fixture.invalid/v1/chat/completions",
    http_method: "POST",
    streaming: false,
    validator_id: "fixture/chat-envelope",
    validator_revision: "1",
    validator_artifact_cid: "sha256:9dde7d7e6c108739d709824371c425f8d26afd8451d470d7477ef2ac8ecffacd",
    completion_basis: "generation_finish",
  }
}

///|
fn client_node_layout_test_declaration(
  plan : ClientInferPlanGraph,
) -> ClientNodeModelPreparationLayout {
  // Synthetic positive envelopes exercise ownership predicates only. No byte
  // coefficient, installed runtime, physical proof or public grant is adopted.
  {
    response_profile: client_node_layout_test_profile(),
    runtime_artifact_cid: "sha256:" + "d".repeat(64),
    layout_artifact_cid: "sha256:" + "e".repeat(64),
    program_definition_cid: prepared_client_identity(plan.owner).program_definition_cid,
    parameter_values_cid: prepared_client_identity(plan.owner).parameter_values_cid,
    barrier_cid: plan.barrier_cid,
    prepared_rows: 2L,
    retained_bytes: 7000L,
    execution_bytes: 3000L,
  }
}

///|
test "checked Graph exposes only its original input identities for an installed read recipe" {
  let (_, _, graph) = client_model_read_test_run("recipe")
  let original = prepared_client_identity(graph.owner)
  assert_eq(
    client_infer_plan_program_cid(graph),
    original.program_definition_cid,
  )
  assert_eq(
    client_infer_plan_parameters_cid(graph),
    original.parameter_values_cid,
  )
  assert_eq(client_infer_plan_boundary(graph).3, graph.barrier_cid)
}

///|
test "checked Node layout rejects missing installation and changed pinned facts before claim" {
  let (compiled, definition, plan) = client_model_read_test_run("layout")
  let layout = client_node_layout_test_declaration(plan)
  let installation = client_node_layout_test_installation()
  let ledger = @resources.create_ledger({
    planning_work: 3,
    attempts: 2,
    holdings: 3,
    transfer_bytes: 11L,
    retained_bytes: 7003L,
    execution_bytes: 3002L,
  }).unwrap()
  let bootstrap = @resources.reserve_capacity(ledger, 3L, 2L).unwrap()
  let scope = begin_client_model_read_scope(
    compiled, definition, plan, ledger, bootstrap, 2, 0, 0,
  ).unwrap()
  let read = prepare_client_model_read(scope, 7000L, 3000L).unwrap()
  let before = @resources.ledger_usage(ledger)
  assert_true(
    claim_client_node_model_preparation_layout(
      read,
      compiled,
      definition,
      plan,
      None,
      installation,
      layout.runtime_artifact_cid,
      layout.layout_artifact_cid,
      None,
    )
    is Err(Unavailable),
  )
  assert_true(
    claim_client_node_model_preparation_layout(
      read,
      compiled,
      definition,
      plan,
      Some(layout),
      installation,
      "sha256:" + "f".repeat(64),
      layout.layout_artifact_cid,
      None,
    )
    is Err(RuntimeMismatch),
  )
  assert_true(
    claim_client_node_model_preparation_layout(
      read,
      compiled,
      definition,
      plan,
      Some(layout),
      installation,
      layout.runtime_artifact_cid,
      "sha256:" + "f".repeat(64),
      None,
    )
    is Err(LayoutMismatch),
  )
  for
    changed in [
      { ..installation, builder_revision: "2", },
      { ..installation, codec_revision: "2", },
      { ..installation, endpoint: "https://other.invalid", },
      { ..installation, validator_revision: "2", },
    ] {
    assert_true(
      claim_client_node_model_preparation_layout(
        read,
        compiled,
        definition,
        plan,
        Some(layout),
        changed,
        layout.runtime_artifact_cid,
        layout.layout_artifact_cid,
        None,
      )
      is Err(Profile(@environment.ReferenceMismatch)),
    )
  }
  for
    changed in [
      { ..layout, program_definition_cid: "sha256:" + "f".repeat(64), },
      { ..layout, parameter_values_cid: "sha256:" + "f".repeat(64), },
      { ..layout, barrier_cid: "sha256:" + "f".repeat(64), },
    ] {
    assert_true(
      claim_client_node_model_preparation_layout(
        read,
        compiled,
        definition,
        plan,
        Some(changed),
        installation,
        layout.runtime_artifact_cid,
        layout.layout_artifact_cid,
        None,
      )
      is Err(PreparationMismatch),
    )
  }
  assert_eq(@resources.ledger_usage(ledger), before)
  assert_true(client_model_read_available(read, compiled, definition, plan))
  stop_client_model_read(read).unwrap()
  settle_client_model_read(read, true).unwrap()
  assert_true(
    @resources.finish_original_ledger_inventory(ledger, true).unwrap(),
  )
}

///|
test "checked Node layout binds checked all rows and positive base without sampling" {
  let installation = client_node_layout_test_installation()
  // All prepared rows use this checked bound even if a later send mask is all
  // false. The supplier accepts no eligible-row or sample-count parameter.
  let prepared = client_infer_prefix_test_program(
    input_rows="[{\"id\":\"a\",\"text\":null},{\"id\":\"b\",\"text\":\"hello\"}]",
  )
  let plan = client_infer_material_test_graph(prepared)
  let layout = client_node_layout_test_declaration(plan)
  assert_eq(@checked.infer_item_limit_maximum(plan.item_limit), 2L)
  assert_true(
    check_client_node_model_preparation_layout(
      Some({ ..layout, prepared_rows: 1L, }),
      plan,
      installation,
      layout.runtime_artifact_cid,
      layout.layout_artifact_cid,
      None,
    )
    is Err(PreparedRowsLimit),
  )
  check_client_node_model_preparation_layout(
    Some(layout),
    plan,
    installation,
    layout.runtime_artifact_cid,
    layout.layout_artifact_cid,
    None,
  ).unwrap()
  let empty = client_infer_material_test_graph(
    client_infer_prefix_test_program(input_rows="[]"),
  )
  assert_eq(@checked.infer_item_limit_maximum(empty.item_limit), 0L)
  let zero_rows = {
    ..client_node_layout_test_declaration(empty),
    prepared_rows: 0L,
  }
  assert_true(
    check_client_node_model_preparation_layout(
      Some(layout),
      empty,
      installation,
      layout.runtime_artifact_cid,
      layout.layout_artifact_cid,
      None,
    )
    is Err(PreparationMismatch),
  )
  check_client_node_model_preparation_layout(
    Some(zero_rows),
    empty,
    installation,
    layout.runtime_artifact_cid,
    layout.layout_artifact_cid,
    None,
  ).unwrap()
  for
    invalid in [
      { ..zero_rows, retained_bytes: 0L, },
      { ..zero_rows, execution_bytes: 0L, },
      { ..zero_rows, retained_bytes: 4095L, },
      { ..zero_rows, execution_bytes: 2047L, },
      { ..zero_rows, prepared_rows: -1L, },
      { ..zero_rows, runtime_artifact_cid: "", },
      { ..zero_rows, layout_artifact_cid: "", },
    ] {
    assert_true(
      check_client_node_model_preparation_layout(
        Some(invalid),
        empty,
        installation,
        layout.runtime_artifact_cid,
        layout.layout_artifact_cid,
        None,
      )
      is Err(InvalidLayout),
    )
  }
}

///|
test "checked Node layout consumes exact original envelope once and preserves pending cleanup" {
  let (compiled, definition, plan) = client_model_read_test_run("layout")
  let (_, foreign_definition, _) = client_model_read_test_run("foreign-layout")
  let layout = client_node_layout_test_declaration(plan)
  let installation = client_node_layout_test_installation()
  for (retained, execution) in [(6999L, 3000L), (7000L, 2999L), (7000L, 3000L)] {
    let ledger = @resources.create_ledger({
      planning_work: 3,
      attempts: 2,
      holdings: 3,
      transfer_bytes: 11L,
      retained_bytes: 7003L,
      execution_bytes: 3002L,
    }).unwrap()
    let bootstrap = @resources.reserve_capacity(ledger, 3L, 2L).unwrap()
    let scope = begin_client_model_read_scope(
      compiled, definition, plan, ledger, bootstrap, 2, 0, 0,
    ).unwrap()
    let read = prepare_client_model_read(scope, retained, execution).unwrap()
    let before = @resources.ledger_usage(ledger)
    assert_true(
      claim_client_node_model_preparation_layout(
        read,
        compiled,
        foreign_definition,
        plan,
        Some(layout),
        installation,
        layout.runtime_artifact_cid,
        layout.layout_artifact_cid,
        None,
      )
      is Err(Read(ForeignRun)),
    )
    let issued = claim_client_node_model_preparation_layout(
      read,
      compiled,
      definition,
      plan,
      Some(layout),
      installation,
      layout.runtime_artifact_cid,
      layout.layout_artifact_cid,
      None,
    )
    if retained < 7000L {
      assert_true(
        issued
        is Err(Read(Resource(@resources.Resource(@resources.RetentionLimit)))),
      )
      assert_true(client_model_read_available(read, compiled, definition, plan))
    } else if execution < 3000L {
      assert_true(
        issued
        is Err(Read(Resource(@resources.Resource(@resources.ExecutionLimit)))),
      )
      assert_true(client_model_read_available(read, compiled, definition, plan))
    } else {
      let consumer = issued.unwrap()
      assert_true(
        claim_client_node_model_preparation_layout(
          read,
          compiled,
          definition,
          plan,
          Some(layout),
          installation,
          layout.runtime_artifact_cid,
          layout.layout_artifact_cid,
          None,
        )
        is Err(Read(Resource(@resources.SpentClaim))),
      )
      enter_client_model_read_consumer(
        consumer, compiled, definition, plan, 7000L, 3000L,
      ).unwrap()
      assert_true(
        enter_client_model_read_consumer(
          consumer, compiled, definition, plan, 7000L, 3000L,
        )
        is Err(Resource(@resources.SpentClaim)),
      )
      stop_client_model_read_consumer(consumer).unwrap()
      assert_true(
        settle_client_model_read_consumer(consumer, false)
        is Err(Resource(@resources.CleanupPending)),
      )
      assert_eq(@resources.ledger_usage(ledger), before)
      settle_client_model_read_consumer(consumer, true).unwrap()
      assert_false(
        client_model_read_consumer_available(
          consumer, compiled, definition, plan, 7000L, 3000L,
        ),
      )
    }
    if issued is Err(_) {
      assert_eq(@resources.ledger_usage(ledger), before)
      stop_client_model_read(read).unwrap()
      settle_client_model_read(read, true).unwrap()
    }
    assert_true(
      @resources.finish_original_ledger_inventory(ledger, true).unwrap(),
    )
  }
}
