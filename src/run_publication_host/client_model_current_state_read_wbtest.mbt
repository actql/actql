///|
fn client_current_read_test_source(
  wire? : String = "[\"actql-original-ledger-state/0.1\",[\"17\",\"2\",\"3\",\"11\",\"20\",\"12\"],[\"17\",\"0\",\"0\",\"0\",\"0\",\"0\",\"0\",\"10\",\"7\",\"10\",\"0\",\"2\",\"0\"],[\"0\",\"0\",\"0\"],null,[[\"0\",\"0\",\"0\"],[\"0\",\"0\",\"0\"],[\"0\",\"0\",\"0\"]],[\"-3\",\"0\",\"0\"],[\"2\",\"0\",\"0\",true,true,false,\"parked\",true],[\"-1\",\"0\",\"3\",\"2\",true,false,null,null,[false,false,false],null,false,false],[[\"-2\",\"0\",\"7\",\"5\",true,false,null,null,[false,false,false],null,false,false]],[],[]]",
) -> @decode.Cursor {
  // Independently fixed existing Host vector, not bytes generated by Writer.
  @decode.admit(
    @source.parse_json(wire, {
      max_input_bytes: 4000,
      max_nodes: 400,
      max_depth: 10,
    }).unwrap(),
    {
      max_nodes: 400,
      max_depth: 10,
      max_string_bytes: 100,
      max_total_string_bytes: 4000,
    },
  ).unwrap()
}

///|
test "checked current Reader uses actual original Scope bounds and compares the same park" {
  let (compiled, definition, plan) = client_model_read_test_run(
    "owned-current-reader",
  )
  let (scope, consumer) = client_current_write_test_scope(
    compiled, definition, plan, 17,
  )
  let park = park_client_model_read_consumer_for_state_write(
    scope, consumer, compiled, definition, plan,
  ).unwrap()
  assert_eq(
    client_model_current_state_read_bounds(
      park, scope, compiled, definition, plan,
    ),
    Ok({
      max_reservations: 2,
      max_holdings: 0,
      max_delegations: 0,
      reservations: 1,
      holdings: 0,
      delegations: 0,
      reader_work: 3,
    }),
  )
  let limits : @decode.Limits = {
    max_nodes: 400,
    max_depth: 10,
    max_string_bytes: 100,
    max_total_string_bytes: 4000,
  }
  let source = client_current_read_test_source()
  let before = @resources.ledger_usage(scope.ledger)
  assert_true(
    start_client_model_current_state_document_read(
      park, scope, compiled, definition, plan, source, 2, limits,
    )
    is Err(@resources.Document(@resources.WorkLimit)),
  )
  let read = start_client_model_current_state_document_read(
    park, scope, compiled, definition, plan, source, 3, limits,
  ).unwrap()
  let document = match
    @resources.advance_original_current_state_document_read(read, 3) {
    @resources.CurrentDocumentComplete(value, work=3) => value
    _ => abort("checked current Reader unexpectedly refused")
  }
  let compare = start_client_model_current_state_comparison(
    park, scope, compiled, definition, plan, document, 3,
  ).unwrap()
  assert_true(
    advance_client_model_current_state_comparison(
      compare, park, scope, compiled, definition, plan, 3,
    )
    is Ok(@resources.ComparisonComplete(work=3)),
  )
  assert_eq(@resources.ledger_usage(scope.ledger), before)
  @resources.retire_original_current_state_document(document)
  assert_true(
    client_model_resource_park_current(park, scope, compiled, definition, plan)
    is Some(_),
  )
  assert_true(
    settle_client_model_read_consumer(consumer, false)
    is Err(Resource(@resources.Resource(@resources.ResourceParked))),
  )
  // No actual Store/journal receipt exists. Keep the original park pending.
}

///|
test "checked current Reader refuses foreign original scope and malformed tree before returning data" {
  let (compiled, definition, plan) = client_model_read_test_run(
    "owned-current-reader-foreign",
  )
  let (_, foreign_definition, _) = client_model_read_test_run(
    "owned-current-reader-other",
  )
  let (scope, consumer) = client_current_write_test_scope(
    compiled, definition, plan, 17,
  )
  let (other, _) = client_current_write_test_scope(
    compiled, definition, plan, 17,
  )
  let park = park_client_model_read_consumer_for_state_write(
    scope, consumer, compiled, definition, plan,
  ).unwrap()
  let source = client_current_read_test_source()
  let limits : @decode.Limits = {
    max_nodes: 400,
    max_depth: 10,
    max_string_bytes: 100,
    max_total_string_bytes: 4000,
  }
  let before = @resources.ledger_usage(scope.ledger)
  assert_true(
    client_model_current_state_read_bounds(
      park, other, compiled, definition, plan,
    )
    is Err(Resource(@resources.ForeignOrigin)),
  )
  assert_true(
    client_model_current_state_read_bounds(
      park, scope, compiled, foreign_definition, plan,
    )
    is Err(ForeignRun),
  )
  assert_true(
    start_client_model_current_state_document_read(
      park, other, compiled, definition, plan, source, 3, limits,
    )
    is Err(@resources.Original(@resources.ForeignOrigin)),
  )
  assert_true(
    start_client_model_current_state_document_read(
      park, scope, compiled, foreign_definition, plan, source, 3, limits,
    )
    is Err(@resources.Original(@resources.ForeignOrigin)),
  )
  assert_true(
    start_client_model_current_state_document_read(
      park,
      scope,
      compiled,
      definition,
      plan,
      client_current_read_test_source(wire="[]"),
      3,
      limits,
    )
    is Err(@resources.Document(@resources.InvalidRecord)),
  )
  assert_true(
    start_client_model_current_state_document_read(
      park,
      scope,
      compiled,
      definition,
      plan,
      source,
      3,
      { ..limits, max_nodes: 0, },
    )
    is Err(@resources.Document(@resources.InvalidBounds)),
  )
  assert_eq(@resources.ledger_usage(scope.ledger), before)
  assert_true(@decode.array_length(source) is Some(12))
  assert_true(
    client_model_resource_park_current(park, scope, compiled, definition, plan)
    is Some(_),
  )
}
