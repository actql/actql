///|
test "original origin issuer borrows twelve actual fields without spending read or custody" {
  let (compiled, definition, plan, ledger, scope) = client_model_state_test_scope(
    17,
  )
  let layout = client_node_layout_test_declaration(plan)
  // Existing independent binding preimage and checked-original fixture; the
  // expected document is not generated by the new issuer under test.
  let expected = client_original_storage_test_document(
    compiled, definition, plan, layout,
  )
  let storage = @publication.seal_run_evidence_value(
    "model_original_storage_binding",
    client_original_storage_test_body(),
    2048,
    32,
    2,
  ).unwrap()
  let before = @resources.ledger_usage(ledger)
  for
    field in [
      "run_id", "run_definition_cid", "prepared_invocation_cid", "host_policy_cid",
      "execution_context_cid", "program_definition_cid", "parameter_values_cid",
      "barrier_cid", "runtime_artifact_cid", "layout_artifact_cid", "response_profile_cid",
      "storage_binding_cid",
    ] {
    let value = client_model_original_origin_field(
      scope,
      compiled,
      definition,
      plan,
      Some(layout),
      client_node_layout_test_installation(),
      layout.runtime_artifact_cid,
      layout.layout_artifact_cid,
      None,
      storage,
      field,
    ).unwrap()
    assert_eq(
      Some(value),
      @publication.model_original_resource_origin_field(expected, field),
    )
    assert_eq(@resources.ledger_usage(ledger), before)
  }
  // All twelve repeated borrows leave the original one-shot descriptor and
  // Writer usable. This is data emission, not issuance of a second read grant.
  let writer = @encode.writer(1000, 200, 10)
  let read = prepare_client_model_read_state(scope, writer, 7L, 5L).unwrap()
  assert_true(
    advance_client_model_read_state(read, compiled, definition, plan, 17)
    is @resources.StateWriteComplete(work=17),
  )
  assert_eq(@encode.finish(writer), client_model_state_match_test_wire())
  settle_client_model_read(read, true).unwrap()
  assert_true(
    finish_client_model_read_scope(scope, compiled, definition, plan, true).unwrap(),
  )
}

///|
test "original origin issuer rejects foreign originals layout storage kind and open fields" {
  let (compiled, definition, plan, ledger, scope) = client_model_state_test_scope(
    17,
  )
  let layout = client_node_layout_test_declaration(plan)
  let (foreign, foreign_definition, foreign_plan) = client_model_read_test_run(
    "origin-issuer-foreign",
  )
  let storage = @publication.seal_run_evidence_value(
    "model_original_storage_binding",
    client_original_storage_test_body(),
    2048,
    32,
    2,
  ).unwrap()
  let get = fn(c, d, p, runtime, value, field) {
    client_model_original_origin_field(
      scope,
      c,
      d,
      p,
      Some(layout),
      client_node_layout_test_installation(),
      runtime,
      layout.layout_artifact_cid,
      None,
      value,
      field,
    )
  }
  let before = @resources.ledger_usage(ledger)
  for
    (c, d, p) in [
      (foreign, definition, plan),
      (compiled, foreign_definition, plan),
      (compiled, definition, foreign_plan),
    ] {
    assert_true(
      get(c, d, p, layout.runtime_artifact_cid, storage, "run_id")
      is Err(ForeignRun),
    )
  }
  assert_true(
    get(
      compiled,
      definition,
      plan,
      "sha256:" + "0".repeat(64),
      storage,
      "run_id",
    )
    is Err(Layout(_)),
  )
  assert_true(
    get(
      compiled,
      definition,
      plan,
      layout.runtime_artifact_cid,
      @publication.run_publication_prepared(compiled.admission),
      "run_id",
    )
    is Err(OriginMismatch("storage_binding_cid")),
  )
  for field in ["ledger", "resource_state", "current_cut", "send", ""] {
    assert_true(
      get(
        compiled,
        definition,
        plan,
        layout.runtime_artifact_cid,
        storage,
        field,
      )
      is Err(OriginMismatch("origin_field")),
    )
  }
  assert_eq(@resources.ledger_usage(ledger), before)
  assert_true(
    finish_client_model_read_scope(scope, compiled, definition, plan, true).unwrap(),
  )
}

///|
test "original origin issuer loses availability during cleanup without returning pending capacity" {
  let (compiled, definition, plan, ledger, scope) = client_model_state_test_scope(
    17,
  )
  let layout = client_node_layout_test_declaration(plan)
  let storage = @publication.seal_run_evidence_value(
    "model_original_storage_binding",
    client_original_storage_test_body(),
    2048,
    32,
    2,
  ).unwrap()
  let read = prepare_client_model_read(scope, 7L, 5L).unwrap()
  assert_false(
    finish_client_model_read_scope(scope, compiled, definition, plan, false).unwrap(),
  )
  let before = @resources.ledger_usage(ledger)
  let get = fn() {
    client_model_original_origin_field(
      scope,
      compiled,
      definition,
      plan,
      Some(layout),
      client_node_layout_test_installation(),
      layout.runtime_artifact_cid,
      layout.layout_artifact_cid,
      None,
      storage,
      "run_id",
    )
  }
  assert_true(get() is Err(Unavailable))
  assert_eq(@resources.ledger_usage(ledger), before)
  assert_eq(before.reserved_retention_bytes, 10L)
  assert_eq(before.reserved_execution_bytes, 7L)
  settle_client_model_read(read, true).unwrap()
  assert_true(
    finish_client_model_read_scope(scope, compiled, definition, plan, true).unwrap(),
  )
  assert_true(get() is Err(Unavailable))
  assert_eq(@resources.ledger_usage(ledger).reserved_retention_bytes, 0L)
}
