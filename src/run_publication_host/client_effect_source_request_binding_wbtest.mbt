///|
fn bound_effect_source_fixture(
  canonical_request? : Bool = false,
) -> (
  ClientEffectCompilation,
  ClientEffectAllowedRun,
  @publication.PublicationContract,
  ClientRequestIdentity,
  ClientRequestIdentity,
) {
  let (_, _, effect_limits) = client_composed_effect_base_fixture()
  let environment = if canonical_request {
    canonical_source_request_test_environment()
  } else {
    admit_client_check_environment(
      bound_effect_source_environment,
      "sha256:e3da0e91ef758728bdf6e58957c09fe044d97d1fa2a21c9c19e3bdf5109bf45b",
      { text_time: false, veca: false, },
      { rela: true, sga: false, tea: false, calendar: false, text_rank: false, },
    ).unwrap()
  }
  let prepared = prepare_client_effect_computation(
    if canonical_request {
      canonical_source_request_test_document(bound_effect_source_document)
    } else {
      bound_effect_source_document
    },
    Json,
    environment,
    None,
    [],
    effect_limits,
  ).unwrap()
  let limits = run_materials_limits()
  // The distinct metadata-only fixture uses the existing journal-free
  // compiler entrance, as the combined Unit fixture does. It does not claim
  // an installed normalization profile or normal execution admission.
  let original = if canonical_request {
    None
  } else {
    Some(issue_prepared_client_effect_normalization(prepared).unwrap())
  }
  let compilation = issue_prepared_client_effect_compilation(
    prepared,
    run_materials_manifests(),
    limits.sequence,
    limits.max_sequence_steps,
    limits.max_sequence_work,
    limits.max_evidence_bytes,
    limits.max_evidence_nodes,
    limits.max_evidence_depth,
    normalization=original,
  ).unwrap()
  let allowed = issue_client_effect_allowed_run(
    compilation,
    "sha256:" + "a".repeat(64),
    "sha256:" + "b".repeat(64),
    "2026-10-10T00:00:00.000Z",
  ).unwrap()
  let definition = issue_client_effect_run_definition(
    allowed, "scope", "source-request-run", "2026-10-09T00:00:00.000Z", "2026-10-10T00:00:00.000Z",
  ).unwrap()
  let first = prepare_client_effect_request_identity(
    prepared,
    "sha256:" + "c".repeat(64),
    "first-caller",
    source_free_caller_input_intent_cid(),
  ).unwrap()
  let second = prepare_client_effect_request_identity(
    prepared,
    "sha256:" + "c".repeat(64),
    "second-caller",
    source_free_caller_input_intent_cid(),
  ).unwrap()
  (compilation, allowed, definition, first, second)
}

///|
fn bound_effect_source_dispatch(
  allowed : ClientEffectAllowedRun,
  definition : @publication.PublicationContract,
  request : ClientRequestIdentity,
) -> @remote.DispatchRequest {
  prepare_client_effect_source_dispatch(
    allowed,
    definition,
    request,
    1,
    "original-producer",
    {
      site_key: "site",
      site_generation: 1,
      runtime_bundle_cid: "sha256:" + "d".repeat(64),
      connector_registration: "local",
      connector_revision: "local/1",
      strategy_revision: "strategy/1",
      obligations_cid: "sha256:" + "2".repeat(64),
      budget_cid: "sha256:" + "3".repeat(64),
      evidence_issuer_capability_cid: "sha256:" + "4".repeat(64),
      grant_cid: "sha256:" + "5".repeat(64),
    },
  ).unwrap()
}

///|
test "finite Source binding carries the original request separately from materials" {
  let (compilation, allowed, definition, first, second) = bound_effect_source_fixture()
  let binding = prepare_client_effect_source_input_binding(
    compilation,
    request=Some(first),
  ).unwrap()
  let request = bound_effect_source_dispatch(allowed, definition, first)
  assert_eq(
    client_effect_source_binding_request(binding, request).unwrap(),
    Some(first),
  )
  let changed = prepare_client_effect_source_input_binding(
    compilation,
    request=Some(second),
  ).unwrap()
  assert_true(
    @remote.remote_input_binding_cid(binding) !=
    @remote.remote_input_binding_cid(changed),
  )
  assert_true(
    client_effect_source_binding_request(changed, request) is Err(ForeignInput),
  )
  assert_true(
    @remote.dispatch_request_identity(request) !=
    @remote.dispatch_request_identity(
      bound_effect_source_dispatch(allowed, definition, second),
    ),
  )
  assert_true(
    prepare_client_effect_source_input_binding(compilation)
    is Err(ForeignRequest),
  )
  let foreign_input = prepare_client_effect_request_identity(
    client_effect_compilation_owner(compilation),
    "sha256:" + "c".repeat(64),
    "foreign-input",
    "sha256:" + "e".repeat(64),
  ).unwrap()
  assert_true(
    prepare_client_effect_source_input_binding(
      compilation,
      request=Some(foreign_input),
    )
    is Err(ForeignRequest),
  )
}

///|
test "Source binding refuses material request substitution before dispatch admission" {
  let (compilation, allowed, definition, first, second) = bound_effect_source_fixture()
  let prepared = client_effect_compilation_owner(compilation)
  let normalization = issue_prepared_client_effect_normalization(prepared).unwrap()
  let binding = prepare_client_effect_source_input_binding(
    compilation,
    request=Some(first),
  ).unwrap()
  let dispatch = bound_effect_source_dispatch(allowed, definition, first)
  let expected_request = client_effect_source_binding_request(binding, dispatch).unwrap()
  let original = issue_prepared_client_effect_run_materials(
    allowed,
    definition,
    request=Some(first),
    normalization=Some(normalization),
  ).unwrap()
  let run = @publication.publication_contract_identity(definition)
  let restored = normalization_materials_untrusted_admission(
    original,
    run,
    expected_request~,
  ).unwrap()
  assert_true(
    bind_client_effect_source_dispatch(restored, dispatch, binding) is Ok(_),
  )
  assert_true(restore_client_effect_run_normalization(restored) is Ok(_))
  let changed = issue_prepared_client_effect_run_materials(
    allowed,
    definition,
    request=Some(second),
    normalization=Some(normalization),
  ).unwrap()
  assert_true(
    normalization_materials_untrusted_admission(changed, run, expected_request~)
    is Err(Request(IdentityMismatch)),
  )
}
