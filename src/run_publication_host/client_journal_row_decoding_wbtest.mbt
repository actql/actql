///|
// Fixed original row schemas and independently hashed request/Definition
// preimages. These inputs are not generated by the product codec.
let journal_decoding_wire : String =
  #|{"cancellation_requested":false,"checkpoint":null,"dispatch_reserved":false,"physical_start_claimed":false,"publication_binding":null,"request":"{\"authority_scope_cid\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"caller_input_intent_cid\":\"sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd\",\"caller_request_id\":\"caller-é\",\"intent_fingerprint_cid\":\"sha256:585c858537f5e7ec79a326a54e2891d2c3fc83c2dac4047e1b63f648d9d8f010\",\"logical_request_scope_cid\":\"sha256:11db8fa880c5aaf9c54a60dffecdb102d4b7c0cfbeb4ea3c0b86eb8b46f0b2c6\",\"parameter_values_cid\":\"sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\",\"program_definition_cid\":\"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"}","run_definition":"{\"authorization_context_cid\":\"sha256:2222222222222222222222222222222222222222222222222222222222222222\",\"compiled_plan_cid\":\"sha256:1111111111111111111111111111111111111111111111111111111111111111\",\"created_at\":\"2026-09-18T00:00:00.000Z\",\"input_artifact_set_cid\":\"sha256:3333333333333333333333333333333333333333333333333333333333333333\",\"invocation_template_cid\":\"sha256:6666666666666666666666666666666666666666666666666666666666666666\",\"run_definition_cid\":\"sha256:7a12ebea352eee2a7d88bf6df5c5b6d7b56d6383f7e6e5fc9231fef79412fafc\",\"run_id\":\"run\",\"scope_id\":\"scope\",\"valid_until\":\"2099-01-01T00:00:00.000Z\",\"version\":\"actql-run-definition/0.1\"}","version":"actql-native-client-run-row/0.1"}

///|
let journal_decoding_private_wire : String =
  #|{"cancellation_requested":true,"checkpoint":"é\r\n","dispatch_reserved":true,"effect_material_originals":"{\"value\":null,\"é\":\"é\"}","physical_start_claimed":true,"publication_binding":"original-store-é","publication_policy_originals":"{\"raw\":\"é\\r\\n\"}","request":"{\"authority_scope_cid\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"caller_input_intent_cid\":\"sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd\",\"caller_request_id\":\"caller-é\",\"intent_fingerprint_cid\":\"sha256:585c858537f5e7ec79a326a54e2891d2c3fc83c2dac4047e1b63f648d9d8f010\",\"logical_request_scope_cid\":\"sha256:11db8fa880c5aaf9c54a60dffecdb102d4b7c0cfbeb4ea3c0b86eb8b46f0b2c6\",\"parameter_values_cid\":\"sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\",\"program_definition_cid\":\"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"}","run_definition":"{\"authorization_context_cid\":\"sha256:2222222222222222222222222222222222222222222222222222222222222222\",\"compiled_plan_cid\":\"sha256:1111111111111111111111111111111111111111111111111111111111111111\",\"created_at\":\"2026-09-18T00:00:00.000Z\",\"input_artifact_set_cid\":\"sha256:3333333333333333333333333333333333333333333333333333333333333333\",\"invocation_template_cid\":\"sha256:6666666666666666666666666666666666666666666666666666666666666666\",\"run_definition_cid\":\"sha256:7a12ebea352eee2a7d88bf6df5c5b6d7b56d6383f7e6e5fc9231fef79412fafc\",\"run_id\":\"run\",\"scope_id\":\"scope\",\"valid_until\":\"2099-01-01T00:00:00.000Z\",\"version\":\"actql-run-definition/0.1\"}","version":"actql-native-client-run-row/0.1"}

///|
test "original Run row decoder preserves independently fixed request and Definition" {
  let value = decode_client_run_journal_row(@utf8.encode(journal_decoding_wire)).unwrap()
  assert_eq(client_request_caller_id(value.request), "caller-é")
  assert_eq(
    client_request_scope_cid(value.request),
    "sha256:11db8fa880c5aaf9c54a60dffecdb102d4b7c0cfbeb4ea3c0b86eb8b46f0b2c6",
  )
  assert_eq(
    @publication.publication_contract_identity(value.definition),
    "sha256:7a12ebea352eee2a7d88bf6df5c5b6d7b56d6383f7e6e5fc9231fef79412fafc",
  )
  assert_false(value.dispatch_reserved)
  assert_false(value.physical_start_claimed)
  assert_false(value.cancellation_requested)
  assert_eq(value.checkpoint, None)
  assert_eq(value.publication_binding, None)
  assert_eq(value.publication_policy_originals, None)
  assert_eq(value.effect_material_originals, None)
}

///|
test "original Run row decoding preserves unadmitted private originals without normalization" {
  let value = decode_client_run_journal_row(
    @utf8.encode(journal_decoding_private_wire),
  ).unwrap()
  assert_true(value.dispatch_reserved)
  assert_true(value.physical_start_claimed)
  assert_true(value.cancellation_requested)
  assert_eq(value.checkpoint, Some("e\u{0301}\r\n"))
  assert_eq(value.publication_binding, Some("original-store-é"))
  assert_eq(
    value.effect_material_originals,
    Some("{\"value\":null,\"é\":\"e\u{0301}\"}"),
  )
  assert_eq(
    value.publication_policy_originals,
    Some("{\"raw\":\"e\u{0301}\\r\\n\"}"),
  )
  // The intentionally unadmitted originals above are shape fields only.
  // Existing Policy/Effect/Checkpoint Owners must refuse them at readmission.
}

///|
test "original Run row decoding rejects duplicate unknown missing and wrongly typed fields" {
  for
    wire in [
      "null",
      "{}",
      journal_decoding_wire.replace(old="\"checkpoint\":null,", new=""),
      journal_decoding_wire.replace(old="\"publication_binding\":null,", new=""),
      journal_decoding_wire.replace(
        old="\"checkpoint\":null",
        new="\"checkpoint\":{}",
      ),
      journal_decoding_wire.replace(
        old="\"publication_binding\":null",
        new="\"publication_binding\":\"\"",
      ),
      journal_decoding_wire.replace(
        old="\"cancellation_requested\":false",
        new="\"cancellation_requested\":0",
      ),
      journal_decoding_wire.replace(
        old="\"cancellation_requested\":false",
        new="\"cancellation_requested\":false,\"cancellation_requested\":true",
      ),
      journal_decoding_wire.replace(old="{", new="{\"accepted\":true,"),
      journal_decoding_wire.replace(
        old="\"checkpoint\":null",
        new="\"checkpoint\":null,\"publication_policy_originals\":null",
      ),
      journal_decoding_wire.replace(
        old="\"checkpoint\":null",
        new="\"checkpoint\":null,\"effect_material_originals\":false",
      ),
    ] {
    assert_true(
      decode_client_run_journal_row(@utf8.encode(wire)) is Err(CustodyLost),
    )
  }
}

///|
test "original Run row decoding rejects forged identities and impossible start flags" {
  for
    wire in [
      journal_decoding_wire.replace(old="585c858537f5", new="000000000000"),
      journal_decoding_wire.replace(old="7a12ebea352e", new="000000000000"),
      journal_decoding_wire.replace(
        old="\"physical_start_claimed\":false",
        new="\"physical_start_claimed\":true",
      ),
      journal_decoding_wire.replace(
        old="actql-native-client-run-row/0.1",
        new="actql-native-client-run-row/0.2",
      ),
    ] {
    assert_true(
      decode_client_run_journal_row(@utf8.encode(wire)) is Err(CustodyLost),
    )
  }
}

///|
test "original Run row decoder requires exact canonical retained bytes" {
  for
    wire in [
      " " + journal_decoding_wire,
      journal_decoding_wire.replace(old="{", new="{ "),
      journal_decoding_wire.replace(old="caller-é", new="caller-e\\u0301"),
    ] {
    assert_true(
      decode_client_run_journal_row(@utf8.encode(wire)) is Err(CustodyLost),
    )
  }
}

///|
test "original Run row decoder preserves existing finite limits" {
  assert_true(
    decode_client_run_journal_row(@utf8.encode("x".repeat(131073)))
    is Err(CustodyLost),
  )
  let wire = journal_decoding_wire.replace(
    old="\"publication_binding\":null",
    new="\"publication_binding\":\"" + "x".repeat(4097) + "\"",
  )
  assert_true(
    decode_client_run_journal_row(@utf8.encode(wire)) is Err(CustodyLost),
  )
  assert_true(decode_client_run_journal_row(b"\xff") is Err(CustodyLost))
}

///|
test "original journal issuance count retains exact canonical decimal and caps" {
  for
    (bytes, maximum, count) in [
      (b"0", 1, 0),
      (b"1", 1, 1),
      (b"8", 8, 8),
      (b"1023", 1023, 1023),
      (b"1024", 1024, 1024),
      (b"1025", 1025, 1025),
      (b"10000", 10000, 10000),
      (b"2147483647", 2147483647, 2147483647),
    ] {
    assert_eq(client_journal_issuance_count(bytes, maximum), Ok(count))
  }
  for
    bytes in [
      b"", b"00", b"01", b"-1", b"+1", b"1.0", b" 0", b"0\n", b"00000", b"1025",
      b"\xff",
    ] {
    assert_eq(client_journal_issuance_count(bytes, 1024), Err(CustodyLost))
  }
  for maximum in [0, -1] {
    assert_eq(client_journal_issuance_count(b"0", maximum), Err(CustodyLost))
  }
  assert_eq(client_journal_issuance_count(b"9", 8), Err(CustodyLost))
  for bytes in [b"2147483648", b"9999999999", b"10000000000", b"00000000000"] {
    assert_eq(
      client_journal_issuance_count(bytes, 2147483647),
      Err(CustodyLost),
    )
  }
}

///|
// Existing Run Definition preimage with run_id changed independently using
// Python hashlib. This is a valid foreign original, not a substituted self CID.
let journal_decoding_other_definition = "{\"authorization_context_cid\":\"sha256:2222222222222222222222222222222222222222222222222222222222222222\",\"compiled_plan_cid\":\"sha256:1111111111111111111111111111111111111111111111111111111111111111\",\"created_at\":\"2026-09-18T00:00:00.000Z\",\"input_artifact_set_cid\":\"sha256:3333333333333333333333333333333333333333333333333333333333333333\",\"invocation_template_cid\":\"sha256:6666666666666666666666666666666666666666666666666666666666666666\",\"run_definition_cid\":\"sha256:39d086f5335d45f573ddf2a9a20d7607111cf31d5bde3e7b1258e20f295038f6\",\"run_id\":\"other-run\",\"scope_id\":\"scope\",\"valid_until\":\"2099-01-01T00:00:00.000Z\",\"version\":\"actql-run-definition/0.1\"}"

///|
fn journal_decoding_foreign_request() -> ClientRequestIdentity {
  let original = journal_encoding_original().request
  derive_client_request_identity(
    {
      program_definition_cid: client_request_program_cid(original),
      parameter_values_cid: client_request_parameters_cid(original),
    },
    client_request_authority_scope_cid(original),
    "foreign-request",
    client_request_input_cid(original),
  ).unwrap()
}

///|
test "Run row identity reuse preserves exact original instances across metadata revisions" {
  let original = journal_encoding_original()
  let changed = {
    ..original,
    dispatch_reserved: true,
    publication_policy_originals: Some("new private metadata, not a grant"),
  }
  let body = client_run_journal_row_body(changed).unwrap()
  let (decoded, local_row, observation) = decode_client_run_journal_row_with_retained_identity(
    body,
    original.request,
    original.definition,
  ).unwrap()
  assert_true(physical_equal(decoded.request, original.request))
  assert_true(physical_equal(decoded.definition, original.definition))
  assert_true(decoded.dispatch_reserved)
  assert_eq(
    decoded.publication_policy_originals,
    changed.publication_policy_originals,
  )
  assert_eq(local_row, None)
  assert_eq(observation, None)
  assert_eq(client_run_journal_row_body(decoded).unwrap(), body)
}

///|
test "Run row identity reuse independently admits changed or foreign fields" {
  let original = journal_encoding_original()
  let body = @utf8.encode(journal_decoding_wire)
  let foreign = journal_decoding_foreign_request()
  let definition = @publication.admit_publication_contract(
    "run_definition", journal_decoding_other_definition, 65536, 4096, 64,
  ).unwrap()
  let (decoded, _, _) = decode_client_run_journal_row_with_retained_identity(
    body,
    foreign,
    original.definition,
  ).unwrap()
  assert_false(physical_equal(decoded.request, foreign))
  assert_eq(client_request_caller_id(decoded.request), "caller-é")
  assert_true(physical_equal(decoded.definition, original.definition))
  let (decoded, _, _) = decode_client_run_journal_row_with_retained_identity(
    body,
    original.request,
    definition,
  ).unwrap()
  assert_true(physical_equal(decoded.request, original.request))
  assert_false(physical_equal(decoded.definition, definition))
  assert_eq(
    @publication.publication_contract_identity(decoded.definition),
    @publication.publication_contract_identity(original.definition),
  )
  // A legitimate changed row is admitted, never forced into its prior IDs.
  let changed = { ..original, request: foreign, definition, }
  let body = client_run_journal_row_body(changed).unwrap()
  let (decoded, _, _) = decode_client_run_journal_row_with_retained_identity(
    body,
    original.request,
    original.definition,
  ).unwrap()
  assert_eq(client_request_caller_id(decoded.request), "foreign-request")
  assert_eq(
    @publication.publication_contract_identity(decoded.definition),
    @publication.publication_contract_identity(definition),
  )
}

///|
test "Run row identity reuse retains malformed canonical and control refusals" {
  let original = journal_encoding_original()
  for
    wire in [
      journal_decoding_wire.replace(old="585c858537f5", new="000000000000"),
      journal_decoding_wire.replace(old="7a12ebea352e", new="000000000000"),
      journal_decoding_wire.replace(
        old="\"physical_start_claimed\":false",
        new="\"physical_start_claimed\":true",
      ),
      journal_decoding_wire.replace(
        old="\"request\":\"{",
        new="\"request\":\" {",
      ),
      journal_decoding_wire.replace(
        old="\"run_definition\":\"{",
        new="\"run_definition\":\" {",
      ),
      journal_decoding_wire.replace(old="{", new="{ "),
      journal_decoding_wire.replace(old="{", new="{\"unknown\":true,"),
      journal_decoding_wire.replace(
        old="\"checkpoint\":null",
        new="\"checkpoint\":null,\"checkpoint\":null",
      ),
      "x".repeat(131073),
    ] {
    assert_true(
      decode_client_run_journal_row_with_retained_identity(
        @utf8.encode(wire),
        original.request,
        original.definition,
      )
      is Err(CustodyLost),
    )
  }
}

///|
test "Run row identity reuse keeps raw private originals and old reader semantics" {
  let original = journal_encoding_original()
  let body = @utf8.encode(journal_decoding_private_wire)
  let (reused, _, _) = decode_client_run_journal_row_with_retained_identity(
    body,
    original.request,
    original.definition,
  ).unwrap()
  let legacy = decode_client_run_journal_row(body).unwrap()
  assert_eq(legacy.checkpoint, reused.checkpoint)
  assert_eq(legacy.effect_material_originals, reused.effect_material_originals)
  assert_eq(
    legacy.publication_policy_originals,
    reused.publication_policy_originals,
  )
  assert_false(physical_equal(legacy.request, original.request))
  assert_false(physical_equal(legacy.definition, original.definition))
  assert_true(physical_equal(reused.request, original.request))
  assert_true(physical_equal(reused.definition, original.definition))
}

///|
test "Run row retained Definition preserves the original child byte limit" {
  let original = journal_encoding_original()
  let cid = (digit : String) => "sha256:" + digit.repeat(64)
  // The public issuer accepts a larger caller budget. Its valid original is
  // not automatically admissible under the Journal child's narrower limit.
  let definition = @publication.seal_publication_contract(
    "run_definition",
    "{\"version\":\"actql-run-definition/0.1\",\"scope_id\":\"scope\",\"run_id\":\"" +
    "r".repeat(70 * 1024) +
    "\",\"compiled_plan_cid\":\"" +
    cid("1") +
    "\",\"invocation_template_cid\":\"" +
    cid("2") +
    "\",\"authorization_context_cid\":\"" +
    cid("3") +
    "\",\"input_artifact_set_cid\":\"" +
    cid("4") +
    "\",\"created_at\":\"2026-09-18T00:00:00.000Z\",\"valid_until\":\"2099-01-01T00:00:00.000Z\"}",
    131072,
    4096,
    64,
  ).unwrap()
  let wire = @publication.publication_contract_json(definition)
  assert_true(@utf8.encode(wire).length() > 65536)
  let body = client_run_journal_row_body({ ..original, definition, }).unwrap()
  assert_true(body.length() < 131072)
  assert_true(decode_client_run_journal_row(body) is Err(CustodyLost))
  assert_true(
    decode_client_run_journal_row_with_retained_identity(
      body,
      original.request,
      definition,
    )
    is Err(CustodyLost),
  )
}

///|
fn journal_decoding_limit_definition(
  run_id : String,
) -> @publication.PublicationContract {
  let cid = (digit : String) => "sha256:" + digit.repeat(64)
  @publication.seal_publication_contract(
    "run_definition",
    "{\"version\":\"actql-run-definition/0.1\",\"scope_id\":\"scope\",\"run_id\":\"" +
    run_id +
    "\",\"compiled_plan_cid\":\"" +
    cid("1") +
    "\",\"invocation_template_cid\":\"" +
    cid("2") +
    "\",\"authorization_context_cid\":\"" +
    cid("3") +
    "\",\"input_artifact_set_cid\":\"" +
    cid("4") +
    "\",\"created_at\":\"2026-09-18T00:00:00.000Z\",\"valid_until\":\"2099-01-01T00:00:00.000Z\"}",
    131072,
    4096,
    64,
  ).unwrap()
}

///|
test "Run row retained Definition preserves exact ASCII and Unicode byte boundaries" {
  let original = journal_encoding_original()
  // Independent JSON field lengths, including a 71-byte self CID, give
  // 640 UTF-8 bytes outside run_id. No expected limit uses issuer output.
  for
    (run_id, bytes, accepted) in [
      ("r".repeat(64896), 65536, true),
      ("r".repeat(64897), 65537, false),
      ("é".repeat(32448), 65536, true),
      ("é".repeat(32449), 65538, false),
    ] {
    let definition = journal_decoding_limit_definition(run_id)
    let wire = @publication.publication_contract_json(definition)
    assert_eq(@utf8.encode(wire).length(), bytes)
    let body = client_run_journal_row_body({ ..original, definition, }).unwrap()
    assert_true(body.length() < 131072)
    let legacy = decode_client_run_journal_row(body)
    let retained = decode_client_run_journal_row_with_retained_identity(
      body,
      original.request,
      definition,
    )
    if accepted {
      assert_true(legacy is Ok(_))
      let (decoded, _, _) = retained.unwrap()
      assert_true(physical_equal(decoded.definition, definition))
    } else {
      assert_true(legacy is Err(CustodyLost))
      assert_true(retained is Err(CustodyLost))
    }
  }
}
