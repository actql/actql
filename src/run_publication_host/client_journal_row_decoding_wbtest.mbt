///|
// Fixed original row schemas and independently hashed request/Definition
// preimages. These inputs are not generated by the product codec.
let journal_decoding_wire : String =
  #|{"cancellation_requested":false,"checkpoint":null,"dispatch_reserved":false,"physical_start_claimed":false,"publication_binding":null,"request":"{\"authority_scope_cid\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"caller_input_intent_cid\":\"sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd\",\"caller_request_id\":\"caller-é\",\"intent_fingerprint_cid\":\"sha256:585c858537f5e7ec79a326a54e2891d2c3fc83c2dac4047e1b63f648d9d8f010\",\"logical_request_scope_cid\":\"sha256:11db8fa880c5aaf9c54a60dffecdb102d4b7c0cfbeb4ea3c0b86eb8b46f0b2c6\",\"parameter_values_cid\":\"sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\",\"program_definition_cid\":\"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"}","run_definition":"{\"authorization_context_cid\":\"sha256:2222222222222222222222222222222222222222222222222222222222222222\",\"compiled_plan_cid\":\"sha256:1111111111111111111111111111111111111111111111111111111111111111\",\"created_at\":\"2026-09-18T00:00:00.000Z\",\"input_artifact_set_cid\":\"sha256:3333333333333333333333333333333333333333333333333333333333333333\",\"invocation_template_cid\":\"sha256:6666666666666666666666666666666666666666666666666666666666666666\",\"run_definition_cid\":\"sha256:7a12ebea352eee2a7d88bf6df5c5b6d7b56d6383f7e6e5fc9231fef79412fafc\",\"run_id\":\"run\",\"scope_id\":\"scope\",\"valid_until\":\"2099-01-01T00:00:00.000Z\",\"version\":\"actql-run-definition/0.1\"}","version":"actql-native-client-run-row/0.1"}

///|
let journal_decoding_private_wire : String =
  #|{"cancellation_requested":true,"checkpoint":"é\r\n","dispatch_reserved":true,"effect_material_originals":"{\"value\":null,\"é\":\"é\"}","physical_start_claimed":true,"publication_binding":"original-store-é","publication_policy_originals":"{\"raw\":\"é\\r\\n\"}","request":"{\"authority_scope_cid\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"caller_input_intent_cid\":\"sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd\",\"caller_request_id\":\"caller-é\",\"intent_fingerprint_cid\":\"sha256:585c858537f5e7ec79a326a54e2891d2c3fc83c2dac4047e1b63f648d9d8f010\",\"logical_request_scope_cid\":\"sha256:11db8fa880c5aaf9c54a60dffecdb102d4b7c0cfbeb4ea3c0b86eb8b46f0b2c6\",\"parameter_values_cid\":\"sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\",\"program_definition_cid\":\"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"}","run_definition":"{\"authorization_context_cid\":\"sha256:2222222222222222222222222222222222222222222222222222222222222222\",\"compiled_plan_cid\":\"sha256:1111111111111111111111111111111111111111111111111111111111111111\",\"created_at\":\"2026-09-18T00:00:00.000Z\",\"input_artifact_set_cid\":\"sha256:3333333333333333333333333333333333333333333333333333333333333333\",\"invocation_template_cid\":\"sha256:6666666666666666666666666666666666666666666666666666666666666666\",\"run_definition_cid\":\"sha256:7a12ebea352eee2a7d88bf6df5c5b6d7b56d6383f7e6e5fc9231fef79412fafc\",\"run_id\":\"run\",\"scope_id\":\"scope\",\"valid_until\":\"2099-01-01T00:00:00.000Z\",\"version\":\"actql-run-definition/0.1\"}","version":"actql-native-client-run-row/0.1"}

///|
test "original Run row decoder preserves independently fixed request and Definition" {
  let value = decode_client_run_journal_row(@utf8.encode(journal_decoding_wire)).unwrap()
  assert_eq(client_request_caller_id(value.request), "caller-é")
  assert_eq(
    client_request_scope_cid(value.request),
    "sha256:11db8fa880c5aaf9c54a60dffecdb102d4b7c0cfbeb4ea3c0b86eb8b46f0b2c6",
  )
  assert_eq(
    @publication.publication_contract_identity(value.definition),
    "sha256:7a12ebea352eee2a7d88bf6df5c5b6d7b56d6383f7e6e5fc9231fef79412fafc",
  )
  assert_false(value.dispatch_reserved)
  assert_false(value.physical_start_claimed)
  assert_false(value.cancellation_requested)
  assert_eq(value.checkpoint, None)
  assert_eq(value.publication_binding, None)
  assert_eq(value.publication_policy_originals, None)
  assert_eq(value.effect_material_originals, None)
}

///|
test "original Run row decoding preserves unadmitted private originals without normalization" {
  let value = decode_client_run_journal_row(
    @utf8.encode(journal_decoding_private_wire),
  ).unwrap()
  assert_true(value.dispatch_reserved)
  assert_true(value.physical_start_claimed)
  assert_true(value.cancellation_requested)
  assert_eq(value.checkpoint, Some("e\u{0301}\r\n"))
  assert_eq(value.publication_binding, Some("original-store-é"))
  assert_eq(
    value.effect_material_originals,
    Some("{\"value\":null,\"é\":\"e\u{0301}\"}"),
  )
  assert_eq(
    value.publication_policy_originals,
    Some("{\"raw\":\"e\u{0301}\\r\\n\"}"),
  )
  // The intentionally unadmitted originals above are shape fields only.
  // Existing Policy/Effect/Checkpoint Owners must refuse them at readmission.
}

///|
test "original Run row decoding rejects duplicate unknown missing and wrongly typed fields" {
  for
    wire in [
      "null",
      "{}",
      journal_decoding_wire.replace(old="\"checkpoint\":null,", new=""),
      journal_decoding_wire.replace(old="\"publication_binding\":null,", new=""),
      journal_decoding_wire.replace(
        old="\"checkpoint\":null",
        new="\"checkpoint\":{}",
      ),
      journal_decoding_wire.replace(
        old="\"publication_binding\":null",
        new="\"publication_binding\":\"\"",
      ),
      journal_decoding_wire.replace(
        old="\"cancellation_requested\":false",
        new="\"cancellation_requested\":0",
      ),
      journal_decoding_wire.replace(
        old="\"cancellation_requested\":false",
        new="\"cancellation_requested\":false,\"cancellation_requested\":true",
      ),
      journal_decoding_wire.replace(old="{", new="{\"accepted\":true,"),
      journal_decoding_wire.replace(
        old="\"checkpoint\":null",
        new="\"checkpoint\":null,\"publication_policy_originals\":null",
      ),
      journal_decoding_wire.replace(
        old="\"checkpoint\":null",
        new="\"checkpoint\":null,\"effect_material_originals\":false",
      ),
    ] {
    assert_true(
      decode_client_run_journal_row(@utf8.encode(wire)) is Err(CustodyLost),
    )
  }
}

///|
test "original Run row decoding rejects forged identities and impossible start flags" {
  for
    wire in [
      journal_decoding_wire.replace(old="585c858537f5", new="000000000000"),
      journal_decoding_wire.replace(old="7a12ebea352e", new="000000000000"),
      journal_decoding_wire.replace(
        old="\"physical_start_claimed\":false",
        new="\"physical_start_claimed\":true",
      ),
      journal_decoding_wire.replace(
        old="actql-native-client-run-row/0.1",
        new="actql-native-client-run-row/0.2",
      ),
    ] {
    assert_true(
      decode_client_run_journal_row(@utf8.encode(wire)) is Err(CustodyLost),
    )
  }
}

///|
test "original Run row decoder requires exact canonical retained bytes" {
  for
    wire in [
      " " + journal_decoding_wire,
      journal_decoding_wire.replace(old="{", new="{ "),
      journal_decoding_wire.replace(old="caller-é", new="caller-e\\u0301"),
    ] {
    assert_true(
      decode_client_run_journal_row(@utf8.encode(wire)) is Err(CustodyLost),
    )
  }
}

///|
test "original Run row decoder preserves existing finite limits" {
  assert_true(
    decode_client_run_journal_row(@utf8.encode("x".repeat(131073)))
    is Err(CustodyLost),
  )
  let wire = journal_decoding_wire.replace(
    old="\"publication_binding\":null",
    new="\"publication_binding\":\"" + "x".repeat(4097) + "\"",
  )
  assert_true(
    decode_client_run_journal_row(@utf8.encode(wire)) is Err(CustodyLost),
  )
  assert_true(decode_client_run_journal_row(b"\xff") is Err(CustodyLost))
}

///|
test "original journal issuance count retains exact canonical decimal and caps" {
  for
    (bytes, maximum, count) in [
      (b"0", 1, 0),
      (b"1", 1, 1),
      (b"8", 8, 8),
      (b"1024", 1024, 1024),
    ] {
    assert_eq(client_journal_issuance_count(bytes, maximum), Ok(count))
  }
  for
    bytes in [
      b"", b"00", b"01", b"-1", b"+1", b"1.0", b" 0", b"0\n", b"00000", b"1025",
      b"\xff",
    ] {
    assert_eq(client_journal_issuance_count(bytes, 1024), Err(CustodyLost))
  }
  for maximum in [0, 1025, -1] {
    assert_eq(client_journal_issuance_count(b"0", maximum), Err(CustodyLost))
  }
  assert_eq(client_journal_issuance_count(b"9", 8), Err(CustodyLost))
}
