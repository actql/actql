///|
test "Local Environment fixture preserves original identity and member-order refusals" {
  let limits : @environment.Limits = {
    max_bytes: 65536,
    max_nodes: 4096,
    max_depth: 64,
    max_members: 256,
  }
  assert_true(
    @environment.read(
      @utf8.encode(local_history_unordered_environment),
      "sha256:7d396c299e58a85fec0efdfecd0801c94a4cded4b29215a75291428a32aee0aa",
      limits,
    )
    is Err(@environment.UnsortedEvidence(@environment.ConnectorCapabilities)),
  )
  assert_true(
    @environment.read(
      @utf8.encode(local_history_ordered_environment),
      "sha256:7d396c299e58a85fec0efdfecd0801c94a4cded4b29215a75291428a32aee0aa",
      limits,
    )
    is Err(@environment.IdentityMismatch),
  )
  assert_true(
    @environment.read(
      @utf8.encode(local_history_ordered_environment),
      "sha256:9882e5f1412beaf650b0fdaf55035b198b7b87e8e9e3c3a0f07730953b0a72ed",
      limits,
    )
    is Ok(_),
  )
}
