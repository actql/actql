///|
// Exact midpoint between zero and the smallest subnormal: 2^-1075 = 5^1075 * 10^-1075.
test "long exact subnormal midpoint retains a nonzero tail beyond stored precision" {
  let coefficient = "247032822920623272088284396434110686182529901307162382212792841250337753635104375932649918" +
    "180817996189898282347722858865463328355177969898199387398005390939063150356595155702263922" +
    "908583924491051844359318028499365361525003193704576782492193656236698636584807570015857692" +
    "699037063119282795585513329278343384093519780155312465972635795746227664652728272200563740" +
    "064854999770965994704540208281662262378573934507363390079677619305775067401763246736009689" +
    "513405355374585166611342237666786041621596804619144672918403005300575308490487653917113865" +
    "916462395249126236538818796362393732804238910186723484976682350898633885879256283027559956" +
    "575244555072551893136908362547791869486679949683240497058210285131854513962138377228261454" +
    "37693412532098591327667236328125"
  let halfway = "0." + "0".repeat(323) + coefficient
  for
    (text, bits) in [
      (halfway, 0UL),
      (halfway + "0".repeat(1000), 0UL),
      (halfway + "0".repeat(1000) + "1", 1UL),
    ] {
    guard parsed(text).value is Number(number) else {
      fail("expected subnormal boundary")
    }
    assert_eq(number.reinterpret_as_uint64(), bits)
  }
  assert_eq(rejected("-" + halfway).issue, NegativeZero)
}
