///|
fn preparation_credential_fixture_scope() -> LocalPreparationCredentialScope {
  {
    account_configuration_cid: credential_cid("1"),
    account_id: "account-a",
    attempt_id: "observe-original",
    authority_scope_cid: credential_cid("2"),
    connector_registration: "salesforce-a",
    connector_revision: "salesforce-a/1",
    preparation_fence: prepare_local_preparation_fence_identity(
      preparation_identity_fields(),
    ).unwrap(),
    host_adoption_cid: credential_cid("4"),
    operation: "salesforce:record:observe",
    operation_occurrence_cid: credential_cid("3"),
    principal: "operator",
    request_body_cid: "sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
    request_cid: credential_cid("6"),
    request_method: "GET",
    request_path: "/services/data/v61.0/sobjects/Account/001-original",
    resource_origin: "https://resource.example",
    run_invocation_cid: credential_cid("4"),
    submission_scope_cid: credential_cid("2"),
    unit_definition_cid: credential_cid("5"),
  }
}

///|
fn preparation_credential_fixture_grant() -> LocalPreparationCredentialGrant {
  prepare_local_preparation_credential_grant(
    "local-authority-a",
    preparation_credential_fixture_scope(),
    2000000000000L,
    2,
  ).unwrap()
}

///|
// Independent standard-library JSON/UTF-8/SHA-256 vectors from authored literals.
// The grant and use expectation is not generated by an ActQL encoder.
let preparation_grant_body : String =
  #|{"account_configuration_cid":"sha256:1111111111111111111111111111111111111111111111111111111111111111","account_id":"account-a","attempt_id":"observe-original","authority_scope_cid":"sha256:2222222222222222222222222222222222222222222222222222222222222222","connector_registration":"salesforce-a","connector_revision":"salesforce-a/1","expires_unix_ms":"2000000000000","host_adoption_cid":"sha256:4444444444444444444444444444444444444444444444444444444444444444","issuer_authority":"local-authority-a","max_uses":2,"operation":"salesforce:record:observe","operation_occurrence_cid":"sha256:3333333333333333333333333333333333333333333333333333333333333333","preparation_fence_cid":"sha256:25682af870e2978302b45578ce9aca8d560549c3c510a073242669a5a3efbf34","principal":"operator","request_body_cid":"sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","request_cid":"sha256:6666666666666666666666666666666666666666666666666666666666666666","request_method":"GET","request_path":"/services/data/v61.0/sobjects/Account/001-original","resource_origin":"https://resource.example","run_invocation_cid":"sha256:4444444444444444444444444444444444444444444444444444444444444444","submission_scope_cid":"sha256:2222222222222222222222222222222222222222222222222222222222222222","unit_definition_cid":"sha256:5555555555555555555555555555555555555555555555555555555555555555","version":"actql-local-preparation-credential-grant/0.1"}

///|
let preparation_grant_cid : String = "sha256:f94a8a51a980cc764a6bc45f2e10805537effe1dc89e73991d119d8986ae41d2"

///|
let preparation_use_body : String =
  #|{"grant_cid":"sha256:f94a8a51a980cc764a6bc45f2e10805537effe1dc89e73991d119d8986ae41d2","use_id":"observe-use","use_ordinal":1,"version":"actql-local-credential-use/0.1"}

///|
let preparation_use_cid : String = "sha256:17f393ef1ac8c8fd7d86ddb27ae3f62869b6d3391bf1a1c040b10df8169443f8"

///|
test "Local preparation credential independent grant and use vectors retain the full original fence" {
  let scope = preparation_credential_fixture_scope()
  let grant = preparation_credential_fixture_grant()
  assert_eq(
    local_preparation_credential_grant_json(grant),
    Ok(preparation_grant_body),
  )
  assert_eq(
    local_preparation_credential_grant_cid(grant),
    preparation_grant_cid,
  )
  let restored = admit_local_preparation_credential_grant_json(
    preparation_grant_body,
    preparation_grant_cid,
    scope.preparation_fence,
  ).unwrap()
  assert_eq(local_preparation_credential_grant_scope(restored), scope)
  let first = prepare_local_preparation_credential_use(
    restored, "observe-use", 1999999999999L, 0, false, scope,
  ).unwrap()
  assert_eq(
    local_preparation_credential_use_json(first),
    Ok(preparation_use_body),
  )
  assert_eq(local_preparation_credential_use_cid(first), preparation_use_cid)
  for _ in 0..<3 {
    let original = admit_local_preparation_credential_use_json(
      grant, preparation_use_body, preparation_use_cid,
    ).unwrap()
    assert_eq(
      local_preparation_credential_use_projection(original),
      (preparation_grant_cid, "observe-use", 1),
    )
    assert_true(
      authorize_local_preparation_credential_use(
        original, 1999999999999L, false, scope,
      )
      is Ok(_),
    )
  }
}

///|
test "Local preparation credential refuses mutation body and every mismatched original fence projection" {
  let scope = preparation_credential_fixture_scope()
  for
    changed in [
      { ..scope, request_method: "PATCH", },
      { ..scope, request_method: "POST", },
      { ..scope, operation: "salesforce:record:patch", },
      { ..scope, request_body_cid: credential_cid("a"), },
      { ..scope, operation_occurrence_cid: credential_cid("a"), },
      { ..scope, run_invocation_cid: credential_cid("a"), },
      { ..scope, submission_scope_cid: credential_cid("a"), },
      { ..scope, unit_definition_cid: credential_cid("a"), },
      { ..scope, request_path: "//other.example", },
      { ..scope, resource_origin: "https://user@resource.example", },
    ] {
    assert_true(
      prepare_local_preparation_credential_grant(
        "local-authority-a", changed, 2000000000000L, 2,
      )
      is Err(InvalidCredentialGrant),
    )
  }
  let fields = preparation_identity_fields()
  for
    changed in [
      { ..fields, client_request_intent_cid: credential_cid("a"), },
      { ..fields, client_request_scope_cid: credential_cid("a"), },
      { ..fields, operation_occurrence_cid: credential_cid("a"), },
      { ..fields, run_invocation_cid: credential_cid("a"), },
      { ..fields, unit_definition_cid: credential_cid("a"), },
    ] {
    let other = prepare_local_preparation_fence_identity(changed).unwrap()
    assert_true(
      admit_local_preparation_credential_grant_json(
        preparation_grant_body, preparation_grant_cid, other,
      )
      is Err(CredentialGrantIdentityMismatch),
    )
  }
}

///|
test "Local preparation credential rejects missing malformed noncanonical and mixed-domain wire" {
  let scope = preparation_credential_fixture_scope()
  // Enumerate the authored wire fields; do not decode expectations through
  // the product parser or encoder.
  for
    (name, field) in [
      (
        "account_configuration_cid", "\"account_configuration_cid\":\"sha256:1111111111111111111111111111111111111111111111111111111111111111\"",
      ),
      ("account_id", "\"account_id\":\"account-a\""),
      ("attempt_id", "\"attempt_id\":\"observe-original\""),
      (
        "authority_scope_cid", "\"authority_scope_cid\":\"sha256:2222222222222222222222222222222222222222222222222222222222222222\"",
      ),
      ("connector_registration", "\"connector_registration\":\"salesforce-a\""),
      ("connector_revision", "\"connector_revision\":\"salesforce-a/1\""),
      ("expires_unix_ms", "\"expires_unix_ms\":\"2000000000000\""),
      (
        "host_adoption_cid", "\"host_adoption_cid\":\"sha256:4444444444444444444444444444444444444444444444444444444444444444\"",
      ),
      ("issuer_authority", "\"issuer_authority\":\"local-authority-a\""),
      ("max_uses", "\"max_uses\":2"),
      ("operation", "\"operation\":\"salesforce:record:observe\""),
      (
        "operation_occurrence_cid", "\"operation_occurrence_cid\":\"sha256:3333333333333333333333333333333333333333333333333333333333333333\"",
      ),
      (
        "preparation_fence_cid", "\"preparation_fence_cid\":\"sha256:25682af870e2978302b45578ce9aca8d560549c3c510a073242669a5a3efbf34\"",
      ),
      ("principal", "\"principal\":\"operator\""),
      (
        "request_body_cid", "\"request_body_cid\":\"sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"",
      ),
      (
        "request_cid", "\"request_cid\":\"sha256:6666666666666666666666666666666666666666666666666666666666666666\"",
      ),
      ("request_method", "\"request_method\":\"GET\""),
      (
        "request_path", "\"request_path\":\"/services/data/v61.0/sobjects/Account/001-original\"",
      ),
      ("resource_origin", "\"resource_origin\":\"https://resource.example\""),
      (
        "run_invocation_cid", "\"run_invocation_cid\":\"sha256:4444444444444444444444444444444444444444444444444444444444444444\"",
      ),
      (
        "submission_scope_cid", "\"submission_scope_cid\":\"sha256:2222222222222222222222222222222222222222222222222222222222222222\"",
      ),
      (
        "unit_definition_cid", "\"unit_definition_cid\":\"sha256:5555555555555555555555555555555555555555555555555555555555555555\"",
      ),
      (
        "version", "\"version\":\"actql-local-preparation-credential-grant/0.1\"",
      ),
    ] {
    let missing = if preparation_grant_body.contains(field + ",") {
      preparation_grant_body.replace_all(old=field + ",", new="")
    } else {
      preparation_grant_body.replace_all(old="," + field, new="")
    }
    for
      wire in [
        missing,
        preparation_grant_body.replace_all(
          old=field,
          new="\"" + name + "\":null",
        ),
      ] {
      assert_true(
        admit_local_preparation_credential_grant_json(
          wire,
          preparation_grant_cid,
          scope.preparation_fence,
        )
        is Err(_),
      )
    }
  }
  for
    wire in [
      preparation_grant_body + " ",
      preparation_grant_body.replace_all(
        old="{",
        new="{\"fence_claimant\":\"future-owner\",",
      ),
      preparation_grant_body.replace_all(
        old="{",
        new="{\"fence_generation\":\"1\",",
      ),
      preparation_grant_body.replace_all(
        old="{",
        new="{\"fence_intent_cid\":\"" + credential_cid("a") + "\",",
      ),
      preparation_grant_body.replace_all(old="{", new="{\"site_key\":\"fake\","),
      preparation_grant_body.replace_all(old="/0.1", new="/0.2"),
      preparation_grant_body.replace_all(old="sha256:", new="SHA256:"),
      " ".repeat(32769),
      local_credential_expected_body,
      credential_grant_json(credential_grant()).unwrap(),
    ] {
    assert_true(
      admit_local_preparation_credential_grant_json(
        wire,
        preparation_grant_cid,
        scope.preparation_fence,
      )
      is Err(_),
    )
  }
  assert_true(
    admit_local_credential_grant_json(
      preparation_grant_body, preparation_grant_cid,
    )
    is Err(InvalidCredentialGrant),
  )
  assert_true(
    admit_grant_json(preparation_grant_body, preparation_grant_cid)
    is Err(InvalidCredentialGrant),
  )
  assert_true(
    admit_local_preparation_credential_grant_json(
      preparation_grant_body,
      credential_cid("a"),
      scope.preparation_fence,
    )
    is Err(CredentialGrantIdentityMismatch),
  )
}

///|
test "Local preparation credential use refuses changed authority request and original identity without renewing limits" {
  let scope = preparation_credential_fixture_scope()
  let grant = preparation_credential_fixture_grant()
  let first = prepare_local_preparation_credential_use(
    grant, "observe-use", 1999999999999L, 0, false, scope,
  ).unwrap()
  let changed_fence = prepare_local_preparation_fence_identity({
    ..preparation_identity_fields(),
    client_request_intent_cid: credential_cid("a"),
  }).unwrap()
  for
    changed in [
      { ..scope, account_configuration_cid: credential_cid("a"), },
      { ..scope, account_id: "other", },
      { ..scope, attempt_id: "other", },
      { ..scope, authority_scope_cid: credential_cid("a"), },
      { ..scope, connector_registration: "other", },
      { ..scope, connector_revision: "other", },
      { ..scope, host_adoption_cid: credential_cid("a"), },
      { ..scope, operation: "other", },
      { ..scope, operation_occurrence_cid: credential_cid("a"), },
      { ..scope, preparation_fence: changed_fence, },
      { ..scope, principal: "other", },
      { ..scope, request_body_cid: credential_cid("a"), },
      { ..scope, request_cid: credential_cid("a"), },
      { ..scope, request_method: "PATCH", },
      { ..scope, request_path: "/other", },
      { ..scope, resource_origin: "https://other.example", },
      { ..scope, run_invocation_cid: credential_cid("a"), },
      { ..scope, submission_scope_cid: credential_cid("a"), },
      { ..scope, unit_definition_cid: credential_cid("a"), },
    ] {
    assert_true(
      prepare_local_preparation_credential_use(
        grant, "next", 1999999999999L, 1, false, changed,
      )
      is Err(CredentialGrantInactive),
    )
    assert_true(
      authorize_local_preparation_credential_use(
        first, 1999999999999L, false, changed,
      )
      is Err(CredentialGrantInactive),
    )
  }
  for now in [-1L, 2000000000000L] {
    assert_true(
      prepare_local_preparation_credential_use(
        grant, "next", now, 0, false, scope,
      )
      is Err(CredentialGrantInactive),
    )
    assert_true(
      authorize_local_preparation_credential_use(first, now, false, scope)
      is Err(CredentialGrantInactive),
    )
  }
  assert_true(
    prepare_local_preparation_credential_use(
      grant, "next", 1999999999999L, 2, false, scope,
    )
    is Err(CredentialGrantInactive),
  )
  assert_true(
    authorize_local_preparation_credential_use(
      first, 1999999999999L, true, scope,
    )
    is Err(CredentialGrantInactive),
  )
  assert_true(
    admit_local_preparation_credential_use_json(
      grant,
      preparation_use_body + " ",
      preparation_use_cid,
    )
    is Err(CredentialUseCollision),
  )
  assert_true(
    admit_local_credential_use_json(
      local_credential_fixture_grant(),
      preparation_use_body,
      preparation_use_cid,
    )
    is Err(CredentialUseCollision),
  )
  assert_true(
    admit_credential_use_json(
      credential_grant(),
      preparation_use_body,
      preparation_use_cid,
    )
    is Err(CredentialUseCollision),
  )
  assert_eq(
    local_credential_grant_json(local_credential_fixture_grant()),
    Ok(local_credential_expected_body),
  )
  assert_eq(
    credential_grant_cid(credential_grant()),
    "sha256:06e4af5fa870fbe558c30211879440b84757b52e5d761cdb80f65c4b0eeb6d1c",
  )
}

///|
test "Local preparation credential preserves original Unicode and each line ending" {
  let scope = preparation_credential_fixture_scope()
  let original = "e\u0301\r\n"
  let grant = prepare_local_preparation_credential_grant(
    "local-authority-a",
    { ..scope, principal: original, },
    2000000000000L,
    2,
  ).unwrap()
  let restored = admit_local_preparation_credential_grant_json(
    local_preparation_credential_grant_json(grant).unwrap(),
    local_preparation_credential_grant_cid(grant),
    scope.preparation_fence,
  ).unwrap()
  assert_eq(
    local_preparation_credential_grant_scope(restored).principal,
    original,
  )
  for changed in ["é\r\n", "e\u0301\r", "e\u0301\n"] {
    let other = prepare_local_preparation_credential_grant(
      "local-authority-a",
      { ..scope, principal: changed, },
      2000000000000L,
      2,
    ).unwrap()
    assert_false(
      local_preparation_credential_grant_cid(other) ==
      local_preparation_credential_grant_cid(grant),
    )
  }
}

///|
test "Local preparation credential keeps finite issuer expiry use and transport budgets" {
  let scope = preparation_credential_fixture_scope()
  for issuer in ["", "i".repeat(513)] {
    assert_true(
      prepare_local_preparation_credential_grant(
        issuer, scope, 2000000000000L, 2,
      )
      is Err(InvalidCredentialGrant),
    )
  }
  for uses in [0, 1025] {
    assert_true(
      prepare_local_preparation_credential_grant(
        "local-authority-a", scope, 2000000000000L, uses,
      )
      is Err(InvalidCredentialGrant),
    )
  }
  for expiry in [-1L, 0L] {
    assert_true(
      prepare_local_preparation_credential_grant(
        "local-authority-a", scope, expiry, 2,
      )
      is Err(InvalidCredentialGrant),
    )
  }
  for
    changed in [
      { ..scope, account_id: "a".repeat(513), },
      { ..scope, attempt_id: "a".repeat(257), },
      { ..scope, request_path: "/" + "a".repeat(2048), },
    ] {
    assert_true(
      prepare_local_preparation_credential_grant(
        "local-authority-a", changed, 2000000000000L, 2,
      )
      is Err(InvalidCredentialGrant),
    )
  }
  let grant = preparation_credential_fixture_grant()
  assert_true(
    prepare_local_preparation_credential_use(
      grant,
      "u".repeat(257),
      1999999999999L,
      0,
      false,
      scope,
    )
    is Err(CredentialGrantInactive),
  )
}
