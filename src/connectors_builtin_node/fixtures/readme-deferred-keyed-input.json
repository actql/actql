  "publicationWire": "{\"environmentCid\":\"sha256:06a84050e708b158f01e77d7bbea8fbd4e392f85219cda9a80f0b7aa61e15caf\",\"aliases\":[{\"name\":\"salesforce.opportunities\",\"sourceRef\":\"connector://salesforce/Opportunity#records\",\"sourceViewContractCid\":\"sha256:3dfd92bc95dda82beeb5416b54a4a7994f8637a8d142272d5b92de7c50d83fb9\",\"schemaContractCid\":\"sha256:35ea261fabf053209a426e03ec25516a49999eec773b188d263ba8a02f863275\"},{\"name\":\"drive.files\",\"sourceRef\":\"connector://drive/files#records\",\"sourceViewContractCid\":\"sha256:82bf54fe47cc1c4e4f1cecc7350c189e9f7d94dd354e1fd2330becf45d659f7b\",\"schemaContractCid\":\"sha256:dd1c24e31e22d61a2e3ce6d0ca1afe2fc06af7b8926476c266374b20d22eb2b4\",\"request\":{\"paths\":null,\"glob\":null}},{\"name\":\"drive.contents\",\"sourceRef\":\"connector://drive/contents#records\",\"sourceViewContractCid\":\"sha256:6ced0971e3bc0fe2dfa5980f093e88431833a61fc31f76194279c98cdc5e680e\",\"schemaContractCid\":\"sha256:4d9decec7c0ace38459dec83fed01c2f8e7c20e9b4ab6d87cd8b670f76fdfbc5\"}],\"updateTargets\":[{\"name\":\"salesforce.Opportunity\",\"targetRef\":\"connector://salesforce/Opportunity\",\"installationBindingCid\":\"sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd\",\"installationOwnerCid\":\"sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee\"}]}",
  "source": "SELECT o.id AS id, o.StageName, o.NextStep,\n       c.content AS notes\nFROM salesforce.opportunities AS o\nJOIN drive.files AS f ON f.name = o.name\nJOIN drive.contents AS c USING (resource, version)\n|> ASSERT UNIQUE BY (id)\n|> INFER `model-task:deal-review.v1`\n     INPUT (StageName, NextStep, notes) AS review\n|> WHERE review.outcome = 'ok' AND review.value.changed\n|> RESULT updates\n|> EFFECT UPDATE salesforce.Opportunity\n     ID id SET (\n       StageName = review.value.stage,\n       NextStep = review.value.next_step\n     );\n",
  "task": "task: model-task:deal-review.v1\ninput:\n  StageName: string\n  NextStep: {type: string, nullable: true}\n  notes: {type: content_ref, nullable: false}\ninstructions: |\n  Review only the current stage, current next step and the captured meeting\n  notes supplied for this deal. State whether the notes establish a change.\n  When they do, return the new stage and one specific next step supported by\n  those notes. Do not invent facts, external context or another document.\noutput:\n  changed: boolean\n  stage: string\n  next_step: string\n"
}
