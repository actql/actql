// Errors
pub(all) suberror ClientBroadResidualNodeIssue {
  Preparation(@client_local_host.ClientQueryResidualIssue)
  Local(@connector_sdk.FixedComputeIssue)
  Acquisition(@actql/actql/connectors/duckdb/host.BroadHostIssue)
  Stopped
}

pub(all) suberror ClientProgramRunObservationIssue {
  Observation(@run_publication.RunStateObservationIssue)
}

pub(all) suberror ClientProgramRunStateIssue {
  InvalidTerminalOutcome
  Projection(@run_publication.RunStateIssue)
}

pub suberror ClientRequestProgramModuleBridgeIssue {
  Manifests(@run_publication_host.ClientCompilationManifestIssue)
  Preparation(@client_local_host.ClientRequestProgramPlanIssue)
}

pub(all) suberror NodeHostFailure {
  Diagnostics(@physical_host_dispatch.ComputeDiagnosticsIssue)
  Dispatch(@physical_host_dispatch.ComputeHostIssue[@physical_strategy_host.RunIssue])
  Execution(@physical_strategy_host.RunIssue)
  InvalidCommand
  Encoding(@encode_core.EncodeFailure)
  OutputExport(@execution_relation.CompletedExportIssue)
  PublicationEvidence(@run_publication.ResultEvidenceIssuanceIssue)
  ResultTransformation(@run_publication_host.CapturedClientResultTransformationIssue)
  EffectIdentity(@effect_application.EffectIdentityIssue)
  EffectSetProgress(@effect_application.EffectSetProgressIssue)
  EffectFootprint(@effect_application.EffectFootprintIssue)
  EffectPreviewFootprint(@effect_application.EffectPreviewFootprintIssue)
  EffectPreviewIdentity(@effect_application.EffectPreviewApplyIdentityIssue)
  EffectPreviewRecoveryKeys(@effect_application.EffectPreviewRecoveryKeysIssue)
  EffectPreviewTargetGuard(@effect_application.EffectPreviewTargetGuardIssue)
  EffectCollectionBatch(@effect_application.EffectCollectionBatchIssue)
  EffectLedger(@effect_application.EffectLedgerIssue)
  CapturedRun(@run_publication.CapturedRunIssuanceIssue)
  RemoteDispatch(@remote_site_protocol.DispatchIssue)
  RemoteTransfer(@remote_transfer.RemoteTransferIssue)
  RemoteCredential(@remote_credential.RemoteCredentialIssue)
  RemoteBundle(@remote_bundle.RemoteBundleIssue)
  PhysicalManifest(@physical_manifest.PhysicalManifestIssue)
  LocalManagedStart(@actql/actql/connectors/local/driver.LocalDispatchIssue)
  ReferenceComputeManagedStart(@reference_compute.PlanIssue)
}

