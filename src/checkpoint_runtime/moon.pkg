supported_targets = "+js+wasm+native"

import {
  "actql/actql/canonical_json" @json,
  "actql/actql/canonical_value" @canonical,
  "actql/actql/decode_scalar" @scalar,
  "actql/actql/run_publication" @publication,
  "actql/actql/source_value" @source,
  "moonbitlang/core/encoding/base64",
}

formatter(ignore: [ "signature_vectors.generated_test.mbt" ])

import {
  "moonbitlang/core/encoding/utf8",
} for "wbtest"
