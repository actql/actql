supported_targets = "+js+wasm+native"

import {
  "actql/actql/bounded_execution" @bounded,
  "actql/actql/carrier_contract" @carrier,
  "actql/actql/carrier_projection",
  "actql/actql/connector_sdk" @connector,
  "actql/actql/connectors/local",
  "actql/actql/execution_relation" @execution,
  "actql/actql/local_bridge" @bridge,
  "actql/actql/local_tea" @tea,
  "actql/actql/lowering_relation" @lower,
  "actql/actql/managed_record_runtime" @records,
  "actql/actql/managed_record_storage" @storage,
  "actql/actql/managed_carrier_runtime" @lifecycle,
}

import {
  "actql/actql/pipeline_typing" @pipeline,
  "actql/actql/decode_core" @decode,
  "actql/actql/source_value" @source,
  "actql/actql/calendar_profile",
  "actql/actql/canonical_json" @identity,
  "actql/actql/value_admission" @value,
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
} for "wbtest"
