) -> Unit raise NodeHostFailure {
  match
    @strategy.abort_captured_managed_transfer(
      @host_driver.dispatch_driver_run(@builtin.configured_host_driver(host)),
      transfer,
      confirmed,
    ) {
    Ok(_) => ()
    Err(issue) => raise Execution(@strategy.Physical(issue))
  }
}

