// Snapshots of the independent original five/two Source controls, never product output.

///|
fn composite_vector_source_preparation_normal_inputs() -> Array[String] {
  [
    // composite-vector-json
    "{\"kind\":\"program\",\"input\":{\"version\":\"actql/0.1\",\"id\":\"fixture.composite_vectors\",\"stages\":[{\"id\":\"queries_source\",\"inputs\":{\"remote\":{\"connector\":\"composite_fixture\",\"resource\":\"queries\"}},\"steps\":[{\"from\":\"remote\",\"filter\":\"true\",\"as\":\"all_rows\"},{\"from\":\"all_rows\",\"select\":[\"a\",\"b\",\"embedding\"],\"as\":\"captured\"}],\"results\":{\"rows\":{\"from\":\"captured\",\"fields\":[\"a\",\"b\",\"embedding\"]}}},{\"id\":\"candidates_source\",\"inputs\":{\"remote\":{\"connector\":\"composite_fixture\",\"resource\":\"candidates\"}},\"steps\":[{\"from\":\"remote\",\"filter\":\"true\",\"as\":\"all_rows\"},{\"from\":\"all_rows\",\"select\":[\"a\",\"b\",\"embedding\"],\"as\":\"captured\"}],\"results\":{\"rows\":{\"from\":\"captured\",\"fields\":[\"a\",\"b\",\"embedding\"]}}},{\"id\":\"main\",\"inputs\":{\"queries\":{\"result\":{\"stage\":\"queries_source\",\"result\":\"rows\"}},\"candidates\":{\"result\":{\"stage\":\"candidates_source\",\"result\":\"rows\"}}},\"steps\":[{\"from\":\"queries\",\"pool_vectors\":{\"by\":[\"b\",\"a\"],\"method\":\"mean\",\"vector\":\"embedding\"},\"as\":\"qv\"},{\"from\":\"candidates\",\"pool_vectors\":{\"by\":[\"b\",\"a\"],\"method\":\"mean\",\"vector\":\"embedding\"},\"as\":\"cv\"},{\"from\":\"cv\",\"nearest\":{\"queries\":\"qv\",\"metric\":\"cosine\",\"k\":1},\"as\":\"matches\"},{\"from\":\"matches\",\"derive\":{\"hit\":{\"object\":{\"query_key\":{\"object\":{\"b\":{\"property\":{\"value\":{\"field\":\"query_id\"},\"name\":\"0\"}},\"a\":{\"property\":{\"value\":{\"field\":\"query_id\"},\"name\":\"1\"}}}},\"candidate_key\":{\"object\":{\"b\":{\"property\":{\"value\":{\"field\":\"candidate_id\"},\"name\":\"0\"}},\"a\":{\"property\":{\"value\":{\"field\":\"candidate_id\"},\"name\":\"1\"}}}},\"score\":{\"field\":\"score\"},\"rank\":{\"field\":\"rank\"}}},\"query_a\":{\"property\":{\"value\":{\"field\":\"query_id\"},\"name\":\"1\"}},\"candidate_a\":{\"property\":{\"value\":{\"field\":\"candidate_id\"},\"name\":\"1\"}}},\"as\":\"projected\"},{\"from\":\"projected\",\"sort\":[{\"field\":\"query_a\",\"dir\":\"asc\",\"nulls\":\"first\"},{\"field\":\"candidate_a\",\"dir\":\"asc\",\"nulls\":\"first\"}],\"as\":\"ordered\"},{\"from\":\"ordered\",\"select\":[\"hit\"],\"as\":\"out\"}],\"results\":{\"rows\":{\"from\":\"out\",\"fields\":[\"hit\"]}}}],\"results\":{\"answer\":{\"from\":{\"stage\":\"main\",\"result\":\"rows\"}}}},\"parameters\":null}",
    // composite-vector-implicit-sql
     "{\"kind\":\"aql\",\"input\":{\"format\":\"sql\",\"text\":\"WITH qv AS (FROM queries |> pool_vectors(by: [b, a], method: 'mean', vector: embedding)), cv AS (FROM candidates |> pool_vectors(by: [b, a], method: 'mean', vector: embedding)), hits AS (FROM qv |> NEAREST cv AS corpus METRIC cosine K 1 AS hit) SELECT hit FROM hits ORDER BY hit.query_key.a, hit.candidate_key.a\"},\"parameters\":null}",
    // composite-vector-implicit-aql-text
     "{\"kind\":\"aql\",\"input\":{\"format\":\"aql-text\",\"text\":\"WITH qv AS (FROM queries |> pool_vectors(by: [b, a], method: 'mean', vector: embedding)), cv AS (FROM candidates |> pool_vectors(by: [b, a], method: 'mean', vector: embedding)) FROM qv |> NEAREST cv AS corpus METRIC cosine K 1 AS hit |> SELECT hit |> ORDER BY hit.query_key.a, hit.candidate_key.a\"},\"parameters\":null}",
    // composite-vector-explicit-sql
     "{\"kind\":\"aql\",\"input\":{\"format\":\"sql\",\"text\":\"WITH qv AS (FROM queries |> pool_vectors(by: [b, a], method: 'mean', vector: embedding)), cv AS (FROM candidates |> pool_vectors(by: [b, a], method: 'mean', vector: embedding)), hits AS (FROM qv |> NEAREST cv AS corpus QUERY KEY (b, a) VECTOR embedding CANDIDATE KEY (corpus.b, corpus.a) VECTOR corpus.embedding METRIC cosine K 1 AS hit) SELECT hit FROM hits ORDER BY hit.query_key.a, hit.candidate_key.a\"},\"parameters\":null}",
    // composite-vector-explicit-aql-text
     "{\"kind\":\"aql\",\"input\":{\"format\":\"aql-text\",\"text\":\"WITH qv AS (FROM queries |> pool_vectors(by: [b, a], method: 'mean', vector: embedding)), cv AS (FROM candidates |> pool_vectors(by: [b, a], method: 'mean', vector: embedding)) FROM qv |> NEAREST cv AS corpus QUERY KEY (b, a) VECTOR embedding CANDIDATE KEY (corpus.b, corpus.a) VECTOR corpus.embedding METRIC cosine K 1 AS hit |> SELECT hit |> ORDER BY hit.query_key.a, hit.candidate_key.a\"},\"parameters\":null}",
  ]
}

///|
fn composite_vector_source_preparation_refusal_inputs() -> Array[String] {
  [
    // composite-vector-reordered-query-key-sql
    "{\"kind\":\"aql\",\"input\":{\"format\":\"sql\",\"text\":\"WITH qv AS (FROM queries |> pool_vectors(by: [b, a], method: 'mean', vector: embedding)), cv AS (FROM candidates |> pool_vectors(by: [b, a], method: 'mean', vector: embedding)), hits AS (FROM qv |> NEAREST cv AS corpus QUERY KEY (a, b) VECTOR embedding CANDIDATE KEY (corpus.b, corpus.a) VECTOR corpus.embedding METRIC cosine K 1 AS hit) SELECT hit FROM hits ORDER BY hit.query_key.a, hit.candidate_key.a\"},\"parameters\":null}",
    // composite-vector-reordered-query-key-aql-text
     "{\"kind\":\"aql\",\"input\":{\"format\":\"aql-text\",\"text\":\"WITH qv AS (FROM queries |> pool_vectors(by: [b, a], method: 'mean', vector: embedding)), cv AS (FROM candidates |> pool_vectors(by: [b, a], method: 'mean', vector: embedding)) FROM qv |> NEAREST cv AS corpus QUERY KEY (a, b) VECTOR embedding CANDIDATE KEY (corpus.b, corpus.a) VECTOR corpus.embedding METRIC cosine K 1 AS hit |> SELECT hit |> ORDER BY hit.query_key.a, hit.candidate_key.a\"},\"parameters\":null}",
  ]
}

///|
fn composite_vector_source_preparation_expected_schema() -> String {
  "{\"hit\":{\"additional_properties\":false,\"fields\":{\"candidate_key\":{\"additional_properties\":false,\"fields\":{\"a\":{\"max_utf8_bytes\":1,\"nullable\":false,\"type\":\"string\"},\"b\":{\"nullable\":false,\"type\":\"number\"}},\"nullable\":false,\"type\":\"object\"},\"query_key\":{\"additional_properties\":false,\"fields\":{\"a\":{\"max_utf8_bytes\":1,\"nullable\":false,\"type\":\"string\"},\"b\":{\"nullable\":false,\"type\":\"number\"}},\"nullable\":false,\"type\":\"object\"},\"rank\":{\"nullable\":false,\"type\":\"number\"},\"score\":{\"nullable\":false,\"type\":\"number\"}},\"nullable\":false,\"type\":\"object\"}}"
}
