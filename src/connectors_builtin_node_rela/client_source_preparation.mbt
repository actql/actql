///|
fn client_prepare_source_computation(
  document : String,
  format : String,
  environment : @program_check.CheckEnvironment,
  publication : String,
  declarations : String?,
  parameters : String?,
  allow_effects : Bool,
  evidence : Array[@context.StageCapacityInput],
  public_primary? : Bool = false,
) -> ClientSourceComputationBridgeOutcome {
  let catalogs : Array[@program_check.PreparedSourceCatalog] = []
  let lowered = match
    client_program_lower_source(
      document,
      format,
      environment,
      publication,
      declarations,
      public_primary~,
      source_catalog_out=Some(catalogs),
    ) {
    Ok(value) => value
    Err(issue) => return SourcePure(Rejected(issue))
  }
  guard catalogs.length() == 1 && catalogs.get(0) is Some(source_catalog) else {
    return SourcePure(Rejected(SourcePreparation(Publication)))
  }
  client_program_finish_source_computation(
    lowered, environment, source_catalog, parameters, allow_effects, evidence,
  )
}

///|
fn client_program_finish_source_computation(
  lowered : @source_frontend.Lowered,
  environment : @program_check.CheckEnvironment,
  source_catalog : @program_check.PreparedSourceCatalog,
  parameters : String?,
  allow_effects : Bool,
  evidence : Array[@context.StageCapacityInput],
) -> ClientSourceComputationBridgeOutcome {
  let (_, supplied) = match client_program_input("json", parameters) {
    Ok(value) => value
    Err(issue) => return SourcePure(Rejected(issue))
  }
  let limits = client_program_standard_limits()
  let parsed = match client_source_program(lowered) {
    Ok(value) => value
    Err(issue) => return SourcePure(Rejected(issue))
  }
  for stage in @stage_syntax.stages(parsed) {
    if !@stage_syntax.effect_names(stage).is_empty() {
      if !allow_effects {
        return SourcePure(Rejected(Preparation(EffectNotSupported(stage.id))))
      }
      // The static publication is not installed target custody. Until the
      // existing Effect owner consumes that exact original selection, refuse
      // rather than discard it or reconstruct authority from canonical text.
      if lowered.command_selection is Some(_) {
        return SourcePure(
          Rejected(SourcePreparation(CommandTargetOriginalsUnavailable)),
        )
      }
      if lowered.keyed_effect_kind is Some(Upsert | Delete) ||
        lowered.insert_effect {
        // This Source caller has not connected original record capture yet.
        // Keep its explicit refusal distinct from canonical DELETE selection.
        return SourcePure(
          Rejected(SourcePreparation(RecordTargetOriginalsUnavailable)),
        )
      }
      let value = match
        @publication_host.prepare_parsed_client_effect_computation(
          parsed,
          environment,
          supplied,
          evidence,
          client_program_effect_limits(),
          update_targets=lowered.update_targets,
          store_targets=lowered.store_targets,
          command_targets=lowered.command_targets,
          source_catalog=Some(source_catalog),
        ) {
        Ok(value) => value
        Err(issue) => return SourceEffect(EffectRejected(Preparation(issue)))
      }
      match
        @source_frontend.check_array_profile(
          @program_check.effect_program_static_checked_computation(
            @publication_host.prepared_client_effect_computation_candidate(
              value,
            ),
          ),
          max_work=1000000,
          max_slots=100000,
        ) {
        Ok(_) => return SourceEffect(EffectPrepared(value))
        // Source rejection has the parser/lowerer's typed input classification.
        // It never prepares a second computation owner.
        Err(issue) =>
          return SourcePure(Rejected(SourcePreparation(ArrayProfile(issue))))
      }
    }
  }
  SourcePure(
    client_source_checked_array_profile(
      match
        @publication_host.prepare_parsed_effect_free_client_program(
          parsed,
          environment,
          supplied,
          limits,
          source_catalog=Some(source_catalog),
        ) {
        Ok(value) => Prepared(value)
        Err(issue) => Rejected(Preparation(issue))
      },
    ),
  )
}

///|
#export_name("clientProgramSourceComputationPure")
pub fn client_program_source_computation_pure(
  outcome : ClientSourceComputationBridgeOutcome,
) -> ClientProgramBridgeOutcome? {
  match outcome {
    SourcePure(value) => Some(value)
    SourceEffect(_) => None
  }
}

///|
#export_name("clientProgramSourceComputationEffect")
pub fn client_program_source_computation_effect(
  outcome : ClientSourceComputationBridgeOutcome,
) -> ClientEffectProgramBridgeOutcome? {
  match outcome {
    SourcePure(_) => None
    SourceEffect(value) => Some(value)
  }
}
