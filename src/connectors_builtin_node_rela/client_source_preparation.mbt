// Generated by scripts/connector-node-bundles.mjs; edit the selected bridge.

///|
/// Host-local source preparation. Publication input is installation metadata,
/// not Client-supplied schema, an acquisition receipt or a read grant.
pub(all) enum ClientSourcePreparationIssue {
  Publication
  Limit
  UnsupportedCarrier
  Declarations
  Alias(@source_frontend.AliasIssue)
  Frontend(@source_frontend.Issue)
  ArrayProfile(@source_frontend.ArrayProfileIssue)
}

///|
fn client_source_preparation_issue_code(
  issue : ClientSourcePreparationIssue,
) -> String {
  match issue {
    Publication | Alias(_) => "source_rejected"
    Limit => "source_limit"
    UnsupportedCarrier => "source_unsupported"
    Declarations => "source_declarations"
    ArrayProfile(BudgetExceeded) => "source_limit"
    ArrayProfile(UnsupportedNestedArray(_, _, _))
    | ArrayProfile(UnsupportedNestedArrayColumn(_, _, _)) =>
      "source_unsupported"
    ArrayProfile(_) => "source_invalid_input"
    Frontend(issue) =>
      match issue {
        MissingQueryContext => "source_missing_input"
        Encoding => "source_encoding"
        QueryLowering(issue) =>
          match issue {
            UnknownRelation | UnresolvedRelation(_) => "source_unresolved"
            UnsupportedProjection
            | UnsupportedGrouping
            | UnsupportedAggregate
            | UnsupportedHaving
            | UnsupportedOrdering
            | UnsupportedAnalytic
            | UnsupportedSet
            | UnsupportedJoin
            | UnsupportedCte
            | UnsupportedGraph => "source_unsupported"
            // These typed facts come from the existing lowerer. The public
            // submission projection must still establish audience disclosure.
            InvalidQuery
            | UnknownColumn
            | AmbiguousColumn
            | AmbiguousRelation
            | DuplicateOutput
            | ExpressionTyping(
              {
                kind: UnknownField(_)
                | UnknownParameter(_)
                | TypeMismatch(_)
                | MissingJoinScope(_)
                | ForbiddenConstructorValue
                | InvalidStaticOption(_)
                | InvalidJsonLiteral(_)
                | NullTypeUnresolved,
                ..
              }
            )
            | Expression(
              { issue: UnknownReference | InvalidArguments | InvalidNumber, .. }
            ) => "source_invalid_input"
            _ => "source_rejected"
          }
        QuerySyntax({ issue: Limit(_), .. }) => "source_limit"
        _ => "source_invalid_input"
      }
  }
}

///|
priv suberror ClientSourceStop {
  ClientSourceStop(ClientSourcePreparationIssue)
}

///|
fn source_publication_cursor(
  wire : String,
) -> @decode.Cursor raise ClientSourceStop {
  let node = @source.parse_json_bytes(@utf8.encode(wire), {
    max_input_bytes: 1048576,
    max_nodes: 16384,
    max_depth: 32,
  }).unwrap_or_else(() => raise ClientSourceStop(Publication))
  @decode.admit(node, {
    max_nodes: 16384,
    max_depth: 32,
    max_string_bytes: 65536,
    max_total_string_bytes: 1048576,
  }).unwrap_or_else(() => raise ClientSourceStop(Publication))
}

///|
fn source_publication_field(
  value : @decode.Cursor,
  name : String,
) -> @decode.Cursor raise ClientSourceStop {
  let object = @decode.open_object(value).unwrap_or_else(() => {
    raise ClientSourceStop(Publication)
  })
  @decode.required(object, name).unwrap_or_else(() => {
    raise ClientSourceStop(Publication)
  })
}

///|
fn source_publication_text(
  value : @decode.Cursor,
  name : String,
) -> String raise ClientSourceStop {
  @decode.text(source_publication_field(value, name)).unwrap_or_else(() => {
    raise ClientSourceStop(Publication)
  })
}

///|
fn client_source_context(
  environment : @program_check.CheckEnvironment,
  publication : String,
  declarations : String?,
) -> @query_program.Context raise ClientSourceStop {
  match
    @source_publication.bind_published_query_context(
      environment, publication, declarations,
    ) {
    Ok(context) => context
    Err(issue) =>
      raise ClientSourceStop(
        match issue {
          Publication => Publication
          Limit => Limit
          UnsupportedCarrier => UnsupportedCarrier
          Declarations => Declarations
          Alias(issue) => Alias(issue)
        },
      )
  }
}

///|
#export_name("clientProgramCheckingEnvironmentCid")
pub fn client_program_checking_environment_cid(
  environment : @program_check.CheckEnvironment,
) -> String {
  @program_check.checking_environment_cid(environment)
}

///|
#export_name("clientProgramSourcePublicationValid")
pub fn client_program_source_publication_valid(
  environment : @program_check.CheckEnvironment,
  publication : String,
) -> Bool {
  try {
    client_source_context(environment, publication, None) |> ignore
    client_table_write_publication(environment, publication) |> ignore
    true
  } catch {
    _ => false
  }
}

///|
#export_name("clientProgramPrepareSourceWithParameters")
pub fn client_program_prepare_source_with_parameters(
  document : String,
  format : String,
  environment : @program_check.CheckEnvironment,
  publication : String,
  declarations : String?,
  parameters : String?,
) -> ClientProgramBridgeOutcome {
  let lowered = match
    client_program_lower_source(
      document, format, environment, publication, declarations,
    ) {
    Ok(value) => value
    Err(issue) => return Rejected(issue)
  }
  let prepared = client_program_prepare_effect_free_with_parameters(
    lowered.document,
    "json",
    environment,
    parameters,
  )
  client_source_checked_array_profile(prepared)
}

///|
fn client_source_checked_array_profile(
  outcome : ClientProgramBridgeOutcome,
) -> ClientProgramBridgeOutcome {
  match outcome {
    Prepared(value) =>
      match
        @source_frontend.check_array_profile(
          @strategy.graph_program(
            @publication_host.prepared_client_graph(value),
          ),
          max_work=1000000,
          max_slots=100000,
        ) {
        Ok(_) => outcome
        Err(issue) => Rejected(SourcePreparation(ArrayProfile(issue)))
      }
    _ => outcome
  }
}

///|
fn client_program_lower_source(
  document : String,
  format : String,
  environment : @program_check.CheckEnvironment,
  publication : String,
  declarations : String?,
) -> Result[@source_frontend.Lowered, ClientProgramBridgeIssue] {
  let context = client_source_context(environment, publication, declarations) catch {
    ClientSourceStop(issue) => return Err(SourcePreparation(issue))
  }
  let selected = match @source_frontend.select_format(format) {
    Ok(Text) => @source_frontend.Text
    Ok(Sql) => @source_frontend.Sql
    _ => return Err(InvalidFormat)
  }
  let table_writes = client_table_write_publication(environment, publication) catch {
    ClientSourceStop(issue) => return Err(SourcePreparation(issue))
  }
  match
    @source_frontend.lower(document, selected, Some(context), table_writes~) {
    Ok(value) => Ok(value)
    Err(issue) => Err(SourcePreparation(Frontend(issue)))
  }
}

///|
/// Select an existing computation owner from the parser's Effect inventory,
/// before semantic checking. Neither branch is a fallback for the other.
pub(all) enum ClientSourceComputationBridgeOutcome {
  SourcePure(ClientProgramBridgeOutcome)
  SourceEffect(ClientEffectProgramBridgeOutcome)
}

///|
#export_name("clientProgramPrepareSourceComputationWithParameters")
pub fn client_program_prepare_source_computation_with_parameters(
  document : String,
  format : String,
  environment : @program_check.CheckEnvironment,
  publication : String,
  declarations : String?,
  parameters : String?,
  allow_effects : Bool,
  evidence : Array[@context.StageCapacityInput],
) -> ClientSourceComputationBridgeOutcome {
  let lowered = match
    client_program_lower_source(
      document, format, environment, publication, declarations,
    ) {
    Ok(value) => value
    Err(issue) => return SourcePure(Rejected(issue))
  }
  let (_, supplied) = match client_program_input("json", parameters) {
    Ok(value) => value
    Err(issue) => return SourcePure(Rejected(issue))
  }
  let limits = client_program_standard_limits()
  let parsed = match
    @stage_syntax.parse(
      lowered.document,
      limits.checking.input,
      format=lowered.format,
    ) {
    Ok(value) => value
    Err(issue) => return SourcePure(Rejected(Preparation(Syntax(issue))))
  }
  for stage in @stage_syntax.stages(parsed) {
    if !@stage_syntax.effect_names(stage).is_empty() {
      if !allow_effects {
        return SourcePure(Rejected(Preparation(EffectNotSupported(stage.id))))
      }
      let value = match
        @publication_host.prepare_parsed_client_effect_computation(
          parsed,
          environment,
          supplied,
          evidence,
          client_program_effect_limits(),
        ) {
        Ok(value) => value
        Err(issue) => return SourceEffect(EffectRejected(Preparation(issue)))
      }
      match
        @source_frontend.check_array_profile(
          @program_check.effect_program_static_checked_computation(
            @publication_host.prepared_client_effect_computation_candidate(
              value,
            ),
          ),
          max_work=1000000,
          max_slots=100000,
        ) {
        Ok(_) => return SourceEffect(EffectPrepared(value))
        // Source rejection has the parser/lowerer's typed input classification.
        // It never prepares a second computation owner.
        Err(issue) =>
          return SourcePure(Rejected(SourcePreparation(ArrayProfile(issue))))
      }
    }
  }
  SourcePure(
    client_source_checked_array_profile(
      match
        @publication_host.prepare_parsed_effect_free_client_program(
          parsed, environment, supplied, limits,
        ) {
        Ok(value) => Prepared(value)
        Err(issue) => Rejected(Preparation(issue))
      },
    ),
  )
}

///|
#export_name("clientProgramSourceComputationPure")
pub fn client_program_source_computation_pure(
  outcome : ClientSourceComputationBridgeOutcome,
) -> ClientProgramBridgeOutcome? {
  match outcome {
    SourcePure(value) => Some(value)
    SourceEffect(_) => None
  }
}

///|
#export_name("clientProgramSourceComputationEffect")
pub fn client_program_source_computation_effect(
  outcome : ClientSourceComputationBridgeOutcome,
) -> ClientEffectProgramBridgeOutcome? {
  match outcome {
    SourcePure(_) => None
    SourceEffect(value) => Some(value)
  }
}
