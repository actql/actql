// Generated by scripts/connector-node-bundles.mjs; edit the selected bridge.

///|
/// Host-local source preparation. Publication input is installation metadata,
/// not Client-supplied schema, an acquisition receipt or a read grant.
pub(all) enum ClientSourcePreparationIssue {
  Publication
  Limit
  UnsupportedCarrier
  CommandTargetOriginalsUnavailable
  RecordTargetOriginalsUnavailable
  Declarations
  Alias(@source_frontend.AliasIssue)
  Frontend(@source_frontend.Issue)
  ArrayProfile(@source_frontend.ArrayProfileIssue)
}

///|
fn client_source_preparation_issue_code(
  issue : ClientSourcePreparationIssue,
) -> String {
  match issue {
    Publication | Alias(_) => "source_rejected"
    Limit => "source_limit"
    UnsupportedCarrier
    | CommandTargetOriginalsUnavailable
    | RecordTargetOriginalsUnavailable => "source_unsupported"
    Declarations => "source_declarations"
    ArrayProfile(BudgetExceeded) => "source_limit"
    ArrayProfile(UnsupportedNestedArray(_, _, _))
    | ArrayProfile(UnsupportedNestedArrayColumn(_, _, _)) =>
      "source_unsupported"
    ArrayProfile(_) => "source_invalid_input"
    Frontend(issue) =>
      match issue {
        MissingQueryContext => "source_missing_input"
        Encoding => "source_encoding"
        QueryLowering(issue) =>
          match issue {
            CommandTargetBinding(WorkLimit) => "source_limit"
            CommandTargetBinding(_) => "source_unresolved"
            UnknownRelation | UnresolvedRelation(_) => "source_unresolved"
            UnsupportedProjection
            | UnsupportedGrouping
            | UnsupportedAggregate
            | UnsupportedHaving
            | UnsupportedOrdering
            | UnsupportedAnalytic
            | UnsupportedSet
            | UnsupportedJoin
            | UnsupportedCte
            | UnsupportedGraph
            | Expression({ issue: UnsupportedFunction | UnsupportedCast, .. }) =>
              "source_implementation_limit"
            // Only the original frontend's typed construction/admission
            // budget is an analysis limit. Opaque Source/array limits above
            // retain their existing protected fallback.
            Construction(
              InputLimit
              | NodeLimit
              | DepthLimit
              | StringLimit
              | OriginLimit
              | OutputLimit
              | Admission({ kind: BudgetExceeded, .. })
            )
            | Admission(
              Structure(StageLimit, ..)
              | RetentionLimit(_, ..)
              | Decode({ kind: BudgetExceeded, .. })
            ) => "source_analysis_limit"
            // The published-Catalog wrapper retains this exact authored
            // missing Event field from the common pipeline owner.
            BindingPreparation(
              SourceProgram(
                Program(Pipeline(_, { kind: Event(Decode(MissingField)), .. }))
              )
            )
            | BindingPreparationSource(
              SourceProgram(
                Program(Pipeline(_, { kind: Event(Decode(MissingField)), .. }))
              ),
              _
            ) => "source_invalid_input"
            // These typed facts come from the existing lowerer. The public
            // submission projection must still establish audience disclosure.
            InvalidQuery
            | GraphExpected(_)
            | InferKeyLabel(
              EmptyOrAmbiguousLabel
              | ReservedRole
              | DuplicateLabel,
              _
            )
            | RangeAliasRequiresRelation
            | UnknownColumn
            | AmbiguousColumn
            | AmbiguousRelation
            | DuplicateOutput
            | ExpressionTyping(
              {
                kind: UnknownField(_)
                | UnknownParameter(_)
                | TypeMismatch(_)
                | MissingJoinScope(_)
                | ForbiddenConstructorValue
                | InvalidStaticOption(_)
                | InvalidJsonLiteral(_)
                | NullTypeUnresolved,
                ..
              }
            )
            | Expression(
              { issue: UnknownReference | InvalidArguments | InvalidNumber, .. }
            ) => "source_invalid_input"
            // Incomplete internal correspondence is not an authored label
            // conflict, even when the lowerer retains the INFER token origin.
            InferKeyLabel(MissingCorrespondence | DuplicateSlot, _) =>
              "source_rejected"
            _ => "source_rejected"
          }
        QuerySyntax({ issue: Limit(_), .. }) => "source_analysis_limit"
        _ => "source_invalid_input"
      }
  }
}

///|
priv suberror ClientSourceStop {
  ClientSourceStop(ClientSourcePreparationIssue)
}

///|
fn client_source_context(
  environment : @program_check.CheckEnvironment,
  publication : String,
  declarations : String?,
) -> @query_program.Context raise ClientSourceStop {
  match
    @source_publication.bind_published_query_context(
      environment, publication, declarations,
    ) {
    Ok(context) => context
    Err(issue) =>
      raise ClientSourceStop(
        match issue {
          Publication => Publication
          Limit => Limit
          UnsupportedCarrier => UnsupportedCarrier
          Declarations => Declarations
          Alias(issue) => Alias(issue)
        },
      )
  }
}

///|
#export_name("clientProgramCheckingEnvironmentCid")
pub fn client_program_checking_environment_cid(
  environment : @program_check.CheckEnvironment,
) -> String {
  @program_check.checking_environment_cid(environment)
}

///|
#export_name("clientProgramSourcePublicationValid")
pub fn client_program_source_publication_valid(
  environment : @program_check.CheckEnvironment,
  publication : String,
) -> Bool {
  match
    @source_publication.bind_published_query_parts(
      environment,
      publication,
      None,
    ) {
    Ok(_) => true
    Err(_) => false
  }
}

///|
#export_name("clientProgramPrepareSourceWithParameters")
pub fn client_program_prepare_source_with_parameters(
  document : String,
  format : String,
  environment : @program_check.CheckEnvironment,
  publication : String,
  declarations : String?,
  parameters : String?,
) -> ClientProgramBridgeOutcome {
  let catalogs : Array[@program_check.PreparedSourceCatalog] = []
  let lowered = match
    client_program_lower_source(
      document,
      format,
      environment,
      publication,
      declarations,
      source_catalog_out=Some(catalogs),
    ) {
    Ok(value) => value
    Err(issue) => return Rejected(issue)
  }
  guard catalogs.length() == 1 && catalogs.get(0) is Some(source_catalog) else {
    return Rejected(SourcePreparation(Publication))
  }
  let (_, supplied) = match client_program_input("json", parameters) {
    Ok(value) => value
    Err(issue) => return Rejected(issue)
  }
  let parsed = match client_source_program(lowered) {
    Ok(value) => value
    Err(issue) => return Rejected(issue)
  }
  let prepared = match
    @publication_host.prepare_parsed_effect_free_client_program(
      parsed,
      environment,
      supplied,
      client_program_standard_limits(),
      source_catalog=Some(source_catalog),
    ) {
    Ok(value) => Prepared(value)
    Err(issue) => Rejected(Preparation(issue))
  }
  client_source_checked_array_profile(prepared)
}

///|
fn client_source_checked_array_profile(
  outcome : ClientProgramBridgeOutcome,
) -> ClientProgramBridgeOutcome {
  match outcome {
    Prepared(value) =>
      match
        @source_frontend.check_array_profile(
          @strategy.graph_program(
            @publication_host.prepared_client_graph(value),
          ),
          max_work=1000000,
          max_slots=100000,
        ) {
        Ok(_) => outcome
        Err(issue) => Rejected(SourcePreparation(ArrayProfile(issue)))
      }
    _ => outcome
  }
}

///|
fn client_program_lower_source(
  document : String,
  format : String,
  environment : @program_check.CheckEnvironment,
  publication : String,
  declarations : String?,
  public_primary? : Bool = false,
  source_catalog_out? : Array[@program_check.PreparedSourceCatalog]? = None,
) -> Result[@source_frontend.Lowered, ClientProgramBridgeIssue] {
  let selected = match @source_frontend.select_format(format) {
    Ok(Text) => @source_frontend.Text
    Ok(Sql) => @source_frontend.Sql
    _ => {
      // Retain the original context-before-format refusal on this invalid
      // input path. The ordinary supported path binds every part once below.
      let _ = client_source_context(environment, publication, declarations) catch {
        ClientSourceStop(issue) => return Err(SourcePreparation(issue))
      }
      return Err(InvalidFormat)
    }
  }
  let (
    context,
    table_writes,
    update_targets,
    store_targets,
    command_targets,
    catalog,
  ) = match
    @source_publication.bind_published_query_parts_with_catalog(
      environment, publication, declarations,
    ) {
    Ok(value) => value
    Err(issue) =>
      return Err(
        SourcePreparation(
          match issue {
            Publication => Publication
            Limit => Limit
            UnsupportedCarrier => UnsupportedCarrier
            Declarations => Declarations
            Alias(issue) => Alias(issue)
          },
        ),
      )
  }
  if source_catalog_out is Some(output) {
    output.push(catalog)
  }
  // Both authored forms carry the same admitted publication into the ordinary
  // checked Effect owner. Selection is retained material, never a permission.
  match
    @source_frontend.lower(
      document,
      selected,
      Some(context),
      table_writes~,
      update_targets~,
      store_targets~,
      command_targets~,
      public_primary~,
    ) {
    Ok(value) => Ok(value)
    Err(issue) => Err(SourcePreparation(Frontend(issue)))
  }
}

///|
// Query lowering already admitted this exact Program and its authored spans.
// The existing parsed checker applies current limits and semantic checks;
// emitted JSON is not another input to admit during the same preparation.
fn client_source_program(
  lowered : @source_frontend.Lowered,
) -> Result[@stage_syntax.Program, ClientProgramBridgeIssue] {
  match lowered.program {
    Some(program) => Ok(program)
    None => Err(SourcePreparation(Frontend(Encoding)))
  }
}

///|
/// Select an existing computation owner from the parser's Effect inventory,
/// before semantic checking. Neither branch is a fallback for the other.
pub(all) enum ClientSourceComputationBridgeOutcome {
  SourcePure(ClientProgramBridgeOutcome)
  SourceEffect(ClientEffectProgramBridgeOutcome)
}

///|
#export_name("clientProgramPrepareSourceComputationWithParameters")
pub fn client_program_prepare_source_computation_with_parameters(
  document : String,
  format : String,
  environment : @program_check.CheckEnvironment,
  publication : String,
  declarations : String?,
  parameters : String?,
  allow_effects : Bool,
  evidence : Array[@context.StageCapacityInput],
) -> ClientSourceComputationBridgeOutcome {
  client_prepare_source_computation(
    document, format, environment, publication, declarations, parameters, allow_effects,
    evidence,
  )
}

///|
/// A new public Source selects its primary in the same Common frontend.
/// The original entry above retains the explicit historical answer recipe;
/// neither entry renames an admitted or saved Program.
#export_name("clientProgramPreparePublicSourceComputationWithParameters")
pub fn client_program_prepare_public_source_computation_with_parameters(
  document : String,
  format : String,
  environment : @program_check.CheckEnvironment,
  publication : String,
  declarations : String?,
  parameters : String?,
  allow_effects : Bool,
  evidence : Array[@context.StageCapacityInput],
