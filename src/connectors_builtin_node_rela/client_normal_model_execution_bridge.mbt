///|
/// Standard Model-attempt transfer DATA for the installed Node provider.
/// Explicit caller-supplied wire limits still enter the existing writer unchanged.
#export_name("clientProgramStandardInferModelTransferBytes")
pub fn client_program_standard_infer_model_transfer_bytes(
  max_attempts : Int64,
) -> Int64 {
