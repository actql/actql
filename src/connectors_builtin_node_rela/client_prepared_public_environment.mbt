///|
/// Install pure publication metadata once. The actual Host retains its module,
/// generation and closing fence; this handle contains no permission or Run.
#export_name("clientProgramPreparePublicSourceEnvironment")
pub fn client_program_prepare_public_source_environment(
  environment : @program_check.CheckEnvironment,
  publication : String,
) -> @source_publication.PreparedPublishedQueryEnvironment? {
  match
    @source_publication.prepare_published_query_environment(
      environment, publication,
    ) {
    Ok(value) => Some(value)
    Err(_) => None
  }
}

///|
#export_name("clientProgramPublicSourceEnvironmentMatches")
pub fn client_program_public_source_environment_matches(
  prepared : @source_publication.PreparedPublishedQueryEnvironment,
  environment : @program_check.CheckEnvironment,
) -> Bool {
  @source_publication.prepared_published_query_environment_matches(
    prepared, environment,
  )
}

///|
fn client_prepared_publication_issue(
  issue : @source_publication.PreparedPublicationIssue,
) -> ClientSourcePreparationIssue {
  match issue {
    ForeignEnvironment => Publication
    Frontend(issue) => Frontend(issue)
    Publication(issue) =>
      match issue {
        Publication => Publication
        Limit => Limit
        UnsupportedCarrier => UnsupportedCarrier
        Declarations => Declarations
        Alias(issue) => Alias(issue)
      }
  }
}

///|
/// Each new Source still parses, resolves names/types and checks its original
/// Parameter values. Only the immutable installation facts are shared.
#export_name("clientProgramPrepareSourceComputationInPublicEnvironment")
pub fn client_program_prepare_source_computation_in_public_environment(
  document : String,
  format : String,
  environment : @program_check.CheckEnvironment,
  prepared : @source_publication.PreparedPublishedQueryEnvironment,
  declarations : String?,
  parameters : String?,
  allow_effects : Bool,
  evidence : Array[@context.StageCapacityInput],
) -> ClientSourceComputationBridgeOutcome {
  if !client_program_public_source_environment_matches(prepared, environment) {
    return SourcePure(Rejected(SourcePreparation(Publication)))
  }
  let selected = match @source_frontend.select_format(format) {
    Ok(Text) => @source_frontend.Text
    Ok(Sql) => @source_frontend.Sql
    _ => return SourcePure(Rejected(InvalidFormat))
  }
  let (lowered, catalog) = match
    @source_publication.lower_prepared_published_query(
      prepared, environment, document, selected, declarations,
    ) {
    Ok(value) => value
    Err(issue) =>
      return SourcePure(
        Rejected(SourcePreparation(client_prepared_publication_issue(issue))),
      )
  }
  client_program_finish_source_computation(
    lowered, environment, catalog, parameters, allow_effects, evidence,
  )
}

///|
/// JSON Effects use the same installation's retained targets and Catalog.
/// Their Program, values, Mapping/Preview, current authority and dispatch are
/// still checked by the existing Effect owners for each operation.
#export_name("clientProgramPrepareEffectComputationInPublicEnvironment")
pub fn client_program_prepare_effect_computation_in_public_environment(
  document : String,
  format : String,
  environment : @program_check.CheckEnvironment,
  prepared : @source_publication.PreparedPublishedQueryEnvironment,
  parameters : String?,
  evidence : Array[@context.StageCapacityInput],
) -> ClientEffectProgramBridgeOutcome {
  let (update_targets, store_targets, command_targets, catalog) = match
    @source_publication.prepared_published_effect_parts(prepared, environment) {
    Ok(value) => value
    Err(issue) =>
      return EffectRejected(
        Input(SourcePreparation(client_prepared_publication_issue(issue))),
      )
  }
  let (selected, supplied) = match client_program_input(format, parameters) {
    Ok(value) => value
    Err(issue) => return EffectRejected(Input(issue))
  }
  let limits = client_program_effect_limits()
  let parsed = match
    @stage_syntax.parse(
      document,
      limits.program.checking.input,
      format=selected,
    ) {
    Ok(value) => value
    Err(issue) => return EffectRejected(Preparation(Syntax(issue)))
  }
  match
    @publication_host.prepare_parsed_client_effect_computation(
      parsed,
      environment,
      supplied,
      evidence,
      limits,
      update_targets~,
      store_targets~,
      command_targets~,
      source_catalog=Some(catalog),
    ) {
    Ok(value) => EffectPrepared(value)
    Err(issue) => EffectRejected(Preparation(issue))
  }
}
