    None,
    registry_body,
    values_body,
    1L,
    0L,
    0L,
    0L,
    fragment_body~,
    ordered_body~,
    captured_sources=[(0, sources[0]), (1, sources[1])],
    acquisition_ledger=Some(ledger),
