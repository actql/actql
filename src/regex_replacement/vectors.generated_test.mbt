///|
test "regex replacement rejects: bare" {
  assert_true(parse("$", limits()) is Err(InvalidReplacement(0)))
}

///|
test "regex replacement rejects: tail" {
  assert_true(parse("a$", limits()) is Err(InvalidReplacement(1)))
}

///|
test "regex replacement rejects: zero" {
  assert_true(parse("$0", limits()) is Err(InvalidReplacement(0)))
}

///|
test "regex replacement rejects: leading-zero" {
  assert_true(parse("$01", limits()) is Err(InvalidReplacement(0)))
}

///|
test "regex replacement rejects: braced" {
  assert_true(parse("${1}", limits()) is Err(InvalidReplacement(0)))
}

///|
test "regex replacement rejects: named" {
  assert_true(parse("$name", limits()) is Err(InvalidReplacement(0)))
}

///|
test "regex replacement rejects: arabic" {
  assert_true(parse("$\u{661}", limits()) is Err(InvalidReplacement(0)))
}

///|
test "regex replacement rejects: fullwidth" {
  assert_true(parse("$\u{ff11}", limits()) is Err(InvalidReplacement(0)))
}

///|
test "regex replacement rejects: dollar-dangling" {
  assert_true(parse("$$$", limits()) is Err(InvalidReplacement(2)))
}

///|
test "regex replacement rejects: supplementary-offset" {
  assert_true(parse("\u{1f600}$x", limits()) is Err(InvalidReplacement(2)))
}

///|
test "regex replacement rejects: nfd" {
  assert_true(parse("e\u{301}", limits()) is Err(NonCanonicalText))
}

///|
test "regex replacement rejects: cr" {
  assert_true(parse("a\u{d}b", limits()) is Err(NonCanonicalText))
}

///|
test "regex replacement rejects: crlf" {
  assert_true(parse("a\u{d}\u{a}b", limits()) is Err(NonCanonicalText))
}
