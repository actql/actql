test "regex replacement: repeated" {
  let value = parse("$2-$1$2", limits()).unwrap()
  assert_eq(cid(value), "sha256:57b44872220727d67640afab02c03e062c31e06abb39797ee365d072e9903a4c")
  let wire = @encode.writer(10000,1000,3)
  emit(value,wire)
  assert_eq(@encode.finish(wire), "{\"ast_cid\":\"sha256:57b44872220727d67640afab02c03e062c31e06abb39797ee365d072e9903a4c\",\"capture_reference_count\":3,\"literal_utf8_bytes\":1,\"max_capture_index\":2,\"parts\":[{\"capture\":2,\"kind\":\"capture\"},{\"kind\":\"literal\",\"value\":\"-\"},{\"capture\":1,\"kind\":\"capture\"},{\"capture\":2,\"kind\":\"capture\"}],\"version\":\"actql-regex-replacement-ast/0.1\"}")
  let preimage = @encode.writer(10000,1000,3)
  emit_preimage(value,preimage)
  assert_eq(@encode.finish(preimage), "{\"capture_reference_count\":3,\"literal_utf8_bytes\":1,\"max_capture_index\":2,\"parts\":[{\"capture\":2,\"kind\":\"capture\"},{\"kind\":\"literal\",\"value\":\"-\"},{\"capture\":1,\"kind\":\"capture\"},{\"capture\":2,\"kind\":\"capture\"}],\"version\":\"actql-regex-replacement-ast/0.1\"}")
  assert_eq(stats(value).literal_utf8_bytes, 1)
  assert_eq(stats(value).capture_reference_count, 3)
  assert_eq(stats(value).max_capture_index, 2)
  assert_eq(part_count(value), 4)
  assert_eq(part_at(value, 0), Some(Capture(2)))
  assert_eq(part_at(value, 1), Some(Literal("-")))
  assert_eq(part_at(value, 2), Some(Capture(1)))
  assert_eq(part_at(value, 3), Some(Capture(2)))
}

