  ])
  @publication.record_result_access_resolution(access, true).unwrap()
  rows.push([
    "publication",
    "resultAccess",
    "ResultAccessCheckInitialAvailability",
    "check_initial_availability",
    @publication.result_access_progress_action_code(access).to_string(),
  ])
  @publication.record_result_access_initial_availability(access, true).unwrap()
  rows.push([
    "publication",
    "resultAccess",
    "ResultAccessAdmitRead",
    "admit_read",
    @publication.result_access_progress_action_code(access).to_string(),
  ])
  @publication.record_result_access_read_admission(access, true).unwrap()
  rows.push([
    "publication",
    "resultAccess",
    "ResultAccessIssueGrant",
    "issue_grant",
    @publication.result_access_progress_action_code(access).to_string(),
  ])
  @publication.record_result_access_grant(access, true).unwrap()
  rows.push([
    "publication",
    "resultAccess",
    "ResultAccessStartDelivery",
    "start_delivery",
    @publication.result_access_progress_action_code(access).to_string(),
  ])
  let rejected = @publication.begin_result_access_progress()
  @publication.record_result_access_request_authorization(rejected, false).unwrap()
  rows.push([
    "publication",
    "resultAccess",
    "ResultAccessReject",
    "reject",
    @publication.result_access_progress_action_code(rejected).to_string(),
  ])
  rows
}
