supported_targets = "+js+wasm+native"

import {
  "actql/actql/client_local_preparation" @input,
  "actql/actql/run_publication_host" @host,
  "actql/actql/sha256" @sha,
  "actql/actql/encode_core" @encode,
  "actql/actql/run_publication" @publication,
  "actql/actql/publication_payload" @payload,
  "actql/actql/check_environment" @environment,
  "actql/actql/program_check" @checked,
  "actql/actql/execution_authorization" @authorization,
  "actql/actql/physical_strategy_host" @strategy,
  "actql/actql/client_local_host" @local,
  "actql/actql/connectors_builtin" @builtin,
  "actql/actql/physical_host_dispatch" @driver,
  "actql/actql/connectors/local/driver" @managed,
  "actql/actql/execution_relation" @execution,
  "actql/actql/execution_query" @query,
  "actql/actql/query_planning" @planning,
  "actql/actql/connectors/duckdb/host" @acquisition_host,
  "actql/actql/connectors/duckdb/acquisition" @duckdb_acquisition,
  "actql/actql/physical_resources" @resources,
  "moonbitlang/core/encoding/utf8",
}

import {
  "actql/actql/canonical_json" @identity,
  "moonbitlang/core/json",
} for "wbtest"
