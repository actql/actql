///|
test "historical holding restoration retains cleanup until bounded acquisition after revocation" {
  let site = create_site("original", 7, "runtime-original", 1, 1, 100L, 100L).unwrap()
  let restoration = prepare_site_holding_restoration(site, 10L).unwrap()
  let occupied = retain_site_holding(site, 95L).unwrap()
  assert_eq(site_status(site)[5], 1L)
  assert_true(restoration.acquire() is None)
  assert_eq(site_status(site)[6], 95L)
  revoke_site(site)
  assert_true(retain_site_holding(site, 0L) is None)
  assert_true(prepare_site_holding_restoration(site, 10L) is None)
  assert_true(start_site_operation(site, 0L, 0L) is None)
  assert_true(release_site_holding(occupied))
  assert_eq(site_status(site)[10], 0L)
  let holding = restoration.acquire().unwrap()
  assert_eq(site_status(site)[5], 0L)
  assert_eq(site_status(site)[4], 1L)
  assert_eq(site_status(site)[6], 10L)
  assert_eq(site_status(site)[10], 0L)
  assert_true(restoration.acquire() is None)
  assert_true(release_site_holding(holding))
  assert_false(release_site_holding(holding))
  assert_true(restoration.acquire() is None)
  assert_eq(site_status(site)[6], 0L)
  assert_eq(site_status(site)[10], 1L)
}

///|
test "historical holding restoration validates original capacity and cannot reserve through teardown" {
  let site = create_site("original", 7, "runtime-original", 1, 1, 100L, 100L).unwrap()
  assert_true(prepare_site_holding_restoration(site, -1L) is None)
  assert_true(prepare_site_holding_restoration(site, 101L) is None)
  assert_eq(site_status(site)[5], 0L)
  let restoration = prepare_site_holding_restoration(site, 10L).unwrap()
  let operation = start_site_operation(site, 95L, 1L).unwrap()
  begin_site_teardown(site)
  assert_true(prepare_site_holding_restoration(site, 1L) is None)
  assert_true(restoration.acquire() is None)
  assert_eq(site_status(site)[5], 1L)
  assert_true(settle_site_operation(operation))
  let holding = restoration.acquire().unwrap()
  assert_eq(site_status(site)[7], 0L)
  assert_eq(site_status(site)[6], 10L)
  assert_eq(site_status(site)[5], 0L)
  assert_true(release_site_holding(holding))
  assert_eq(site_status(site)[10], 1L)
}
