///|
// Independent canonical request/Definition preimages retained from the original
// Journal codec fixture. Expected identity wires are not generated by this caller.
let submission_identity_wire : String =
  #|{"cancellation_requested":false,"checkpoint":null,"dispatch_reserved":false,"physical_start_claimed":false,"publication_binding":null,"request":"{\"authority_scope_cid\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"caller_input_intent_cid\":\"sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd\",\"caller_request_id\":\"caller-é\",\"intent_fingerprint_cid\":\"sha256:585c858537f5e7ec79a326a54e2891d2c3fc83c2dac4047e1b63f648d9d8f010\",\"logical_request_scope_cid\":\"sha256:11db8fa880c5aaf9c54a60dffecdb102d4b7c0cfbeb4ea3c0b86eb8b46f0b2c6\",\"parameter_values_cid\":\"sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\",\"program_definition_cid\":\"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"}","run_definition":"{\"authorization_context_cid\":\"sha256:2222222222222222222222222222222222222222222222222222222222222222\",\"compiled_plan_cid\":\"sha256:1111111111111111111111111111111111111111111111111111111111111111\",\"created_at\":\"2026-09-18T00:00:00.000Z\",\"input_artifact_set_cid\":\"sha256:3333333333333333333333333333333333333333333333333333333333333333\",\"invocation_template_cid\":\"sha256:6666666666666666666666666666666666666666666666666666666666666666\",\"run_definition_cid\":\"sha256:7a12ebea352eee2a7d88bf6df5c5b6d7b56d6383f7e6e5fc9231fef79412fafc\",\"run_id\":\"run\",\"scope_id\":\"scope\",\"valid_until\":\"2099-01-01T00:00:00.000Z\",\"version\":\"actql-run-definition/0.1\"}","version":"actql-native-client-run-row/0.1"}

///|
let submission_identity_other_definition = "{\"authorization_context_cid\":\"sha256:2222222222222222222222222222222222222222222222222222222222222222\",\"compiled_plan_cid\":\"sha256:1111111111111111111111111111111111111111111111111111111111111111\",\"created_at\":\"2026-09-18T00:00:00.000Z\",\"input_artifact_set_cid\":\"sha256:3333333333333333333333333333333333333333333333333333333333333333\",\"invocation_template_cid\":\"sha256:6666666666666666666666666666666666666666666666666666666666666666\",\"run_definition_cid\":\"sha256:39d086f5335d45f573ddf2a9a20d7607111cf31d5bde3e7b1258e20f295038f6\",\"run_id\":\"other-run\",\"scope_id\":\"scope\",\"valid_until\":\"2099-01-01T00:00:00.000Z\",\"version\":\"actql-run-definition/0.1\"}"

///|
fn submission_identity_row(body : Bytes) -> @host.ClientJournalPhysicalRow {
  { key: "original-row", revision: 7L, body, }
}

///|
test "saved inspection reuses exact immutable identity and cold inspection admits independently" {
  let row = submission_identity_row(@utf8.encode(submission_identity_wire))
  let original = submission_append_run_inspection(row).unwrap()
  let reused = submission_run_inspection_with_identity(
    row,
    Some((original.request, original.definition)),
  ).unwrap()
  assert_true(physical_equal(reused.request, original.request))
  assert_true(physical_equal(reused.definition, original.definition))
  let cold = submission_append_run_inspection(row).unwrap()
  assert_false(physical_equal(cold.request, original.request))
  assert_false(physical_equal(cold.definition, original.definition))
  // A metadata revision remains a fresh full row observation, not an identity grant.
  let changed = submission_identity_row(
    @utf8.encode(
      submission_identity_wire.replace(
        old="\"cancellation_requested\":false",
        new="\"cancellation_requested\":true",
      ),
    ),
  )
  let revised = submission_run_inspection_with_identity(
    changed,
    Some((original.request, original.definition)),
  ).unwrap()
  assert_true(physical_equal(revised.request, original.request))
  assert_true(physical_equal(revised.definition, original.definition))
}

///|
test "saved inspection independently admits each changed or foreign identity" {
  let row = submission_identity_row(@utf8.encode(submission_identity_wire))
  let original = submission_append_run_inspection(row).unwrap()
  // Independent Python hashlib preimage; this caller has no private request issuer.
  let foreign = @host.admit_client_request_identity_record(
    "sha256:" + "a".repeat(64),
    "foreign-request",
    "sha256:" + "b".repeat(64),
    "sha256:" + "c".repeat(64),
    "sha256:" + "d".repeat(64),
    "sha256:3a2347c340e9e3308264b173e037e968058af1fcec1f1c30830225716297e7cb",
    "sha256:585c858537f5e7ec79a326a54e2891d2c3fc83c2dac4047e1b63f648d9d8f010",
  ).unwrap()
  let definition = @publication.admit_publication_contract(
    "run_definition", submission_identity_other_definition, 65536, 4096, 64,
  ).unwrap()
  let first = submission_run_inspection_with_identity(
    row,
    Some((foreign, original.definition)),
  ).unwrap()
  assert_false(physical_equal(first.request, foreign))
  assert_true(physical_equal(first.definition, original.definition))
  assert_eq(@host.client_request_caller_id(first.request), "caller-é")
  let second = submission_run_inspection_with_identity(
    row,
    Some((original.request, definition)),
  ).unwrap()
  assert_true(physical_equal(second.request, original.request))
  assert_false(physical_equal(second.definition, definition))
  // The changed row, not the retained old identity, selects the actual objects.
  let decoded = @host.decode_client_run_journal_row(row.body).unwrap()
  let body = @host.client_run_journal_row_body({
    ..decoded,
    request: foreign,
    definition,
  }).unwrap()
  let changed = submission_run_inspection_with_identity(
    submission_identity_row(body),
    Some((original.request, original.definition)),
  ).unwrap()
  assert_eq(@host.client_request_caller_id(changed.request), "foreign-request")
  assert_eq(
    @publication.publication_contract_identity(changed.definition),
    "sha256:39d086f5335d45f573ddf2a9a20d7607111cf31d5bde3e7b1258e20f295038f6",
  )
}

///|
test "saved inspection preserves canonical bounds nested validation and refusal order" {
  let original = submission_append_run_inspection(
    submission_identity_row(@utf8.encode(submission_identity_wire)),
  ).unwrap()
  let inspect = wire => {
    submission_run_inspection_with_identity(
      submission_identity_row(@utf8.encode(wire)),
      Some((original.request, original.definition)),
    )
  }
  for
    wire in [
      submission_identity_wire.replace(old="585c858537f5", new="000000000000"),
      submission_identity_wire.replace(old="7a12ebea352e", new="000000000000"),
      submission_identity_wire.replace(old="{", new="{ "),
      submission_identity_wire.replace(old="{", new="{\"unknown\":true,"),
      submission_identity_wire.replace(
        old="\"checkpoint\":null",
        new="\"checkpoint\":null,\"checkpoint\":null",
      ),
      submission_identity_wire.replace(
        old="\"physical_start_claimed\":false",
        new="\"physical_start_claimed\":true",
      ),
      submission_identity_wire.replace(
        old="\"request\":\"{",
        new="\"request\":\" {",
      ),
      submission_identity_wire.replace(
        old="\"run_definition\":\"{",
        new="\"run_definition\":\" {",
      ),
      "x".repeat(131073),
    ] {
    assert_true(inspect(wire) is Err(-31))
  }
  // Canonical outer encoding permits these private metadata strings, but the
  // unchanged consumer must validate them or keep its original unsupported error.
  let decoded = @host.decode_client_run_journal_row(
    @utf8.encode(submission_identity_wire),
  ).unwrap()
  let run = record => {
    submission_run_inspection_with_identity(
      submission_identity_row(
        @host.client_run_journal_row_body(record).unwrap(),
      ),
      Some((original.request, original.definition)),
    )
  }
  assert_true(
    run({ ..decoded, publication_policy_originals: Some("{}"), }) is Err(-31),
  )
  assert_true(run({ ..decoded, checkpoint: Some("{}"), }) is Err(-42))
  assert_true(
    run({ ..decoded, effect_material_originals: Some("{}"), }) is Err(-42),
  )
  let local_policy = @host.client_run_journal_row_body(
    { ..decoded, checkpoint: Some("{}"), },
    local_run_policy_originals=Some("{}"),
  ).unwrap()
  // Invalid local policy still fails before unsupported Checkpoint inspection.
  assert_true(
    submission_run_inspection_with_identity(
      submission_identity_row(local_policy),
      Some((original.request, original.definition)),
    )
    is Err(-31),
  )
  let observation = @host.client_run_journal_row_body(
    decoded,
    run_observation_originals=Some("{}"),
  ).unwrap()
  assert_true(
    submission_run_inspection_with_identity(
      submission_identity_row(observation),
      Some((original.request, original.definition)),
    )
    is Err(-31),
  )
}

///|
test "saved inspection retains exact independent Definition child byte boundary" {
  let original = @host.decode_client_run_journal_row(
    @utf8.encode(submission_identity_wire),
  ).unwrap()
  let cid = (digit : String) => "sha256:" + digit.repeat(64)
  // The independent fixture has 640 UTF-8 bytes outside run_id, including self CID.
  for (length, accepted) in [(64896, true), (64897, false)] {
    let definition = @publication.seal_publication_contract(
      "run_definition",
      "{\"version\":\"actql-run-definition/0.1\",\"scope_id\":\"scope\",\"run_id\":\"" +
      "r".repeat(length) +
      "\",\"compiled_plan_cid\":\"" +
      cid("1") +
      "\",\"invocation_template_cid\":\"" +
      cid("2") +
      "\",\"authorization_context_cid\":\"" +
      cid("3") +
      "\",\"input_artifact_set_cid\":\"" +
      cid("4") +
      "\",\"created_at\":\"2026-09-18T00:00:00.000Z\",\"valid_until\":\"2099-01-01T00:00:00.000Z\"}",
      131072,
      4096,
      64,
    ).unwrap()
    assert_eq(
      @utf8.encode(@publication.publication_contract_json(definition)).length(),
      length + 640,
    )
    let row = submission_identity_row(
      @host.client_run_journal_row_body({ ..original, definition, }).unwrap(),
    )
    assert_true(row.body.length() < 131072)
    let result = submission_run_inspection_with_identity(
      row,
      Some((original.request, definition)),
    )
    if accepted {
      let value = result.unwrap()
      assert_true(physical_equal(value.definition, definition))
    } else {
      assert_true(result is Err(-31))
    }
  }
}
