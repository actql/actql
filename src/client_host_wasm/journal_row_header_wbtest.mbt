///|
test "journal row header preserves exact revisions and maximum field bounds" {
  assert_eq(
    journal_row_header(
      b"\x00\x10\x00\x00\x00\x00\x04\x00\x01\x00\x00\x00\x00\x00\x20\x00",
    ),
    Ok((4096, 262144, 9007199254740993L)),
  )
  assert_eq(
    journal_row_header(
      b"\x01\x00\x00\x00\x00\x00\x00\x00\xff\xff\xff\xff\xff\xff\xff\x7f",
    ),
    Ok((1, 0, 9223372036854775807L)),
  )
}

///|
test "journal row header refuses malformed signed lengths before allocation" {
  for
    header in [
      b"", b"\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00", b"\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
      b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00", b"\x00\x00\x00\x80\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
      b"\x01\x00\x00\x00\x00\x00\x00\x80\x00\x00\x00\x00\x00\x00\x00\x00", b"\x01\x10\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00",
      b"\x01\x00\x00\x00\x01\x00\x04\x00\x00\x00\x00\x00\x00\x00\x00\x00", b"\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x80",
      b"\x01\x00\x00\x00\x00\x00\x00\x00\xff\xff\xff\xff\xff\xff\xff\xff",
    ] {
    assert_eq(journal_row_header(header), Err(-41))
  }
}
