supported_targets = "+js+wasm+native"

import {
  "actql/actql/source_value" @source,
  "actql/actql/decode_core" @decode,
  "actql/actql/canonical_value" @unicode,
  "actql/actql/encode_core" @encode,
  "actql/actql/sha256" @sha,
  "actql/actql/capacity_policy" @policy,
  "actql/actql/text_time_policy" @text_policy,
  "actql/actql/value_contract",
  "actql/actql/carrier_contract" @carrier,
  "actql/actql/relation_schema" @row,
  "actql/actql/graph_contract" @graph,
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/core/json",
  "actql/actql/canonical_json" @canonical,
} for "test"

formatter(
  ignore: [
    "vectors.generated_test.mbt",
    "catalog_roles.generated.mbt",
    "source_view_shape.generated.mbt",
    "carrier_vectors.generated_test.mbt",
    "lookup_capacity.generated_test.mbt",
    "lookup_execution.generated_test.mbt",
  ],
)
