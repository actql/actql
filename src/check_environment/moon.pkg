supported_targets = "+js+wasm+native"

import {
  "actql/actql/decode_shape" @shape,
  "actql/actql/vector_checking" @score_checks,
  "actql/actql/capacity_witness" @bound_wire,
  "actql/actql/capacity_host_witness" @bound_host,
  "actql/actql/capacity_derivation" @listing_arithmetic,
  "actql/actql/canonical_json" @canonical,
  "moonbitlang/core/json",
  "actql/actql/calendar_profile" @calendar,
  "actql/actql/text_rank_profile" @lexical,
  "actql/actql/source_value" @source,
  "actql/actql/decode_core" @decode,
  "actql/actql/decode_scalar" @scalar,
  "actql/actql/contract_reference" @contract_ref,
  "actql/actql/canonical_value" @unicode,
  "actql/actql/encode_core" @encode,
  "actql/actql/sha256" @sha,
  "actql/actql/capacity_policy" @policy,
  "actql/actql/text_time_policy" @text_policy,
  "actql/actql/value_contract",
  "actql/actql/carrier_contract" @carrier,
  "actql/actql/relation_schema" @row,
  "actql/actql/graph_contract" @graph,
  "moonbitlang/core/encoding/utf8",
}

formatter(
  ignore: [
    "source_evidence_members.generated_test.mbt",
    "command_target_bindings.generated_test.mbt",
    "inherited_text_time.generated.mbt",
    "compilation_manifests.generated.mbt",
    "catalog_grammar.generated.mbt",
    "text_profile.generated_test.mbt",
    "vectors.generated_test.mbt",
    "catalog_roles.generated.mbt",
    "source_view_shape.generated.mbt",
    "carrier_vectors.generated_test.mbt",
    "lookup_capacity.generated_test.mbt",
    "lookup_execution.generated_test.mbt",
    "pushdown_vectors.generated_test.mbt",
    "decision_profile.generated.mbt",
    "decision_vectors.generated_test.mbt",
    "decision_arithmetic.generated_wbtest.mbt",
  ],
)

import {
  "actql/actql/relation_evidence" @evidence,
  "actql/actql/pipeline_typing" @pipeline,
  "actql/actql/stage_syntax" @syntax,
} for "test"
