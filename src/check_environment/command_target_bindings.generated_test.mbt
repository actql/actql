test "Original Command target fixed identity legacy-field" {
  let environment = read(
    @utf8.encode("{\"version\":\"actql-check-environment/0.1\",\"schema_snapshots\":[],\"connector_capabilities\":[],\"mapping_contracts\":[],\"source_views\":[],\"command_contracts\":[{\"schema\":\"actql.command_contract/0.1\",\"command_id\":\"command:mail.send.v1\",\"version\":\"vendor-1\",\"connector_id\":\"example\",\"target\":{\"resource_kind\":\"mailbox\",\"cardinality\":\"single\"},\"input_schema\":{\"id\":\"mail.input\",\"version\":\"vendor-1\",\"cid\":\"sha256:ceffb59b34b9fee831dc4060f0de02e3268bc8fe8549ea4516f74e15da90c0e2\"},\"input_contract\":{\"additional_properties\":false,\"fields\":{\"body\":{\"type\":\"string\",\"nullable\":false}}},\"output_schema\":{\"id\":\"mail.output\",\"version\":\"vendor-1\",\"cid\":\"sha256:db19239d74f021e17ac68b37e34a434a43c28a7d46f4329535afae74e148835c\"},\"permissions\":[\"mail.send\"],\"idempotency\":{\"support\":\"unsupported\"},\"minimum_approval\":\"required\",\"preview\":{\"strength\":\"exact\"},\"reversibility\":\"unknown\",\"atomicity\":\"single_target\",\"outcome\":\"synchronous\",\"contract_cid\":\"sha256:8eaaf8eb0c34992a610de81c25a3d71c082106ff2f7b9b6cead8227c0d480255\"}],\"model_task_contracts\":[],\"contract_registry\":[{\"schema\":\"actql.contract/0.1\",\"id\":\"mail.input\",\"kind\":\"command_input\",\"version\":\"vendor-1\",\"body\":{\"type\":\"object\",\"nullable\":false,\"additional_properties\":false,\"fields\":{\"body\":{\"type\":\"string\",\"nullable\":false}}},\"cid\":\"sha256:ceffb59b34b9fee831dc4060f0de02e3268bc8fe8549ea4516f74e15da90c0e2\"},{\"schema\":\"actql.contract/0.1\",\"id\":\"mail.output\",\"kind\":\"command_output\",\"version\":\"vendor-1\",\"body\":{\"type\":\"object\",\"nullable\":false,\"additional_properties\":false,\"fields\":{\"id\":{\"type\":\"string\",\"nullable\":false}}},\"cid\":\"sha256:db19239d74f021e17ac68b37e34a434a43c28a7d46f4329535afae74e148835c\"}],\"connector_catalogs\":[{\"schema\":\"actql.connector_catalog/0.1\",\"connector_id\":\"example\",\"connector_version\":\"vendor-1\",\"source_views\":[],\"commands\":[{\"schema\":\"actql.command_contract/0.1\",\"command_id\":\"command:mail.send.v1\",\"version\":\"vendor-1\",\"connector_id\":\"example\",\"target\":{\"resource_kind\":\"mailbox\",\"cardinality\":\"single\"},\"input_schema\":{\"id\":\"mail.input\",\"version\":\"vendor-1\",\"cid\":\"sha256:ceffb59b34b9fee831dc4060f0de02e3268bc8fe8549ea4516f74e15da90c0e2\"},\"input_contract\":{\"additional_properties\":false,\"fields\":{\"body\":{\"type\":\"string\",\"nullable\":false}}},\"output_schema\":{\"id\":\"mail.output\",\"version\":\"vendor-1\",\"cid\":\"sha256:db19239d74f021e17ac68b37e34a434a43c28a7d46f4329535afae74e148835c\"},\"permissions\":[\"mail.send\"],\"idempotency\":{\"support\":\"unsupported\"},\"minimum_approval\":\"required\",\"preview\":{\"strength\":\"exact\"},\"reversibility\":\"unknown\",\"atomicity\":\"single_target\",\"outcome\":\"synchronous\",\"contract_cid\":\"sha256:8eaaf8eb0c34992a610de81c25a3d71c082106ff2f7b9b6cead8227c0d480255\"}],\"contracts\":[{\"schema\":\"actql.contract/0.1\",\"id\":\"mail.input\",\"kind\":\"command_input\",\"version\":\"vendor-1\",\"body\":{\"type\":\"object\",\"nullable\":false,\"additional_properties\":false,\"fields\":{\"body\":{\"type\":\"string\",\"nullable\":false}}},\"cid\":\"sha256:ceffb59b34b9fee831dc4060f0de02e3268bc8fe8549ea4516f74e15da90c0e2\"},{\"schema\":\"actql.contract/0.1\",\"id\":\"mail.output\",\"kind\":\"command_output\",\"version\":\"vendor-1\",\"body\":{\"type\":\"object\",\"nullable\":false,\"additional_properties\":false,\"fields\":{\"id\":{\"type\":\"string\",\"nullable\":false}}},\"cid\":\"sha256:db19239d74f021e17ac68b37e34a434a43c28a7d46f4329535afae74e148835c\"}],\"catalog_cid\":\"sha256:43235b817c50293006d90fcccf68e0b2b5bf926d0d3a4c7841deee36011e4a94\"}],\"host_policy_profile\":{},\"evidence_bundle_cid\":\"sha256:f179507be9db54d960a1acb7cf80fb04a9e3b1b82c5ab4c59c26a68a5e53fc1a\"}"),
    "sha256:f179507be9db54d960a1acb7cf80fb04a9e3b1b82c5ab4c59c26a68a5e53fc1a", caps(),
  ).unwrap()
  let contents = check_catalog_contents(check_contract_registry(environment, caps()).unwrap(), caps()).unwrap()
  let target = select_command_target(contents, "command:mail.send.v1", 1000).unwrap()
  assert_true(select_published_command_binding(contents, "command:mail.send.v1", published_command_limits(), 1000) is Err(MissingBinding))
  assert_eq(command_target_cid(target), "sha256:8eaaf8eb0c34992a610de81c25a3d71c082106ff2f7b9b6cead8227c0d480255")
  assert_eq(catalog_identity(command_target_catalog(target)).2, "sha256:43235b817c50293006d90fcccf68e0b2b5bf926d0d3a4c7841deee36011e4a94")
  assert_eq(cid(member_environment(command_target_member(target))), "sha256:f179507be9db54d960a1acb7cf80fb04a9e3b1b82c5ab4c59c26a68a5e53fc1a")
  assert_true(physical_equal(member_environment(command_target_member(target)), environment))
}

