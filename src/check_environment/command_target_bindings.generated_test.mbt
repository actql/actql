test "Original Command target fixed identity legacy-field" {
  let environment = read(
    @utf8.encode("{\"command_contracts\":[{\"atomicity\":\"single_target\",\"command_id\":\"command:mail.send.v1\",\"connector_id\":\"example\",\"contract_cid\":\"sha256:8eaaf8eb0c34992a610de81c25a3d71c082106ff2f7b9b6cead8227c0d480255\",\"idempotency\":{\"support\":\"unsupported\"},\"input_contract\":{\"additional_properties\":false,\"fields\":{\"body\":{\"nullable\":false,\"type\":\"string\"}}},\"input_schema\":{\"cid\":\"sha256:ceffb59b34b9fee831dc4060f0de02e3268bc8fe8549ea4516f74e15da90c0e2\",\"id\":\"mail.input\",\"version\":\"vendor-1\"},\"minimum_approval\":\"required\",\"outcome\":\"synchronous\",\"output_schema\":{\"cid\":\"sha256:db19239d74f021e17ac68b37e34a434a43c28a7d46f4329535afae74e148835c\",\"id\":\"mail.output\",\"version\":\"vendor-1\"},\"permissions\":[\"mail.send\"],\"preview\":{\"strength\":\"exact\"},\"reversibility\":\"unknown\",\"schema\":\"actql.command_contract/0.1\",\"target\":{\"cardinality\":\"single\",\"resource_kind\":\"mailbox\"},\"version\":\"vendor-1\"}],\"connector_capabilities\":[],\"connector_catalogs\":[{\"catalog_cid\":\"sha256:43235b817c50293006d90fcccf68e0b2b5bf926d0d3a4c7841deee36011e4a94\",\"commands\":[{\"atomicity\":\"single_target\",\"command_id\":\"command:mail.send.v1\",\"connector_id\":\"example\",\"contract_cid\":\"sha256:8eaaf8eb0c34992a610de81c25a3d71c082106ff2f7b9b6cead8227c0d480255\",\"idempotency\":{\"support\":\"unsupported\"},\"input_contract\":{\"additional_properties\":false,\"fields\":{\"body\":{\"nullable\":false,\"type\":\"string\"}}},\"input_schema\":{\"cid\":\"sha256:ceffb59b34b9fee831dc4060f0de02e3268bc8fe8549ea4516f74e15da90c0e2\",\"id\":\"mail.input\",\"version\":\"vendor-1\"},\"minimum_approval\":\"required\",\"outcome\":\"synchronous\",\"output_schema\":{\"cid\":\"sha256:db19239d74f021e17ac68b37e34a434a43c28a7d46f4329535afae74e148835c\",\"id\":\"mail.output\",\"version\":\"vendor-1\"},\"permissions\":[\"mail.send\"],\"preview\":{\"strength\":\"exact\"},\"reversibility\":\"unknown\",\"schema\":\"actql.command_contract/0.1\",\"target\":{\"cardinality\":\"single\",\"resource_kind\":\"mailbox\"},\"version\":\"vendor-1\"}],\"connector_id\":\"example\",\"connector_version\":\"vendor-1\",\"contracts\":[{\"body\":{\"additional_properties\":false,\"fields\":{\"body\":{\"nullable\":false,\"type\":\"string\"}},\"nullable\":false,\"type\":\"object\"},\"cid\":\"sha256:ceffb59b34b9fee831dc4060f0de02e3268bc8fe8549ea4516f74e15da90c0e2\",\"id\":\"mail.input\",\"kind\":\"command_input\",\"schema\":\"actql.contract/0.1\",\"version\":\"vendor-1\"},{\"body\":{\"additional_properties\":false,\"fields\":{\"id\":{\"nullable\":false,\"type\":\"string\"}},\"nullable\":false,\"type\":\"object\"},\"cid\":\"sha256:db19239d74f021e17ac68b37e34a434a43c28a7d46f4329535afae74e148835c\",\"id\":\"mail.output\",\"kind\":\"command_output\",\"schema\":\"actql.contract/0.1\",\"version\":\"vendor-1\"}],\"schema\":\"actql.connector_catalog/0.1\",\"source_views\":[]}],\"contract_registry\":[{\"body\":{\"additional_properties\":false,\"fields\":{\"id\":{\"nullable\":false,\"type\":\"string\"}},\"nullable\":false,\"type\":\"object\"},\"cid\":\"sha256:db19239d74f021e17ac68b37e34a434a43c28a7d46f4329535afae74e148835c\",\"id\":\"mail.output\",\"kind\":\"command_output\",\"schema\":\"actql.contract/0.1\",\"version\":\"vendor-1\"},{\"body\":{\"additional_properties\":false,\"fields\":{\"body\":{\"nullable\":false,\"type\":\"string\"}},\"nullable\":false,\"type\":\"object\"},\"cid\":\"sha256:ceffb59b34b9fee831dc4060f0de02e3268bc8fe8549ea4516f74e15da90c0e2\",\"id\":\"mail.input\",\"kind\":\"command_input\",\"schema\":\"actql.contract/0.1\",\"version\":\"vendor-1\"}],\"evidence_bundle_cid\":\"sha256:8d3e3f090026d3f482be46e02e63b5220e5c0422d1666dbb8c9adf2cb54b85b7\",\"host_policy_profile\":{},\"mapping_contracts\":[],\"model_task_contracts\":[],\"schema_snapshots\":[],\"source_views\":[],\"version\":\"actql-check-environment/0.1\"}"),
    "sha256:8d3e3f090026d3f482be46e02e63b5220e5c0422d1666dbb8c9adf2cb54b85b7", caps(),
  ).unwrap()
  let contents = check_catalog_contents(check_contract_registry(environment, caps()).unwrap(), caps()).unwrap()
  let target = select_command_target(contents, "command:mail.send.v1", 1000).unwrap()
  assert_true(select_published_command_binding(contents, "command:mail.send.v1", published_command_limits(), 1000) is Err(MissingBinding))
  assert_eq(command_target_cid(target), "sha256:8eaaf8eb0c34992a610de81c25a3d71c082106ff2f7b9b6cead8227c0d480255")
  assert_eq(catalog_identity(command_target_catalog(target)).2, "sha256:43235b817c50293006d90fcccf68e0b2b5bf926d0d3a4c7841deee36011e4a94")
  assert_eq(cid(member_environment(command_target_member(target))), "sha256:8d3e3f090026d3f482be46e02e63b5220e5c0422d1666dbb8c9adf2cb54b85b7")
  assert_true(physical_equal(member_environment(command_target_member(target)), environment))
}

