test "self-cid-rejected" {
  let environment = @check_environment.read(@utf8.encode("{\"command_contracts\":[],\"connector_capabilities\":[{\"capability_contract_cids\":[\"sha256:5555555555555555555555555555555555555555555555555555555555555555\",\"sha256:6666666666666666666666666666666666666666666666666666666666666666\"],\"read_mode\":\"snapshot\",\"source_contract_cid\":\"sha256:1111111111111111111111111111111111111111111111111111111111111111\",\"source_ref\":\"connector://duckdb/local/orders#snapshot\",\"source_view_contract_cid\":\"sha256:2222222222222222222222222222222222222222222222222222222222222222\"}],\"connector_catalogs\":[],\"contract_registry\":[],\"evidence_bundle_cid\":\"sha256:658dd615d0d993a860f9deb45cbda4073c86e6d64a91cc642a8dd1560081da1a\",\"host_policy_profile\":{},\"mapping_contracts\":[],\"model_task_contracts\":[],\"schema_snapshots\":[{\"carrier_schema_contract_cid\":\"sha256:3333333333333333333333333333333333333333333333333333333333333333\",\"data_classification\":\"internal\",\"output_carrier\":\"relation\",\"read_mode\":\"snapshot\",\"schema_evidence_cid\":\"sha256:8888888888888888888888888888888888888888888888888888888888888888\",\"source_contract_cid\":\"sha256:1111111111111111111111111111111111111111111111111111111111111111\",\"source_data_policy_cid\":\"sha256:4444444444444444444444444444444444444444444444444444444444444444\",\"source_ref\":\"connector://duckdb/local/orders#snapshot\",\"source_view_contract_cid\":\"sha256:2222222222222222222222222222222222222222222222222222222222222222\"}],\"source_views\":[],\"version\":\"actql-check-environment/0.1\"}"),
    "sha256:658dd615d0d993a860f9deb45cbda4073c86e6d64a91cc642a8dd1560081da1a", { max_bytes: 10000, max_nodes: 1000, max_depth: 20, max_members: 20 }).unwrap()
  let selection = @check_environment.select_connector_source_evidence_members(environment, {
    source_ref: "connector://duckdb/local/orders#snapshot",
    source_contract_cid: "sha256:1111111111111111111111111111111111111111111111111111111111111111",
    source_view_contract_cid: "sha256:2222222222222222222222222222222222222222222222222222222222222222",
    carrier_schema_contract_cid: "sha256:3333333333333333333333333333333333333333333333333333333333333333",
    source_data_policy_cid: "sha256:4444444444444444444444444444444444444444444444444444444444444444",
    data_classification: "internal",
  })
  assert_true(selection is Err(@check_environment.InvalidMember))
}

