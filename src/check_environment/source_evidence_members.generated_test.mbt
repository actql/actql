    "sha256:cd319323da2f2f14b529154fe4840addf88f8e270cd86f3db7118dbd2254ca3c", { max_bytes: 10000, max_nodes: 1000, max_depth: 20, max_members: 20 }).unwrap()
  let selection = @check_environment.select_connector_source_evidence_members(environment, {
    source_ref: "connector://duckdb/local/orders#snapshot",
    source_contract_cid: "sha256:1111111111111111111111111111111111111111111111111111111111111111",
    source_view_contract_cid: "sha256:2222222222222222222222222222222222222222222222222222222222222222",
    carrier_schema_contract_cid: "sha256:3333333333333333333333333333333333333333333333333333333333333333",
    source_data_policy_cid: "sha256:4444444444444444444444444444444444444444444444444444444444444444",
    data_classification: "internal",
  })
  let members = selection.unwrap()
  assert_eq(@check_environment.connector_source_evidence_member_cids(members), ("sha256:d46240ea5d2e49c1b6f21ba31aafb9a702effba5c99bfd5119411d346c93930d", "sha256:5fb04839ee89af2dd06828dd53d12049a64640e0d46d12848732fdcec663e34a"))
