  assert_true(@check_environment.read(@utf8.encode("{\"command_contracts\":[],\"connector_capabilities\":[],\"connector_catalogs\":[],\"contract_registry\":[],\"evidence_bundle_cid\":\"sha256:91ba2b29f5ce3266de9696dcf226c727bf4efa34074676b957b96e206af158ca\",\"host_policy_profile\":{\"mode\":\"unresolved\",\"version\":\"actql-host-policy/0.1\"},\"mapping_contracts\":[],\"model_task_contracts\":[],\"schema_snapshots\":[{\"output_carrier\":\"relation\",\"schema\":{\"additional_properties\":false,\"fields\":{},\"nullable\":false,\"type\":\"object\"},\"source_ref\":\"source:local/s/rows\",\"version\":\"actql-local-input-schema/0.1\"}],\"source_views\":[],\"version\":\"actql-check-environment/0.1\"}"), "sha256:91ba2b29f5ce3266de9696dcf226c727bf4efa34074676b957b96e206af158ca", { max_bytes: bytes, max_nodes: nodes - 1, max_depth: 100, max_members: members }) is Err(@check_environment.BudgetExceeded))
}

