// Generated from independent scripts/fixtures/decision-contract.mjs.

///|
fn decision_fixture_limits() -> DecisionLimits {
  {max_questions: 8, max_options: 8, max_levels: 8, max_name_bytes: 10000, max_work: 10000}
}

///|
fn decision_fixture_task() -> ModelTaskContract {
  let tasks = check_model_tasks(model_wire(["{\"authored_model_selector\":\"fixture-native\",\"connector_id\":\"models/fixture\",\"contract_cid\":\"sha256:def45fa15b898ea3ae17c7920d24ea8c11af6cfc7dee7b5a39ef7566d5e96d4e\",\"data_handling\":{\"accepted_classifications\":[\"public\"],\"allowed_regions\":[\"fixture\"],\"contract_cid\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"retention\":\"none\",\"training_use\":\"forbidden\"},\"decision_config\":{\"answer_profile\":\"actql.decision_answers/0.1\",\"distribution_policy\":\"required_for_choice_and_score\",\"probability_source\":\"native\"},\"input_contract\":{\"additional_properties\":false,\"fields\":{\"state\":{\"nullable\":true,\"type\":\"json\"}},\"nullable\":false,\"type\":\"object\"},\"input_schema_cid\":\"sha256:3b945d01674c1d9006497d459e110bfde9e836e5686fcca3b6dd1fc7b82f9466\",\"max_items\":4,\"output_contract\":{\"additional_properties\":false,\"fields\":{\"__proto__\":{\"additional_properties\":false,\"fields\":{\"choice\":{\"nullable\":false,\"type\":\"string\"},\"probabilities\":{\"items\":{\"additional_properties\":false,\"fields\":{\"option\":{\"nullable\":false,\"type\":\"string\"},\"probability\":{\"nullable\":false,\"type\":\"number\"}},\"nullable\":false,\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"}},\"nullable\":false,\"type\":\"object\"},\"constructor\":{\"additional_properties\":false,\"fields\":{\"probabilities\":{\"items\":{\"additional_properties\":false,\"fields\":{\"level\":{\"nullable\":false,\"type\":\"number\"},\"probability\":{\"nullable\":false,\"type\":\"number\"}},\"nullable\":false,\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"score\":{\"nullable\":false,\"type\":\"number\"}},\"nullable\":false,\"type\":\"object\"},\"enabled\":{\"additional_properties\":false,\"fields\":{\"probability\":{\"nullable\":false,\"type\":\"number\"}},\"nullable\":false,\"type\":\"object\"}},\"nullable\":false,\"type\":\"object\"},\"output_schema_cid\":\"sha256:4ce8bfaf60dd4fe01d0f7df2cc73fb8303c9daef9c06adb09e72385be34ff3f9\",\"prompt_template_cid\":\"sha256:3cb49cca43b2ada3360038ff65eb699c5c79e93c2630bd3e3e4ed2fdd980db80\",\"retrieval_policy\":\"none\",\"schema\":\"actql.model_task/0.2\",\"streaming\":false,\"task_id\":\"model-task:decision-fixture\",\"task_kind\":\"decision\",\"tool_policy\":\"none\",\"version\":\"1\"}"]), model_limits()).unwrap()
  resolve_model_task(tasks, "model-task:decision-fixture").unwrap()
}

///|
fn decision_fixture_prompt() -> ModelDependency {
  read_model_dependency(ModelPrompt, @utf8.encode("{\"payload\":{\"format\":\"actql.decision_prompt/0.1\",\"questions\":[{\"id\":\"__proto__\",\"instructions\":\"Choose a routing label.\\r\\né\",\"options\":[{\"description\":\"toString\",\"id\":\"toString\"},{\"description\":\"__proto__\",\"id\":\"__proto__\"},{\"description\":\"constructor\",\"id\":\"constructor\"}],\"type\":\"choice\"},{\"id\":\"constructor\",\"instructions\":\"Score the state.\",\"levels\":[\"low\",\"medium\",\"high\"],\"type\":\"score\"},{\"id\":\"enabled\",\"instructions\":\"P(true) for eligibility.\",\"type\":\"boolean\"}],\"state_input\":\"state\"},\"self_cid\":\"sha256:3cb49cca43b2ada3360038ff65eb699c5c79e93c2630bd3e3e4ed2fdd980db80\",\"version\":\"actql-model-prompt/0.1\"}"), "sha256:3cb49cca43b2ada3360038ff65eb699c5c79e93c2630bd3e3e4ed2fdd980db80", model_limits().bodies, 100000).unwrap()
}

///|
fn decision_fixture_cursor(wire : String) -> @decode.Cursor {
  let tree = @source.parse_json_bytes_preserving(@utf8.encode(wire), {max_input_bytes: 10000, max_nodes: 1000, max_depth: 50}).unwrap()
  @decode.admit(tree, {max_nodes: 1000, max_depth: 50, max_string_bytes: 10000, max_total_string_bytes: 10000}).unwrap()
}

///|
test "Decision independent Task/prompt CID, output correspondence and no generation defaults" {
  let task = decision_fixture_task()
  let prompt = decision_fixture_prompt()
  assert_eq(model_task_identity(task).2, "sha256:def45fa15b898ea3ae17c7920d24ea8c11af6cfc7dee7b5a39ef7566d5e96d4e")
  assert_eq(model_task_prompt_cid(task), "sha256:3cb49cca43b2ada3360038ff65eb699c5c79e93c2630bd3e3e4ed2fdd980db80")
  assert_eq(model_task_kind(task), Decision)
  assert_true(model_task_generation_config(task) is None)
  let checked = read_decision_contract(task, prompt, decision_fixture_limits()).unwrap()
  assert_true(decision_contract_matches(checked, task, prompt))
  assert_eq(decision_state_input(checked), "state")
  assert_false(decision_contract_matches(checked, decision_fixture_task(), prompt))
  assert_eq(@value_contract.stringify_checked(decision_output_contract(checked), 10000, 1000, 50), "{\"additional_properties\":false,\"fields\":{\"__proto__\":{\"additional_properties\":false,\"fields\":{\"choice\":{\"nullable\":false,\"type\":\"string\"},\"probabilities\":{\"items\":{\"additional_properties\":false,\"fields\":{\"option\":{\"nullable\":false,\"type\":\"string\"},\"probability\":{\"nullable\":false,\"type\":\"number\"}},\"nullable\":false,\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"}},\"nullable\":false,\"type\":\"object\"},\"constructor\":{\"additional_properties\":false,\"fields\":{\"probabilities\":{\"items\":{\"additional_properties\":false,\"fields\":{\"level\":{\"nullable\":false,\"type\":\"number\"},\"probability\":{\"nullable\":false,\"type\":\"number\"}},\"nullable\":false,\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"score\":{\"nullable\":false,\"type\":\"number\"}},\"nullable\":false,\"type\":\"object\"},\"enabled\":{\"additional_properties\":false,\"fields\":{\"probability\":{\"nullable\":false,\"type\":\"number\"}},\"nullable\":false,\"type\":\"object\"}},\"nullable\":false,\"type\":\"object\"}")
  let generated = check_model_tasks(model_wire(["{\"authored_model_selector\":\"fixture-native\",\"connector_id\":\"models/fixture\",\"contract_cid\":\"sha256:2a429743ad2291d2f0961a5427f1fb5b99096a39bae6bb7a0bffa72d62c31b6a\",\"data_handling\":{\"accepted_classifications\":[\"public\"],\"allowed_regions\":[\"fixture\"],\"contract_cid\":\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"retention\":\"none\",\"training_use\":\"forbidden\"},\"generation_config\":{\"max_output_tokens\":32,\"temperature\":0,\"top_p\":1},\"input_contract\":{\"additional_properties\":false,\"fields\":{\"state\":{\"nullable\":true,\"type\":\"json\"}},\"nullable\":false,\"type\":\"object\"},\"input_schema_cid\":\"sha256:3b945d01674c1d9006497d459e110bfde9e836e5686fcca3b6dd1fc7b82f9466\",\"max_items\":4,\"output_contract\":{\"additional_properties\":false,\"fields\":{\"__proto__\":{\"additional_properties\":false,\"fields\":{\"choice\":{\"nullable\":false,\"type\":\"string\"},\"probabilities\":{\"items\":{\"additional_properties\":false,\"fields\":{\"option\":{\"nullable\":false,\"type\":\"string\"},\"probability\":{\"nullable\":false,\"type\":\"number\"}},\"nullable\":false,\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"}},\"nullable\":false,\"type\":\"object\"},\"constructor\":{\"additional_properties\":false,\"fields\":{\"probabilities\":{\"items\":{\"additional_properties\":false,\"fields\":{\"level\":{\"nullable\":false,\"type\":\"number\"},\"probability\":{\"nullable\":false,\"type\":\"number\"}},\"nullable\":false,\"type\":\"object\"},\"nullable\":true,\"type\":\"array\"},\"score\":{\"nullable\":false,\"type\":\"number\"}},\"nullable\":false,\"type\":\"object\"},\"enabled\":{\"additional_properties\":false,\"fields\":{\"probability\":{\"nullable\":false,\"type\":\"number\"}},\"nullable\":false,\"type\":\"object\"}},\"nullable\":false,\"type\":\"object\"},\"output_schema_cid\":\"sha256:4ce8bfaf60dd4fe01d0f7df2cc73fb8303c9daef9c06adb09e72385be34ff3f9\",\"prompt_template_cid\":\"sha256:3cb49cca43b2ada3360038ff65eb699c5c79e93c2630bd3e3e4ed2fdd980db80\",\"retrieval_policy\":\"none\",\"schema\":\"actql.model_task/0.2\",\"streaming\":false,\"task_id\":\"model-task:decision-fixture\",\"task_kind\":\"structured_generate\",\"tool_policy\":\"none\",\"version\":\"1\"}"]), model_limits()).unwrap()
  let generation = resolve_model_task(generated, "model-task:decision-fixture").unwrap()
  assert_eq(model_task_identity(generation).2, "sha256:2a429743ad2291d2f0961a5427f1fb5b99096a39bae6bb7a0bffa72d62c31b6a")
  assert_eq(model_task_kind(generation), StructuredGenerate)
  assert_eq(model_task_generation_config(generation).unwrap().max_output_tokens, 32L)
}

