///|
test "Decision answer: unknown answer member" {
  let checked = read_decision_contract(decision_fixture_task(), decision_fixture_prompt(), decision_fixture_limits()).unwrap()
  assert_true(validate_decision_answers(checked, decision_fixture_cursor("{\"__proto__\":{\"choice\":\"toString\",\"probabilities\":[{\"option\":\"toString\",\"probability\":0.33},{\"option\":\"__proto__\",\"probability\":0.33},{\"option\":\"constructor\",\"probability\":0.33}]},\"constructor\":{\"probabilities\":[{\"level\":0,\"probability\":0.33},{\"level\":1,\"probability\":0.33},{\"level\":2,\"probability\":0.33}],\"score\":1},\"enabled\":{\"confidence\":1,\"probability\":0.5}}"), initial_jev_decision_profile(), 10000) is Err({kind: InvalidAnswer, ..}))
}

