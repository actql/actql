},\"output_schema_cid\":\"sha256:4ce8bfaf60dd4fe01d0f7df2cc73fb8303c9daef9c06adb09e72385be34ff3f9\",\"prompt_template_cid\":\"sha256:858b82d6a9aa9e3efe46de3cb3df4ab61ba33e1667803b314f66d2e2c0ddf8b9\",\"retrieval_policy\":\"none\",\"schema\":\"actql.model_task/0.2\",\"streaming\":false,\"task_id\":\"model-task:decision-fixture\",\"task_kind\":\"decision\",\"tool_policy\":\"none\",\"version\":\"1\"}"]), model_limits()).unwrap(), "model-task:decision-fixture").unwrap()
  let prompt = read_model_dependency(ModelPrompt, @utf8.encode("{\"payload\":{\"format\":\"actql.decision_prompt/0.1\",\"questions\":[{\"id\":\"__proto__\",\"instructions\":\"Choose a routing label.\\r\\né\",\"options\":[{\"description\":\"toString\",\"id\":\"toString\"},{\"description\":\"__proto__\",\"id\":\"__proto__\"},{\"description\":\"constructor\",\"id\":\"constructor\"}],\"type\":\"choice\"},{\"id\":\"constructor\",\"instructions\":\"Score the state.\",\"levels\":[null,\"medium\",\"high\"],\"type\":\"score\"},{\"id\":\"enabled\",\"instructions\":\"P(true) for eligibility.\",\"type\":\"boolean\"}],\"state_input\":\"state\"},\"self_cid\":\"sha256:858b82d6a9aa9e3efe46de3cb3df4ab61ba33e1667803b314f66d2e2c0ddf8b9\",\"version\":\"actql-model-prompt/0.1\"}"), "sha256:858b82d6a9aa9e3efe46de3cb3df4ab61ba33e1667803b314f66d2e2c0ddf8b9", model_limits().bodies, 100000).unwrap()
  assert_true(read_decision_contract(task, prompt, decision_fixture_limits()) is Err({kind: InvalidPrompt, ..}))
}

