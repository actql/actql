///|
test "Decision independent exact and one-short validation work" {
  let task = decision_fixture_task()
  let prompt = decision_fixture_prompt()
  let limits = {..decision_fixture_limits(), max_work: 471}
  let checked = read_decision_contract(task, prompt, limits).unwrap()
  assert_eq(decision_contract_usage(checked), 471)
  assert_true(read_decision_contract(task, prompt, {..limits, max_work: 470}) is Err({kind: WorkLimit, ..}))
  let answer = decision_fixture_cursor("{\"__proto__\":{\"choice\":\"toString\",\"probabilities\":[{\"option\":\"toString\",\"probability\":0.33},{\"option\":\"__proto__\",\"probability\":0.33},{\"option\":\"constructor\",\"probability\":0.33}]},\"constructor\":{\"probabilities\":[{\"level\":0,\"probability\":0.33},{\"level\":1,\"probability\":0.33},{\"level\":2,\"probability\":0.33}],\"score\":1},\"enabled\":{\"probability\":0.5}}")
  assert_eq(validate_decision_answers(checked, answer, initial_jev_decision_profile(), 290).unwrap(), 290)
  assert_true(validate_decision_answers(checked, answer, initial_jev_decision_profile(), 289) is Err({kind: WorkLimit, ..}))
}

///|
test "Decision dependencies connect the original checked Task and prompt" {
  let task = decision_fixture_task()
  let execution = read_model_execution_contract(task, @utf8.encode("{\"backoff_contract_cid\":\"sha256:739f886f72a9d0393470b92ccc3eb6a3a00f0616ed2d6f61df714f429de99d56\",\"default_publication\":\"outcomes\",\"max_attempts_per_slot\":1,\"max_total_attempts\":1,\"max_total_cost_units\":0,\"max_total_duration_ms\":1000,\"max_total_token_reservation\":128,\"max_total_wire_bytes\":2048,\"media_input_contracts\":{},\"model_task_contract_cid\":\"sha256:def45fa15b898ea3ae17c7920d24ea8c11af6cfc7dee7b5a39ef7566d5e96d4e\",\"retry_classification_contract_cid\":\"sha256:0c53e62a9c01afcf23a2036a06dd0b5e47653e943cae76d48bee1c84c11efb90\",\"self_cid\":\"sha256:de6383143d932950e1472a28c5dc61a44fa473df3c0848e82f5310a3bbaea334\",\"version\":\"actql-model-execution-contract/0.1\"}"), "sha256:de6383143d932950e1472a28c5dc61a44fa473df3c0848e82f5310a3bbaea334", model_limits().bodies, 100000).unwrap()
  let dependencies = read_single_attempt_model_dependencies(execution, Some(@utf8.encode("{\"payload\":{\"format\":\"actql.decision_prompt/0.1\",\"questions\":[{\"id\":\"__proto__\",\"instructions\":\"Choose a routing label.\\r\\né\",\"options\":[{\"description\":\"toString\",\"id\":\"toString\"},{\"description\":\"__proto__\",\"id\":\"__proto__\"},{\"description\":\"constructor\",\"id\":\"constructor\"}],\"type\":\"choice\"},{\"id\":\"constructor\",\"instructions\":\"Score the state.\",\"levels\":[\"low\",\"medium\",\"high\"],\"type\":\"score\"},{\"id\":\"enabled\",\"instructions\":\"P(true) for eligibility.\",\"type\":\"boolean\"}],\"state_input\":\"state\"},\"self_cid\":\"sha256:3cb49cca43b2ada3360038ff65eb699c5c79e93c2630bd3e3e4ed2fdd980db80\",\"version\":\"actql-model-prompt/0.1\"}")), Some(@utf8.encode("{\"retryable_failures\":[],\"self_cid\":\"sha256:0c53e62a9c01afcf23a2036a06dd0b5e47653e943cae76d48bee1c84c11efb90\",\"version\":\"actql-model-retry-policy/0.1\"}")), Some(@utf8.encode("{\"delays_ms\":[],\"self_cid\":\"sha256:739f886f72a9d0393470b92ccc3eb6a3a00f0616ed2d6f61df714f429de99d56\",\"version\":\"actql-model-backoff/0.1\"}")), model_limits().bodies, 100000).unwrap()
  let decision = single_attempt_model_decision(dependencies).unwrap()
  assert_true(single_attempt_model_dependencies_match(dependencies, execution))
  assert_true(decision_contract_matches(decision, task, single_attempt_model_prompt(dependencies)))
  assert_eq(decision_contract_usage(decision), 471)
}

///|
test "Decision rejects typed NaN and infinity without repair" {
  let checked = read_decision_contract(decision_fixture_task(), decision_fixture_prompt(), decision_fixture_limits()).unwrap()
  for value in [0.0 / 0.0, 1.0 / 0.0, -1.0 / 0.0] {
    let tree = @source.parse_json_bytes_preserving(@utf8.encode("{\"__proto__\":{\"choice\":\"toString\",\"probabilities\":[{\"option\":\"toString\",\"probability\":0.33},{\"option\":\"__proto__\",\"probability\":0.33},{\"option\":\"constructor\",\"probability\":0.33}]},\"constructor\":{\"probabilities\":[{\"level\":0,\"probability\":0.33},{\"level\":1,\"probability\":0.33},{\"level\":2,\"probability\":0.33}],\"score\":1},\"enabled\":{\"probability\":0.5}}"), {max_input_bytes: 10000, max_nodes: 1000, max_depth: 50}).unwrap()
    guard tree.value is @source.Object(fields) else { fail("fixture root") }
    for field in fields {
      if field.key == "enabled" {
        guard field.value.value is @source.Object(entries) else { fail("fixture answer") }
        let original = entries[0]
        entries[0] = {..original, value: {..original.value, value: @source.Number(value)}}
      }
    }
    let cursor = @decode.admit(tree, {max_nodes: 1000, max_depth: 50, max_string_bytes: 10000, max_total_string_bytes: 10000}).unwrap()
    assert_true(validate_decision_answers(checked, cursor, initial_jev_decision_profile(), 10000) is Err({kind: InvalidAnswer, ..}))
  }
}
