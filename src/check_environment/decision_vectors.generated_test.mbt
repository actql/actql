  assert_true(validate_decision_answers(checked, decision_fixture_cursor("{\"__proto__\":{\"choice\":\"toString\",\"probabilities\":[{\"option\":\"toString\",\"probability\":1},{\"option\":\"__proto__\",\"probability\":0},{\"option\":\"constructor\",\"probability\":0}]},\"constructor\":{\"probabilities\":[{\"level\":0,\"probability\":0.33},{\"level\":1,\"probability\":0.33},{\"level\":2,\"probability\":0.33}],\"score\":1},\"enabled\":{\"probability\":0}}"), initial_jev_decision_profile(), 10000) is Ok(_))
}

