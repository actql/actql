supported_targets = "+js+wasm+native"

import {
  "actql/actql/canonical_value" @canonical,
  "actql/actql/query_syntax" @query,
  "actql/actql/query_expression" @expression,
  "actql/actql/expression_typing" @typing,
  "actql/actql/program_source_builder" @builder,
  "actql/actql/frontend_source_map" @origin,
  "actql/actql/decode_core" @wire,
  "actql/actql/stage_syntax" @program,
  "actql/actql/parameter_binding" @parameters,
  "actql/actql/carrier_contract" @carrier,
  "actql/actql/value_contract" @contract,
  "actql/actql/relation_schema" @schema,
  "actql/actql/relation_typing" @relation,
  "actql/actql/relation_values" @values,
  "actql/actql/relation_join_shape" @join_shape,
  "actql/actql/relation_append" @append_shape,
  "actql/actql/relation_set" @set_shape,
  "actql/actql/expression_syntax",
  "actql/actql/local_relation_input" @local_input,
  "actql/actql/vector_typing" @vector,
  "actql/actql/pipeline_typing" @pipeline,
  "actql/actql/check_environment" @environment,
  "actql/actql/contract_reference" @contract_ref,
  "actql/actql/pipeline_check_context" @check_context,
  "actql/actql/sourceview_input" @sourceviews,
  "actql/actql/stage_parameters",
  "actql/actql/stage_results",
  "actql/actql/pipeline_parameters",
  "actql/actql/relation_results",
}

import {
  "actql/actql/source_value" @source,
  "actql/actql/encode_core" @encode,
  "actql/actql/program_check" @check,
  "actql/actql/numeric_reduction" @numeric,
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/debug",
  "actql/actql/lowering_relation" @lower,
  "actql/actql/relation_evidence" @evidence,
  "actql/actql/source_frontend" @frontend,
} for "test"

import {
  "actql/actql/source_value" @source,
  "actql/actql/encode_core" @encode,
} for "wbtest"
