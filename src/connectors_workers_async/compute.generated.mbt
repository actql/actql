// Generated by scripts/connector-compute-bundles.mjs; edit connector manifests.

///|
/// Pure assembly of an explicit Host implementation subset. Omitted modules
/// remain absent; registration/ownership checks use the shared SDK.
pub fn[E] assemble_compute_contributions(
  registry : @connector.CapabilityRegistry,
  max_entries : Int,
  with_reference_compute? : (
    @binding3.NumericComputeContribution,
    (@binding4.RunIssue) -> E,
    (@binding4.RunIssue) -> E,
  )? = None,
) -> Result[
  @connector.CapabilityImplementations[@host.ComputeContribution[Unit, E]],
  @connector.CapabilityInstallationIssue,
] {
  if max_entries < 0 {
    return Err(InvalidLimits)
  }
  let mut count = 0
  if with_reference_compute is Some(_) {
    count += 1
  }
  if count > max_entries {
    return Err(EntryLimit)
  }
  let entries : Array[
    (@connector.CapabilityRegistration, @host.ComputeContribution[Unit, E]),
  ] = []
  if with_reference_compute is Some((installed, dispatch_issue, estimate_issue)) {
    entries.push(
      (
        @binding3.numeric_contribution_registration(installed),
        @binding3.numeric_compute_contribution(
          installed, dispatch_issue, estimate_issue,
        ),
      ),
    )
  }
  @connector.install_capability_implementations(
    registry,
    entries,
    max_entries,
    registry_order=true,
  )
}

///|
struct ConfiguredComputeModules[E] {
  driver : @host.DispatchDriver
  installed_reference_compute : (
    @binding3.NumericComputeContribution,
    (@binding4.RunIssue) -> E,
    (@binding4.RunIssue) -> E,
  )?
  contributions : @connector.CapabilityImplementations[
    @host.ComputeContribution[Unit, E],
  ]
}

///|
/// Validate the complete registration subset before invoking any connector factory.
/// Configuration is synchronous and cannot authorize provider I/O or task start.
pub fn[E] configure_compute_modules(
  driver : @host.DispatchDriver,
  registry : @connector.CapabilityRegistry,
  max_entries : Int,
  installation_issue : (@connector.CapabilityInstallationIssue) -> E,
  with_reference_compute? : (
    @connector.CapabilityRegistration,
    @binding3.NumericComputeConfiguration,
    (@binding4.RunIssue) -> E,
    (@binding4.RunIssue) -> E,
  )? = None,
) -> Result[ConfiguredComputeModules[E], E] {
  let registrations : Array[(@connector.CapabilityRegistration, Unit)] = []
  if with_reference_compute is Some((registration, _, _, _)) {
    registrations.push((registration, ()))
  }
  match
    @connector.install_capability_implementations(
      registry, registrations, max_entries,
    ) {
    Err(issue) => return Err(installation_issue(issue))
    Ok(_) => ()
  }
  let installed_reference_compute = match with_reference_compute {
    None => None
    Some((registration, configuration, dispatch_issue, estimate_issue)) =>
      match
        @binding3.configure_numeric_compute(
          driver, registry, registration, configuration,
        ) {
        Ok(installed) => Some((installed, dispatch_issue, estimate_issue))
        Err(issue) => return Err(dispatch_issue(issue))
      }
  }
  let contributions = match
    assemble_compute_contributions(
      registry,
      max_entries,
      with_reference_compute=installed_reference_compute,
    ) {
    Ok(value) => value
    Err(issue) => return Err(installation_issue(issue))
  }
  Ok({ driver, installed_reference_compute, contributions, })
}

///|
pub fn[E] configured_compute_contributions(
  value : ConfiguredComputeModules[E],
) -> @connector.CapabilityImplementations[@host.ComputeContribution[Unit, E]] {
  value.contributions
}

///|
pub fn[E] configured_reference_compute_module(
  value : ConfiguredComputeModules[E],
) -> @binding3.NumericComputeContribution? {
  value.installed_reference_compute.map(value => value.0)
}

///|
/// Composition keys only; not capability IDs, resource bindings or dispatch authority.
pub fn[E] configured_compute_module_keys(
  value : ConfiguredComputeModules[E],
) -> Array[String] {
  let keys = []
  if value.installed_reference_compute is Some(_) {
    keys.push("reference_compute")
  }
  keys
}

///|
pub(all) enum ConfiguredDispatchIssue[E] {
  MissingImplementation
  Implementation(E)
}

///|
/// Invoke the configured implementation; the connector verifies the exact dispatch ownership.
pub fn[C, E] dispatch_reference_compute(
  value : ConfiguredComputeModules[E],
  host : @host.DispatchHost[C, E],
  task : @host.PreparedTaskDispatch,
) -> Result[Unit, ConfiguredDispatchIssue[E]] {
  match value.installed_reference_compute {
    None => Err(MissingImplementation)
    Some((installed, project, _)) =>
      @binding3.execute_numeric_contribution(installed, host, task).map_err(issue => {
        Implementation(project(issue))
      })
  }
}

///|
/// Prepare one managed task through the configured implementation.
pub fn[E] dispatch_managed_reference_compute(
  value : ConfiguredComputeModules[E],
  completed : Array[@execution.ManagedCompletedOutput[Int]],
  obligations : @execution.ManagedObligations,
  output_file_bytes : Int64,
) -> Result[
  @binding3.NumericManagedDispatchConfiguration[Int],
  ConfiguredDispatchIssue[E],
] {
  match value.installed_reference_compute {
    None => Err(MissingImplementation)
    Some((installed, project, _)) =>
      @binding3.prepare_numeric_managed_dispatch(
        installed, completed, obligations, output_file_bytes,
      ).map_err(issue => Implementation(project(issue)))
  }
}

///|
/// Standard composition: only an already configured installation and common
/// limits. Connector configuration and typed execution remain in the modules.
struct ConfiguredComputeHost[E] {
  modules : ConfiguredComputeModules[E]
  runtime : @host.ComputeHost[Unit, E]
}

///|
pub fn[E] open_configured_compute_host(
  modules : ConfiguredComputeModules[E],
  registry : @connector.CapabilityRegistry,
  capacity : @connector.FixedComputeCapacity,
  max_entries : Int,
  max_name_bytes : Int,
  max_implementations : Int,
) -> Result[ConfiguredComputeHost[E], @host.ComputeHostIssue[E]] {
  @host.open_compute_host(
    modules.driver,
    registry,
    modules.contributions,
    capacity,
    max_entries,
    max_name_bytes,
    max_implementations,
  ).map(runtime => { modules, runtime, })
}

///|
pub fn[E] configured_host_runtime(
  value : ConfiguredComputeHost[E],
) -> @host.ComputeHost[Unit, E] {
  value.runtime
}

///|
pub fn[E] configured_host_modules(
  value : ConfiguredComputeHost[E],
) -> ConfiguredComputeModules[E] {
  value.modules
}

///|
pub fn[E] configured_host_driver(
  value : ConfiguredComputeHost[E],
) -> @host.DispatchDriver {
  value.modules.driver
}

///|
/// Invoke an installed in-process implementation by exact registration. External
/// transport modules are not coerced into this synchronous execution contract.
pub fn[E] execute_configured_in_process(
  value : ConfiguredComputeHost[E],
  task : @host.PreparedTaskDispatch,
) -> Result[Unit, ConfiguredDispatchIssue[E]] {
  let selected = @host.prepared_task_registration(task)

  if value.modules.installed_reference_compute is Some((installed, project, _)) &&
    physical_equal(
      selected,
      @binding3.numeric_contribution_registration(installed),
    ) {
    return @binding3.execute_numeric_contribution(
      installed,
      @host.compute_host_dispatch(value.runtime),
      task,
    ).map_err(issue => Implementation(project(issue)))
  }
  Err(MissingImplementation)
}
