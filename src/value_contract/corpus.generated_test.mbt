test "value contract corpus: nel-field" {
  let value = @value_contract.read_author(cursor("{\"type\":\"object\",\"nullable\":false,\"fields\":{\"\u{85}\":{\"type\":\"string\",\"nullable\":false}}}"), limits()).unwrap()
  assert_eq(render(value), "{\"additional_properties\":false,\"fields\":{\"\u{85}\":{\"nullable\":false,\"type\":\"string\"}},\"nullable\":false,\"type\":\"object\"}")
  let checked = @value_contract.read_checked(cursor("{\"additional_properties\":false,\"fields\":{\"\u{85}\":{\"nullable\":false,\"type\":\"string\"}},\"nullable\":false,\"type\":\"object\"}"), limits()).unwrap()
  assert_true(@value_contract.type_equal(value, checked, 1000))
}

