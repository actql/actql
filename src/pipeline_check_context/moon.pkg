supported_targets = "+js+wasm+native"

import {
  "actql/actql/numeric_reduction" @numeric,
  "moonbitlang/core/encoding/utf8" @wire_utf8,
  "actql/actql/capacity_law" @law,
  "actql/actql/capacity_derivation" @derivation,
  "actql/actql/local_source_ref" @local_ref,
  "actql/actql/local_relation_snapshot" @snapshot,
  "actql/actql/capacity_host_witness" @host,
  "actql/actql/capacity_witness" @wire,
  "actql/actql/binding_declarations",
  "actql/actql/relation_schema" @schema,
  "actql/actql/local_relation_input" @local_input,
  "actql/actql/stage_syntax" @syntax,
  "actql/actql/calendar_profile",
  "actql/actql/text_rank_profile" @lexical,
  "actql/actql/relation_values" @values,
  "actql/actql/vector_typing" @vector,
  "actql/actql/carrier_contract" @carrier,
  "actql/actql/carrier_projection" @projection,
  "actql/actql/time_series" @series,
  "actql/actql/calendar_typing" @calendar,
  "actql/actql/calendar_options",
  "actql/actql/relation_typing" @relation,
  "actql/actql/relation_append" @append,
  "actql/actql/relation_set" @set,
  "actql/actql/relation_join" @join,
  "actql/actql/relation_evidence" @evidence,
  "actql/actql/value_contract" @contract,
  "actql/actql/stage_parameters" @stages,
  "actql/actql/encode_core" @encode,
  "actql/actql/program_references" @program_refs,
  "actql/actql/source_request_slots" @request_slots,
  "actql/actql/stage_source" @stage_body,
  "actql/actql/stage_results",
  "actql/actql/stage_local_inputs" @local_inputs,
  "actql/actql/pipeline_parameters" @parameter_slots,
  "actql/actql/parameter_references" @references,
  "actql/actql/expression_typing" @typing,
  "actql/actql/relation_results" @results,
  "actql/actql/pipeline_typing" @pipeline,
  "actql/actql/capacity_graph_preflight" @capacity,
  "actql/actql/capacity_program_step" @step_bounds,
  "actql/actql/capacity_policy" @policy,
  "actql/actql/parameter_binding" @parameter,
  "actql/actql/check_environment" @environment,
  "actql/actql/decode_core" @decode,
  "actql/actql/value_admission" @value,
  "actql/actql/timestamp_pattern" @timestamp,
  "actql/actql/regex_pattern" @regex,
  "actql/actql/regex_replacement" @replacement,
  "actql/actql/decode_scalar" @scalar,
  "actql/actql/text_time_policy" @text_policy,
  "actql/actql/text_time_bounds" @bounds,
  "actql/actql/sourceview_resolution" @sourceviews,
  "actql/actql/sourceview_input" @source_inputs,
}

import {
  "moonbitlang/core/debug",
  "actql/actql/stage_source_refs" @refs,
  "actql/actql/sha256" @sha,
  "actql/actql/source_value" @source,
  "actql/actql/relation_evidence" @evidence,
  "actql/actql/capacity_program_step" @program,
  "moonbitlang/core/encoding/utf8",
} for "test"

formatter(
  ignore: [
    "local_body_identity.generated_test.mbt",
    "sourceview_fixture.generated_test.mbt",
    "text_profile.generated_test.mbt",
    "numeric_profile.generated_test.mbt",
  ],
)
