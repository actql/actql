// Errors

// Types and methods
type AdmittedOperationQuery

pub struct AnalyticEnvelopeCheck {
  site : OperationRequirementSite
  step : @pipeline_typing.CheckedStep
  input : @pipeline_typing.Target
  operation : @relation_typing.CheckedOperation
  analytic : @relation_typing.CheckedAnalytic
  policy : @capacity_policy.Policy
  input_wire_bytes : @capacity_policy.Ceiling
  output_wire_bytes : @capacity_policy.Ceiling
  partition_wire_bytes : @capacity_policy.Ceiling
  frame_memberships : @capacity_policy.Ceiling
  output_rows : @capacity_policy.Ceiling
}

pub struct AnalyticExecutionCheck {
  site : OperationRequirementSite
  step : @pipeline_typing.CheckedStep
  input : @pipeline_typing.Target
  operation : @relation_typing.CheckedOperation
  analytic : @relation_typing.CheckedAnalytic
  rule : AnalyticExecutionRule
}

pub enum AnalyticExecutionRule {
  PartitionAuthoredPeers
  EvaluateCallDemands
  EvaluateAggregate(@relation_typing.AnalyticCall)
  ValidateResultContract(@relation_typing.AnalyticCall)
  EnforceStatisticalLaw(@relation_typing.AnalyticCall, StatisticalLaw)
  EnforceStringBytes(@relation_typing.AnalyticCall, GroupStringLimit)
  EnforceArrayItems(@relation_typing.AnalyticCall, GroupArrayLimit)
  CaptureNumericObservation(AnalyticNumericSlot)
}

pub struct AnalyticNumericSlot {
  requirement_index : Int
  site : OperationRequirementSite
  step : @pipeline_typing.CheckedStep
  input : @pipeline_typing.Target
  analytic : @relation_typing.CheckedAnalytic
  frame_call : @relation_typing.AnalyticCall
  call : @relation_typing.CheckedAggregate
  profile : @numeric_reduction.Profile
}

pub struct AppendRowsCheck {
  site : OperationRequirementSite
  step : @pipeline_typing.CheckedStep
  left : @pipeline_typing.Target
  right : @pipeline_typing.Target
  operation : @relation_append.CheckedAppend
  rule : AppendRowsRule
  policy : @capacity_policy.Policy
  left_order : @pipeline_typing.LogicalOrder?
  right_order : @pipeline_typing.LogicalOrder?
}

pub(all) enum AppendRowsRule {
  AdmitBothInputs
  PreserveLeftThenRight
  RetainIdentityAndCompleteness
  EnforceOutputEnvelope(@capacity_policy.Ceiling)
}

pub struct AsOfExecutionCheck {
  site : OperationRequirementSite
  step : @pipeline_typing.CheckedStep
  left : @pipeline_typing.Target
  right : @pipeline_typing.Target
  operation : @relation_evidence.CheckedAsOf
  left_time : @relation_schema.FieldName
  right_time : @relation_schema.FieldName
  left_timestamp : Bool
  right_timestamp : Bool
  output_order : @pipeline_typing.LogicalOrder
