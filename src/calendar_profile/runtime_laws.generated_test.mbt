// Generated by scripts/generate-calendar-runtime-laws.mjs from the fixed independent corpus.

///|
test "original Calendar law: leap-day" {
  let profile = runtime_law_profile()
  let table = @calendar_profile.zone(profile, "UTC").unwrap()
  let actual = runtime_law_bucket(table, "2024-02-29T12:00:00.000Z", Day, None, 1)
  assert_eq(actual.0, Ok(("2024-02-29T00:00:00.000Z", "2024-03-01T00:00:00.000Z")))
  assert_eq(runtime_law_bucket(table, "2024-02-29T12:00:00.000Z", Day, None, 127), actual)
}

