///|
test "pinned IANA offsets cover gaps folds skipped dates and far future" {
  let p = @calendar_profile.admit(real_fixture(), real_fixture_cid(), "2025b", {
    max_bytes: 900000,
    max_nodes: 100000,
    max_depth: 8,
    max_zones: 3,
    max_transitions: 20000,
  }).unwrap()
  // Expectations follow the US March/November rules and Samoa's 2011 date-line
  // change in the pinned source, not values generated by the fixture parser.
  for
    (name, instant, expected) in [
      ("America/New_York", 1710053999999L, -18000),
      ("America/New_York", 1710054000000L, -14400),
      ("America/New_York", 1730613599999L, -14400),
      ("America/New_York", 1730613600000L, -18000),
      ("America/New_York", 253386403200000L, -14400),
      ("America/New_York", 253370764800000L, -18000),
      ("Pacific/Apia", 1325239199999L, -36000),
      ("Pacific/Apia", 1325239200000L, 50400),
      ("UTC", -62135596800000L, 0),
      ("UTC", 253402300799999L, 0),
    ] {
    let table = @calendar_profile.zone(p, name).unwrap()
    assert_eq(@transition.offset_at(table, instant), Some(expected))
  }
  assert_true(@calendar_profile.zone(p, "Europe/London") is None)
}
