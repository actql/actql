supported_targets = "+js+wasm+native"

formatter(
  ignore: [
    "stage_expression_contract.generated.mbt",
    "stage_semantics.generated_test.mbt",
    "program_semantics.generated_test.mbt",
  ],
)

import {
  "actql/actql/source_request_slots" @requests,
  "actql/actql/stage_source" @body,
  "actql/actql/stage_parameters" @stages,
  "actql/actql/stage_syntax" @stage,
  "actql/actql/parameter_references" @parameters,
  "actql/actql/parameter_binding" @parameter,
  "actql/actql/pipeline_parameters" @collection,
  "actql/actql/binding_declarations" @bindings,
  "actql/actql/expression_syntax" @expression,
  "actql/actql/decode_core" @decode,
  "actql/actql/canonical_value" @canonical,
  "actql/actql/encode_core" @encode,
}

import {
  "actql/actql/pipeline_typing" @pipeline,
  "actql/actql/relation_schema" @schema,
  "actql/actql/source_value" @source,
} for "test"
