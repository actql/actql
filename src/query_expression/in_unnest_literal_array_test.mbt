///|
// Independent existing IN-list controls. No expected value is generated by
// the source lowerer or its Array constructor helper.
test "IN UNNEST literal array keeps the existing literal list contract" {
  for
    (source, expected) in [
      (
        "x IN UNNEST([2, NULL, @p])", "{\"in\":[{\"field\":\"x\"},{\"literal\":[2,null,{\"$param\":\"p\"}]}]}",
      ),
      (
        "x NOT IN UNNEST(ARRAY[-(2), +((3)), ((@p))])", "{\"not_in\":[{\"field\":\"x\"},{\"literal\":[-2,3,{\"$param\":\"p\"}]}]}",
      ),
      (
        "x IN UNNEST((([1, 1])))", "{\"in\":[{\"field\":\"x\"},{\"literal\":[1,1]}]}",
      ),
      ("x IN UNNEST([])", "{\"in\":[{\"field\":\"x\"},{\"literal\":[]}]}"),
      (
        "x NOT IN UNNEST(ARRAY[])", "{\"not_in\":[{\"field\":\"x\"},{\"literal\":[]}]}",
      ),
    ] {
    assert_eq(emit(source), expected, msg=source)
  }
}

///|
test "IN UNNEST preserves general ARRAY operands and their annotations" {
  assert_eq(
    emit("x IN UNNEST([y])"),
    "{\"in\":[{\"field\":\"x\"},{\"array\":[{\"field\":\"y\"}]}]}",
  )
  assert_eq(
    emit("x IN UNNEST([1 + 2])"),
    "{\"in\":[{\"field\":\"x\"},{\"array\":[{\"add\":[{\"literal\":1},{\"literal\":2}]}]}]}",
  )
  assert_eq(
    emit("x IN UNNEST([-@p])"),
    "{\"in\":[{\"field\":\"x\"},{\"array\":[{\"negate\":{\"$param\":\"p\"}}]}]}",
  )
  assert_eq(
    emit("x IN UNNEST(ARRAY<STRING>[1])"),
    "{\"in\":[{\"field\":\"x\"},{\"if\":[{\"literal\":true},{\"array\":[{\"literal\":1}]},{\"empty_array\":{\"items\":{\"nullable\":false,\"type\":\"string\"}}}]}]}",
  )
}
