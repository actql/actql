// Runnable application example, not a test fixture or formal Program runner.
supported_targets = "+js+wasm+native"

pkgtype(kind: "foreign_library")

import {
  "actql/actql/connectors_builtin" @builtin,
  "actql/actql/connectors/local/driver" @local_driver,
  "actql/actql/connectors/duckdb/host" @acquisition_host,
  "actql/actql/connectors/duckdb/acquisition" @duckdb_query,
  "actql/actql/connector_sdk" @connector,
  "actql/actql/physical_resources" @resources,
  "actql/actql/canonical_json" @identity,
  "actql/actql/execution_relation" @execution,
  "actql/actql/connectors/duckdb/adapter" @duckdb,
  "actql/actql/connectors/duckdb/compute" @duckdb_compute,
  "actql/actql/connectors/duckdb/standard_host" @dbhost,
  "actql/actql/lowering_relation" @lower,
  "actql/actql/pipeline_typing" @pipeline,
  "actql/actql/relation_schema" @schema,
  "moonbitlang/core/json",
  "actql/actql/pipeline_check_context" @context,
  "actql/actql/execution_query" @query,
  "actql/actql/query_planning" @planning,
  "actql/actql/physical_cost" @cost,
  "actql/actql/physical_strategy" @strategy,
  "actql/actql/physical_task_manifest" @manifest,
}
