  assert_eq(account_configuration_cid_json("{\"entries\":[{\"exclusions\":[],\"operation\":{\"all\":true},\"resource\":{\"all\":true},\"connection\":{\"any_of\":[\"local-files\"]},\"principal\":{\"any_of\":[\"operator\"]},\"outcome\":\"allow\",\"entry_id\":\"files\"}],\"account_id\":\"local:operator\",\"version\":\"actql-execution-account-config/0.1\"}"), Ok("sha256:e240525257340428cc9117b0b0e84a000996791f43b230abdb553e55223bec12"))
}

