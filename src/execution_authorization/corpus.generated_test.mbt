///|
test "account config evaluation vectors" {
  let config = admit_account_configuration_json("{\"version\":\"actql-execution-account-config/0.1\",\"account_id\":\"acct\",\"entries\":[{\"entry_id\":\"crm\",\"outcome\":\"delegate\",\"principal\":{\"all\":true},\"connection\":{\"any_of\":[\"crm\"]},\"resource\":{\"all\":true},\"operation\":{\"all\":true},\"exclusions\":[{\"principal\":{\"all\":true},\"connection\":{\"all\":true},\"resource\":{\"any_of\":[\"X\"]},\"operation\":{\"all\":true}}]},{\"entry_id\":\"files\",\"outcome\":\"allow\",\"principal\":{\"any_of\":[\"operator\"]},\"connection\":{\"any_of\":[\"local-files\"]},\"resource\":{\"all\":true},\"operation\":{\"all\":true},\"exclusions\":[{\"principal\":{\"all\":true},\"connection\":{\"all\":true},\"resource\":{\"any_of\":[\"secrets\"]},\"operation\":{\"all\":true}}]},{\"entry_id\":\"system\",\"outcome\":\"deny\",\"principal\":{\"all\":true},\"connection\":{\"any_of\":[\"crm\"]},\"resource\":{\"any_of\":[\"X\"]},\"operation\":{\"all\":true},\"exclusions\":[]}]}").unwrap()
  // allow-future-resource
  assert_true(evaluate_account(config, { principal: "operator", connection: "local-files", resource: "new-dir", operation: "read" }) is Allow("files"))
  // excluded-without-other-match
  assert_true(evaluate_account(config, { principal: "operator", connection: "local-files", resource: "secrets", operation: "read" }) is Deny(NoMatch))
  // finite-principal
  assert_true(evaluate_account(config, { principal: "guest", connection: "local-files", resource: "new-dir", operation: "read" }) is Deny(NoMatch))
  // delegate-future-operation
  guard evaluate_account(config, { principal: "svc", connection: "crm", resource: "Account", operation: "merge" }) is Delegate(found) else { fail("delegate-future-operation") }
  assert_eq(found.entry_id, "crm")
  // explicit-deny
  assert_true(evaluate_account(config, { principal: "svc", connection: "crm", resource: "X", operation: "update" }) is Deny(Explicit("system")))
  // unconfigured-connection
  assert_true(evaluate_account(config, { principal: "operator", connection: "mail", resource: "inbox", operation: "read" }) is Deny(NoMatch))
}
