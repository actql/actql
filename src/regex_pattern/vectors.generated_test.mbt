test "regex pattern: escape-D" {
  let p = parse("\\D", limits()).unwrap()
  assert_eq(cid(p), "sha256:6342744958d91e121f76b3a57e71c1a62c698a23cadac8d4bd0471e8db91f6ec")
  assert_eq(capture_count(p), 0)
  assert_eq(nullable(p), false)
  assert_eq(usage(p), (2, 178, 7))
  let w = @encode.writer(10000,10000,100)
  emit(p,w)
  assert_eq(@encode.finish(w), "{\"ast_cid\":\"sha256:6342744958d91e121f76b3a57e71c1a62c698a23cadac8d4bd0471e8db91f6ec\",\"capture_count\":0,\"root\":{\"kind\":\"class_escape\",\"value\":\"D\"},\"version\":\"actql-regex-ast/0.1\"}")
  let w = @encode.writer(10000,10000,100)
  emit_preimage(p,w)
  assert_eq(@encode.finish(w), "{\"capture_count\":0,\"root\":{\"kind\":\"class_escape\",\"value\":\"D\"},\"version\":\"actql-regex-ast/0.1\"}")
}

