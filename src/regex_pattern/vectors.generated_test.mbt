///|
test "regex pattern rejects: empty" {
  assert_true(parse("", limits()) is Err(InvalidSyntax(0)))
}

///|
test "regex pattern rejects: empty-group" {
  assert_true(parse("()", limits()) is Err(InvalidSyntax(1)))
}

///|
test "regex pattern rejects: empty-branch" {
  assert_true(parse("a|", limits()) is Err(InvalidSyntax(2)))
}

///|
test "regex pattern rejects: leading-branch" {
  assert_true(parse("|a", limits()) is Err(InvalidSyntax(0)))
}

///|
test "regex pattern rejects: unclosed" {
  assert_true(parse("(a", limits()) is Err(InvalidSyntax(0)))
}

///|
test "regex pattern rejects: close" {
  assert_true(parse("a)", limits()) is Err(InvalidSyntax(1)))
}

///|
test "regex pattern rejects: lazy" {
  assert_true(parse("a*?", limits()) is Err(InvalidSyntax(2)))
}

///|
test "regex pattern rejects: repeated" {
  assert_true(parse("a**", limits()) is Err(InvalidSyntax(2)))
}

///|
test "regex pattern rejects: anchor-repeat" {
  assert_true(parse("^*", limits()) is Err(NullableRepeat(1)))
}

///|
test "regex pattern rejects: nullable-capture" {
  assert_true(parse("(a?)+", limits()) is Err(NullableRepeat(4)))
}

///|
test "regex pattern rejects: nullable-alternative" {
  assert_true(parse("(^|a)*", limits()) is Err(NullableRepeat(5)))
}

///|
test "regex pattern rejects: empty-class" {
  assert_true(parse("[]", limits()) is Err(InvalidSyntax(1)))
}

///|
test "regex pattern rejects: unclosed-class" {
  assert_true(parse("[a", limits()) is Err(InvalidSyntax(2)))
}

///|
test "regex pattern rejects: bad-range" {
  assert_true(parse("[z-a]", limits()) is Err(InvalidRange(1)))
}

///|
test "regex pattern rejects: escape-range" {
  assert_true(parse("[\\d-a]", limits()) is Err(InvalidRange(1)))
}

///|
test "regex pattern rejects: cr-range" {
  assert_true(parse("[\\r-\\t]", limits()) is Err(InvalidRange(1)))
}

///|
test "regex pattern rejects: lookahead" {
  assert_true(parse("(?=a)", limits()) is Err(InvalidSyntax(1)))
}

///|
test "regex pattern rejects: backref" {
  assert_true(parse("\\1", limits()) is Err(InvalidSyntax(1)))
}

///|
test "regex pattern rejects: hex" {
  assert_true(parse("\\x41", limits()) is Err(InvalidSyntax(1)))
}

///|
test "regex pattern rejects: unicode" {
  assert_true(parse("\\u0041", limits()) is Err(InvalidSyntax(1)))
}

///|
test "regex pattern rejects: property" {
  assert_true(parse("\\p{L}", limits()) is Err(InvalidSyntax(1)))
}

///|
test "regex pattern rejects: unknown-escape" {
  assert_true(parse("\\q", limits()) is Err(InvalidSyntax(1)))
}

///|
test "regex pattern rejects: unfinished-escape" {
  assert_true(parse("\\", limits()) is Err(InvalidSyntax(1)))
}

///|
test "regex pattern rejects: leading-zero" {
  assert_true(parse("a{01}", limits()) is Err(InvalidQuantifier(2)))
}

///|
test "regex pattern rejects: reversed-repeat" {
  assert_true(parse("a{2,1}", limits()) is Err(InvalidQuantifier(1)))
}

///|
test "regex pattern rejects: missing-min" {
  assert_true(parse("a{,2}", limits()) is Err(InvalidQuantifier(2)))
}

///|
test "regex pattern rejects: signed" {
  assert_true(parse("a{-1}", limits()) is Err(InvalidQuantifier(2)))
}

///|
test "regex pattern rejects: fraction" {
  assert_true(parse("a{1.5}", limits()) is Err(InvalidQuantifier(3)))
}

///|
test "regex pattern rejects: unclosed-repeat" {
  assert_true(parse("a{1", limits()) is Err(InvalidQuantifier(3)))
}

///|
test "regex pattern rejects: inexact-repeat" {
  assert_true(parse("a{9007199254740993}", limits()) is Err(QuantifierOutOfRange(2)))
}

///|
test "regex pattern rejects: hyphen" {
  assert_true(parse("-", limits()) is Err(InvalidSyntax(0)))
}

///|
test "regex pattern rejects: nfd" {
  assert_true(parse("e\u{301}", limits()) is Err(NonCanonicalText))
}

///|
test "regex pattern rejects: raw-cr" {
  assert_true(parse("\u{d}", limits()) is Err(NonCanonicalText))
}

///|
test "regex pattern rejects: supplementary-position" {
  assert_true(parse("\u{1f600}\\q", limits()) is Err(InvalidSyntax(3)))
}
