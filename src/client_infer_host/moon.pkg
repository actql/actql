supported_targets = "+js+wasm+native"

formatter(ignore: [ "decision_admission.generated_wbtest.mbt" ])

import {
  "actql/actql/connectors/local",
  "actql/actql/connector_sdk" @connector,
  "actql/actql/lowering_relation" @lower,
  "actql/actql/pipeline_typing" @pipeline,
  "actql/actql/run_publication" @publication,
  "actql/actql/client_local_host" @input,
  "actql/actql/model_execution" @model,
  "actql/actql/execution_relation" @relation,
  "actql/actql/run_publication_host" @publication_host,
  "actql/actql/physical_strategy_host" @strategy,
  "actql/actql/check_environment" @environment,
  "actql/actql/bounded_execution" @bounded,
  "actql/actql/encode_core" @encode,
  "actql/actql/physical_resources" @resources,
  "actql/actql/source_value" @source,
  "actql/actql/decode_core" @decode,
  "actql/actql/value_admission" @admitted,
}

import {
  "actql/actql/infer_typing" @infer,
  "actql/actql/connectors/local/driver" @local_driver,
  "actql/actql/physical_host_dispatch" @host_driver,
  "actql/actql/connectors_builtin_node" @node_fixture,
  "actql/actql/value_admission" @admitted,
  "actql/actql/execution_authorization" @authorization,
  "actql/actql/sha256" @sha,
  "actql/actql/canonical_json" @canonical,
  "actql/actql/physical_resources" @resources,
  "moonbitlang/core/json",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/utf8",
} for "wbtest"
