///|
/// Pure assembly of an explicit Host implementation subset. Omitted modules
/// remain absent; registration/ownership checks use the shared SDK.
pub fn[E] assemble_compute_contributions(
  registry : @connector.CapabilityRegistry,
  max_entries : Int,
  with_duckdb? : (
    @binding3.DuckDBDispatchModule,
    (@binding3.DuckDBDispatchIssue) -> E,
    (@binding3.DuckDBEstimateIssue) -> E,
  )? = None,
  with_local? : (
    @binding4.LocalDispatchModule,
    (@binding4.LocalDispatchIssue) -> E,
    (@binding4.LocalEstimateIssue) -> E,
  )? = None,
  with_reference_compute? : (
    @binding5.NumericComputeContribution,
    (@binding6.RunIssue) -> E,
    (@binding6.RunIssue) -> E,
  )? = None,
) -> Result[
  @connector.CapabilityImplementations[@host.ComputeContribution[Unit, E]],
  @connector.CapabilityInstallationIssue,
] {
  if max_entries < 0 {
    return Err(InvalidLimits)
  }
  let mut count = 0
  if with_duckdb is Some(_) {
    count += 1
  }
  if with_local is Some(_) {
    count += 1
  }
  if with_reference_compute is Some(_) {
    count += 1
  }
  if count > max_entries {
    return Err(EntryLimit)
  }
  let entries : Array[
    (@connector.CapabilityRegistration, @host.ComputeContribution[Unit, E]),
  ] = []
  if with_duckdb is Some((installed, dispatch_issue, estimate_issue)) {
    entries.push(
      (
        @binding3.duckdb_dispatch_registration(installed),
        @binding3.duckdb_compute_contribution(
          installed, dispatch_issue, estimate_issue,
        ),
      ),
    )
  }
  if with_local is Some((installed, dispatch_issue, estimate_issue)) {
    entries.push(
      (
        @binding4.local_dispatch_registration(installed),
        @binding4.local_compute_contribution(
          installed, dispatch_issue, estimate_issue,
        ),
      ),
    )
  }
  if with_reference_compute is Some((installed, dispatch_issue, estimate_issue)) {
    entries.push(
      (
        @binding5.numeric_contribution_registration(installed),
        @binding5.numeric_compute_contribution(
          installed, dispatch_issue, estimate_issue,
        ),
      ),
    )
  }
  @connector.install_capability_implementations(
    registry,
    entries,
    max_entries,
    registry_order=true,
  )
}

///|
struct ConfiguredComputeModules[E] {
  driver : @host.DispatchDriver
  installed_duckdb : (
    @binding3.DuckDBDispatchModule,
    (@binding3.DuckDBDispatchIssue) -> E,
    (@binding3.DuckDBEstimateIssue) -> E,
  )?
  installed_local : (
    @binding4.LocalDispatchModule,
    (@binding4.LocalDispatchIssue) -> E,
    (@binding4.LocalEstimateIssue) -> E,
  )?
  installed_reference_compute : (
    @binding5.NumericComputeContribution,
    (@binding6.RunIssue) -> E,
    (@binding6.RunIssue) -> E,
  )?
  contributions : @connector.CapabilityImplementations[
    @host.ComputeContribution[Unit, E],
  ]
}

///|
/// Validate the complete registration subset before invoking any connector factory.
/// Configuration is synchronous and cannot authorize provider I/O or task start.
pub fn[E] configure_compute_modules(
  driver : @host.DispatchDriver,
  registry : @connector.CapabilityRegistry,
  max_entries : Int,
  installation_issue : (@connector.CapabilityInstallationIssue) -> E,
  with_duckdb? : (
    @connector.CapabilityRegistration,
    @binding3.DuckDBComputeConfiguration,
    (@binding3.DuckDBDispatchIssue) -> E,
    (@binding3.DuckDBEstimateIssue) -> E,
  )? = None,
  with_local? : (
    @connector.CapabilityRegistration,
    @binding4.LocalComputeConfiguration,
    (@binding4.LocalDispatchIssue) -> E,
    (@binding4.LocalEstimateIssue) -> E,
  )? = None,
  with_reference_compute? : (
    @connector.CapabilityRegistration,
    @binding5.NumericComputeConfiguration,
    (@binding6.RunIssue) -> E,
    (@binding6.RunIssue) -> E,
  )? = None,
) -> Result[ConfiguredComputeModules[E], E] {
  let registrations : Array[(@connector.CapabilityRegistration, Unit)] = []
  if with_duckdb is Some((registration, _, _, _)) {
    registrations.push((registration, ()))
  }
  if with_local is Some((registration, _, _, _)) {
    registrations.push((registration, ()))
  }
  if with_reference_compute is Some((registration, _, _, _)) {
    registrations.push((registration, ()))
  }
  match
    @connector.install_capability_implementations(
      registry, registrations, max_entries,
    ) {
    Err(issue) => return Err(installation_issue(issue))
    Ok(_) => ()
  }
  let installed_duckdb = match with_duckdb {
    None => None
    Some((registration, configuration, dispatch_issue, estimate_issue)) =>
      match
        @binding3.configure_duckdb_compute(
          driver, registry, registration, configuration,
        ) {
        Ok(installed) => Some((installed, dispatch_issue, estimate_issue))
        Err(issue) => return Err(dispatch_issue(issue))
      }
  }
  let installed_local = match with_local {
    None => None
    Some((registration, configuration, dispatch_issue, estimate_issue)) =>
      match
        @binding4.configure_local_compute(
          driver, registry, registration, configuration,
        ) {
        Ok(installed) => Some((installed, dispatch_issue, estimate_issue))
        Err(issue) => return Err(dispatch_issue(issue))
      }
  }
  let installed_reference_compute = match with_reference_compute {
    None => None
    Some((registration, configuration, dispatch_issue, estimate_issue)) =>
      match
        @binding5.configure_numeric_compute(
          driver, registry, registration, configuration,
        ) {
        Ok(installed) => Some((installed, dispatch_issue, estimate_issue))
        Err(issue) => return Err(dispatch_issue(issue))
      }
  }
  let contributions = match
    assemble_compute_contributions(
      registry,
      max_entries,
      with_duckdb=installed_duckdb,
      with_local=installed_local,
      with_reference_compute=installed_reference_compute,
    ) {
    Ok(value) => value
    Err(issue) => return Err(installation_issue(issue))
  }
  Ok({
    driver,
    installed_duckdb,
    installed_local,
    installed_reference_compute,
    contributions,
  })
}

