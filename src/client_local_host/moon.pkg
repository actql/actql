supported_targets = "+js+wasm+native"

import {
  "actql/actql/client_source_publication" @source_publication,
  "actql/actql/expression_typing" @typing,
  "actql/actql/encode_core" @encode,
  "actql/actql/stage_syntax" @syntax,
  "actql/actql/decode_core" @decode,
  "actql/actql/program_check" @checked,
  "actql/actql/pipeline_check_context" @context,
  "actql/actql/check_environment" @environment,
  "actql/actql/relation_results" @results,
  "actql/actql/relation_schema" @schema,
  "actql/actql/value_contract" @contract,
  "actql/actql/connectors_builtin" @builtin,
  "actql/actql/physical_host" @host_driver,
  "actql/actql/physical_strategy" @strategy,
  "actql/actql/physical_resources" @resources,
  "actql/actql/execution_query" @query,
  "actql/actql/execution_relation" @execution,
  "actql/actql/value_admission" @admitted,
  "actql/actql/connector_sdk" @connector,
  "actql/actql/run_publication_host" @publication_host,
  "actql/actql/run_publication" @publication,
  "actql/actql/connectors/local/driver" @local_driver,
  "actql/actql/connectors/local",
  "actql/actql/physical_cost" @cost,
  "actql/actql/canonical_json" @identity,
  "actql/actql/canonical_value" @canonical,
  "actql/actql/lowering_relation" @lower,
  "actql/actql/pipeline_typing" @pipeline,
  "actql/actql/bounded_execution" @bounded,
  "actql/actql/query_planning" @planning,
  "actql/actql/sourceview_resolution" @sourceviews,
  "actql/actql/connectors/duckdb/acquisition" @duckdb_query,
  "actql/actql/connectors/duckdb/host" @duckdb_host,
  "actql/actql/client_row_source_host" @row_source_host,
  "moonbitlang/core/json",
}

import {
  "actql/actql/local_veca_provider" @nearest_provider,
  "actql/actql/source_frontend" @frontend,
  "actql/actql/source_value" @source,
  "actql/actql/sha256" @sha,
  "moonbitlang/core/encoding/utf8",
} for "wbtest"

options(
  targets: {
    "preparation_publication_custody_wbtest.mbt": [ "js" ],
    "preparation_publication_snapshot_wbtest.mbt": [ "js" ],
    "preparation_publication_start_custody_wbtest.mbt": [ "js" ],
    "preparation_publication_validation_custody_wbtest.mbt": [ "js" ],
    "installed_effect_operation_parent_js_wbtest.mbt": [ "js" ],
    "installed_capture_parent_js_wbtest.mbt": [ "js" ],
  },
)
