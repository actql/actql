///|
/// Fixed control peak for the selected one-Values, one-direct-Result compiler
/// issuer call graph. Source guard records each function and bounded repetition;
/// this counts allocated success/failure carriers, NOT local variables or VM
/// frames. Row/cell, canonical/parser, writer, schema and metadata collections
/// have their own constructor projections.
///
/// Each guarded constructor site has an envelope for a result/option wrapper
/// (1H,1R,1W), typed issue payload (1H,1R,1W), and largest returned tuple with
/// at most four refs/two scalar slots (1H,4R,2W): total (3H,6R,4W).
/// Pattern sites and unreachable alternative branches are explicit conservative
/// slack. The nine metadata parsed children bound the four parse-array calls;
/// witness scopes are three and row/byte facts two. Per-field loops retain no
/// carrier wrappers between iterations; owned outputs are separately priced.
/// No borrowed text backing or shared semantic owner is charged again here.
let compilation_call_control_original : PreparationRepresentationUnits = {
  record_headers: 549L * 3L,
  reference_slots: 549L * 6L,
  scalar_words: 549L * 4L,
  owned_utf16_units: 0L,
  owned_wire_bytes: 0L,
}

///|
fn closed_values_compilation_call_controls() -> PreparationRepresentationUnits {
  compilation_call_control_original
}
