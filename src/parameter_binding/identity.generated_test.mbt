///|
test "parameter identity: escaped-utf16-field-order" {
  let value = identity_ready("{\"v\":{\"type\":\"object\",\"fields\":{\"!first\":{\"type\":\"number\"},\"$actql_value\":{\"type\":\"string\"},\"\u{1f600}\":{\"type\":\"string\",\"format\":\"duration\"},\"\u{e000}\":{\"type\":\"decimal\",\"precision\":2,\"scale\":1}}}}", "{\"v\":{\"\u{e000}\":\"1.2\",\"\u{1f600}\":\"1S\",\"$actql_value\":\"data\",\"!first\":7}}")
  assert_eq(@parameter_binding.stringify_values(value, 282, 29, 9), "{\"values\":{\"v\":{\"$actql_value\":[\"object\",[[\"!first\",7],[\"$actql_value\",\"data\"],[\"\u{1f600}\",{\"$actql_value\":[\"duration\",1000]}],[\"\u{e000}\",{\"$actql_value\":[\"decimal\",{\"coefficient\":\"12\",\"precision\":2,\"scale\":1,\"version\":\"aoa-decimal-value/0.1\"}]}]]]}},\"version\":\"actql-parameter-values/0.1\"}")
  assert_eq(@parameter_binding.parameter_values_cid(value, 282, 29, 9), "sha256:06091873311e70b5c62e57e7b7546d5cd38573be05506cb866a313163288d039")
  assert_eq(@parameter_binding.measure_values(value, 282, 29, 9), 282)
  assert_true(try { ignore(@parameter_binding.parameter_values_cid(value, 281, 29, 9)); false } catch { @encode.OutputLimit => true; _ => false })
  assert_true(try { ignore(@parameter_binding.parameter_values_cid(value, 282, 28, 9)); false } catch { @encode.OutputLimit => true; _ => false })
  assert_true(try { ignore(@parameter_binding.parameter_values_cid(value, 282, 29, 8)); false } catch { @encode.OutputLimit => true; _ => false })
}
