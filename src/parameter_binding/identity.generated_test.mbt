  assert_true(try { ignore(@parameter_binding.parameter_values_cid(value, 121, 10, 4)); false } catch { @encode.OutputLimit => true; _ => false })
}

///|
test "parameter identity: dates-remain-text" {
  let value = identity_ready("{\"d\":{\"type\":\"date\"},\"t\":{\"type\":\"timestamp\"}}", "{\"d\":\"0000-02-29\",\"t\":\"2000-02-29T12:34:56.789Z\"}")
