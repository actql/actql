        0x6ecf9ec583bdc706UL, 0xeb6dedcc6b0fe113UL, 0x11103132b9cf541cUL, 0x0dab27343efebd19UL,
      ),
    ] {
    exponent += 1
    if exponent > 0 {
      power *= @bigint.BigInt::from_int(5)
    }
    for
      (inverse, hi, lo) in [
        (false, positive_hi, positive_lo),
        (true, negative_hi, negative_lo),
      ] {
      if !inverse || exponent > 0 {
        let actual = decimal_power_pair(power, inverse).unwrap()
        assert_eq(actual.hi.reinterpret_as_uint64(), hi)
        assert_eq(actual.lo.reinterpret_as_uint64(), lo)
      }
    }
  }
