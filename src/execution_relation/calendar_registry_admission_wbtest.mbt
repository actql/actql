///|
// This input is the declared Calendar-extended registry, independently of
// the generated runtime selection constant. It is never product output.
test "Calendar registration reaches original exact registry admission" {
  let candidate = @identity.from_json(
    @json.parse(
      "{\n  \"REL.select\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"REL.where\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"REL.assert_all\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"REL.assert_unique\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"REL.derive\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"relation\",\n    \"execution_extensions\": {\n      \"ordered_bindings\": {\n        \"file\": \"spec/contracts/actql-aoa.json\",\n        \"pointer\": \"/execution_contracts/REL.derive.ordered\",\n        \"cid\": \"sha256:00a8fa5a08e8d02ef2e2864deb77be1b6a637d0f7f78d7cfa7b5ec9555573b29\"\n      }\n    }\n  },\n  \"REL.orderByStable\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"REL.limit\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"REL.topk\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"REL.window.fixed\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"REL.window.sliding\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"REL.window.project\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"REL.window.lag\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"REL.watermark\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"REL.pivot\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"REL.unpivot\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"REL.unnest\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"REL.dedupeRows\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"REL.json.pick\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"REL.join\": {\n    \"inputs\": [\n      \"relation\",\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"REL.groupBy\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"REL.distinct\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"REL.unionAll\": {\n    \"inputs\": [\n      \"relation\",\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"REL.except_rows\": {\n    \"inputs\": [\n      \"relation\",\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"REL.intersect_rows\": {\n    \"inputs\": [\n      \"relation\",\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"REL.cross_join\": {\n    \"inputs\": [\n      \"relation\",\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"REL.topk_partitioned\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"REL.analytic\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"SGA.normalize\": {\n    \"inputs\": [\n      \"graph\"\n    ],\n    \"output\": \"graph\"\n  },\n  \"SGA.reachable\": {\n    \"input_alternatives\": [\n      [\n        \"graph\"\n      ],\n      [\n        \"graph\",\n        \"relation\"\n      ]\n    ],\n    \"output\": \"relation\"\n  },\n  \"SGA.bounds_check\": {\n    \"inputs\": [\n      \"graph\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"SGA.degree_metrics\": {\n    \"inputs\": [\n      \"graph\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"SGA.apply_delta\": {\n    \"inputs\": [\n      \"graph\",\n      \"relation\"\n    ],\n    \"output\": \"graph\"\n  },\n  \"SGA.diff\": {\n    \"inputs\": [\n      \"graph\",\n      \"graph\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"SGA.graft\": {\n    \"inputs\": [\n      \"graph\",\n      \"graph\"\n    ],\n    \"output\": \"graph\"\n  },\n  \"SGA.union_structural\": {\n    \"finite_inputs\": {\n      \"repeated_input\": \"graph\",\n      \"minimum_inputs\": 2\n    },\n    \"output\": \"graph\"\n  },\n  \"SGA.diff_structural\": {\n    \"inputs\": [\n      \"graph\",\n      \"graph\"\n    ],\n    \"output\": \"graph\"\n  },\n  \"SGA.match_nodes\": {\n    \"inputs\": [\n      \"graph\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"SGA.match_edges\": {\n    \"inputs\": [\n      \"graph\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"SGA.traverse\": {\n    \"input_alternatives\": [\n      [\n        \"graph\"\n      ],\n      [\n        \"graph\",\n        \"relation\"\n      ]\n    ],\n    \"output\": \"relation\"\n  },\n  \"SGA.shortest_path\": {\n    \"input_alternatives\": [\n      [\n        \"graph\"\n      ],\n      [\n        \"graph\",\n        \"relation\"\n      ],\n      [\n        \"graph\",\n        \"relation\",\n        \"relation\"\n      ]\n    ],\n    \"output\": \"relation\"\n  },\n  \"SGA.components\": {\n    \"inputs\": [\n      \"graph\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"SGA.subgraph\": {\n    \"input_alternatives\": [\n      [\n        \"graph\"\n      ],\n      [\n        \"graph\",\n        \"relation\"\n      ]\n    ],\n    \"output\": \"graph\"\n  },\n  \"SGA.equal\": {\n    \"inputs\": [\n      \"graph\",\n      \"graph\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"SGA.mean_structural\": {\n    \"finite_inputs\": {\n      \"repeated_input\": \"graph\",\n      \"minimum_inputs\": 1\n    },\n    \"output\": \"graph\"\n  },\n  \"TEA.window.fixed_label\": {\n    \"inputs\": [\n      \"event_stream\"\n    ],\n    \"output\": \"event_stream\"\n  },\n  \"TEA.window.sliding_assign\": {\n    \"inputs\": [\n      \"event_stream\"\n    ],\n    \"output\": \"event_stream\"\n  },\n  \"TEA.watermark.label\": {\n    \"inputs\": [\n      \"event_stream\"\n    ],\n    \"output\": \"event_stream\"\n  },\n  \"TEA.window.session_assign\": {\n    \"inputs\": [\n      \"event_stream\"\n    ],\n    \"output\": \"event_stream\"\n  },\n  \"TEA.dedupe\": {\n    \"inputs\": [\n      \"event_stream\"\n    ],\n    \"output\": \"event_stream\"\n  },\n  \"TEA.join.asof\": {\n    \"inputs\": [\n      \"event_stream\",\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"TEA.sequence.match\": {\n    \"inputs\": [\n      \"event_stream\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"TEA.time_series\": {\n    \"inputs\": [],\n    \"output\": \"relation\"\n  },\n  \"TEA.join.interval\": {\n    \"inputs\": [\n      \"relation\",\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"VEC.normalize_l2\": {\n    \"inputs\": [\n      \"vector_set\"\n    ],\n    \"output\": \"vector_set\"\n  },\n  \"VEC.score_sort\": {\n    \"inputs\": [\n      \"vector_set\"\n    ],\n    \"output\": \"vector_set\"\n  },\n  \"VEC.knn_join\": {\n    \"inputs\": [\n      \"vector_set\",\n      \"vector_set\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"VEC.pool\": {\n    \"inputs\": [\n      \"vector_set\"\n    ],\n    \"output\": \"vector_set\"\n  },\n  \"VEC.merge_rankings\": {\n    \"policy_inputs\": {\n      \"max\": {\n        \"inputs\": [\n          \"relation\",\n          \"relation\"\n        ]\n      },\n      \"weighted_sum\": {\n        \"inputs\": [\n          \"relation\",\n          \"relation\"\n        ]\n      },\n      \"rrf\": {\n        \"repeated_input\": \"relation\",\n        \"minimum_inputs\": 2\n      }\n    },\n    \"output\": \"relation\"\n  },\n  \"BRIDGE.graph.to_edge_rows\": {\n    \"inputs\": [\n      \"graph\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"BRIDGE.graph.to_node_rows\": {\n    \"inputs\": [\n      \"graph\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"BRIDGE.rows.to_graph\": {\n    \"finite_inputs\": {\n      \"repeated_input\": \"relation\",\n      \"minimum_inputs\": 0\n    },\n    \"output\": \"graph\",\n    \"execution_contract\": {\n      \"file\": \"spec/contracts/actql-aoa.json\",\n      \"pointer\": \"/execution_contracts/BRIDGE.rows.to_graph\",\n      \"cid\": \"sha256:0979999a64bb47f7fcb0d113c0bbcab592ad0a268b548a8776f8fac4fd6f6d84\"\n    }\n  },\n  \"BRIDGE.events.to_rows\": {\n    \"inputs\": [\n      \"event_stream\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"BRIDGE.rows.to_events\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"event_stream\"\n  },\n  \"BRIDGE.vectors.to_rows\": {\n    \"inputs\": [\n      \"vector_set\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"BRIDGE.rows.to_vectors\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"vector_set\"\n  },\n  \"EFFECT.plan\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"relation\"\n  },\n  \"REL.values\": {\n    \"inputs\": [],\n    \"output\": \"relation\",\n    \"execution_contract\": {\n      \"file\": \"spec/contracts/actql-aoa.json\",\n      \"pointer\": \"/execution_contracts/REL.values\",\n      \"cid\": \"sha256:96c7925a693801dcb3bce9f3e2da9b4fd9ed39e517af90cbac0e1adbee5ad2ae\"\n    }\n  },\n  \"ACTQL.expression_fragment/0.1\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"relation\",\n    \"execution_contract\": {\n      \"file\": \"spec/contracts/actql-aoa.json\",\n      \"pointer\": \"/execution_contracts/ACTQL.expression_fragment~10.1\",\n      \"cid\": \"sha256:ced7ee00f232f8d5bcfde44dfc769d9d6ae02c8386e54db7d844d43f922bac90\"\n    }\n  },\n  \"TEA.calendar.bucket\": {\n    \"inputs\": [\n      \"relation\"\n    ],\n    \"output\": \"relation\",\n    \"execution_contract\": {\n      \"file\": \"spec/contracts/actql-aoa.json\",\n      \"pointer\": \"/execution_contracts/TEA.calendar.bucket\",\n      \"cid\": \"sha256:8cbb70e4edcd1dd29deee777b44b3f09b9cee337b5495944ca895fa3065b6227\"\n    }\n  },\n  \"TEA.calendar.series\": {\n    \"inputs\": [],\n    \"output\": \"relation\",\n    \"execution_contract\": {\n      \"file\": \"spec/contracts/actql-aoa.json\",\n      \"pointer\": \"/execution_contracts/TEA.calendar.series\",\n      \"cid\": \"sha256:8070a5fa9b6177df0d407b474a2b34aff2ecde9cf9c5b726191f7bd908a4dc83\"\n    }\n  }\n}",
    ),
    10000,
    100,
    100000,
  )
  assert_eq(
    @identity.cid_value(candidate, 100000, 10000, 100),
    "sha256:204fd80c64c2bff246015f06ae50d0044aa566f197922f14cd15ecf0b3285fdb",
  )
  let accepted = admit_relation_registry(
    candidate,
    registered_values(),
    registry_limits(),
  ).unwrap()
  assert_eq(
    accepted.registry_cid,
    "sha256:204fd80c64c2bff246015f06ae50d0044aa566f197922f14cd15ecf0b3285fdb",
  )
}

