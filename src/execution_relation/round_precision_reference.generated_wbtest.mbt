        0x671a31d81ff2969fUL, -174.0, 0x671a31d81ff296a7UL, 0x671a31d81ff29697UL,
        false,
      ),
      (
        0x8a0b893a5be305c3UL, 268.0, 0x8a0b893a5c03473bUL, 0x8a0b893a5a5ca483UL,
        false,
      ),
      (
        0x9b964820b9770a10UL, 180.0, 0x9b96482852a80133UL, 0x9b964817b98d6538UL,
        false,
      ),
      (
        0xf88ff953dc218442UL, -274.0, 0x0000000000000000UL, 0x0000000000000000UL,
        false,
      ),
      (
        0x738bc453de8604fbUL, -233.0, 0x738bc453de8604faUL, 0x738bc453de8604faUL,
        false,
