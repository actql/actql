        false,
      ),
      (
        0x36b4b6276683b27bUL, 219.0, 0x36b4b6276683b27bUL, 0x36b4b6276683b27bUL,
        false,
      ),
      (
        0xa722314394b35975UL, -58.0, 0x0000000000000000UL, 0x0000000000000000UL,
        false,
      ),
      (
        0x8d5139cec77e9803UL, -70.0, 0x0000000000000000UL, 0x0000000000000000UL,
        false,
      ),
      (
        0x07d9efabb8df67bdUL, -36.0, 0x0000000000000000UL, 0x0000000000000000UL,
        false,
      ),
      (
        0xfc1e4e65e1f4fe6eUL, -76.0, 0xfc1e4e65e1f4fe6eUL, 0xfc1e4e65e1f4fe6eUL,
        false,
      ),
    ] {
    let value = Number(input.reinterpret_as_double())
    if overflow {
      assert_true(
        binary(@lower.RoundAt, value, Number(digits)) is Err(ArithmeticFailure),
      )
    } else {
      guard binary(@lower.RoundAt, value, Number(digits)) is Ok(Number(actual)) else {
        fail("reference ROUND")
      }
      assert_eq(actual.reinterpret_as_uint64(), rounded)
    }
    guard binary(@lower.TruncAt, value, Number(digits)) is Ok(Number(actual)) else {
      fail("reference TRUNC")
    }
    assert_eq(actual.reinterpret_as_uint64(), truncated)
  }
}

