        0x76c07de1dcc3ce17UL, -266.0, 0x0000000000000000UL, 0x0000000000000000UL,
        false,
      ),
    ] {
    let value = Number(input.reinterpret_as_double())
    if overflow {
      assert_true(
        binary(@lower.RoundAt, value, Number(digits)) is Err(ArithmeticFailure),
      )
    } else {
      guard binary(@lower.RoundAt, value, Number(digits)) is Ok(Number(actual)) else {
        fail("reference ROUND")
      }
      assert_eq(actual.reinterpret_as_uint64(), rounded)
    }
    guard binary(@lower.TruncAt, value, Number(digits)) is Ok(Number(actual)) else {
      fail("reference TRUNC")
    }
    assert_eq(actual.reinterpret_as_uint64(), truncated)
  }
}

