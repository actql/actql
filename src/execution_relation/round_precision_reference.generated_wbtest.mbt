      ),
      (
        0xbea3e7a6941cf01cUL, 23.0, 0xbea3e7a6941cf01cUL, 0xbea3e7a6941cf01cUL, false,
      ),
      (
        0x3e89e7a6941cf01aUL, 23.0, 0x3e89e7a6941cf01aUL, 0x3e89e7a6941cf01aUL, false,
      ),
      (
        0xbe89e7a6941cf01aUL, 23.0, 0xbe89e7a6941cf01aUL, 0xbe89e7a6941cf01aUL, false,
      ),
      (
        0x3e89e7a6941cf01bUL, 23.0, 0x3e89e7a6941cf01bUL, 0x3e89e7a6941cf01bUL, false,
      ),
      (
        0xbe89e7a6941cf01bUL, 23.0, 0xbe89e7a6941cf01bUL, 0xbe89e7a6941cf01bUL, false,
      ),
      (
        0x3e89e7a6941cf01cUL, 23.0, 0x3e89e7a6941cf01cUL, 0x3e89e7a6941cf01cUL, false,
      ),
      (
        0xbe89e7a6941cf01cUL, 23.0, 0xbe89e7a6941cf01cUL, 0xbe89e7a6941cf01cUL, false,
      ),
    ] {
    let value = Number(input.reinterpret_as_double())
    if overflow {
      assert_true(
        binary(@lower.RoundAt, value, Number(digits)) is Err(ArithmeticFailure),
      )
    } else {
      guard binary(@lower.RoundAt, value, Number(digits)) is Ok(Number(actual)) else {
        fail("reference ROUND")
      }
      assert_eq(actual.reinterpret_as_uint64(), rounded)
    }
    guard binary(@lower.TruncAt, value, Number(digits)) is Ok(Number(actual)) else {
      fail("reference TRUNC")
    }
    assert_eq(actual.reinterpret_as_uint64(), truncated)
  }
}

