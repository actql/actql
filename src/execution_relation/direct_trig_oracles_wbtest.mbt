///|
test "direct trig MPFR frozen atan2 controls" {
  for
    (first, second, lower, upper) in [
      (1.0, 1.0, 0.7853981633974481, 0.7853981633974486),
      (1.0, -1.0, 2.356194490192344, 2.356194490192346),
      (-1.0, -1.0, -2.356194490192346, -2.356194490192344),
      (-1.0, 1.0, -0.7853981633974486, -0.7853981633974481),
      (1.0, 2.0, 0.463647609000806, 0.46364760900080626),
      (2.0, 1.0, 1.10714871779409, 1.107148717794091),
      (1.0, 0.0, 1.5707963267948961, 1.5707963267948972),
      (-1.0, 0.0, -1.5707963267948972, -1.5707963267948961),
      (0.0, -1.0, 3.1415926535897922, 3.1415926535897944),
      (5.0e-324, 1.7976931348623157e308, 0.0, 0.0),
      (-5.0e-324, 1.7976931348623157e308, 0.0, 0.0),
      (1.7976931348623157e308, 5.0e-324, 1.5707963267948961, 1.5707963267948972),
      (
        1.7976931348623157e308, -5.0e-324, 1.5707963267948961, 1.5707963267948972,
      ),
      (
        -1.7976931348623157e308, 5.0e-324, -1.5707963267948972, -1.5707963267948961,
      ),
      (
        -1.7976931348623157e308, -5.0e-324, -1.5707963267948972, -1.5707963267948961,
      ),
      (
        1.7976931348623157e308, 1.7976931348623157e308, 0.7853981633974481, 0.7853981633974486,
      ),
      (
        -1.7976931348623157e308, 1.7976931348623157e308, -0.7853981633974486, -0.7853981633974481,
      ),
      (5.0e-324, 5.0e-324, 0.7853981633974481, 0.7853981633974486),
      (5.0e-324, -5.0e-324, 2.356194490192344, 2.356194490192346),
      (-5.0e-324, -5.0e-324, -2.356194490192346, -2.356194490192344),
      (-5.0e-324, 5.0e-324, -0.7853981633974486, -0.7853981633974481),
    ] {
    guard binary(@lower.Atan2, Number(first), Number(second))
      is Ok(Number(actual)) else {
      fail("atan2 unexpectedly refused a finite-domain result")
    }
    assert_true(actual >= lower && actual <= upper)
  }
}
