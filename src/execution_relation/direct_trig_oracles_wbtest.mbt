// Generated only from independent directed MPFR oracles.
// See scripts/generate-direct-trig-oracles.py; never derive expectations from product output.
// Two adjacent values per side are fixed test tolerance, not a universal accuracy law.

///|
test "direct trig MPFR frozen sin controls" {
  for
    (input, lower, upper) in [
      (0.5, 0.47942553860420284, 0.4794255386042031),
      (-0.5, -0.4794255386042031, -0.47942553860420284),
      (1.0, 0.8414709848078963, 0.8414709848078968),
      (-1.0, -0.8414709848078968, -0.8414709848078963),
      (1.5707963267948963, 0.9999999999999997, 1.0000000000000004),
      (1.5707963267948966, 0.9999999999999997, 1.0000000000000004),
      (1.5707963267948968, 0.9999999999999997, 1.0000000000000004),
      (1.0e20, -0.6452512852657811, -0.6452512852657806),
      (-1.0e20, 0.6452512852657806, 0.6452512852657811),
      (1.0e100, -0.3806377310050288, -0.3806377310050285),
      (-1.0e100, 0.3806377310050285, 0.3806377310050288),
      (1.0e300, -0.8178819121159089, -0.8178819121159083),
      (-1.0e300, 0.8178819121159083, 0.8178819121159089),
      (1.7976931348623157e308, 0.0049619547891840594, 0.004961954789184064),
      (-1.7976931348623157e308, -0.004961954789184064, -0.0049619547891840594),
    ] {
    guard unary(@lower.Sin, Number(input)) is Ok(Number(actual)) else {
      fail("sin unexpectedly refused a finite-domain result")
    }
    assert_true(actual >= lower && actual <= upper)
  }
}

