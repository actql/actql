    registered_relation_contracts(),
    prepared_sequence(owner),
    [],
    ["select_3"],
    run_limits(),
    { remaining: 100000, max_frames: 100, },
  ).unwrap()
  assert_eq(result.next, 4)
  let table = result.tables[3].unwrap().table
  assert_eq(table.names, ["x"])
  assert_eq(table.rows.length(), 2)
  assert_eq(table.rows[0].length(), 1)
  assert_true(table.rows[0][0] is Number(1.0))
  assert_eq(table.rows[1].length(), 1)
  assert_true(table.rows[1][0] is Number(2.0))
}

