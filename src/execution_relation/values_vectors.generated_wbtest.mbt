test "values four-operation execution: temporal-vector" {
  let owner = bound_pipeline(
    "[{\"values\":{\"schema\":{\"d\":{\"type\":\"date\",\"nullable\":false},\"t\":{\"type\":\"timestamp\",\"nullable\":false},\"v\":{\"type\":\"vector\",\"nullable\":false,\"dimensions\":2}},\"rows\":[{\"d\":{\"literal\":\"0000-02-29\"},\"t\":{\"literal\":\"2000-02-29T12:30:00.000Z\"},\"v\":{\"literal\":[0.1,2]}}]},\"as\":\"seed\"},{\"derive\":{}},{\"filter\":\"true\"},{\"select\":[\"v\",\"t\",\"d\"]}]",
  )
  let result = evaluate_sequence_components(
    registered_relation_contracts(),
    prepared_sequence(owner),
    [],
    ["select_3"],
    run_limits(),
    { remaining: 100000, max_frames: 100, },
  ).unwrap()
  assert_eq(result.next, 4)
  let table = result.tables[3].unwrap().table
  assert_eq(table.names, ["v", "t", "d"])
  assert_eq(table.rows.length(), 1)
  assert_eq(table.rows[0].length(), 3)
  guard table.rows[0][0] is Captured(v27) else { fail("structured cell") }
  guard v27 is @admitted.Vector(items28) else { fail("Vector") }
  assert_eq(@admitted.element_count(items28), 2)
  let item29 = @admitted.element_at(items28, 0).unwrap()
  assert_eq(item29, 0.1)
  let item30 = @admitted.element_at(items28, 1).unwrap()
  assert_eq(item30, 2.0)
  guard table.rows[0][1] is Captured(v31) else { fail("structured cell") }
  assert_true(v31 is @admitted.Timestamp("2000-02-29T12:30:00.000Z"))
  guard table.rows[0][2] is Captured(v32) else { fail("structured cell") }
  assert_true(v32 is @admitted.Date("0000-02-29"))
}
