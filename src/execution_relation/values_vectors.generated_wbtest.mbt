test "values four-operation execution: ordinary" {
  let owner = bound_pipeline(
    "[{\"values\":{\"schema\":{\"x\":{\"type\":\"number\",\"nullable\":false}},\"rows\":[{\"x\":{\"literal\":1}},{\"x\":{\"literal\":2}}]},\"as\":\"seed\"},{\"derive\":{}},{\"filter\":\"true\"},{\"select\":[\"x\"]}]",
  )
