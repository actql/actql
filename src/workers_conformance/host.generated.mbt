pub fn async_strategy_host_task(
  task : @host_driver.PreparedTaskDispatch,
) -> Int {
  @host_driver.prepared_task_index(task)
}

///|
#export_name("asyncStrategyHostTaskCapacity")
pub fn async_strategy_host_task_capacity(
  host : @probe.ConfiguredComputeHost[@strategy.RunIssue],
  task : Int,
) -> Array[Int64] raise AsyncHostFailure {
  guard @strategy.strategy_task_envelope(
      @host_driver.dispatch_driver_run(@probe.configured_host_driver(host)),
      task,
    )
    is Some(capacity) else {
    raise InvalidCommand
  }
  [capacity.retained_bytes, capacity.execution_bytes]
}

///|
#export_name("asyncStrategyHostRegistration")
pub fn async_strategy_host_registration(
  task : @host_driver.PreparedTaskDispatch,
) -> @connector.CapabilityRegistration? {
  Some(@host_driver.prepared_task_registration(task))
}

///|
#export_name("asyncStrategyHostTaskCompleted")
pub fn async_strategy_host_task_completed(
  host : @probe.ConfiguredComputeHost[@strategy.RunIssue],
  task : Int,
) -> Bool {
  @strategy.captured_task_completed(
    @host_driver.dispatch_driver_run(@probe.configured_host_driver(host)),
    task,
  )
}

///|
#export_name("asyncStrategyHostResident")
pub fn async_strategy_host_resident(
  task : @host_driver.PreparedTaskDispatch,
) -> Bool {
  async_strategy_host_resource_binding(task) is Some(_)
}

///|
#export_name("asyncStrategyHostRun")
pub fn async_strategy_host_run(
  host : @probe.ConfiguredComputeHost[@strategy.RunIssue],
) -> @strategy.CapturedDAG {
  @host_driver.dispatch_driver_run(@probe.configured_host_driver(host))
}

///|
#export_name("asyncStrategyHostResourceBinding")
pub fn async_strategy_host_resource_binding(
  task : @host_driver.PreparedTaskDispatch,
) -> @connector.ResourceBinding? {
  @strategy.strategy_resident_profile(
    @host_driver.prepared_task_revision(task),
    @host_driver.prepared_task_index(task),
  ).map(@strategy.resident_profile_resource_binding)
}

///|
#export_name("asyncStrategyHostResidentInputs")
pub fn async_strategy_host_resident_inputs(
  host : @probe.ConfiguredComputeHost[@strategy.RunIssue],
  task : Int,
) -> Array[Array[Int64]] raise AsyncHostFailure {
  guard @host_driver.compute_host_resident_inputs(
      @probe.configured_host_runtime(host),
      task,
    )
    is Some(inputs) else {
    raise InvalidCommand
  }
  inputs.map(input => {
    let (producer, bytes, entries, names) = input
    [producer.to_int64(), bytes, entries.to_int64(), names.to_int64()]
  })
}

///|
#export_name("asyncStrategyHostCount")
pub fn async_strategy_host_count(
  host : @probe.ConfiguredComputeHost[@strategy.RunIssue],
) -> Int {
  @strategy.graph_task_count(
    @strategy.captured_dag_graph(
      @host_driver.dispatch_driver_run(@probe.configured_host_driver(host)),
    ),
  )
}

///|
#export_name("asyncStrategyHostFinished")
pub fn async_strategy_host_finished(
  host : @probe.ConfiguredComputeHost[@strategy.RunIssue],
) -> Bool {
  let run = @host_driver.dispatch_driver_run(
    @probe.configured_host_driver(host),
  )
  for task in 1..<async_strategy_host_count(host) {
    if !@strategy.captured_task_completed(run, task) {
      return false
    }
  }
  true
}

///|
#export_name("asyncStrategyHostStop")
pub fn async_strategy_host_stop(
  host : @probe.ConfiguredComputeHost[@strategy.RunIssue],
) -> Unit {
  @host_driver.stop_dispatch_driver(@probe.configured_host_driver(host))
}

///|
#export_name("asyncStrategyHostCloseOutputs")
pub fn async_strategy_host_close_outputs(
  host : @probe.ConfiguredComputeHost[@strategy.RunIssue],
) -> Unit {
  let run = @host_driver.dispatch_driver_run(
    @probe.configured_host_driver(host),
  )
  for task = async_strategy_host_count(host) - 1; task > 0; task = task - 1 {
    @strategy.close_captured_task_output(run, task)
  }
}

///|
#export_name("asyncStrategyHostOutput")
pub fn async_strategy_host_output(
  host : @probe.ConfiguredComputeHost[@strategy.RunIssue],
  task : Int,
) -> @execution.CompletedOutput? {
  let run = @host_driver.dispatch_driver_run(
    @probe.configured_host_driver(host),
  )
  @strategy.captured_task_target(run, task).bind(target => {
    @strategy.captured_task_output(run, task, target)
  })
}

///|
#export_name("asyncStrategyHostExplain")
pub fn async_strategy_host_explain(
  host : @probe.ConfiguredComputeHost[@strategy.RunIssue],
  max_bytes : Int,
  max_nodes : Int,
) -> String raise AsyncHostFailure {
  let excluded = match
    @host_driver.compute_host_exclusions(
      @probe.configured_host_runtime(host),
      max_nodes,
    ) {
    Ok(value) => value
    Err(issue) => raise Diagnostics(issue)
  }
  match
    @strategy.explain_captured_strategy(
      @host_driver.dispatch_driver_run(@probe.configured_host_driver(host)),
      max_bytes,
      max_nodes,
      excluded~,
    ) {
    Ok(value) => value
    Err(issue) => raise Encoding(issue)
  }
}

///|
#export_name("asyncStrategyHostUsage")
pub fn async_strategy_host_usage(
  host : @probe.ConfiguredComputeHost[@strategy.RunIssue],
) -> Array[Int64] {
  let usage = @resources.ledger_usage(
    @strategy.captured_dag_ledger(
      @host_driver.dispatch_driver_run(@probe.configured_host_driver(host)),
    ),
  )
  [
    usage.planning_work.to_int64(),
    usage.attempts.to_int64(),
    usage.holdings.to_int64(),
    usage.transferred_bytes,
    usage.reserved_transfer_bytes,
    usage.held_bytes,
    usage.reserved_retention_bytes,
    usage.reserved_execution_bytes,
  ]
}

///|
/// Reserve one explicit representation transfer in the existing Run ledger.
/// Site discovery and binding are Host concerns; this handle owns only the
/// physical attempt, cumulative transfer, destination holding and cleanup.
#export_name("asyncStrategyHostTransferBegin")
pub fn async_strategy_host_transfer_begin(
  host : @probe.ConfiguredComputeHost[@strategy.RunIssue],
  source_task : Int,
  transfer_bytes : Int64,
  retained_bytes : Int64,
  execution_bytes : Int64,
) -> @strategy.ManagedTransfer raise AsyncHostFailure {
  match
    @strategy.begin_captured_managed_transfer(
      @host_driver.dispatch_driver_run(@probe.configured_host_driver(host)),
      source_task,
      transfer_bytes,
      retained_bytes,
      execution_bytes,
    ) {
    Ok(value) => value
    Err(issue) => raise Execution(issue)
  }
}

///|
#export_name("asyncStrategyHostTransferCharge")
pub fn async_strategy_host_transfer_charge(
  host : @probe.ConfiguredComputeHost[@strategy.RunIssue],
  transfer : @strategy.ManagedTransfer,
  bytes : Int64,
) -> Unit raise AsyncHostFailure {
  match
    @strategy.charge_captured_managed_transfer(
      @host_driver.dispatch_driver_run(@probe.configured_host_driver(host)),
      transfer,
      bytes,
    ) {
    Ok(_) => ()
    Err(issue) => raise Execution(@strategy.Physical(issue))
  }
}

