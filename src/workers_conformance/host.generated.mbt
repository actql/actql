///|
#export_name("asyncStrategyModule_reference_compute_Dispatch")
pub fn reference_compute_dispatch(
  setup : @probe.ConfiguredComputeHost[@strategy.RunIssue],
  task : @host_driver.PreparedTaskDispatch,
  completion_ready : () -> Bool,
) -> Unit raise AsyncHostFailure {
  match
    @probe.dispatch_reference_compute_with_completion_admission(
      @probe.configured_host_modules(setup),
      @host_driver.compute_host_dispatch(@probe.configured_host_runtime(setup)),
      task,
      completion_ready,
    ) {
    Ok(value) => value
    Err(MissingImplementation) => raise InvalidCommand
    Err(Implementation(issue)) => raise Execution(issue)
  }
}

///|
#export_name("asyncStrategyModule_reference_compute_ManagedDispatch")
pub fn reference_compute_managed_dispatch(
  setup : @probe.ConfiguredComputeHost[@strategy.RunIssue],
  completed : Array[@execution.ManagedCompletedOutput[Int]],
  output_file_bytes : Int64,
) -> @numeric_driver.NumericManagedDispatchConfiguration[Int]? raise AsyncHostFailure {
  let obligations = match
    @strategy.captured_next_managed_obligations(
      @host_driver.dispatch_driver_run(@probe.configured_host_driver(setup)),
      @host_driver.compute_host_max_entries(
        @probe.configured_host_runtime(setup),
      ),
    ) {
    Ok(value) => value
    Err(_) => raise InvalidCommand
  }
  match
    @probe.dispatch_managed_reference_compute(
      @probe.configured_host_modules(setup),
      completed,
      obligations,
      output_file_bytes,
    ) {
    Ok(value) => value
    Err(MissingImplementation) => raise InvalidCommand
    Err(Implementation(issue)) => raise Execution(issue)
  }
}

