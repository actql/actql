///|
#export_name("asyncStrategyHostTransferPending")
pub fn async_strategy_host_transfer_pending(
  transfer : @strategy.ManagedTransfer,
) -> Bool {
  @strategy.captured_managed_transfer_pending(transfer)
}

///|
#export_name("asyncStrategyHostTransferReceipt")
pub fn async_strategy_host_transfer_receipt(
  receipt : @strategy.ManagedTransferReceipt,
) -> Array[Int64] {
  let (transferred, retained) = @strategy.captured_managed_transfer_receipt_bytes(
    receipt,
  )
  [
    @strategy.captured_managed_transfer_receipt_source(receipt).to_int64(),
    @strategy.captured_managed_transfer_receipt_attempt(receipt).to_int64(),
    transferred,
    retained,
    if @strategy.captured_managed_transfer_receipt_available(receipt) {
      1L
    } else {
      0L
    },
  ]
}

///|
#export_name("asyncStrategyModule_reference_compute_Registration")
pub fn reference_compute_registration(
  setup : @probe.ConfiguredComputeHost[@strategy.RunIssue],
) -> @connector.CapabilityRegistration {
  @numeric_driver.numeric_contribution_registration(
    @probe.configured_reference_compute_module(
      @probe.configured_host_modules(setup),
    ).unwrap(),
  )
}

///|
#export_name("asyncStrategyModule_reference_compute_Dispatch")
pub fn reference_compute_dispatch(
  setup : @probe.ConfiguredComputeHost[@strategy.RunIssue],
  task : @host_driver.PreparedTaskDispatch,
) -> Unit raise AsyncHostFailure {
  match
    @probe.dispatch_reference_compute(
      @probe.configured_host_modules(setup),
      @host_driver.compute_host_dispatch(@probe.configured_host_runtime(setup)),
      task,
    ) {
    Ok(value) => value
    Err(MissingImplementation) => raise InvalidCommand
    Err(Implementation(issue)) => raise Execution(issue)
  }
}

///|
#export_name("asyncStrategyModule_reference_compute_ManagedDispatch")
pub fn reference_compute_managed_dispatch(
  setup : @probe.ConfiguredComputeHost[@strategy.RunIssue],
  completed : Array[@execution.ManagedCompletedOutput[Int]],
  output_file_bytes : Int64,
) -> @numeric_driver.NumericManagedDispatchConfiguration[Int]? raise AsyncHostFailure {
  let obligations = match
    @strategy.captured_next_managed_obligations(
      @host_driver.dispatch_driver_run(@probe.configured_host_driver(setup)),
      @host_driver.compute_host_max_entries(
        @probe.configured_host_runtime(setup),
      ),
    ) {
    Ok(value) => value
    Err(_) => raise InvalidCommand
  }
  match
    @probe.dispatch_managed_reference_compute(
      @probe.configured_host_modules(setup),
      completed,
      obligations,
      output_file_bytes,
    ) {
    Ok(value) => value
    Err(MissingImplementation) => raise InvalidCommand
    Err(Implementation(issue)) => raise Execution(issue)
  }
}

///|
#export_name("asyncStrategyModule_reference_compute_ManagedDuration")
pub fn reference_compute_managed_duration(
  setup : @numeric_driver.NumericManagedDispatchConfiguration[Int],
) -> Int64? {
  @numeric_driver.numeric_managed_dispatch_duration(setup)
}

///|
#export_name("asyncStrategyModule_reference_compute_ManagedCapacity")
pub fn reference_compute_managed_capacity(
  setup : @numeric_driver.NumericManagedDispatchConfiguration[Int],
) -> (Int64, Int64)? {
  @numeric_driver.numeric_managed_dispatch_site_capacity(setup)
}

///|
#export_name("asyncStrategyModule_reference_compute_ManagedStart")
pub fn reference_compute_managed_start(
  setup : @numeric_driver.NumericManagedDispatchConfiguration[Int],
) -> @numeric_driver.NumericManagedDispatchOperations[Int] raise AsyncHostFailure {
  match @numeric_driver.start_numeric_managed_dispatch_node(setup) {
    Ok(value) => value
    Err(_) => raise InvalidCommand
  }
}
