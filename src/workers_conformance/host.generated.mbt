pub fn async_strategy_host_next(
  host : @probe.ConfiguredComputeHost[@strategy.RunIssue],
) -> @host_driver.PreparedTaskDispatch? raise AsyncHostFailure {
  match
    @host_driver.prepare_next_compute_task(
      @probe.configured_host_runtime(host),
      (),
    ) {
    Ok(value) => value
    Err(issue) => raise Dispatch(issue)
  }
}

