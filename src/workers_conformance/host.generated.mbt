  host : @probe.ConfiguredComputeHost[@strategy.RunIssue],
  task : Int,
) -> Array[Array[Int64]] raise AsyncHostFailure {
  guard @host_driver.compute_host_resident_inputs(
      @probe.configured_host_runtime(host),
      task,
    )
    is Some(inputs) else {
    raise InvalidCommand
  }
  inputs.map(input => {
    let (producer, bytes, entries, names) = input
    [producer.to_int64(), bytes, entries.to_int64(), names.to_int64()]
  })
}

