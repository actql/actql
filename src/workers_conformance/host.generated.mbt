pub fn async_strategy_host_output_export_cancel(
  value : AsyncStrategyHostOutputExport,
) -> Unit {
  match value.receipt {
    Some(receipt) => {
      @execution.cancel_completed_relation_export_receipt(receipt)
      value.receipt = None
      value.evidence = None
