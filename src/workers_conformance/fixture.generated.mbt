///|
/// Fixture owner: query_integration/query_sequence_wbtest.mbt
fn query_generated(
  owner : @lower.BoundPrepared,
  retained? : Array[String] = ["select_1"],
  prefix_end? : Int? = None,
) -> @execution.GeneratedSequence raise {
  let sequence = prepared_sequence(owner, prefix_end~)
  @execution.prepare_generated_sequence(
    registered_relation_contracts(),
    sequence,
    [sequence_fragment_context(sequence, 0, 10L)],
    retained,
    100000,
    10000,
  ).unwrap()
}

///|
/// Fixture owner: query_integration/query_guards_wbtest.mbt
fn query_guard_physical() -> @query.QueryGuardMeasureLimits {
  { max_work: 10000, max_bytes: 100000, max_nodes: 10000, max_depth: 100, }
}

///|
/// Fixture owner: query_integration/query_issuer_wbtest.mbt
fn query_issuer_attempt(
  issuer : @mock.MockQueryIssuer,
  sequence : @query.QuerySequence,
  route : @mock.QueryRealization,
  rows? : Array[String]? = None,
) -> @mock.MockQueryAttempt {
  let inputs = match rows {
    Some(rows) => rows.map(input_cursor)
    None =>
      [
        input_cursor("{\"id\":3}"),
        input_cursor("{\"id\":1}"),
        input_cursor("{\"id\":2}"),
      ]
  }
  @mock.prepare_issued_mock_query_attempt(
    issuer,
    strategy_for(sequence, route),
    inputs,
    inputs.length(),
  ).unwrap()
}

///|
/// Fixture owner: query_integration/query_issuer_wbtest.mbt
fn query_issuer_run(
  attempt : @mock.MockQueryAttempt,
  retention? : @mock.MockRetentionLimits = query_retention_limits(),
) -> Unit {
  @mock.execute_mock_query(
    attempt,
    mock_strategy_limits(),
    guard_measure=Some(query_guard_physical()),
  ).unwrap()
  |> ignore
  @mock.retain_mock_query(attempt, retention).unwrap() |> ignore
}

