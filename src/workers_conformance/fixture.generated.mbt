///|
/// Fixture owner: query_integration/physical_graph_wbtest.mbt
fn physical_graph_owners(
  program : @program_check.CheckedProgram,
) -> Array[@lower.BoundPrepared] {
  let identity = @program_check.source_identity(program)
  Array::makei(@program_check.unit_count(program), stage => {
    let pipeline = @program_check.unit_pipeline(program, stage).unwrap()
    let prepared = @lower.prepare(pipeline, {
      max_nodes: 100,
      max_references: 100,
      max_work: 100000,
      max_identifier_bytes: 10000,
    }).unwrap()
    let values = @parameter_refs.bound_values(
      @context.stage_identity_parameter_values(
        @context.program_identity_stage_at(identity, stage).unwrap(),
      ),
    )
    @lower.bind_parameters(
      prepared,
      Some(values),
      max_parameters=100,
      max_name_bytes=10000,
      expression_profiles=checked_expression_profile_admission(program),
    ).unwrap()
  })
}

///|
/// Fixture owner: query_integration/engine_fixtures_wbtest.mbt
fn prepared_sequence(
  owner : @lower.BoundPrepared,
  prefix_end? : Int? = None,
) -> @lower.PreparedSequence {
  let limits : @lower.SequenceLimits = {
    max_steps: 100,
    max_rows: 100,
    max_cells: 10000,
    max_bindings: 100,
    max_name_bytes: 10000,
    expressions: {
      max_nodes: 10000,
      max_work: 100000,
      max_depth: 100,
      max_literal_nodes: 10000,
      max_literal_text_bytes: 10000,
    },
  }
  match prefix_end {
    Some(last) => @lower.prepare_sequence_prefix(owner, last, limits).unwrap()
    None => @lower.prepare_sequence(owner, limits).unwrap()
  }
}

///|
/// Fixture owner: query_integration/join_graph_capacity_wbtest.mbt
// Integrity-valid authored capacity evidence for a fixed fixture operation.
// Application and ownership remain the formal checker's responsibility.
fn query_capacity_proof(
  law : String,
  value : Int64,
  derivation : String,
  inputs? : Array[String] = [],
  step? : Int = 0,
  unit? : String = "rows",
) -> @wire.ProgramProofClaim {
  let proof_inputs = inputs.copy()
  proof_inputs.sort()
  let input_text = proof_inputs.map(value => "\"" + value + "\"").join(",")
  let semantic_ref = "checked-step:" + step.to_string()
  let proof_body = "{\"inputs\":[" +
    input_text +
    "],\"law_id\":\"" +
    law +
    "\",\"semantic_ref\":\"" +
    semantic_ref +
    "\",\"unit\":\"" +
    unit +
    "\",\"value\":" +
    value.to_string() +
    ",\"version\":\"actql-bound-proof/0.1\"}"
  let proof_cid = "sha256:" + @sha.hex(@utf8.encode(proof_body))
  let dependencies = proof_inputs.copy()
  dependencies.push(proof_cid)
  dependencies.sort()
  let unique_dependencies : Array[String] = []
  for dependency in dependencies {
    if !unique_dependencies.contains(dependency) {
      unique_dependencies.push(dependency)
    }
  }
  let dependency_text = unique_dependencies
    .map(value => "\"" + value + "\"")
    .join(",")
  let prefix = "{\"dependencies\":[" +
    dependency_text +
    "],\"derivation\":" +
    derivation +
    ",\"law_id\":\"" +
    law +
    "\",\"role\":\"proven_upper_bound\",\"source\":{\"kind\":\"program\",\"proof_cid\":\"" +
    proof_cid +
    "\",\"semantic_ref\":\"" +
    semantic_ref +
    "\"},\"unit\":\"" +
    unit +
    "\",\"value\":" +
    value.to_string() +
    ",\"version\":\"actql-bound-witness/0.1\""
  let witness_cid = "sha256:" + @sha.hex(@utf8.encode(prefix + "}"))
  let limits : @wire.Limits = {
    max_bytes: 10000,
    max_nodes: 1000,
    max_depth: 30,
  }
  let witness = @wire.admit(
    @utf8.encode(prefix + ",\"witness_cid\":\"" + witness_cid + "\"}"),
    witness_cid,
    limits,
  ).unwrap()
  @wire.bind_program_proof(@utf8.encode(proof_body), witness, limits).unwrap()
}

