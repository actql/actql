///|
/// Fixture owner: query_integration/local_managed_sequence_wbtest.mbt
fn sequence_capacity_material(
  environment : @environment.WireEnvironment,
  input_proof : @wire.ProgramProofClaim,
  stage? : String = "matched",
  step? : Int = 0,
) -> @context.StageCapacityInput raise {
  let policy = @environment.capacity_policy(
    @environment.read_capacity(environment, {
      max_bytes: 10000,
      max_nodes: 1000,
      max_depth: 30,
    }).unwrap(),
  )
  let witnesses = []
  let artifacts = []
  let mut output_host_cid = ""
  for
    (field, unit, suffix) in [
      ("max_temporal_matches_per_key", "matches_per_key", "matches-per-key"),
      ("max_temporal_output_rows", "rows", "output"),
    ] {
    let host = @host.create(@capacity_policy.ceiling(policy, field).unwrap(), {
      max_bytes: 10000,
      max_nodes: 1000,
      max_depth: 30,
    }).unwrap()
    let writer = @encode.writer(10000, 1000, 30)
    @host.emit(host, writer)
    let host_text = @encode.finish(writer)
    let host_wire = @wire.admit(@utf8.encode(host_text), @host.cid(host), {
      max_bytes: 10000,
      max_nodes: 1000,
      max_depth: 30,
    }).unwrap()
    witnesses.push(host_wire)
    if suffix == "output" {
      output_host_cid = @wire.cid(host_wire)
    }
    let candidates = [host_text]
    let effective = @wire.value(host_wire)
    let body = "{\"author_guard_binding\":\"absent\",\"breach\":\"fail\",\"candidates\":[" +
      candidates.join(",") +
      "],\"effective_max\":" +
      effective.to_string() +
      ",\"enforcement\":\"engine_atomic\",\"subject_ref\":\"sequence:checked-step:" +
      step.to_string() +
      ":" +
      suffix +
      "\",\"unit\":\"" +
      unit +
      "\",\"version\":\"actql-resolved-limit/0.1\"}"
    let cid = "sha256:" + @sha.hex(@utf8.encode(body))
    artifacts.push(
      (
        @utf8.encode(
          body.replace(
            old="\"subject_ref\":",
            new="\"resolved_limit_cid\":\"" + cid + "\",\"subject_ref\":",
          ),
        ),
        cid,
      ),
    )
  }
  let output_proof = query_capacity_proof(
    "actql.bound.sequence-output",
    @wire.value(witnesses[1]),
    "{\"op\":\"source\"}",
    inputs=[output_host_cid],
    step~,
  )
  witnesses.push(@wire.program_proof_witness(input_proof))
  witnesses.push(@wire.program_proof_witness(output_proof))
  let mixed = @wire.check_mixed_claims(witnesses, artifacts, {
    max_entities: 10,
    max_references: 20,
    max_bytes: 10000,
    max_nodes: 1000,
    max_depth: 30,
  }).unwrap()
  let claims = @wire.check_mixed_program_claims(
    mixed,
    [input_proof, output_proof],
    { max_witnesses: 10, max_references: 20, },
  ).unwrap()
  let sources = @host.bind_claim_sources(claims, [policy], {
    max_entries: 10,
    max_bytes: 10000,
    max_nodes: 1000,
    max_depth: 30,
  }).unwrap()
  {
    stage,
    sources,
    uses: [
      Sequence(
        step~,
        matches=@wire.mixed_limit_at(mixed, 0).unwrap(),
        output=@wire.mixed_limit_at(mixed, 1).unwrap(),
      ),
    ],
  }
}

///|
/// Fixture owner: query_integration/engine_fixtures_wbtest.mbt
fn sequence_fragment_context(
  sequence : @lower.PreparedSequence,
  step : Int,
  rows : Int64,
) -> @execution.FragmentRuntimeContext raise {
  let logical : @lower.FragmentRowLimits = {
    max_input_rows: rows,
    max_value_bytes: 1000L,
    max_live_value_bytes: 10000L,
    max_work: 100000L,
  }
  let pipeline = @lower.prepare_fragment_pipeline(sequence, step, {
    max_roots: 100,
    max_pointer_bytes: 10000,
    max_work: 100000,
  }).unwrap()
  let ordered = match @lower.sequence_step(sequence, step) {
    Some(@lower.RowStep(kernel)) =>
      if @lower.kernel_body(kernel) is @lower.OrderedBindings(_) {
        Some(
          @execution.admit_ordered_contract(
            registered_relation_contracts(),
            registered_ordered(),
            registry_limits(),
          ).unwrap(),
        )
      } else {
        None
      }
    _ => None
  }
  let request = @lower.prepare_fragment_request(
    pipeline,
    10L,
    1000L,
    row_limits=if ordered is Some(_) { Some(logical) } else { None },
  ).unwrap()
  @execution.prepare_runtime_fragment(
    request,
    test_fragment_contract(),
    material_demands(),
    registry_limits(),
    logical,
    ordered~,
  ).unwrap()
}

///|
/// Fixture owner: query_integration/query_strategy_wbtest.mbt
fn strategy_estimates(
  values : Array[Int64?],
) -> Array[@cost.SerialEstimateLine] {
  values.mapi((i, v) => { work_slots: [i], milliseconds: v, })
}

///|
/// Fixture owner: query_integration/query_strategy_wbtest.mbt
fn strategy_for(
  owner : @query.QuerySequence,
  route : @mock.QueryRealization,
) -> @mock.QueryStrategy {
  let offer = strategy_offer(owner, route, [])
  let choice = @mock.choose_query_strategy(owner, [offer], Some([0]), 3).unwrap()
  guard choice is Proposed(strategy) else { abort("mock strategy fixture") }
  strategy
}

///|
/// Fixture owner: query_integration/query_strategy_wbtest.mbt
fn strategy_offer(
  owner : @query.QuerySequence,
  route : @mock.QueryRealization,
  values : Array[Int64?],
) -> @mock.QueryOffer {
  @mock.offer_mock_query(
    owner,
    route,
    strategy_estimates(values),
    { transfer_bytes: None, retained_bytes: None, money_units: None, },
    1000,
  ).unwrap()
}

///|
/// Fixture owner: query_integration/task_generated_fixture_wbtest.mbt
/// Reuse the real Local sequence compiler and its exact expression contexts.
/// No assumption about a demonstration task's operation count or positions.
fn task_test_generated(
  owner : @lower.BoundPrepared,
) -> @execution.GeneratedSequence raise {
  let sequence = prepared_sequence(owner)
  let contexts = []
  for step in 0..<@lower.sequence_count(sequence) {
    if @lower.sequence_step(sequence, step) is Some(RowStep(kernel)) {
      match @lower.kernel_body(kernel) {
        SnapshotMap(_) | OrderedBindings(_) | Filter(_) | AssertAll(_) =>
          contexts.push(sequence_fragment_context(sequence, step, 10L))
        Groups(group) => {
          let mut required = false
          for aggregate = 0
              aggregate < @lower.group_aggregate_count(group)
              aggregate = aggregate + 1 {
            let value = @lower.group_aggregate_at(group, aggregate).unwrap()
            if @lower.group_aggregate_requires_expression_context(value) {
              required = true
            }
          }
          if required {
            contexts.push(sequence_fragment_context(sequence, step, 10L))
          }
        }
        AnalyticRows(analytic) =>
          if @lower.analytic_requires_expression_context(analytic) {
            contexts.push(sequence_fragment_context(sequence, step, 10L))
          }
        _ => ()
      }
    }
  }
  let last = @lower.node_at(
    @lower.bound_preparation(owner),
    @lower.sequence_count(sequence) - 1,
  ).unwrap()
  @execution.prepare_generated_sequence(
    registered_relation_contracts(),
    sequence,
    contexts,
    [@lower.node_id(last)],
    100000,
    10000,
  ).unwrap()
}

