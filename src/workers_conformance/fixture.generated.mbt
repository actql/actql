      max_nodes: 1000,
      max_depth: 100,
      max_string_bytes: 10000,
      max_total_string_bytes: 10000,
    },
  ).unwrap()
}

///|
/// Fixture owner: query_integration/join_graph_capacity_wbtest.mbt
/// Authored fixture material for join step zero and the catalog's fixed 10000
/// row Host ceiling. This is input to the checker, not an expected result
/// generated from a checked Program or an execution result.
fn join_graph_capacity_material(
  environment : @environment.WireEnvironment,
  stage : String,
  steps? : Array[Int] = [0],
  proofs? : Array[@wire.ProgramProofClaim] = [],
  candidates? : Array[@wire.ProgramProofClaim] = [],
) -> @context.StageCapacityInput raise {
  let policy = @environment.capacity_policy(
    @environment.read_capacity(environment, {
      max_bytes: 10000,
      max_nodes: 1000,
      max_depth: 30,
    }).unwrap(),
  )
  let host = @host.create(
    @capacity_policy.ceiling(policy, "max_relation_output_rows").unwrap(),
    { max_bytes: 10000, max_nodes: 1000, max_depth: 30, },
  ).unwrap()
  let writer = @encode.writer(10000, 1000, 30)
  @host.emit(host, writer)
  let host_text = @encode.finish(writer)
  let witness = @wire.admit(@utf8.encode(host_text), @host.cid(host), {
    max_bytes: 10000,
    max_nodes: 1000,
    max_depth: 30,
  }).unwrap()
  let candidate_wires = candidates.map(@wire.program_proof_witness)
  candidate_wires.push(witness)
  candidate_wires.sort_by((a, b) => @wire.cid(a).compare(@wire.cid(b)))
  let candidate_text = candidate_wires.map(candidate => {
    let writer = @encode.writer(10000, 1000, 30)
    @wire.emit(candidate, writer)
    @encode.finish(writer)
  })
  let mut effective_max = @wire.value(candidate_wires[0])
  for candidate in candidate_wires {
    effective_max = Int64::min(effective_max, @wire.value(candidate))
  }
  let body = "{\"author_guard_binding\":\"absent\",\"breach\":\"fail\",\"candidates\":[" +
    candidate_text.join(",") +
    "],\"effective_max\":" +
    effective_max.to_string() +
    ",\"enforcement\":\"engine_atomic\",\"subject_ref\":\"join:checked-step:0:output\",\"unit\":\"rows\",\"version\":\"actql-resolved-limit/0.1\"}"
  let artifacts = steps.map(step => {
    let body = body.replace(
      old="checked-step:0:",
      new="checked-step:" + step.to_string() + ":",
    )
    let cid = "sha256:" + @sha.hex(@utf8.encode(body))
    let resolved = body.replace(
      old="\"subject_ref\":",
      new="\"resolved_limit_cid\":\"" + cid + "\",\"subject_ref\":",
    )
    (@utf8.encode(resolved), cid)
  })
  let witnesses = proofs.map(@wire.program_proof_witness)
  witnesses.push(witness)
  let mixed = @wire.check_mixed_claims(witnesses, artifacts, {
    max_entities: 10,
    max_references: 20,
    max_bytes: 10000,
    max_nodes: 1000,
    max_depth: 30,
  }).unwrap()
  let claims = @wire.check_mixed_program_claims(mixed, proofs, {
    max_witnesses: 10,
    max_references: 20,
  }).unwrap()
  let sources = @host.bind_claim_sources(claims, [policy], {
    max_entries: 10,
    max_bytes: 10000,
    max_nodes: 1000,
    max_depth: 30,
  }).unwrap()
  {
    stage,
    sources,
    uses: Array::makei(steps.length(), i => {
      Join(step=steps[i], output=@wire.mixed_limit_at(mixed, i).unwrap())
    }),
  }
}

///|
/// Fixture owner: query_integration/query_checked_program_wbtest.mbt
fn linear_compute_program(count : Int) -> String raise {
  if count < 1 || count > 32 {
    fail("invalid linear compute fixture")
  }
  let stages = Array::makei(count, index => {
    let prior = if index == 0 {
      "a"
    } else {
      "linear_" + (index - 1).to_string()
    }
    ",{\"id\":\"linear_" +
    index.to_string() +
    "\",\"inputs\":{\"x\":{\"result\":{\"stage\":\"" +
    prior +
    "\",\"result\":\"r\"}}},\"steps\":[{\"filter\":\"id >= 0\"},{\"select\":[\"id\"],\"as\":\"out\"}],\"results\":{\"r\":{\"from\":\"out\",\"fields\":[\"id\"]}}}"
  }).join("")
  "{\"version\":\"actql/0.1\",\"id\":\"linear-placement\",\"params\":{\"minimum\":{\"type\":\"number\",\"nullable\":false}},\"stages\":[{\"id\":\"a\",\"inputs\":{\"remote\":{\"connector\":\"crm/main\",\"resource\":\"r\"}},\"steps\":[{\"filter\":\"id > $minimum\",\"as\":\"filtered\"},{\"select\":[\"id\"],\"as\":\"captured\"}],\"results\":{\"r\":{\"from\":\"captured\",\"fields\":[\"id\"]}}}" +
  stages +
  "],\"results\":{\"out\":{\"from\":{\"stage\":\"linear_" +
  (count - 1).to_string() +
  "\",\"result\":\"r\"}}}}"
}

///|
/// Fixture owner: query_integration/local_carrier_events_wbtest.mbt
fn local_carrier_events_program(variant? : String = "watermark") -> String {
  let dedupe = variant == "dedupe" || variant == "dedupe_filter"
  let window = variant == "window_fixed" ||
    variant == "window_fixed_filter" ||
    variant == "window_sliding" ||
    variant == "window_sliding_filter" ||
    variant == "window_parameter"
  let sequence = variant == "sequence" || variant == "sequence_filter"
  let session = variant.has_prefix("session")
  let session_global = variant == "session_global"
  let session_parameter = variant == "session_parameter"
  let session_relation = variant.has_prefix("session_relation")
  let fields = if sequence {
    "[\"match_start_ms\",\"match_end_ms\",\"start_id\"," +
    "\"start_time_ms\",\"end_id\",\"end_time_ms\"]"
  } else if dedupe {
    "[\"event_id\",\"occurred_at\",\"payload\"]"
  } else if window {
    "[\"event_id\",\"occurred_at\",\"payload\"," +
    "\"window_start_ms\",\"window_end_ms\"]"
  } else if session {
    "[\"event_id\",\"occurred_at\",\"payload\"," +
    "\"session_start_ms\",\"session_end_ms\",\"session_id\"]"
  } else {
    "[\"event_id\",\"occurred_at\",\"payload\"," +
    "\"watermark_ms\",\"late\",\"watermark_decision\"]"
  }
  let rows = if dedupe {
    "[{\"event_id\":1,\"occurred_at\":20,\"payload\":\"a\"}," +
    "{\"event_id\":2,\"occurred_at\":10,\"payload\":\"a\"}," +
    "{\"event_id\":3,\"occurred_at\":30,\"payload\":\"b\"}," +
    "{\"event_id\":4,\"occurred_at\":5,\"payload\":\"b\"}]"
  } else if variant == "session_ties" {
    "[{\"event_id\":2,\"occurred_at\":1,\"payload\":\"a\"}," +
    "{\"event_id\":1,\"occurred_at\":1,\"payload\":\"a\"}," +
    "{\"event_id\":3,\"occurred_at\":13,\"payload\":\"a\"}]"
  } else if session_global {
    "[{\"event_id\":2,\"occurred_at\":1,\"payload\":\"a\"}," +
    "{\"event_id\":1,\"occurred_at\":3,\"payload\":\"b\"}," +
    "{\"event_id\":3,\"occurred_at\":13,\"payload\":\"a\"}]"
  } else if session {
    "[{\"event_id\":2,\"occurred_at\":1,\"payload\":\"a\"}," +
    "{\"event_id\":1,\"occurred_at\":3,\"payload\":\"a\"}," +
    "{\"event_id\":3,\"occurred_at\":13,\"payload\":\"a\"}]"
  } else {
    "[{\"event_id\":1,\"occurred_at\":3,\"payload\":\"first\"}," +
