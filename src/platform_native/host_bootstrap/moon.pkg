supported_targets = "native"

import {
  "actql/actql/physical_resources" @resources,
  "actql/actql/platform_native/executor_slot" @executor,
}

import {
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
} for "wbtest"

options(
  link: {
    "native": { "stub-cc-flags": "-D_GNU_SOURCE", "cc-link-flags": "-pthread" },
  },
  "native-stub": [ "bootstrap_stub.c" ],
)
