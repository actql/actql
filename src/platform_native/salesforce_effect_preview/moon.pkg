supported_targets = "+js+wasm+native"

import {
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/encoding/base64",
  "actql/actql/platform_native/remote_resident_host" @resident,
  "actql/actql/run_publication_host" @host,
  "actql/actql/run_publication" @publication,
  "actql/actql/physical_strategy_host" @strategy,
  "actql/actql/canonical_json" @canonical,
  "actql/actql/source_value" @source,
  "actql/actql/value_admission" @values,
  "actql/actql/encode_core" @encode,
  "actql/actql/decode_core" @decode,
  "actql/actql/program_check" @checked,
  "actql/actql/check_environment" @environment,
  "actql/actql/stage_syntax" @syntax,
  "actql/actql/platform_native/http_client" @http,
  "actql/actql/stage_results" @results,
  "actql/actql/logical_request_scope" @request_scope,
  "actql/actql/effect_application" @effect,
  "actql/actql/connectors/salesforce/catalog",
  "actql/actql/platform_native/credential_resource" @resource,
  "actql/actql/remote_credential" @credential,
  "actql/actql/execution_relation" @execution,
  "actql/actql/execution_authorization" @authorization,
  "actql/actql/platform_native/bounded_files",
  "actql/actql/platform_native/signature",
  "actql/actql/checkpoint_runtime" @checkpoint,
  "actql/actql/platform_native/remote_journal" @journal,
  "actql/actql/platform_native/remote_client" @client,
  "actql/actql/remote_site_protocol" @remote,
  "actql/actql/platform_native/publication_store" @store,
}

import {
  "actql/actql/sha256" @sha,
  "actql/actql/platform_native/filesystem" @files,
} for "wbtest"
