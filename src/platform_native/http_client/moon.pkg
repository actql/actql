supported_targets = "+js+wasm+native"

import {
  "moonbitlang/core/encoding/utf8",
  "actql/actql/platform_native/filesystem",
}

import {
  "moonbitlang/core/env",
} for "wbtest"

options(
  link: { "native": { "cc": "./scripts/native-sqlite-link-driver.sh" } },
  "native-stub": [ "http_client_stub.c" ],
  targets: {
    "http_client_native.mbt": [ "native" ],
    "local_preparation_native.mbt": [ "native" ],
    "local_preparation_unsupported.mbt": [ "not", "native" ],
    "http_client_wbtest.mbt": [ "native" ],
    "diagnostic_ceiling_native_wbtest.mbt": [ "native" ],
    "construction_custody_native_wbtest.mbt": [ "native" ],
    "transport_retirement_native_wbtest.mbt": [ "native" ],
    "http_client_unsupported.mbt": [ "not", "native" ],
    "http_client_unsupported_wbtest.mbt": [ "not", "native" ],
  },
)
