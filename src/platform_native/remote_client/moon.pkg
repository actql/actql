supported_targets = "+js+wasm+native"

import {
  "actql/actql/remote_bundle" @bundle,
  "actql/actql/checkpoint_runtime" @checkpoint,
  "actql/actql/platform_native/http_client" @http,
  "actql/actql/platform_native/remote_journal" @journal,
  "actql/actql/remote_site_protocol" @remote,
  "actql/actql/execution_authorization" @authorization,
  "moonbitlang/core/encoding/utf8",
}

import {
  "actql/actql/execution_site" @site,
  "actql/actql/platform_native/sqlite",
  "moonbitlang/core/env",
} for "wbtest"

options(
  link: { "native": { "cc": "./scripts/native-sqlite-link-driver.sh" } },
  targets: {
    "effect_checkpoint_client_native_wbtest.mbt": [ "native" ],
    "client_native.mbt": [ "native" ],
    "client_native_wbtest.mbt": [ "native" ],
    "client_authorization_native_wbtest.mbt": [ "native" ],
    "client_unsupported.mbt": [ "not", "native" ],
    "client_unsupported_wbtest.mbt": [ "not", "native" ],
  },
)
