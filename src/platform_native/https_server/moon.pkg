supported_targets = "+js+wasm+native"

import {
  "moonbitlang/core/encoding/utf8",
}

options(
  link: {
    "native": {
      "cc": "./scripts/native-cxx-link-driver.sh",
      "stub-cc": "./scripts/native-cxx-link-driver.sh",
      "stub-cc-flags": "-std=c++17",
      "cc-link-flags": "-lssl -lcrypto",
    },
  },
  "native-stub": [ "https_server_stub.cc" ],
  targets: {
    "server_native.mbt": [ "native" ],
    "server_unsupported.mbt": [ "not", "native" ],
    "server_unsupported_wbtest.mbt": [ "not", "native" ],
  },
)
