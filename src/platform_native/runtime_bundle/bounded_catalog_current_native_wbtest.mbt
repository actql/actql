///|
#borrow(database)
extern "C" fn catalog_readback_empty(database : @sqlite.Database) -> Bool = "actql_native_sqlite_test_result_storage_empty"

///|
test "bounded current catalog exact bytes and refusal preserve original custody" {
  // Required physical fixture: absent libraries/root must fail, never skip.
  let (store, generation, artifact, _, _) = native_bundle_fixture(
    "bounded-current",
  ).unwrap()
  let adopted = adopt_native_bundle(store, generation, artifact, "1")
  store.activate(adopted.runtime_bundle_cid).unwrap() |> ignore
  let binding = store
    .acquire_active_component(
      "sha256:5cbfccb321655cdc50146d4dad052ac646ba09180cefd34d8c48cd248166346f",
      "aarch64-apple-darwin", "runtime-process:bounded-current",
    )
    .unwrap()
  let original = store.database.read("runtime_bundle", "catalog").unwrap()
  let limit = original.body.length().to_int64()
  assert_true(limit > 0L && limit < store.max_record_bytes.to_int64())
  store.verify_active_component_binding_with_body_limit(binding, limit).unwrap()
  assert_true(
    store.verify_active_component_binding_with_body_limit(binding, limit - 1L)
    is Err(Database(@sqlite.BodyTooLarge)),
  )
  // The SQLite Owner refused before its body readback allocation/copy.
  assert_true(catalog_readback_empty(store.database))
  assert_true(
    store.verify_active_component_binding_with_body_limit(binding, 0L)
    is Err(Database(@sqlite.BodyTooLarge)),
  )
  assert_true(catalog_readback_empty(store.database))
  assert_true(
    store.verify_active_component_binding_with_body_limit(binding, -1L)
    is Err(Database(@sqlite.InvalidLimit)),
  )
  let after = store.database.read("runtime_bundle", "catalog").unwrap()
  assert_eq(after.revision, original.revision)
  assert_eq(after.body, original.body)
  store.verify_active_component_binding(binding).unwrap()
  store.verify_active_component_binding_with_body_limit(binding, limit).unwrap()
  assert_true(store.release("runtime-process:bounded-current").unwrap())
  assert_true(
    store.verify_active_component_binding_with_body_limit(binding, 1048576L)
    is Err(MissingBundle),
  )
  store.drain(adopted.runtime_bundle_cid).unwrap() |> ignore
  store.reclaim(adopted.runtime_bundle_cid).unwrap() |> ignore
  assert_true(store.close().unwrap())
}

///|
test "bounded current catalog keeps original component hold and retirement fences" {
  let (store, generation, artifact, _, _) = native_bundle_fixture(
    "bounded-current-fences",
  ).unwrap()
  // The fixture shares its owned Store root; retain a distinct signed identity
  // from the first case, including after its proper reclaim/tombstone.
  let adopted = adopt_native_bundle(store, generation, artifact, "2")
  store.activate(adopted.runtime_bundle_cid).unwrap() |> ignore
  let binding = store
    .acquire_active_component(
      "sha256:5cbfccb321655cdc50146d4dad052ac646ba09180cefd34d8c48cd248166346f",
      "aarch64-apple-darwin", "runtime-process:bounded-fences",
    )
    .unwrap()
  let original = store.database.read("runtime_bundle", "catalog").unwrap()
  let limit = original.body.length().to_int64()
  let foreign_component = {
    ..binding,
    component_cid: "sha256:" + "a".repeat(64),
  }
  assert_true(
    store.verify_active_component_binding_with_body_limit(
      foreign_component, limit,
    )
    is Err(ComponentMismatch),
  )
  let foreign_hold = { ..binding, process_hold_id: "runtime-process:foreign", }
  assert_true(
    store.verify_active_component_binding_with_body_limit(foreign_hold, limit)
    is Err(MissingBundle),
  )
  store.retiring = true
  assert_true(
    store.verify_active_component_binding_with_body_limit(binding, limit)
    is Err(CleanupPending),
  )
  store.retiring = false
  store.verify_active_component_binding_with_body_limit(binding, limit).unwrap()
  let after = store.database.read("runtime_bundle", "catalog").unwrap()
  assert_eq(after.revision, original.revision)
  assert_eq(after.body, original.body)
  assert_true(store.release("runtime-process:bounded-fences").unwrap())
  store.drain(adopted.runtime_bundle_cid).unwrap() |> ignore
  store.reclaim(adopted.runtime_bundle_cid).unwrap() |> ignore
  assert_true(store.close().unwrap())
  assert_true(
    store.verify_active_component_binding_with_body_limit(binding, limit)
    is Err(Closed),
  )
}

///|
test "explicit catalog decode limits bind Source and Decode without changing canonical bytes" {
  let (store, _, _, _, _) = native_bundle_fixture("catalog-json-limits").unwrap()
  // Independent literal, not an expectation generated by the catalog encoder.
  let bytes = b"{\"active_bundle_cid\":\"\",\"component_copies\":[],\"entries\":[],\"staging\":[],\"version\":\"actql-native-runtime-bundle-catalog/0.1\"}"
  let exact : @decode.Limits = {
    max_nodes: 6,
    max_depth: 2,
    max_string_bytes: 39,
    max_total_string_bytes: 93,
  }
  let admitted = admit_catalog(store, 17L, bytes, json_limits=Some(exact)).unwrap()
  assert_eq(admitted.revision, 17L)
  assert_eq(catalog_bytes(admitted, store.max_record_bytes).unwrap(), bytes)
  for
    limits in [
      { ..exact, max_nodes: 5, },
      { ..exact, max_depth: 1, },
      { ..exact, max_string_bytes: 38, },
      { ..exact, max_total_string_bytes: 92, },
    ] {
    assert_true(
      admit_catalog(store, 17L, bytes, json_limits=Some(limits))
      is Err(StateCollision),
    )
  }
  assert_true(
    admit_catalog(
      store,
      17L,
      bytes,
      json_limits=Some(exact),
      max_input_bytes=Some(bytes.length() - 1),
    )
    is Err(StateCollision),
  )
  // A larger caller choice cannot raise any original Store structural bound.
  let wide : @decode.Limits = {
    max_nodes: 2147483647,
    max_depth: 2147483647,
    max_string_bytes: 2147483647,
    max_total_string_bytes: 2147483647,
  }
  let clamped = catalog_json_limits(store, Some(wide)).unwrap()
  assert_eq(clamped.max_nodes, store.max_record_bytes)
  assert_eq(clamped.max_depth, 5)
  assert_eq(clamped.max_string_bytes, store.max_record_bytes)
  assert_eq(clamped.max_total_string_bytes, store.max_record_bytes)
  store.close_checked().unwrap()
}

///|
test "explicit catalog decode refusal preserves the same active binding and original row" {
  let (store, generation, artifact, _, _) = native_bundle_fixture(
    "catalog-json-current",
  ).unwrap()
  let adopted = adopt_native_bundle(store, generation, artifact, "3")
  store.activate(adopted.runtime_bundle_cid).unwrap() |> ignore
  let binding = store
    .acquire_active_component(
      "sha256:5cbfccb321655cdc50146d4dad052ac646ba09180cefd34d8c48cd248166346f",
      "aarch64-apple-darwin", "runtime-process:catalog-json-current",
    )
    .unwrap()
  let original = store.database.read("runtime_bundle", "catalog").unwrap()
  let byte_limit = original.body.length().to_int64()
  let enough : @decode.Limits = {
    max_nodes: store.max_record_bytes,
    max_depth: 5,
    max_string_bytes: store.max_record_bytes,
    max_total_string_bytes: store.max_record_bytes,
  }
  store
  .verify_active_component_binding_with_body_limit(
    binding,
    byte_limit,
    json_limits=Some(enough),
  )
  .unwrap()
  for
    limits in [
      { ..enough, max_nodes: 1, },
      { ..enough, max_depth: 1, },
      { ..enough, max_string_bytes: 1, },
      { ..enough, max_total_string_bytes: 1, },
    ] {
    assert_true(
      store.verify_active_component_binding_with_body_limit(
        binding,
        byte_limit,
        json_limits=Some(limits),
      )
      is Err(StateCollision),
    )
  }
  for
    limits in [
      { ..enough, max_nodes: 0, },
      { ..enough, max_depth: -1, },
      { ..enough, max_string_bytes: 0, },
      { ..enough, max_total_string_bytes: -1, },
    ] {
    assert_true(
      store.verify_active_component_binding_with_body_limit(
        binding,
        byte_limit,
        json_limits=Some(limits),
      )
      is Err(InvalidConfiguration),
    )
  }
  assert_true(
    store.verify_active_component_binding_with_body_limit(
      binding,
      byte_limit - 1L,
      json_limits=Some(enough),
    )
    is Err(Database(@sqlite.BodyTooLarge)),
  )
  assert_true(catalog_readback_empty(store.database))
  let after = store.database.read("runtime_bundle", "catalog").unwrap()
  assert_eq(after.revision, original.revision)
  assert_eq(after.body, original.body)
  // Refusal did not discard the original hold or substitute another Store.
  store.verify_active_component_binding(binding).unwrap()
  store
  .verify_active_component_binding_with_body_limit(
    binding,
    byte_limit,
    json_limits=Some(enough),
  )
  .unwrap()
  let foreign = { ..binding, process_hold_id: "runtime-process:foreign-json", }
  assert_true(
    store.verify_active_component_binding_with_body_limit(
      foreign,
      byte_limit,
      json_limits=Some(enough),
    )
    is Err(MissingBundle),
  )
  store.retiring = true
  assert_true(
    store.verify_active_component_binding_with_body_limit(
      binding,
      byte_limit,
      json_limits=Some(enough),
    )
    is Err(CleanupPending),
  )
  store.retiring = false
  assert_true(store.release("runtime-process:catalog-json-current").unwrap())
  store.drain(adopted.runtime_bundle_cid).unwrap() |> ignore
  store.reclaim(adopted.runtime_bundle_cid).unwrap() |> ignore
  store.close_checked().unwrap()
  assert_true(
    store.verify_active_component_binding_with_body_limit(
      binding,
      byte_limit,
      json_limits=Some(enough),
    )
    is Err(Closed),
  )
}
