supported_targets = "+js+wasm+native"

import {
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/core/env",
} for "wbtest"

options(
  "native-stub": [ "filesystem_stub.c" ],
  targets: {
    "filesystem_native.mbt": [ "native" ],
    "filesystem_unsupported.mbt": [ "not", "native" ],
    "filesystem_wbtest.mbt": [ "native" ],
    "filesystem_unsupported_wbtest.mbt": [ "not", "native" ],
  },
)
