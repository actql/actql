supported_targets = "+js+wasm+native"

import {
  "actql/actql/connectors/duckdb/adapters/native" @native_duckdb,
  "actql/actql/connectors/duckdb/host_native" @native_host,
  "actql/actql/execution_query" @query,
  "actql/actql/physical_resources" @resources,
  "actql/actql/physical_strategy" @strategy,
  "actql/actql/physical_strategy_example" @application,
  "actql/actql/platform_native/remote_standard_host" @remote_standard,
  "actql/actql/platform_native/remote_transfer_client" @transfer_client,
  "actql/actql/platform_native/remote_transfer_journal" @transfer_journal,
  "actql/actql/platform_native/filesystem",
  "actql/actql/platform_native/http_client" @http,
  "actql/actql/platform_native/publication_store",
  "actql/actql/platform_native/remote_journal" @journal,
  "actql/actql/platform_native/runtime_bundle" @bundle,
  "actql/actql/execution_site" @site,
  "actql/actql/remote_site_protocol" @remote,
  "actql/actql/remote_transfer" @transfer,
  "actql/actql/publication_payload" @payload,
  "actql/actql/platform_native/bounded_files",
  "actql/actql/platform_native/remote_agent" @agent,
  "actql/actql/platform_native/remote_runtime" @runtime,
  "actql/actql/pipeline_check_context" @context,
  "actql/actql/program_references" @program_refs,
  "actql/actql/run_publication" @publication,
}

import {
  "actql/actql/physical_manifest" @manifest,
  "actql/actql/sha256" @sha,
} for "wbtest"
