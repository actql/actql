supported_targets = "native"

import {
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/debug",
  "actql/actql/platform_native/host_bootstrap" @bootstrap,
  "actql/actql/platform_native/executor_slot" @executor,
  "actql/actql/physical_resources" @resources,
  "actql/actql/client_host_buffers" @buffers,
  "actql/actql/platform_native/sqlite",
  "actql/actql/platform_native/signature",
  "actql/actql/platform_native/filesystem",
}

import {
  "moonbitlang/core/env",
  "actql/actql/client_local_host" @client,
  "actql/actql/platform_native/publication_store" @store,
  "actql/actql/publication_payload" @payload,
  "actql/actql/run_publication" @publication,
  "actql/actql/sha256" @sha,
  "actql/actql/encode_core" @encode,
  "actql/actql/source_value" @source,
  "actql/actql/canonical_json" @json,
} for "wbtest"
