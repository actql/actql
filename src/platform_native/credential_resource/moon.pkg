supported_targets = "+js+wasm+native"

import {
  "actql/actql/remote_credential" @credential,
  "actql/actql/platform_native/http_client" @http,
  "actql/actql/platform_native/filesystem",
  "actql/actql/platform_native/signature",
  "actql/actql/platform_native/sqlite",
  "actql/actql/platform_native/trusted_clock",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
}

options(
  targets: { "guarded_write_native_wbtest.mbt": [ "native" ] },
)
