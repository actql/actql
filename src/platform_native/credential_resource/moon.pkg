supported_targets = "+js+wasm+native"

import {
  "actql/actql/remote_credential" @credential,
  "actql/actql/checkpoint_runtime" @checkpoint,
  "actql/actql/decode_core" @decode,
  "actql/actql/source_value" @source,
  "actql/actql/platform_native/http_client" @http,
  "actql/actql/platform_native/filesystem",
  "actql/actql/platform_native/signature",
  "actql/actql/platform_native/sqlite",
  "actql/actql/platform_native/trusted_clock",
  "actql/actql/platform_native/publication_store" @publication,
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
}

options(
  link: { "native": { "cc": "./scripts/native-sqlite-link-driver.sh" } },
  targets: {
    "guarded_write_native_wbtest.mbt": [ "native" ],
    "remote_use_retention_native_wbtest.mbt": [ "native" ],
    "remote_initial_use_native_wbtest.mbt": [ "native" ],
    "local_signing_history_native_wbtest.mbt": [ "native" ],
    "local_signing_claim_native_wbtest.mbt": [ "native" ],
    "local_initial_host_signing_native_wbtest.mbt": [ "native" ],
    "local_signing_outcome_native_wbtest.mbt": [ "native" ],
    "local_signing_current_native_wbtest.mbt": [ "native" ],
    "local_signing_operation_history_native_wbtest.mbt": [ "native" ],
  },
)
