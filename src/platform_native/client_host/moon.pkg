supported_targets = "native"

import {
  "actql/actql/run_publication_host" @host,
  "actql/actql/program_check" @checked,
  "actql/actql/source_frontend" @frontend,
  "actql/actql/stage_syntax" @syntax,
  "actql/actql/query_program" @query,
  "actql/actql/decode_core" @decode,
  "actql/actql/pipeline_check_context" @context,
  "actql/actql/logical_request_scope" @scope,
  "actql/actql/run_publication" @publication,
  "actql/actql/platform_native/sqlite",
  "actql/actql/platform_native/remote_journal" @journal,
  "actql/actql/platform_native/remote_resident_host" @resident,
  "actql/actql/platform_native/remote_standard_host" @remote_output,
  "actql/actql/physical_resources" @resources,
  "actql/actql/platform_native/signature" @crypto,
  "actql/actql/encode_core" @encode,
  "actql/actql/source_value" @source,
  "actql/actql/canonical_json" @canonical,
  "actql/actql/parameter_binding" @parameters,
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/core/env",
  "actql/actql/check_environment" @environment,
} for "wbtest"
