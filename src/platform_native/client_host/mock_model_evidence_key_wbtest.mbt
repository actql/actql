///|
// Actual Native Journal/Crypto input, with explicit read-routing observations.
// No installed physical pair, Model call or normal Store authority is claimed.
test "Native Model evidence key consumes original epoch custody and exact adoption Store preimage" {
  let host = policy_host_fixture("model-evidence-original-key")
  let calls : Array[String] = []
  let reads = journal_test_read_access(host.database, calls)
  let binding = "sha256:" + "a".repeat(64)
  let key = native_mock_model_evidence_key(host, binding, reads).unwrap()
  let (original, _, _) = read_epoch_custody(host.database).unwrap()
  // Independently authored complete ordered preimage. It is not generated by
  // the new product codec or a second new identity/canonicalization rule.
  let preimage = "{\"adoption_cid\":\"" +
    host.adoption_cid +
    "\",\"domain\":\"actql-native-local-model-evidence-key/0.1\",\"store_binding\":\"" +
    binding +
    "\"}"
  assert_true(
    key ==
    host.epoch.crypto.hmac_sha256(original, @utf8.encode(preimage)).unwrap(),
  )
  assert_eq(key.length(), 32)
  assert_eq(calls, [
    "scan:client_submission_epoch:", "scan:client_submission_epoch:authority", "read:client_submission_epoch:authority",
  ])
  assert_eq(native_mock_model_evidence_key(host, binding, reads).unwrap(), key)
  assert_true(
    native_mock_model_evidence_key(host, "sha256:" + "b".repeat(64), reads).unwrap() !=
    key,
  )
  host.close().unwrap()
}

///|
test "Native Model evidence key refuses absent original epoch custody without initialization" {
  let host = policy_host_fixture("model-evidence-missing-key")
  let calls : Array[String] = []
  let original = journal_test_read_access(host.database, calls)
  let requested : Array[(String, String)] = []
  let reads = {
    ..original,
    read: (table, key) => {
      requested.push((table, key))
      Err(@sqlite.NotFound)
    },
  }
  assert_true(
    native_mock_model_evidence_key(host, "sha256:" + "a".repeat(64), reads)
    is Err(Epoch(CustodyLost)),
  )
  assert_eq(requested, [("client_submission_epoch", "authority")])
  // Missing delivery is not permission to recreate a key. The actual original
  // row and revision remain untouched; no write/clock/epoch issuance occurred.
  assert_true(read_epoch_custody(host.database).unwrap().0.length() == 32)
  host.close().unwrap()
}
