///|
fn read_preimage_test_fields(
  policies : Array[String],
  quantity? : @host.ClientLocalReadEvidenceValue = @host.Quantity(1),
  target? : String = "answer",
) -> Array[(String, @host.ClientLocalReadEvidenceValue)] {
  [
    ("domain", Text("native_local_read.test")),
    ("policies", Texts(policies)),
    ("target", Text(target)),
    ("uses", quantity),
    ("verdict", AllowedReads(target)),
  ]
}

///|
// Actual legacy Crypto hashes and Host cleanup, with controlled operation
// flags selecting only pure DATA retention. No Native Read/pair, Account
// permission, File Writer, material receiver or cleanup ACK is supplied.
test "unchanged read preimages encode once and retire with their command" {
  let host = policy_host_fixture("read-preimage-retention")
  let crypto = epoch_test_crypto()
  let capture = prepare_native_local_journal_capture(
    host.session,
    local_journal_test_library(),
    crypto,
    100.0,
    8,
    8388608L,
  )
  capture.opening = JournalAcquired(host)
  capture.read_callback_active = true
  capture.read_facts_valid = true
  host.journal.operation_active = true
  let policies = ["sha256:a"]
  let first = local_read_preimage(
    crypto,
    read_preimage_test_fields(policies),
    capture=Some(capture),
  ).unwrap()
  assert_eq(
    first.wire,
    "{\"domain\":\"native_local_read.test\",\"policies\":[\"sha256:a\"],\"target\":\"answer\",\"uses\":1,\"verdict\":[{\"operation\":\"read\",\"outcome\":\"allow\",\"resource\":\"run\"},{\"operation\":\"read\",\"outcome\":\"allow\",\"resource\":\"result/answer\"}]}",
  )
  // Independent literal bytes and SHA-256 vector; not generated by product.
  assert_eq(
    first.cid,
    "sha256:b93f673edebe4f65c9697768e1d00bd2b8082cb8554302fb217c98cce4646542",
  )
  let again = local_read_preimage(
    crypto,
    read_preimage_test_fields(["sha256:a"]),
    capture=Some(capture),
  ).unwrap()
  assert_true(physical_equal(first, again))
  assert_eq(capture.read_preimages.length(), 1)
  // A retained input must not alias a caller's mutable policy array.
  policies[0] = "sha256:changed"
  let changed_policy = local_read_preimage(
    crypto,
    read_preimage_test_fields(policies),
    capture=Some(capture),
  ).unwrap()
  assert_false(physical_equal(first, changed_policy))
  assert_true(changed_policy.cid != first.cid)
  policies[0] = "sha256:a"
  assert_true(
    physical_equal(
      first,
      local_read_preimage(
        crypto,
        read_preimage_test_fields(policies),
        capture=Some(capture),
      ).unwrap(),
    ),
  )
  let text_quantity = local_read_preimage(
    crypto,
    read_preimage_test_fields(policies, quantity=@host.Text("1")),
    capture=Some(capture),
  ).unwrap()
  assert_true(text_quantity.cid != first.cid)
  let other_target = local_read_preimage(
    crypto,
    read_preimage_test_fields(policies, target="other"),
    capture=Some(capture),
  ).unwrap()
  assert_true(other_target.cid != first.cid)
  let material : NativeLocalReadMaterialOriginal = {
    receiver_cid: "sha256:receiver",
    result_schema_cid: "sha256:schema",
    ordering_evidence_cid: "sha256:ordering",
  }
  let material_value = local_read_preimage(
    crypto,
    read_preimage_test_fields(policies),
    material=Some(material),
    capture=Some(capture),
  ).unwrap()
  assert_true(material_value.cid != first.cid)
  assert_true(
    physical_equal(
      material_value,
      local_read_preimage(
        crypto,
        read_preimage_test_fields(policies),
        material=Some(material),
        capture=Some(capture),
      ).unwrap(),
    ),
  )
  let other_material = local_read_preimage(
    crypto,
    read_preimage_test_fields(policies),
    material=Some({ ..material, receiver_cid: "sha256:other-receiver", }),
    capture=Some(capture),
  ).unwrap()
  assert_true(other_material.cid != material_value.cid)
  let file : NativeLocalReadFileOriginal = {
    path: ".",
    name: "answer.jsonl",
    staging_name: "answer.partial",
    parent_device: "1",
    parent_inode: "2",
    writer_device: "1",
    writer_inode: "3",
  }
  let file_value = local_read_preimage(
    crypto,
    read_preimage_test_fields(policies),
    file=Some(file),
    capture=Some(capture),
  ).unwrap()
  assert_true(file_value.cid != material_value.cid)
  let other_file = local_read_preimage(
    crypto,
    read_preimage_test_fields(policies),
    file=Some({ ..file, writer_inode: "4", }),
    capture=Some(capture),
  ).unwrap()
  assert_true(other_file.cid != file_value.cid)
  assert_eq(capture.read_preimages.length(), 8)
  // Pure compatibility calls outside a command still encode normally; they
  // neither read nor populate the command's retained observations.
  capture.read_callback_active = false
  host.journal.operation_active = false
  capture.clear_read_operation_facts()
  assert_eq(capture.read_preimages.capacity(), 0)
  let unscoped = local_read_preimage(
    crypto,
    read_preimage_test_fields(policies),
  ).unwrap()
  let inactive = local_read_preimage(
    crypto,
    read_preimage_test_fields(policies),
    capture=Some(capture),
  ).unwrap()
  assert_eq(unscoped.wire, first.wire)
  assert_eq(inactive.cid, first.cid)
  assert_eq(capture.read_preimages.length(), 0)
  capture.read_callback_active = true
  capture.read_facts_valid = true
  host.journal.operation_active = true
  let fresh = local_read_preimage(
    crypto,
    read_preimage_test_fields(policies),
    capture=Some(capture),
  ).unwrap()
  assert_false(physical_equal(first, fresh))
  assert_eq(fresh.cid, first.cid)
  host.journal.operation_active = false
  assert_true(
    local_read_preimage(
      crypto,
      read_preimage_test_fields(policies),
      capture=Some(capture),
    )
    is Err(CustodyLost),
  )
  assert_true(
    capture.read_operation_issue is Some(OriginalResourceScopePending),
  )
  assert_eq(capture.read_preimages.capacity(), 0)
  // Restoring only nominal active flags cannot revive a failed observation.
  capture.read_facts_valid = true
  host.journal.operation_active = true
  assert_true(
    local_read_preimage(
      crypto,
      read_preimage_test_fields(policies),
      capture=Some(capture),
    )
    is Err(CustodyLost),
  )
  capture.read_callback_active = false
  host.journal.operation_active = false
  assert_false(capture.cleanup_acknowledged)
  assert_eq(capture.close().issue_family(), 0)
}
