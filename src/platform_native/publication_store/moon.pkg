supported_targets = "+js+wasm+native"

import {
  "actql/actql/checkpoint_runtime" @checkpoint,
  "actql/actql/remote_credential" @credential,
  "actql/actql/platform_native/http_client" @http,
  "actql/actql/platform_native/filesystem",
  "actql/actql/platform_native/sqlite",
  "actql/actql/platform_native/signature",
  "actql/actql/publication_payload" @payload,
  "actql/actql/run_publication" @publication,
  "actql/actql/sha256" @sha,
  "actql/actql/connectors/salesforce/catalog",
  "actql/actql/encode_core" @encode,
  "actql/actql/decode_core" @decode,
  "actql/actql/decode_shape" @shape,
  "actql/actql/execution_relation" @execution,
  "actql/actql/source_value" @source,
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/string",
  "moonbitlang/core/encoding/utf8",
}

import {
  "actql/actql/canonical_json" @json,
  "moonbitlang/core/env",
} for "wbtest"

options(
  "native-stub": [ "store_format_stub.c" ],
  targets: {
    "store_native.mbt": [ "native" ],
    "captured_content_custody_native.mbt": [ "native" ],
    "captured_content_capacity_native.mbt": [ "native" ],
    "captured_content_custody_native_wbtest.mbt": [ "native" ],
    "captured_content_custody_unsupported.mbt": [ "not", "native" ],
    "publication_observation_native.mbt": [ "native" ],
    "publication_observation_unsupported.mbt": [ "not", "native" ],
    "original_checkpoint_continuation.mbt": [ "native" ],
    "original_checkpoint_continuation_wbtest.mbt": [ "native" ],
    "effect_source_custody_native.mbt": [ "native" ],
    "effect_capture_custody_native.mbt": [ "native" ],
    "effect_catalog_custody_native.mbt": [ "native" ],
    "model_evidence_custody_native.mbt": [ "native" ],
    "model_evidence_custody_native_wbtest.mbt": [ "native" ],
    "model_evidence_custody_unsupported.mbt": [ "not", "native" ],
    "credential_raw_custody_native.mbt": [ "native" ],
    "credential_raw_custody_native_wbtest.mbt": [ "native" ],
    "credential_raw_custody_unsupported.mbt": [ "not", "native" ],
    "effect_catalog_custody_native_wbtest.mbt": [ "native" ],
    "effect_catalog_custody_unsupported.mbt": [ "not", "native" ],
    "effect_capture_custody_unsupported.mbt": [ "not", "native" ],
    "effect_source_custody_unsupported.mbt": [ "not", "native" ],
    "store_native_wbtest.mbt": [ "native" ],
    "open_failure_custody_native_wbtest.mbt": [ "native" ],
    "open_failure_gap_wbtest.mbt": [ "native" ],
    "checked_retirement_native_wbtest.mbt": [ "native" ],
    "store_unsupported.mbt": [ "not", "native" ],
    "store_unsupported_wbtest.mbt": [ "not", "native" ],
  },
)
