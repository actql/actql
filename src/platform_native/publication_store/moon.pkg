supported_targets = "+js+wasm+native"

import {
  "actql/actql/platform_native/filesystem",
  "actql/actql/platform_native/sqlite",
  "actql/actql/platform_native/signature",
  "actql/actql/publication_payload" @payload,
  "actql/actql/run_publication" @publication,
  "actql/actql/sha256" @sha,
  "moonbitlang/core/encoding/utf8",
}

import {
  "actql/actql/canonical_json" @json,
  "actql/actql/encode_core" @encode,
  "actql/actql/source_value" @source,
  "moonbitlang/core/env",
} for "wbtest"

options(
  "native-stub": [ "store_format_stub.c" ],
  targets: {
    "store_native.mbt": [ "native" ],
    "effect_source_custody_native.mbt": [ "native" ],
    "effect_capture_custody_native.mbt": [ "native" ],
    "effect_capture_custody_unsupported.mbt": [ "not", "native" ],
    "effect_source_custody_unsupported.mbt": [ "not", "native" ],
    "store_native_wbtest.mbt": [ "native" ],
    "store_unsupported.mbt": [ "not", "native" ],
    "store_unsupported_wbtest.mbt": [ "not", "native" ],
  },
)
