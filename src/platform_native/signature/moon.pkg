supported_targets = "+js+wasm+native"

import {
  "actql/actql/platform_native/filesystem",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/json",
}

import {
  "moonbitlang/core/env",
} for "wbtest"

options(
  "native-stub": [ "signature_stub.c" ],
  targets: {
    "crypto_component_native.mbt": [ "native" ],
    "crypto_component_unsupported.mbt": [ "not", "native" ],
    "signature_native.mbt": [ "native" ],
    "original_key_signing_native.mbt": [ "native" ],
    "original_key_signing_native_wbtest.mbt": [ "native" ],
    "original_key_signing_owner_native_wbtest.mbt": [ "native" ],
    "original_key_signing_unsupported.mbt": [ "not", "native" ],
    "key_generation_native.mbt": [ "native" ],
    "key_generation_native_wbtest.mbt": [ "native" ],
    "key_generation_unsupported.mbt": [ "not", "native" ],
    "signature_native_wbtest.mbt": [ "native" ],
    "original_close_native_wbtest.mbt": [ "native" ],
    "diagnostic_ceiling_native_wbtest.mbt": [ "native" ],
    "private_evidence_native_wbtest.mbt": [ "native" ],
    "model_private_evidence_native_wbtest.mbt": [ "native" ],
    "signature_unsupported.mbt": [ "not", "native" ],
    "signature_unsupported_wbtest.mbt": [ "not", "native" ],
  },
)
