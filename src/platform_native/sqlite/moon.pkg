supported_targets = "+js+wasm+native"

import {
  "moonbitlang/core/encoding/utf8",
  "actql/actql/platform_native/filesystem",
}

import {
  "moonbitlang/core/env",
} for "wbtest"

options(
  "native-stub": [ "sqlite_stub.c" ],
  targets: {
    "sqlite_native.mbt": [ "native" ],
    "owned_body_extent_native.mbt": [ "native" ],
    "owned_body_extent_unsupported.mbt": [ "not", "native" ],
