    "store_operation_unsupported.mbt": [ "not", "native" ],
    "lookup_snapshot_native.mbt": [ "native" ],
    "lookup_snapshot_unsupported.mbt": [ "not", "native" ],
    "lookup_snapshot_native_wbtest.mbt": [ "native" ],
    "sqlite_unsupported.mbt": [ "not", "native" ],
    "sqlite_wbtest.mbt": [ "native" ],
    "diagnostic_ceiling_native_wbtest.mbt": [ "native" ],
    "current_component_origin_native_wbtest.mbt": [ "native" ],
    "current_component_origin_unsupported_wbtest.mbt": [ "not", "native" ],
    "selected_library_custody_native_wbtest.mbt": [ "native" ],
    "journal_wal_native_wbtest.mbt": [ "native" ],
    "local_store_wal_native_wbtest.mbt": [ "native" ],
    "selected_library_unsupported_wbtest.mbt": [ "not", "native" ],
    "readback_retirement_native_wbtest.mbt": [ "native" ],
    "bounded_read_native_wbtest.mbt": [ "native" ],
    "capacity_release_transaction_native_wbtest.mbt": [ "native" ],
