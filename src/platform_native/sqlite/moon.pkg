    "existing_database_wbtest.mbt": [ "native" ],
    "owned_database_wbtest.mbt": [ "native" ],
    "owned_database_custody_native_wbtest.mbt": [ "native" ],
    "transaction_state_native_wbtest.mbt": [ "native" ],
