supported_targets = "+js+wasm+native"

import {
  "moonbitlang/core/encoding/utf8",
  "actql/actql/platform_native/filesystem",
}

import {
  "moonbitlang/core/env",
} for "wbtest"

options(
  "native-stub": [ "sqlite_stub.c" ],
  targets: {
    "sqlite_native.mbt": [ "native" ],
    "sqlite_unsupported.mbt": [ "not", "native" ],
    "sqlite_wbtest.mbt": [ "native" ],
    "diagnostic_ceiling_native_wbtest.mbt": [ "native" ],
    "readback_retirement_native_wbtest.mbt": [ "native" ],
    "exact_removal_native_wbtest.mbt": [ "native" ],
    "existing_database_wbtest.mbt": [ "native" ],
    "owned_database_wbtest.mbt": [ "native" ],
    "sqlite_unsupported_wbtest.mbt": [ "not", "native" ],
  },
)
