supported_targets = "js"

pkgtype(kind: "foreign_library")

import {
  "actql/actql/connectors/sheets/catalog",
  "actql/actql/source_value" @source,
  "actql/actql/decode_shape" @shape,
  "actql/actql/execution_relation" @execution,
  "actql/actql/encode_core" @encode,
  "actql/actql/canonical_value" @canonical,
  "actql/actql/decode_core" @decode,
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
}

import {
  "actql/actql/client_local_host" @client_host,
  "actql/actql/physical_resources" @resources,
  "actql/actql/client_row_source_host" @row_source_host,
  "actql/actql/run_publication_host" @publication_host,
  "actql/actql/canonical_json" @identity,
  "actql/actql/sha256" @sha,
} for "wbtest"
