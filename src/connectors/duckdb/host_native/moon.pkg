supported_targets = "+js+wasm+native"

import {
  "actql/actql/connectors/duckdb/adapter" @duckdb,
  "actql/actql/connectors/duckdb/acquisition" @duckdb_query,
  "actql/actql/connectors/duckdb/compute" @duckdb_compute,
  "actql/actql/connectors/duckdb/driver" @duckdb_driver,
  "actql/actql/connectors/duckdb/standard_host" @duckdb_standard_host,
  "actql/actql/connectors/local/driver" @local_driver,
  "actql/actql/connectors/duckdb/host" @duckdb_host,
  "actql/actql/connectors/duckdb/adapters/native" @native_duckdb,
  "actql/actql/decode_core" @decode,
  "actql/actql/execution_relation" @execution,
  "actql/actql/physical_resources" @resources,
  "actql/actql/physical_strategy" @strategy,
  "actql/actql/platform_native/run_publication" @native_publication,
  "actql/actql/platform_native/http_client" @http,
  "actql/actql/platform_native/retained_task_file" @retained_file,
  "actql/actql/platform_native/trusted_clock" @clock,
  "actql/actql/run_publication" @publication,
  "moonbitlang/core/encoding/utf8",
  "actql/actql/run_publication_host" @publication_host,
}

import {
  "actql/actql/source_value" @source,
  "actql/actql/value_contract" @contract,
  "actql/actql/value_admission" @admitted,
  "moonbitlang/core/env",
} for "wbtest"
