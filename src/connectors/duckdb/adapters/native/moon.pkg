supported_targets = "+js+wasm+native"

import {
  "moonbitlang/core/encoding/utf8",
  "actql/actql/platform_native/runtime_bundle" @bundle,
  "actql/actql/platform_native/signature",
}

import {
  "moonbitlang/core/env",
  "moonbitlang/core/string",
} for "wbtest"

options(
  "native-stub": [ "duckdb_stub.c" ],
  targets: {
    "duckdb_native.mbt": [ "native" ],
    "duckdb_unsupported.mbt": [ "not", "native" ],
    "duckdb_wbtest.mbt": [ "native" ],
    "duckdb_environment_readback.generated_wbtest.mbt": [ "native" ],
    "duckdb_unsupported_wbtest.mbt": [ "not", "native" ],
  },
)
