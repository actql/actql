supported_targets = "+js+wasm+native"

import {
  "actql/actql/connectors/kintone/catalog",
  "actql/actql/client_row_source_host" @rows,
  "actql/actql/query_planning" @planning,
  "actql/actql/run_publication" @publication,
  "actql/actql/value_contract" @contract,
  "actql/actql/value_admission" @admitted,
  "actql/actql/sha256" @sha,
  "actql/actql/encode_core" @encode,
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonbitlang/core/debug",
} for "wbtest"

options(
  targets: {
    "record_create_standard_js_wbtest.mbt": [ "js" ],
  },
)
