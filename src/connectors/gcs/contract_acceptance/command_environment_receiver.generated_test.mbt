test "actual B GCS Command environment receiver output enters original Common" {
  let wire = "{\"command_contracts\":[{\"atomicity\":\"single_target\",\"command_id\":\"command:exports.gcs.upload.v1\",\"connector_id\":\"exports\",\"contract_cid\":\"sha256:01b4437a23e585b15309e958d28d7069d58f3f9002ec6fffe8458dc24b58fa39\",\"idempotency\":{\"support\":\"unsupported\"},\"input_contract\":{\"additional_properties\":false,\"fields\":{\"content\":{\"nullable\":false,\"type\":\"content_ref\"},\"content_type\":{\"nullable\":false,\"type\":\"string\"},\"name\":{\"nullable\":false,\"type\":\"string\"},\"overwrite\":{\"nullable\":false,\"type\":\"boolean\"}},\"required_fields\":[\"content\",\"name\"]},\"input_schema\":{\"cid\":\"sha256:d15b2d1c7b0555836d28a967fa895f56ced810a056e4045c500e760181fa5fac\",\"id\":\"exports.gcs.upload.command_input\",\"version\":\"gcs/0.1\"},\"minimum_approval\":\"required\",\"outcome\":\"synchronous\",\"output_schema\":{\"cid\":\"sha256:57da33bdf9e0d3470e4c6436b26c9fb1162cc3200c0e0c331ee28d8ab2afe5ad\",\"id\":\"exports.gcs.upload.command_output\",\"version\":\"gcs/0.1\"},\"permissions\":[\"storage.objects.create\",\"storage.objects.delete\",\"storage.objects.get\"],\"preview\":{\"strength\":\"exact\"},\"reversibility\":\"unknown\",\"schema\":\"actql.command_contract/0.1\",\"target\":{\"cardinality\":\"single\",\"resource_kind\":\"file_collection\"},\"version\":\"gcs/0.1\"}],\"connector_capabilities\":[],\"connector_catalogs\":[{\"catalog_cid\":\"sha256:7eceab115f2a2f4e3b708e9aa0dd627b811bdbda3ed81db8fc569fab81a7cc3b\",\"commands\":[{\"atomicity\":\"single_target\",\"command_id\":\"command:exports.gcs.upload.v1\",\"connector_id\":\"exports\",\"contract_cid\":\"sha256:01b4437a23e585b15309e958d28d7069d58f3f9002ec6fffe8458dc24b58fa39\",\"idempotency\":{\"support\":\"unsupported\"},\"input_contract\":{\"additional_properties\":false,\"fields\":{\"content\":{\"nullable\":false,\"type\":\"content_ref\"},\"content_type\":{\"nullable\":false,\"type\":\"string\"},\"name\":{\"nullable\":false,\"type\":\"string\"},\"overwrite\":{\"nullable\":false,\"type\":\"boolean\"}},\"required_fields\":[\"content\",\"name\"]},\"input_schema\":{\"cid\":\"sha256:d15b2d1c7b0555836d28a967fa895f56ced810a056e4045c500e760181fa5fac\",\"id\":\"exports.gcs.upload.command_input\",\"version\":\"gcs/0.1\"},\"minimum_approval\":\"required\",\"outcome\":\"synchronous\",\"output_schema\":{\"cid\":\"sha256:57da33bdf9e0d3470e4c6436b26c9fb1162cc3200c0e0c331ee28d8ab2afe5ad\",\"id\":\"exports.gcs.upload.command_output\",\"version\":\"gcs/0.1\"},\"permissions\":[\"storage.objects.create\",\"storage.objects.delete\",\"storage.objects.get\"],\"preview\":{\"strength\":\"exact\"},\"reversibility\":\"unknown\",\"schema\":\"actql.command_contract/0.1\",\"target\":{\"cardinality\":\"single\",\"resource_kind\":\"file_collection\"},\"version\":\"gcs/0.1\"}],\"connector_id\":\"exports\",\"connector_version\":\"gcs/0.1\",\"contracts\":[{\"body\":{\"additional_properties\":false,\"fields\":{},\"nullable\":false,\"type\":\"object\"},\"cid\":\"sha256:57da33bdf9e0d3470e4c6436b26c9fb1162cc3200c0e0c331ee28d8ab2afe5ad\",\"id\":\"exports.gcs.upload.command_output\",\"kind\":\"command_output\",\"schema\":\"actql.contract/0.1\",\"version\":\"gcs/0.1\"},{\"body\":{\"additional_properties\":false,\"fields\":{\"content\":{\"nullable\":false,\"type\":\"content_ref\"},\"content_type\":{\"nullable\":false,\"type\":\"string\"},\"name\":{\"nullable\":false,\"type\":\"string\"},\"overwrite\":{\"nullable\":false,\"type\":\"boolean\"}},\"required_fields\":[\"content\",\"name\"]},\"cid\":\"sha256:d15b2d1c7b0555836d28a967fa895f56ced810a056e4045c500e760181fa5fac\",\"id\":\"exports.gcs.upload.command_input\",\"kind\":\"command_input\",\"schema\":\"actql.contract/0.1\",\"version\":\"gcs/0.1\"}],\"schema\":\"actql.connector_catalog/0.1\",\"source_views\":[]}],\"connector_manifest\":{\"connectors\":[{\"connector\":\"gcs\",\"connector_id\":\"exports\",\"connector_version\":\"gcs/0.1\"}],\"version\":\"actql-connectors/0.1\"},\"contract_registry\":[{\"body\":{\"additional_properties\":false,\"fields\":{},\"nullable\":false,\"type\":\"object\"},\"cid\":\"sha256:57da33bdf9e0d3470e4c6436b26c9fb1162cc3200c0e0c331ee28d8ab2afe5ad\",\"id\":\"exports.gcs.upload.command_output\",\"kind\":\"command_output\",\"schema\":\"actql.contract/0.1\",\"version\":\"gcs/0.1\"},{\"body\":{\"additional_properties\":false,\"fields\":{\"content\":{\"nullable\":false,\"type\":\"content_ref\"},\"content_type\":{\"nullable\":false,\"type\":\"string\"},\"name\":{\"nullable\":false,\"type\":\"string\"},\"overwrite\":{\"nullable\":false,\"type\":\"boolean\"}},\"required_fields\":[\"content\",\"name\"]},\"cid\":\"sha256:d15b2d1c7b0555836d28a967fa895f56ced810a056e4045c500e760181fa5fac\",\"id\":\"exports.gcs.upload.command_input\",\"kind\":\"command_input\",\"schema\":\"actql.contract/0.1\",\"version\":\"gcs/0.1\"}],\"evidence_bundle_cid\":\"sha256:32edacd6d400e9f1b882f182652c24d50f2738a39c655db281fa89f0f037d4ee\",\"host_policy_profile\":{},\"mapping_contracts\":[{\"connector_manifest_cid\":\"sha256:770110acd081a211ff71ba28f48fcd784e388ca4d5207e9a7a43402c1bd3e6a0\",\"conversions\":[],\"mapping_contract_cid\":\"sha256:d17037fede59a4c49aa881dded5342de95b42aab745bd7d9eb45c1822672b72c\",\"mapping_ref\":\"mapping:exports.gcs.objects.upload.v1\",\"minimum_approval\":\"required\",\"permission_rules\":[{\"effect_kind\":\"create\",\"permissions\":[\"storage.objects.create\",\"storage.objects.delete\",\"storage.objects.get\"],\"selector_class\":\"none\",\"write_fields\":[\"content\",\"name\"]},{\"effect_kind\":\"create\",\"permissions\":[\"storage.objects.create\",\"storage.objects.delete\",\"storage.objects.get\"],\"selector_class\":\"none\",\"write_fields\":[\"content\",\"content_type\",\"name\"]},{\"effect_kind\":\"create\",\"permissions\":[\"storage.objects.create\",\"storage.objects.delete\",\"storage.objects.get\"],\"selector_class\":\"none\",\"write_fields\":[\"content\",\"name\",\"overwrite\"]},{\"effect_kind\":\"create\",\"permissions\":[\"storage.objects.create\",\"storage.objects.delete\",\"storage.objects.get\"],\"selector_class\":\"none\",\"write_fields\":[\"content\",\"content_type\",\"name\",\"overwrite\"]}],\"primary_identity\":null,\"required_fields\":[\"content\",\"name\"],\"required_permissions\":[\"storage.objects.create\",\"storage.objects.delete\",\"storage.objects.get\"],\"resource_identity_cid\":\"sha256:0cc33aa75bec736618d7e8130c52aa04c2f9228e9952da1a0988965f3931b81b\",\"row_mapping\":{\"content\":{\"field\":\"content\",\"null_behavior\":\"reject\"},\"content_type\":{\"field\":\"content_type\",\"null_behavior\":\"reject\"},\"name\":{\"field\":\"name\",\"null_behavior\":\"reject\"},\"overwrite\":{\"field\":\"overwrite\",\"null_behavior\":\"reject\"}},\"schema\":\"actql.mapping_contract/0.1\",\"store_command\":{\"catalog_cid\":\"sha256:7eceab115f2a2f4e3b708e9aa0dd627b811bdbda3ed81db8fc569fab81a7cc3b\",\"command_contract_cid\":\"sha256:01b4437a23e585b15309e958d28d7069d58f3f9002ec6fffe8458dc24b58fa39\",\"command_ref\":\"command:exports.gcs.upload.v1\"},\"target_ref\":\"connector://exports/objects\",\"target_schema\":{\"additional_properties\":false,\"fields\":{\"content\":{\"nullable\":false,\"type\":\"content_ref\"},\"content_type\":{\"nullable\":false,\"type\":\"string\"},\"name\":{\"nullable\":false,\"type\":\"string\"},\"overwrite\":{\"nullable\":false,\"type\":\"boolean\"}},\"nullable\":false,\"type\":\"object\"},\"target_schema_identity\":\"sha256:3420afa3b6d4a946a3858dde773d70f9ffd4491f083775b06009637a8d2bcf08\",\"version\":\"gcs/0.1\",\"writable_fields\":[\"content\",\"content_type\",\"name\",\"overwrite\"]}],\"model_task_contracts\":[],\"schema_snapshots\":[],\"source_views\":[],\"version\":\"actql-check-environment/0.1\"}\n"
  let original = @environment.read(@utf8.encode(wire), "sha256:32edacd6d400e9f1b882f182652c24d50f2738a39c655db281fa89f0f037d4ee", caps()).unwrap()
  let contents = catalogs(original)
  let refs = references(contents)
  let target = @environment.select_command_target(contents, "command:exports.gcs.upload.v1", 100000).unwrap()
  assert_eq(@environment.command_target_cid(target), "sha256:01b4437a23e585b15309e958d28d7069d58f3f9002ec6fffe8458dc24b58fa39")
  let command = @decode.open_object(@environment.member_body(@environment.command_target_member(target))).unwrap()
  let role = @environment.catalog_reference_for_cursor(refs, @decode.lookup(command, "input_schema").unwrap()).unwrap()
  assert_eq(@environment.contract_identity(@environment.reference_contract(role)).2, "sha256:d15b2d1c7b0555836d28a967fa895f56ced810a056e4045c500e760181fa5fac")
  let (input, _) = @environment.command_target_input_contract(target, refs, value_caps(), 100000).unwrap()
  assert_eq(@environment.command_input_contract_field_count(input), 4)
  for name in ["content", "name"] { assert_true(@environment.command_input_contract_field_required(input, name)) }
  for name in ["content_type", "overwrite"] { assert_false(@environment.command_input_contract_field_required(input, name)) }
  ignore(@environment.check_protocol_value_contracts(@environment.check_source_data_policies(refs, {max_work:100000,max_policies:100}).unwrap(), {max_envelopes:100,contracts:value_caps()}).unwrap())
  let mapping = @environment.mapping_shape_at(@environment.check_mapping_contract_shapes(original,caps(),100000).unwrap(),0).unwrap()
  let bound = @environment.bind_store_command(mapping,contents,100000).unwrap()
  assert_eq(@environment.store_command_mapping_operation(bound),("create","none"))
  assert_eq(@environment.command_target_cid(@environment.store_command_target(bound)),"sha256:01b4437a23e585b15309e958d28d7069d58f3f9002ec6fffe8458dc24b58fa39")
  assert_true(physical_equal(@environment.member_environment(@environment.command_target_member(@environment.store_command_target(bound))),original))
  let copied = @environment.read(@utf8.encode(wire),@environment.cid(original),caps()).unwrap()
  assert_true(@environment.bind_store_command(mapping,catalogs(copied),100000) is Err(@environment.StoreCommandIssue::ForeignEnvironment))
}
