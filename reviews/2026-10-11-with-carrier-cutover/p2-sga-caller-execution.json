  "beforeDeltaFix": {
    "source": "7efa46683d3e414f26260c816806cd03cca56678",
    "path": "src/query_program/graph_delta_program.mbt",
    "sha256": "1cd276649a0f0edd583d86f2bbfe44917e90f5c9fbac77b7ad8feb66ae839aab",
    "text": "///|\n// Retain the Graph contract and lower only the existing named argument roles.\n// Delta JSON, exact row count, identity/base/target and resource validation\n// remain with the common checker and application owner.\nfn lower_script_graph_delta(\n  construction : Construction,\n  query : @query.Query,\n  call : @query.SgaCall,\n  graph : String,\n  known : Array[Input],\n  limits : Limits,\n  steps : Array[@builder.Node],\n  reserved : Array[String],\n) -> String raise Abort {\n  let origin = match\n    @origin.range(@query.query_document(query), call.start, call.end) {\n    Ok(origin) => origin\n    Err(_) => raise Abort(InvalidContext)\n  }\n  let construction = { ..construction, generated: origin, }\n  let body = construction.object(\n    call.arguments.map(argument => {\n      (\n        argument.0,\n        script_traversal_argument(construction, argument.1, known, limits),\n      )\n    }),\n  )\n  let output = pipe_physical_name(reserved, \"aql_sga_\")\n  reserved.push(output)\n  steps.push(\n    construction.object([\n      (\"from\", construction.text(graph)),\n      (\"apply_graph_delta\", body),\n      (\"as\", construction.text(output)),\n    ]),\n  )\n  output\n}\n"
  },
  "minimumFix": "Resolve apply_graph_delta.field against its declared with Relation using the existing selector resolver; preserve ordinary producer, column matching and common JSON/type/application ownership. No evaluator, fallback or new identity law.",
  "refusalBoundaryCorrections": [
    "Numeric MATCH fields reject Syntax(Expected identifier) at the adopted FieldRef parser.",
    "Missing traversal selector field rejects UnknownColumn at operand name resolution. Common operation/domain refusals remain unchanged."
  ],
