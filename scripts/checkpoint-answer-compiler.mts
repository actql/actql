import {compileWireTemplate} from './wire-template-compiler.mjs';
import type {CheckpointAnswerContract} from './checkpoint-answer-wire.mjs';

export function compileCheckpointAnswer(contract: CheckpointAnswerContract) {
  const bindings = `const contract = ${JSON.stringify(contract, null, 2)} as CheckpointAnswerContract;\n` +
    `export type AnswerDecision = ${contract.recipe.decisions.map(value => JSON.stringify(value)).join(' | ')};\n` +
    'const valid = structuralWireValidator({compositeConstants: true});';
  const {module, types} = compileWireTemplate('checkpoint-answer-construction', bindings,
    '// Generated by scripts/generate-client-host-wire.mjs; do not edit.\n');
  return {module, declarations: types};
}
