import {readFileSync} from 'node:fs';
import {fileURLToPath} from 'node:url';
import ts from 'typescript';
import {structuralValidatorSource} from './generate-client-publication-wire.mjs';
import type {CheckpointAnswerContract} from './checkpoint-answer-wire.mjs';

const template = fileURLToPath(new URL('./templates/checkpoint-answer-construction.mts', import.meta.url));
const configuration = fileURLToPath(new URL('../tsconfig.tooling.json', import.meta.url));
const marker = '/* @checkpoint-answer-bindings */';

export function compileCheckpointAnswer(contract: CheckpointAnswerContract) {
  const source = readFileSync(template, 'utf8');
  const pieces = source.split(marker);
  if (pieces.length !== 2) throw new Error('InvalidCheckpointAnswerTemplate');
  const bindings = `const contract = ${JSON.stringify(contract, null, 2)} as CheckpointAnswerContract;\n` +
    "type SummarySchema = CheckpointAnswerContract['summary'];\n" +
    `export type AnswerDecision = ${contract.recipe.decisions.map(value => JSON.stringify(value)).join(' | ')};\n` +
    structuralValidatorSource({compositeConstants: true, inlineTypeScript: true});
  const materialized = pieces.join(bindings);
  const diagnostics: ts.Diagnostic[] = [];
  const config = ts.getParsedCommandLineOfConfigFile(configuration, {}, {...ts.sys,
    onUnRecoverableConfigFileDiagnostic: value => diagnostics.push(value)});
  if (config === undefined || diagnostics.length || config.errors.length) {
    throw new Error(`InvalidCheckpointAnswerCompilerOptions: ${ts.formatDiagnostics(diagnostics.concat(config?.errors ?? []), diagnosticHost)}`);
  }
  const options = {...config.options, types: [], noEmitOnError: true};
  const host = ts.createCompilerHost(options);
  const getSource = host.getSourceFile;
  host.getSourceFile = (path, target, onError, forceNew) => path === template
    ? ts.createSourceFile(template, materialized, target, true)
    : getSource(path, target, onError, forceNew);
  const program = ts.createProgram([template], options, host);
  const outputs = new Map<string, string>();
  const entry = program.getSourceFile(template);
  if (entry === undefined) throw new Error('MissingCheckpointAnswerTemplate');
  const result = program.emit(entry, (name, contents) => outputs.set(name, contents));
  if (result.emitSkipped || result.diagnostics.length) {
    throw new Error(`InvalidCheckpointAnswerTemplate: ${ts.formatDiagnostics(result.diagnostics, diagnosticHost)}`);
  }
  const module = outputs.get(template.replace(/\.mts$/u, '.mjs'));
  const declarations = outputs.get(template.replace(/\.mts$/u, '.d.mts'));
  if (outputs.size !== 2 || module === undefined || declarations === undefined) {
    throw new Error('IncompleteCheckpointAnswerEmit');
  }
  const header = '// Generated by scripts/generate-client-host-wire.mjs; do not edit.\n';
  return {module: header + module, declarations: header + declarations};
}

const diagnosticHost: ts.FormatDiagnosticsHost = {
  getCanonicalFileName: name => name,
  getCurrentDirectory: ts.sys.getCurrentDirectory,
  getNewLine: () => '\n',
};
