        {
          "name": "Test Native Salesforce Effect preview",
          "run": "ulimit -S -s 65536\nnode scripts/test-native-salesforce-effect-preview.mjs\n",
          "id": "native-preview",
          "env": {
            "ACTQL_TEST_SCRATCH_ROOT": "${{ runner.temp }}/native-tests/native-preview"
          }
        },
        {
          "name": "Test Native runtime bundle CLI",
          "run": "ulimit -S -s 65536\nnode scripts/test-native-runtime-bundle-cli.mjs\n",
          "id": "native-bundle-cli",
          "env": {
            "ACTQL_TEST_SCRATCH_ROOT": "${{ runner.temp }}/native-tests/native-bundle-cli"
          }
        },
        {
          "name": "Test Native publication Store lock",
          "run": "ulimit -S -s 65536\nnode scripts/test-native-publication-store-lock.mjs\n",
          "id": "native-publication-lock",
          "env": {
            "ACTQL_TEST_SCRATCH_ROOT": "${{ runner.temp }}/native-tests/native-publication-lock"
          }
        },
        {
          "name": "Test Native remote runtime",
          "run": "ulimit -S -s 65536\nnode scripts/test-native-remote-runtime.mjs\n",
          "id": "native-remote",
          "env": {
            "ACTQL_TEST_SCRATCH_ROOT": "${{ runner.temp }}/native-tests/native-remote"
          }
        }
      ]
    },
    {
      "name": "resident-controls",
