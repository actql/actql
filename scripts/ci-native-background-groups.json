        {
          "name": "Test Native Resident Source",
          "run": "ulimit -S -s 65536\nnode scripts/test-native-resident-site.mjs --source-only\n",
          "id": "native-source",
          "env": {
            "ACTQL_TEST_SCRATCH_ROOT": "${{ runner.temp }}/native-tests/native-source"
          }
        },
        {
          "name": "Test Native observation replay",
          "run": "ulimit -S -s 65536\nnode scripts/test-native-resident-site.mjs --observation-replay-only\n",
          "id": "native-observation",
          "env": {
            "ACTQL_TEST_SCRATCH_ROOT": "${{ runner.temp }}/native-tests/native-observation"
          }
        },
        {
          "name": "Test Native release recovery",
          "run": "ulimit -S -s 65536\nnode scripts/test-native-resident-site.mjs --release-recovery-only\n",
          "id": "native-release",
          "env": {
            "ACTQL_TEST_SCRATCH_ROOT": "${{ runner.temp }}/native-tests/native-release"
          }
        },
        {
          "name": "Test Native cancellation",
          "run": "ulimit -S -s 65536\nnode scripts/test-native-resident-site.mjs --cancel-only\n",
          "id": "native-cancel",
          "env": {
            "ACTQL_TEST_SCRATCH_ROOT": "${{ runner.temp }}/native-tests/native-cancel"
          }
        }
      ]
    },
    {
      "name": "resident-product",
      "steps": [
        {
          "name": "Test public packed Run materials against native resident Site",
          "run": "node scripts/test-packed-resident-materials.mjs",
          "id": "packed-materials",
          "env": {
            "ACTQL_TEST_SCRATCH_ROOT": "${{ runner.temp }}/packed-resident-materials"
          }
        },
        {
          "name": "Test packed exact dispatch recovery against native resident Site",
          "run": "node scripts/test-packed-resident-materials.mjs --redelivery-only",
          "id": "packed-redelivery",
          "env": {
            "ACTQL_TEST_SCRATCH_ROOT": "${{ runner.temp }}/packed-resident-redelivery"
          }
        },
        {
          "name": "Test packed Output report custody and ACK crash boundaries",
          "run": "node scripts/test-packed-resident-materials.mjs --output-report-only",
          "id": "packed-output-report",
          "env": {
            "ACTQL_TEST_SCRATCH_ROOT": "${{ runner.temp }}/packed-output-report"
          }
        }
      ]
    },
    {
      "name": "retained-product",
      "steps": [
        {
          "name": "Verify registered Native retained product path",
          "run": "moon build --target js --release src/benchmark_obligations src/connectors/duckdb/host_node \\\n  src/connectors_builtin_node src/physical_strategy_example src/physical_task_manifest_example \\\n  src/process_host_bridge src/retained_host_bridge\nmoon build src/cmd/native_retained_case_probe --target native --release\nnode benchmarks/retained-results/native-case-probe.mjs native-acquisition-full-validation-low-selectivity/narrow/100\nnode benchmarks/retained-results/native-case-probe.mjs fixed-join-count-shrinking-intermediate/narrow/1000\nnode benchmarks/retained-results/native-estimate-calibration.mjs \\\n  native-acquisition-full-validation-low-selectivity/narrow/1000 \\\n  native-acquisition-full-validation-low-selectivity/narrow/100 \\\n  \"$RUNNER_TEMP/native-retained-calibration.json\"\nACTQL_NATIVE_CALIBRATION_PROFILE=\"$RUNNER_TEMP/native-retained-calibration.json\" \\\n  node scripts/test-native-direct-pair.mjs\n"
        }
      ]
    }
  ],
  "native-macos": [
    {
      "name": "runtime",
