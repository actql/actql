import {readFileSync, writeFileSync} from 'node:fs';
import {join} from 'node:path';
import {fileURLToPath} from 'node:url';
import {emitInterfaceTypeScript} from './typescript-interface-emit.mjs';

const compilerRoot = new URL('../', import.meta.url);
const templatePath = 'scripts/templates/update-target-data-codec.mts';
const marker = '/* @update-target-data-ceilings */';
const header = '// Generated by scripts/generate-update-target-data-codec.mjs. Do not edit.\n';

export function generateUpdateTargetDataCodec(root: string, write = false) {
  const owner = readFileSync(join(root, 'src/run_publication_host/client_effect_target_original_data.mbt'), 'utf8');
  const template = readFileSync(join(root, templatePath), 'utf8').split(marker);
  if (template.length !== 2) throw new Error('Invalid UPDATE transport codec ceiling marker');
  const material = readFileSync(join(root, 'src/remote_site_protocol/poll.mbt'), 'utf8');
  const materialMaximum = /pub const REMOTE_RUN_MATERIALS_MAX_BYTES\s*:\s*Int\s*=\s*(\d+)/u.exec(material)?.[1];
  if (materialMaximum === undefined) throw new Error('Missing existing Run material ceiling');
  const constant = (name: string) => {
    const match = new RegExp(`const ${name}\\s*:\\s*Int\\s*=\\s*(\\d+)`, 'u').exec(owner);
    if (!match) throw new Error(`Missing original Owner codec ceiling: ${name}`);
    return match[1];
  };
  const ceilings = [
    `const metadataMaximum = ${constant('CLIENT_EFFECT_TARGET_ORIGINAL_MAX_BYTES')};`,
    `const originalMaximum = 6 * ${materialMaximum} + metadataMaximum;`,
    `const maxDepth = ${constant('CLIENT_EFFECT_TARGET_ORIGINAL_MAX_DEPTH')};`,
  ].join('\n');
  const outputs = emitInterfaceTypeScript(compilerRoot, new URL(templatePath, compilerRoot), template.join(ceilings));
  for (const [ext, stale] of [['.mjs', 'Stale UPDATE transport codec'],
    ['.d.mts', 'Stale UPDATE transport codec declarations']] as const) {
    const output = outputs.get(ext);
    if (output === undefined) throw new Error('Incomplete UPDATE transport codec emit');
    const body = header + output;
    const path = join(root, `adapters/host-node/update-target-data.generated${ext}`);
    let actual: string | undefined;
    try { actual = readFileSync(path, 'utf8'); }
    catch (error) { if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error; }
    if (actual === body) continue;
    if (!write) throw new Error(stale);
    writeFileSync(path, body);
  }
}

if (process.argv[1] === fileURLToPath(import.meta.url)) {
  if (!['--write', '--check'].includes(process.argv[2]) || process.argv.length !== 3) throw new Error('Use --write or --check');
  generateUpdateTargetDataCodec(fileURLToPath(new URL('../', import.meta.url)), process.argv[2] === '--write');
}
