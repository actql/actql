import assert from 'node:assert/strict';
import { readFileSync, writeFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

type TypingCase = {source?: unknown; type?: string; issue?: string};
type FixedType = {nullable?: boolean; [field: string]: unknown};
type TypingCorpus = {version: string; fields: object; parameters: object;
  types: Record<string, FixedType>; positive: TypingCase[]; negative: TypingCase[]};

const literal = (text: string) => '"' + [...text].map(c => {
  const cp = c.codePointAt(0)!;
  return cp < 32 || cp > 126 ? '\\u{' + cp.toString(16) + '}' : c === '"' || c === '\\' ? '\\' + c : c;
}).join('') + '"';

export function generate(corpus: TypingCorpus) {
  assert.equal(corpus.version, 'actql-expression-typing-corpus/0.1');
  assert.ok(corpus.positive.length && corpus.negative.length);
  assert.ok(corpus.fields && corpus.parameters && corpus.types);
  const seen = new Set<string>();
  const lines = ['// Generated by scripts/check-expression-typing.mjs --write. Do not edit.'];
  const fields = literal(JSON.stringify(corpus.fields));
  const params = literal(JSON.stringify(corpus.parameters));
  lines.push('', '///|', `fn corpus_fields() -> String { ${fields} }`, '', '///|', `fn corpus_parameters() -> String { ${params} }`);
  for (const [group, entries] of [['accepted', corpus.positive], ['rejected', corpus.negative]] as const) {
    for (const [index, entry] of entries.entries()) {
      assert.ok(Object.hasOwn(entry, 'source'));
      const source = JSON.stringify(entry.source);
      assert.ok(!seen.has(source), 'duplicate source');
      seen.add(source);
      let expectation: string;
      if (group === 'accepted') {
        const expected = entry.type === undefined ? undefined : corpus.types[entry.type];
        assert.ok(expected && typeof expected.nullable === 'boolean', 'missing fixed type expectation');
        expectation = JSON.stringify(expected);
      } else {
        const issue = entry.issue;
        assert.ok(typeof issue === 'string' && ['TypeMismatch', 'NullTypeUnresolved', 'UnknownField',
          'UnknownParameter', 'MissingJoinScope', 'InvalidStaticOption', 'ForbiddenConstructorValue'].includes(issue), 'unknown issue');
        expectation = issue;
      }
      lines.push('', '///|', `test "expression type corpus ${group}: ${index + 1}" {`,
        `  ${group === 'accepted' ? 'assert_type' : 'assert_rejected'}(${literal(source)}, corpus_fields(), corpus_parameters(), ${literal(expectation)})`, '}');
    }
  }
  return lines.join('\n') + '\n';
}

if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
  const corpus: TypingCorpus = JSON.parse(readFileSync('portability/corpus/actql-expression-typing-v0.1.json', 'utf8'));
  const output = generate(corpus);
  const path = 'src/expression_typing/corpus.generated_test.mbt';
  if (process.argv.includes('--write')) writeFileSync(path, output);
  else assert.equal(readFileSync(path, 'utf8'), output, 'expression type tests are stale');
  console.log(`${corpus.positive.length} accepted and ${corpus.negative.length} rejected fixed type vectors; runtime evaluation is not tested.`);
}
