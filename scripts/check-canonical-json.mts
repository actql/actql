function main() {
  const args = process.argv.slice(2);
  assert.ok(args.length === 0 || (args.length === 1 && args[0] === '--write'));
  const inputs = fixtures();
  const expected = generateTests(inputs);
  if (args[0] === '--write') writeFileSync(output, expected);
  else assert.equal(readFileSync(output, 'utf8'), expected, 'canonical JSON tests are stale; run npm run generate:canonical');
  console.log(inputs.length + ' canonical JSON identities verified; generated tests match their inputs.');
}

if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) main();
