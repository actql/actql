{
  "version": "actql/0.1",
  "id": "property-graph-parallel",
  "stages": [{
    "id": "source",
    "inputs": {},
    "steps": [
      {"values": {"schema": {"id": {"type": "number", "nullable": false}}, "rows": [{"id": 1}]}, "as": "nodes"},
      {"values": {"schema": {"key": {"type": "number", "nullable": false}, "src": {"type": "number", "nullable": false}, "dst": {"type": "number", "nullable": false}}, "rows": [{"key": 10, "src": 1, "dst": 1}, {"key": 11, "src": 1, "dst": 1}]}, "as": "edges"},
      {"property_graph": {
        "version": "actql-property-graph-constructor/0.1",
        "nodes": [{"name": "N", "from": "nodes", "key": ["id"], "labels": [{"name": "Node", "properties": {"mode": "all_columns"}}]}],
        "edges": [{"name": "E", "from": "edges", "key": ["key"], "source": {"definition": "N", "key": ["src"]}, "target": {"definition": "N", "key": ["dst"]}, "labels": [{"name": "R", "properties": {"mode": "all_columns"}}]}]
      }, "as": "g"},
      {"match_edges": {"definition": "E", "label": "R", "where": "key > 0", "fields": ["key"]}, "as": "matched"}
    ],
    "results": {"out": {"from": "matched", "fields": ["key"]}}
  }],
  "results": {"answer": {"from": {"stage": "source", "result": "out"}}}
}
