  "sql": "SELECT o.id AS id, o.StageName, o.NextStep,\n       c.content AS notes\nFROM salesforce.opportunities AS o\nJOIN drive.files AS f ON f.name = o.name\nJOIN drive.contents AS c USING (resource, version)\n|> ASSERT UNIQUE BY (id)\n|> INFER `model-task:deal-review.v1`\n     INPUT (StageName, NextStep, notes) AS review\n|> WHERE review.outcome = 'ok' AND review.value.changed\n|> RESULT updates\n|> EFFECT UPDATE salesforce.Opportunity\n     ID id SET (\n       StageName = review.value.stage,\n       NextStep = review.value.next_step\n     );",
  "qualification": "Independent complete typed compiler inputs for the current README deal-review example. Source declarations are static contracts, not observed rows, issued ResourceRef/ContentRef values, installed connector authority or model execution. File names are not keys; the authored ASSERT UNIQUE BY enforces deal correlation.",
