{
  "name": "actql-specification",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:docs": "npm run check:contracts && npm run check:links && npm run check:examples && npm run test:docs && npm run check:nest && npm run check:unicode && npm run check:encoding && npm run check:canonical && npm run check:value-contracts",
    "check:value-contracts": "node scripts/check-value-contracts.mjs",
    "generate:value-contracts": "node scripts/check-value-contracts.mjs --write",
    "check:canonical": "node scripts/check-canonical-json.mjs && node --test scripts/canonical-json.test.mjs",
    "generate:canonical": "node scripts/check-canonical-json.mjs --write",
    "check:encoding": "node scripts/check-json-encoding.mjs && node --test scripts/json-encoding.test.mjs",
    "generate:encoding": "node scripts/check-json-encoding.mjs --write",
    "check:unicode": "python3 scripts/generate-unicode-tables.py --check && python3 -m unittest discover -s scripts -p test_unicode_generation.py",
    "check:nest": "node scripts/check-nest-reference.mjs",
    "generate:nest": "node scripts/check-nest-reference.mjs --write",
    "check:contracts": "node scripts/check-actql-spec-family.mjs",
    "check:links": "node scripts/check-document-links.mjs",
    "check:examples": "node scripts/check-document-examples.mjs",
    "test:docs": "node --test scripts/document-validation.test.mjs",
    "generate:requirements": "node scripts/check-actql-spec-family.mjs --write",
    "check:metadata": "node scripts/update-document-metadata.mjs",
    "update:metadata": "node scripts/update-document-metadata.mjs --write && npm run generate:requirements"
  },
  "devDependencies": {
    "github-slugger": "2.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.0"
  }
}
