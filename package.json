{
  "name": "actql-specification",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:windows": "node scripts/window-schema.mjs && node --test scripts/window-schema.test.mjs",
    "check:carrier-projections": "node scripts/carrier-projection-schema.mjs && node --test scripts/carrier-projection-schema.test.mjs",
    "check:graph": "node scripts/graph-schema.mjs && node --test scripts/graph-schema.test.mjs",
    "check:relation-nest": "node scripts/nest-schema.mjs && node scripts/check-relation-nest.mjs && node --test scripts/relation-nest.test.mjs",
    "generate:relation-nest": "node scripts/check-relation-nest.mjs --write",
    "check:docs": "npm run check:contracts && npm run check:links && npm run check:examples && npm run test:docs && npm run check:nest && npm run check:unicode && npm run check:encoding && npm run check:canonical && npm run check:value-contracts && npm run check:value-admission && npm run check:parameters && npm run check:parameter-identities && npm run check:expression-text && npm run check:expression-syntax && npm run check:expression-typing && npm run check:relation-typing && npm run check:pipeline-typing && npm run check:relation-results && npm run check:relation-join && npm run check:relation-append && npm run check:relation-nest && npm run check:values && npm run check:windows && npm run check:carrier-projections && npm run check:graph && npm run check:vector && npm run check:events",
    "check:events": "node scripts/event-schema.mjs && node --test scripts/event-schema.test.mjs",
    "check:vector": "node scripts/vector-schema.mjs && node --test scripts/vector-schema.test.mjs",
    "check:relation-append": "node scripts/check-relation-append.mjs && node --test scripts/relation-append.test.mjs && npm run check:relation-set",
    "check:relation-set": "node scripts/set-schema.mjs && node --test scripts/set-schema.test.mjs",
    "check:values": "node scripts/values-schema.mjs && node --test scripts/values-schema.test.mjs",
    "generate:relation-append": "node scripts/check-relation-append.mjs --write",
    "check:relation-results": "node scripts/check-relation-results.mjs && node --test scripts/relation-results.test.mjs",
    "generate:relation-results": "node scripts/check-relation-results.mjs --write",
    "check:pipeline-typing": "node scripts/check-pipeline-typing.mjs && node --test scripts/pipeline-typing.test.mjs",
    "generate:pipeline-typing": "node scripts/check-pipeline-typing.mjs --write",
    "check:relation-typing": "node scripts/check-relation-typing.mjs && node scripts/aggregate-schema.mjs && node scripts/pivot-schema.mjs && node scripts/analytic-schema.mjs && node scripts/top-k-schema.mjs && node --test scripts/relation-typing.test.mjs scripts/aggregate-schema.test.mjs scripts/pivot-schema.test.mjs scripts/analytic-schema.test.mjs scripts/top-k-schema.test.mjs",
    "generate:relation-typing": "node scripts/check-relation-typing.mjs --write",
    "check:expression-typing": "node scripts/check-expression-typing.mjs && node --test scripts/expression-typing.test.mjs",
    "generate:expression-typing": "node scripts/check-expression-typing.mjs --write",
    "check:expression-syntax": "node scripts/check-expression-syntax.mjs && node --test scripts/expression-syntax.test.mjs",
    "generate:expression-syntax": "node scripts/check-expression-syntax.mjs --write",
    "check:expression-text": "node scripts/check-expression-text.mjs && node --test scripts/expression-text.test.mjs",
    "generate:expression-text": "node scripts/check-expression-text.mjs --write",
    "check:parameter-identities": "node scripts/parameter-identity.mjs && node --test scripts/parameter-identity.test.mjs",
    "generate:parameter-identities": "node scripts/parameter-identity.mjs --write",
    "generate:parameter-identity-schema": "node scripts/parameter-identity.mjs --write-schema",
    "check:parameters": "node scripts/check-parameters.mjs && node --test scripts/parameters.test.mjs",
    "generate:parameters": "node scripts/check-parameters.mjs --write",
    "generate:parameter-schemas": "node scripts/parameter-schema.mjs --write",
    "check:value-admission": "node scripts/check-value-admission.mjs && node --test scripts/value-admission.test.mjs",
    "generate:value-admission": "node scripts/check-value-admission.mjs --write",
    "check:value-contracts": "node scripts/check-value-contracts.mjs",
    "generate:value-contracts": "node scripts/check-value-contracts.mjs --write",
    "check:canonical": "node scripts/check-canonical-json.mjs && node --test scripts/canonical-json.test.mjs",
    "generate:canonical": "node scripts/check-canonical-json.mjs --write",
    "check:encoding": "node scripts/check-json-encoding.mjs && node --test scripts/json-encoding.test.mjs",
    "generate:encoding": "node scripts/check-json-encoding.mjs --write",
    "check:unicode": "python3 scripts/generate-unicode-tables.py --check && python3 -m unittest discover -s scripts -p test_unicode_generation.py",
    "check:nest": "node scripts/check-nest-reference.mjs",
    "generate:nest": "node scripts/check-nest-reference.mjs --write",
    "check:contracts": "node scripts/check-actql-spec-family.mjs && npm run check:aoa",
    "check:aoa": "node scripts/check-aoa-versions.mjs && node --test scripts/aoa-versions.test.mjs scripts/pure-operation-laws.test.mjs",
    "check:links": "node scripts/check-document-links.mjs",
    "check:examples": "node scripts/check-document-examples.mjs",
    "test:docs": "node --test scripts/document-validation.test.mjs",
    "generate:requirements": "node scripts/check-actql-spec-family.mjs --write",
    "check:metadata": "node scripts/update-document-metadata.mjs",
    "update:metadata": "node scripts/update-document-metadata.mjs --write && npm run generate:requirements",
    "check:relation-join": "node scripts/check-relation-join.mjs && node --test scripts/relation-join.test.mjs && node scripts/cross-join-schema.mjs && node --test scripts/cross-join-schema.test.mjs",
    "generate:relation-join": "node scripts/check-relation-join.mjs --write"
  },
  "devDependencies": {
    "github-slugger": "2.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.0"
  }
}
