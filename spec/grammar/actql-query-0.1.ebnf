(* GoogleSQL-derived ActQL query surface. Semantic restrictions are in
   docs/spec/query-text.md. This grammar does not define GoogleSQL as a whole. *)
query         = sql_query | pipe_query ;
sql_query     = [ with_clause ], select_core, { set_part },
                [ order_clause ], [ limit_clause ], [ ";" ] ;
with_clause   = "WITH", cte, { ",", cte } ;
cte           = identifier, "AS", "(", select_core, ")" ;
select_core   = "SELECT", [ "DISTINCT" ], select_list, "FROM", source,
                { join }, [ where_clause ], [ group_clause ],
                [ having_clause ] ;
pipe_query    = "FROM", source, { "|>", pipe_item }, [ ";" ] ;
source        = path, [ source_alias ]
              | "(", select_core, [ order_clause ], [ limit_clause ], ")",
                source_alias ;
source_alias  = [ "AS" ], identifier ;
join          = [ "INNER" | "LEFT", [ "OUTER" ]
                | "FULL", [ "OUTER" ] ],
                "JOIN", source, ( "ON", expression
                | "USING", "(", identifier, { ",", identifier }, ")" )
              | "CROSS", "JOIN", source ;
where_clause  = "WHERE", expression ;
group_clause  = "GROUP", "BY", expression, { ",", expression } ;
having_clause = "HAVING", expression ;
select_list   = select_item, { ",", select_item } ;
select_item   = "*" | path, ".", "*"
              | expression, [ "AS", identifier ] ;
order_clause  = "ORDER", "BY", sort_item, { ",", sort_item } ;
sort_item     = expression, [ "ASC" | "DESC" ],
                [ "NULLS", ( "FIRST" | "LAST" ) ] ;
limit_clause  = "LIMIT", integer, [ "OFFSET", integer ] ;
set_part      = ( "UNION", ( "ALL" | "DISTINCT" )
              | "INTERSECT", "DISTINCT" | "EXCEPT", "DISTINCT" ),
                [ "BY", "NAME" ], select_core ;
pipe_item     = where_clause | "SELECT", select_list
              | "EXTEND", select_list
              | "SET", assignment, { ",", assignment }
              | "DROP", identifier, { ",", identifier }
              | "RENAME", rename, { ",", rename }
              | "AS", identifier
              | "AGGREGATE", select_list, [ group_clause ]
              | join | order_clause | limit_clause
              | pipe_set_part ;
pipe_set_part = ( "UNION", ( "ALL" | "DISTINCT" )
              | "INTERSECT", "DISTINCT" | "EXCEPT", "DISTINCT" ),
                [ "BY", "NAME" ], "(", select_core, ")" ;
assignment    = identifier, "=", expression ;
rename        = identifier, "AS", identifier ;
path          = identifier, { ".", identifier } ;
expression    = ? closed query expression grammar in query-text.md ? ;
identifier    = ? ASCII identifier or backtick-quoted identifier ? ;
integer       = ? decimal integer within the adopted exact range ? ;
