regex       = alternation ;
alternation = sequence, { "|", sequence } ;
sequence    = atom, { atom } ;
atom        = primary, [ quantifier ] ;
primary     = scalar | escape | class | group | "." | "^" | "$" ;
group       = "(", alternation, ")" ;
class       = "[", [ "^" ], class-item, { class-item }, "]" ;
class-item  = class-scalar | class-escape | class-range | escaped-meta | class-hyphen ;
class-range = class-endpoint, "-", class-endpoint ;
class-endpoint = class-scalar | escaped-meta | "\\", ( "n" | "r" | "t" ) ;
class-hyphen = ? unescaped "-" in the first or last item position ? ;
quantifier  = "?" | "*" | "+" | "{", uint, [ ",", [ uint ] ], "}" ;
uint        = "0" | nonzero-digit, { digit } ;
escape      = "\\", ( meta | "n" | "r" | "t" | "d" | "D" | "s" | "S" | "w" | "W" ) ;
escaped-meta = "\\", meta ;
meta        = "\\" | "." | "^" | "$" | "|" | "?" | "*" | "+" | "(" | ")" | "[" | "]" | "{" | "}" | "-" ;
scalar      = ? one Unicode scalar except regex metacharacters ? ;
class-scalar = ? one Unicode scalar except "\\", "]", and unescaped range "-" ? ;
class-escape = "\\", ( "d" | "D" | "s" | "S" | "w" | "W" | "n" | "r" | "t" ) ;
digit       = "0" | nonzero-digit ;
nonzero-digit = "1" | "2" | "3" | "4" | "5" | "6" | "7" | "8" | "9" ;
