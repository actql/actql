AQL '0.1';
PROGRAM 'sga.traverse_paths' {
  STAGE main {
    DATA nodes = OP values {
      "schema": {"id": {"type": "string", "nullable": false}},
      "rows": [{"id": "A"}, {"id": "B"}]
    };
    DATA edges = OP values {
      "schema": {
        "src": {"type": "string", "nullable": false},
        "dst": {"type": "string", "nullable": false}
      },
      "rows": [{"src": "A", "dst": "B"}]
    };
    DATA seeds = OP values {
      "schema": {"id": {"type": "string", "nullable": false}},
      "rows": [{"id": "A"}]
    };
    DATA g = OP graph {
      "nodes": {"from": "nodes", "id": "id", "fields": []},
      "edges": {"from": "edges", "source": "src", "target": "dst", "fields": []}
    };
    DATA paths = FROM g |> traverse(
      start: {from: seeds, id: "id"}, direction: "out",
      min_hops: 1, max_hops: 2, max_output_rows: 4, emit: "paths");
    RESULT answer = {
      "from": "paths",
      "fields": ["start_id", "end_id", "hop_count", "node_ids", "edge_ids"]
    };
  }
  RESULT answer = {"from": {"stage": "main", "result": "answer"}};
}
