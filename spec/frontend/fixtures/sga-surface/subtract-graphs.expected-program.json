{
  "version": "actql/0.1", "id": "sga.subtract_graphs",
  "stages": [{
    "id": "main", "inputs": {},
    "steps": [
      {"values": {"schema": {"id": {"type": "string", "nullable": false}}, "rows": [{"id": "A"}, {"id": "B"}, {"id": "C"}, {"id": "D"}]}, "as": "base_nodes"},
      {"values": {"schema": {"src": {"type": "string", "nullable": false}, "dst": {"type": "string", "nullable": false}}, "rows": [{"src": "A", "dst": "B"}, {"src": "B", "dst": "C"}, {"src": "C", "dst": "D"}]}, "as": "base_edges"},
      {"values": {"schema": {"id": {"type": "string", "nullable": false}}, "rows": [{"id": "C"}, {"id": "D"}]}, "as": "removal_nodes"},
      {"values": {"schema": {"src": {"type": "string", "nullable": false}, "dst": {"type": "string", "nullable": false}}, "rows": [{"src": "C", "dst": "D"}]}, "as": "removal_edges"},
      {"graph": {"nodes": {"from": "base_nodes", "id": "id", "fields": []}, "edges": {"from": "base_edges", "source": "src", "target": "dst", "fields": []}}, "as": "base"},
      {"graph": {"nodes": {"from": "removal_nodes", "id": "id", "fields": []}, "edges": {"from": "removal_edges", "source": "src", "target": "dst", "fields": []}}, "as": "removals"},
      {"from": "base", "subtract_graphs": {"with": "removals"}, "as": "remaining"},
      {"from": "remaining", "node_rows": true, "as": "node_output"},
      {"from": "remaining", "edge_rows": true, "as": "edge_output"}
    ],
    "results": {
      "nodes": {"from": "node_output", "fields": ["id"], "order_by": [{"id": "asc"}]},
      "edges": {"from": "edge_output", "fields": ["src", "dst", "rel"], "order_by": [{"src": "asc"}, {"dst": "asc"}, {"rel": "asc"}]}
    }
  }],
  "results": {
    "nodes": {"from": {"stage": "main", "result": "nodes"}},
    "edges": {"from": {"stage": "main", "result": "edges"}}
  }
}
