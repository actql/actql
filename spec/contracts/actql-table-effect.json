{
  "version": "actql-table-effect-contract/0.1",
  "identity": {
    "request": "canonical_complete_operation_excluding_only_request_cid",
    "receipt": "canonical_complete_receipt_excluding_only_receipt_cid",
    "mapping": "canonical_complete_mapping_excluding_only_mapping_cid",
    "generation": "sha256_of_exact_published_iceberg_metadata_file_bytes",
    "table": "catalog_identity_and_immutable_iceberg_table_uuid",
    "snapshot_id": "nullable_decimal_string_not_generation_or_logical_content_cid"
  },
  "semantics": {
    "input": "one_complete_checked_relation_per_operation_not_per_row",
    "create": "name_absent_at_atomic_publication",
    "replace": "same_table_uuid_exact_expected_generation_same_schema_cid",
    "empty": "typed_empty_table_no_fabricated_row_or_snapshot_id",
    "multiplicity": "preserve_duplicate_rows",
    "ordering": "no_query_order_from_physical_file_or_iceberg_sort_order",
    "approval": "required_before_table_staging_and_publication_current_authority_rechecked",
    "unknown": "reconcile_original_operation_no_resend_no_potentially_published_file_cleanup",
    "publication": "durable_catalog_head_and_original_operation_record_in_one_transaction",
    "completion": "confirmed_original_catalog_commit_not_http_admission_or_staging",
    "recovery": "operation_record_retained_independently_of_head_and_later_commits",
    "retention": "independent_of_origin_run_release_or_named_result_ttl",
    "capacity": "finite_persistent_limits_include_retained_staged_and_unknown_files",
    "refusal": "typed_prewrite_refusal_for_unsupported_contracts_or_storage_exhaustion",
    "external_writers": "outside_initial_provider_capability"
  },
  "presence": {
    "binding": "sealed_logical_column_to_value_and_companion_iceberg_field_ids",
    "false_null": "missing_logical_column",
    "true_null": "present_null_requires_logical_nullable",
    "true_value": "present_value_requires_checked_type",
    "false_value": "reject",
    "missing_or_null_companion": "reject_before_default_projection",
    "missing_value_field": "reject_before_default_projection",
    "required_column": "value_field_physically_present_without_companion_nullable_independent",
    "physical_namespace": "__actql_presence_",
    "ordinary_reader": "physical_companions_visible_no_implicit_actql_presence_semantics"
  },
  "schemas": {
    "operation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:actql:table-operation:0.1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "logical_request_scope_cid",
        "effect_identity_cid",
        "action",
        "catalog_identity_cid",
        "namespace",
        "table_name",
        "expected_table",
        "input_artifact_cid",
        "input_relation_cid",
        "schema_cid",
        "storage_mapping_cid",
        "data_policy_cid",
        "request_cid"
      ],
      "properties": {
        "version": {
          "const": "actql-table-operation/0.1"
        },
        "logical_request_scope_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "effect_identity_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "action": {
          "enum": [
            "create",
            "replace"
          ]
        },
        "catalog_identity_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "namespace": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 1,
          "maxItems": 16
        },
        "table_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expected_table": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "table_uuid",
                "generation_cid"
              ],
              "properties": {
                "table_uuid": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "generation_cid": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "input_artifact_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "input_relation_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "schema_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "storage_mapping_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "data_policy_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "request_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "receipt": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:actql:table-receipt:0.1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "request_cid",
        "effect_identity_cid",
        "catalog_identity_cid",
        "table_uuid",
        "generation_cid",
        "metadata_location",
        "snapshot_id",
        "schema_cid",
        "storage_mapping_cid",
        "row_count",
        "receipt_cid"
      ],
      "properties": {
        "version": {
          "const": "actql-table-receipt/0.1"
        },
        "request_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "effect_identity_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "catalog_identity_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "table_uuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "generation_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "metadata_location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "snapshot_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "storage_mapping_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "row_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "receipt_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "storage_mapping": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:actql:table-storage-mapping:0.1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "schema_cid",
        "iceberg_format_version",
        "columns",
        "mapping_cid"
      ],
      "properties": {
        "version": {
          "const": "actql-table-storage-mapping/0.1"
        },
        "schema_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "iceberg_format_version": {
          "const": 2
        },
        "columns": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value_field_id",
              "presence_field_id",
              "physical_type",
              "nullable",
              "presence"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "value_field_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "presence_field_id": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "physical_type": {
                "enum": [
                  "boolean",
                  "double",
                  "string"
                ]
              },
              "nullable": {
                "type": "boolean"
              },
              "presence": {
                "enum": [
                  "required",
                  "conditional"
                ]
              }
            }
          }
        },
        "mapping_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
