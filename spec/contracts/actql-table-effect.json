{
  "version": "actql-table-effect-contract/0.1",
  "identity": {
    "request": "canonical_complete_operation_excluding_only_request_cid",
    "receipt": "canonical_complete_receipt_excluding_only_receipt_cid",
    "noncommit_receipt": "canonical_complete_noncommit_receipt_excluding_only_receipt_cid",
    "mapping": "canonical_complete_mapping_excluding_only_mapping_cid",
    "generation": "opaque_immutable_connector_publication_identity",
    "table": "catalog_identity_and_immutable_table_uuid",
    "physical_receipt": "opaque_self_cid_of_connector_validated_original_receipt_retained_with_saved_response"
  },
  "semantics": {
    "input": "one_complete_checked_carrier_per_operation_not_per_row_connector_declares_supported_kind",
    "create": "name_absent_at_atomic_publication",
    "replace": "same_table_uuid_exact_expected_generation_same_schema_cid",
    "empty": "typed_empty_table_no_fabricated_row",
    "multiplicity": "preserve_duplicate_rows",
    "ordering": "no_query_order_from_backend_storage",
    "approval": "required_before_table_staging_and_publication_current_authority_rechecked",
    "unknown": "reconcile_original_operation_no_resend_no_potentially_published_file_cleanup",
    "publication": "durable_catalog_head_and_original_operation_record_in_one_transaction",
    "completion": "confirmed_original_catalog_commit_not_http_admission_or_staging",
    "recovery": "operation_record_retained_independently_of_head_and_later_commits",
    "noncommit": "validated_conflict_original_operation_record_and_publication_fence_atomic_not_http_or_absent_head",
    "retention": "independent_of_origin_run_release_or_named_result_ttl",
    "capacity": "finite_persistent_limits_include_retained_staged_and_unknown_files",
    "refusal": "typed_prewrite_refusal_for_unsupported_contracts_or_storage_exhaustion",
    "external_writers": "outside_initial_provider_capability"
  },
  "presence": {
    "binding": "sealed_connector_validated_mapping_of_complete_logical_schema",
    "states": "omission_present_null_present_value_remain_distinct",
    "required": "absence_rejected_nullable_is_independent",
    "invalid_encoding": "reject_no_defaulting_or_null_padding"
  },
  "schemas": {
    "operation": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:actql:table-operation:0.1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "logical_request_scope_cid",
        "effect_identity_cid",
        "action",
        "catalog_identity_cid",
        "namespace",
        "table_name",
        "expected_table",
        "input_artifact_cid",
        "input_carrier",
        "schema_cid",
        "storage_mapping_cid",
        "data_policy_cid",
        "request_cid"
      ],
      "properties": {
        "version": {
          "const": "actql-table-operation/0.1"
        },
        "logical_request_scope_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "effect_identity_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "action": {
          "enum": [
            "create",
            "replace"
          ]
        },
        "catalog_identity_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "namespace": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 1,
          "maxItems": 16
        },
        "table_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expected_table": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "table_uuid",
                "generation_cid"
              ],
              "properties": {
                "table_uuid": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "generation_cid": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "input_artifact_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "input_carrier": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "cid"
          ],
          "properties": {
            "kind": {
              "enum": [
                "relation",
                "graph",
                "vectors",
                "events"
              ]
            },
            "cid": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "schema_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "storage_mapping_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "data_policy_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "request_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "receipt": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:actql:table-receipt:0.1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "request_cid",
        "effect_identity_cid",
        "catalog_identity_cid",
        "table_uuid",
        "generation_cid",
        "physical_receipt_cid",
        "schema_cid",
        "storage_mapping_cid",
        "row_count",
        "receipt_cid"
      ],
      "properties": {
        "version": {
          "const": "actql-table-logical-receipt/0.1"
        },
        "request_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "effect_identity_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "catalog_identity_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "table_uuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "generation_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "physical_receipt_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "schema_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "storage_mapping_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "row_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "receipt_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "noncommit_receipt": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:actql:table-noncommit-receipt:0.1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "request_cid",
        "effect_identity_cid",
        "catalog_identity_cid",
        "schema_cid",
        "storage_mapping_cid",
        "reason",
        "receipt_cid"
      ],
      "properties": {
        "version": {
          "const": "actql-table-noncommit-receipt/0.1"
        },
        "request_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "effect_identity_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "catalog_identity_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "schema_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "storage_mapping_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "reason": {
          "enum": [
            "CreateNameConflict",
            "ExpectedGenerationConflict"
          ]
        },
        "receipt_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "storage_mapping": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:actql:table-storage-mapping-reference:0.1",
      "type": "object",
      "required": [
        "version",
        "schema_cid",
        "mapping_cid"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "schema_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "mapping_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    }
  }
}
