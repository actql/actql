{
  "version": "actql-source-response-policy-contract/0.1",
  "schemas": {
    "policy": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "source_ref",
        "source_view_contract_cid",
        "source_data_policy_cid",
        "minimum_classification",
        "classification"
      ],
      "properties": {
        "version": {
          "const": "actql-source-response-policy/0.1"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_view_contract_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_data_policy_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "minimum_classification": {
          "anyOf": [
            {
              "enum": [
                "public",
                "internal",
                "confidential",
                "restricted"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted",
            "unknown"
          ]
        }
      }
    }
  },
  "semantics": {
    "identity": "entire_policy_canonical_json_utf8_sha256_no_self_cid",
    "classification": "authoritative_unknown_stays_unknown_otherwise_max_authoritative_and_authored_minimum",
    "source": "exact_selected_sourceview_and_its_admitted_data_policy_reference",
    "exclusions": "no_request_input_provenance_observation_host_permission_or_capacity",
    "authority": "policy_identity_is_not_egress_or_execution_permission"
  }
}
