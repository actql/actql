        "parameter_declarations": "none-or-original-supplied-or-declared-default-values",
        "proof": "original-checked-owner-audit",
        "source_selection": "explicit",
        "take_count_minimum": 1,
        "take_maximum": 9007199254740991,
        "take_offset_minimum": 0,
