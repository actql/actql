    "profile": {
      "const": "actql-effect-free-local-completion-free/0.1"
    },
    "rules": {
      "const": [
        {
          "id": "sort.candidate_key_completion",
          "path": "original decoded Program Sort body",
          "authored": "canonical JSON of the original authored Sort array",
          "canonical": "original authored keys in priority followed by actual missing selected candidate-key fields ascending with nulls last",
          "requires": "original same-pipeline same-step SortOrder and selected candidate-key proof with nonzero appended_count"
        }
      ]
    },
