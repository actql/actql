        "binary_set_rows": "existing-complete-typed-row-admission-and-comparison-owners",
        "append_order": "original-left-then-right",
        "set_duplicates": [
          "all",
          "distinct"
        ],
        "set_order": "original-earliest-left-occurrences-no-new-total-order",
        "binary_set_stage_scope": "complete-original-units; prepass-and-every-unit-step-alignment-visit-charged-to-same-audit-work-limit",
