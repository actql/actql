        "distinct_scope": "original-same-pipeline-step-whole-row-or-authored-required-key-projection",
        "distinct_input": "complete-original-row-and-presence-admission-remains-with-execution",
        "distinct_order": "existing-first-occurrence-no-new-total-order",
