      "properties": {
        "dispatch_request_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "holding_evidence_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "logical_view_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "managed_profile_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "material_generation": {
          "type": "string",
          "minLength": 1
        },
        "measurement_evidence_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "physical_manifest_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "representation_codec_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "result_schema_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "retained_bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 19
        },
        "row_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "version": {
          "const": "actql-remote-managed-output-subject/0.1"
        }
      }
    },
    "poll_dispatch": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispatch_request_cid",
        "input_binding_cid",
        "input_binding_json",
