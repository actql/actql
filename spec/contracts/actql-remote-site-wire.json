        "generation": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "report_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "resolution_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
