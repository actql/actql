      "properties": {
        "version": {
          "const": "actql-remote-poll-dispatch/0.1"
        },
        "dispatch_request_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "input_binding_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "input_binding_json": {
          "type": "string",
          "minLength": 1
        },
        "request_json": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "poll_cancel": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispatch_request_cid",
        "request_json",
