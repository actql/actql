          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "version": {
          "const": "actql-remote-effect-checkpoint-reply/0.1"
        }
      }
    },
    "effect_resume_delivery": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_cid",
        "claimant",
