{
  "version": "actql-remote-site-wire/0.1",
  "schemas": {
    "output_report_reply": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispatch_request_cid",
        "intent_cid",
        "outcome",
        "reason",
        "report_cid",
        "version"
      ],
      "properties": {
        "dispatch_request_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "intent_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "accepted",
            "refused"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "",
            "authorization_denied",
            "scope_mismatch",
            "report_conflict"
          ]
        },
        "report_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "version": {
          "const": "actql-remote-output-report-reply/0.1"
        }
      }
    },
    "dispatch_request": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budget_cid",
        "connector_registration",
        "connector_revision",
        "coordinator_authority",
        "dispatch_id",
        "evidence_issuer_capability_cid",
        "grant_cid",
        "input_binding_cid",
        "obligations_cid",
        "run_definition_cid",
        "runtime_bundle_cid",
        "site_generation",
        "site_key",
        "strategy_revision",
        "task_attempt",
        "task_key",
        "version"
      ],
      "properties": {
        "budget_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "connector_registration": {
          "type": "string",
          "minLength": 1
        },
        "connector_revision": {
          "type": "string",
          "minLength": 1
        },
        "coordinator_authority": {
          "type": "string",
          "minLength": 1
        },
        "dispatch_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_issuer_capability_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "grant_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "input_binding_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "obligations_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "run_definition_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "runtime_bundle_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "site_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "site_key": {
          "type": "string",
          "minLength": 1
        },
        "strategy_revision": {
          "type": "string",
          "minLength": 1
        },
        "task_attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "task_key": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "const": "actql-remote-dispatch-request/0.1"
        }
      }
    },
    "managed_output_subject": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispatch_request_cid",
        "holding_evidence_cid",
        "logical_view_cid",
        "managed_profile_cid",
        "material_generation",
        "measurement_evidence_cid",
