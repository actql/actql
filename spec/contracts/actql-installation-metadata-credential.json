{
  "version": "actql-installation-metadata-credential-contract/0.1",
  "description": "Closed installation-metadata DATA alternatives inside the existing Credential Owner. Not operational custody, current authority, funding, a durable use claim or a physical acknowledgement.",
  "$defs": {
    "cid": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000]+$", "x-actql-max-utf16-code-units": 512},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000]+$", "x-actql-max-utf16-code-units": 256},
    "positive_int64_text": {"type": "string", "pattern": "^[1-9][0-9]*$", "x-actql-maximum": "9223372036854775807"}
  },
  "schemas": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_configuration_cid", "account_id", "connection", "connector_registration", "connector_revision", "declaration_source_cid", "installation_request_id", "principal", "runtime_bundle_cid", "site_generation", "site_key", "version"],
      "properties": {
        "account_configuration_cid": {"$ref": "#/$defs/cid"},
        "account_id": {"$ref": "#/$defs/text"},
        "connection": {"$ref": "#/$defs/text"},
        "connector_registration": {"$ref": "#/$defs/text"},
        "connector_revision": {"$ref": "#/$defs/text"},
        "declaration_source_cid": {"$ref": "#/$defs/cid"},
        "installation_request_id": {"$ref": "#/$defs/request_id"},
        "principal": {"$ref": "#/$defs/text"},
        "runtime_bundle_cid": {"$ref": "#/$defs/cid"},
        "site_generation": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "site_key": {"$ref": "#/$defs/text"},
        "version": {"const": "actql-installation-metadata-preparation/0.1"}
      },
      "x-actql-max-utf8-bytes": 8192,
      "x-actql-max-value-nodes": 40,
      "x-actql-max-container-depth": 2
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expires_unix_ms", "issuer_authority", "max_uses", "metadata_occurrence_id", "operation", "preparation_subject_cid", "request_body_cid", "request_method", "request_path", "resource_origin", "subject_kind", "version"],
      "properties": {
        "expires_unix_ms": {"$ref": "#/$defs/positive_int64_text"},
        "issuer_authority": {"$ref": "#/$defs/text"},
        "max_uses": {"type": "integer", "minimum": 1, "maximum": 1024},
        "metadata_occurrence_id": {"$ref": "#/$defs/text"},
        "operation": {"$ref": "#/$defs/text"},
        "preparation_subject_cid": {"$ref": "#/$defs/cid"},
        "request_body_cid": {"const": "sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"},
        "request_method": {"const": "GET"},
        "request_path": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^/(?!/)[^?#\\r\\n\\u0000]*$", "x-actql-max-utf16-code-units": 2048},
        "resource_origin": {"type": "string", "minLength": 9, "maxLength": 2048, "pattern": "^https://[^/@ ?#\\r\\n\\u0000]+$", "x-actql-max-utf16-code-units": 2048},
        "subject_kind": {"const": "installation_metadata"},
        "version": {"const": "actql-installation-preparation-credential-grant/0.1"}
      },
      "x-actql-max-utf8-bytes": 16384,
      "x-actql-max-value-nodes": 32,
      "x-actql-max-container-depth": 2
    }
  }
}
