          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "egress_admission_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "result_delivery_receipt_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
