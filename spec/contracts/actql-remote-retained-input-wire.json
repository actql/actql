{
  "version": "actql-remote-retained-input-wire/0.1",
  "canonicalization": "UTF-8 JSON with sorted object keys, no whitespace and unchanged string values; Int64 policy values are canonical decimal strings.",
  "scope": "One checked incoming edge and one DirectStream receiver on the original producer Site and generation. Protocol admission grants no execution, borrow, Transfer or publication authority.",
