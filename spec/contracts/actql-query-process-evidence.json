  "schemas": {
    "record": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "issuer",
        "attempt",
        "requirement_cid",
        "role",
        "snapshot",
        "scan_scope_cid",
        "actual_access",
        "output"
      ],
      "properties": {
        "version": {
          "const": "actql-query-process-evidence/0.1"
        },
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "string",
          "minLength": 1
        },
        "requirement_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "role": {
          "enum": [
            "source_validation",
            "filter",
            "select"
          ]
        },
        "snapshot": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "contract_cid",
                "token_cid"
              ],
              "properties": {
                "contract_cid": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "token_cid": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "scan_scope_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "actual_access": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope_cid",
            "provider_scope_cid",
            "received_rows",
            "received_fields",
            "received_bytes"
          ],
          "properties": {
            "scope_cid": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "provider_scope_cid": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "received_rows": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "received_fields": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "received_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_cid",
            "rows_cid",
            "row_count"
          ],
          "properties": {
            "contract_cid": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "rows_cid": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "row_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    }
  },
  "semantics": {
    "preimage": "entire_record_canonical_json_utf8_sha256_no_self_cid",
