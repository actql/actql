{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CLI output verification report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verified",
    "byte_count",
    "sha256",
    "supplied_receipt_count",
    "matching_receipt_count",
    "receipt_cids"
  ],
  "properties": {
    "verified": {
      "const": true
    },
    "byte_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 536870912
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "supplied_receipt_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "matching_receipt_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "receipt_cids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    }
  },
  "$comment": "receipt_cids contains every distinct matching admitted identity; matching_receipt_count equals its length and is at most supplied_receipt_count. Other valid receipts make no claim about unprovided output files."
}
