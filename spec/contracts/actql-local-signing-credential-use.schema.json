{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:actql:local-signing-credential-use:0.1",
  "description": "Identity-only restoration of the original use; not a durable claim, permission or signature.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grant_cid",
    "use_id",
    "use_ordinal",
    "version"
  ],
  "properties": {
    "grant_cid": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "use_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "use_ordinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "version": {
      "const": "actql-local-signing-credential-use/0.1"
    }
  }
}
