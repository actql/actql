          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "row_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "byte_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "physical_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "durable_result_binding_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
