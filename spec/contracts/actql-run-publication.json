        },
        "invocation_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "logical_result_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "result_schema_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "ordering_evidence_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "codec_contract_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "material_generation_cid": {
