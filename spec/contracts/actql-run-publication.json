    "publication_request": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://smooth.dev/schemas/actql-publication-request-0.1.json",
      "title": "actql-publication-request-0.1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "tenant_id",
        "authority_scope_cid",
        "run_definition_cid",
        "inventory",
        "publication_policy_cid",
        "publication_target_cid",
        "requested_at",
        "publication_request_cid"
      ],
      "properties": {
        "version": {
          "const": "actql-publication-request/0.1"
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "authority_scope_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "run_definition_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "inventory": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "result_name",
              "result_definition_cid"
            ],
            "properties": {
              "result_name": {
                "type": "string",
                "minLength": 1
              },
              "result_definition_cid": {
