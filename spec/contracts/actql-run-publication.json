    "run_invocation": "template_matches_observation_set_and_all_required_observations_are_admitted",
    "publication_commit": "one_tenant_authority_run_definition_has_one_atomic_durable_public_index_entry",
    "publication_retry": "unknown_reconciles_under_fencing_before_retry_and_durable_commit_wins_cancel_race",
    "availability": "run_outcome_is_immutable_and_current_per_result_availability_is_separate_from_authority",
    "delivery": "attempt_identity_precedes_append_only_progress_and_retry_starts_at_byte_zero",
    "retention": "availability_authority_and_deletion_deadline_are_independent"
