        "program_definition_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "program_semantics_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "aoa_contract_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "aoa_logical_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
