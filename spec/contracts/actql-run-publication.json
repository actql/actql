        },
        "run_definition_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "result_manifest_cid": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "purpose": {
          "type": "string",
