{
  "version": "actql-client-host/0.1",
  "operations": {
    "connect": ["connection"],
    "submit": ["connection", "requestId", "kind", "input", "parameters"],
    "attach": ["connection", "ref"],
    "lookup-request": ["connection", "requestId"],
    "status": ["connection", "ref"],
    "wait": ["connection", "ref", "until"],
    "cancel": ["connection", "ref"],
    "reconcile": ["connection", "ref"],
    "read": ["connection", "ref", "resultName", "format", "attemptId"],
    "delivery-attempt": ["connection", "ref", "resultName", "attemptId"],
    "checkpoints": ["connection", "after", "limit"],
    "checkpoint-review": ["connection", "checkpointCid", "maxBytes"],
    "resolve": ["connection", "items"],
    "cancel-request": ["connection", "requestId"],
    "resources": ["connection", "resourceConnection", "query", "limit"],
    "resource-inspect": ["connection", "resourceConnection", "resource", "maxBytes"],
    "resource-peek": ["connection", "resourceConnection", "resource", "fields", "maxRows", "maxBytes"]
  },
  "schemas": {
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "kind",
        "revision"
      ],
      "properties": {
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tenantId",
            "authorityScopeCid",
            "runDefinitionCid"
          ],
          "properties": {
            "tenantId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "authorityScopeCid": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "runDefinitionCid": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "kind": {
          "enum": [
            "accepted",
            "already_requested",
            "already_terminal"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "run_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "authorityScopeCid", "runDefinitionCid"],
      "properties": {
        "tenantId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "authorityScopeCid": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "runDefinitionCid": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "owner", "consentRefs", "runners"],
      "properties": {
        "mode": {"enum": ["local", "remote", "hybrid"]},
        "owner": {"enum": ["local", "remote", "cloud"]},
        "consentRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}},
        "runners": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}},
        "durability": {"enum": ["volatile", "durable"]},
        "movementPolicyRef": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "cloudConnectionRef": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "mode", "owner", "durability", "scopeRef", "capabilities", "limits"],
      "properties": {
        "version": {"const": "actql-client-host/0.1"},
        "mode": {"enum": ["local", "remote", "hybrid"]},
        "owner": {"enum": ["local", "remote", "cloud"]},
        "durability": {"enum": ["volatile", "durable"]},
        "scopeRef": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxReadWireBytes", "maxRowWireBytes", "maxRowRetainedValueBytes", "maxRetainedValueBytes", "maxRows", "maxBatchRows", "maxBatchRetainedValueBytes"],
          "properties": {
            "maxReadWireBytes": {"type": "integer", "minimum": 1},
            "maxRowWireBytes": {"type": "integer", "minimum": 1},
            "maxRowRetainedValueBytes": {"type": "integer", "minimum": 1},
            "maxRetainedValueBytes": {"type": "integer", "minimum": 1},
            "maxRows": {"type": "integer", "minimum": 1},
            "maxBatchRows": {"type": "integer", "minimum": 1},
            "maxBatchRetainedValueBytes": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "durability", "revision"],
      "properties": {
        "ref": {"type": "object", "additionalProperties": false, "required": ["tenantId", "authorityScopeCid", "runDefinitionCid"], "properties": {"tenantId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}, "authorityScopeCid": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "runDefinitionCid": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
        "durability": {"enum": ["volatile", "durable"]},
        "revision": {"type": "integer", "minimum": 0}
      }
    },
    "lookup_found": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "requestId", "ref", "durability", "lookupExpiresAt"],
      "properties": {
        "kind": {"const": "found"},
        "requestId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "ref": {"type": "object", "additionalProperties": false, "required": ["tenantId", "authorityScopeCid", "runDefinitionCid"], "properties": {"tenantId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}, "authorityScopeCid": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "runDefinitionCid": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
        "durability": {"enum": ["volatile", "durable"]},
        "lookupExpiresAt": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}
      }
    },
    "lookup_not_found": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "not_found"}}},
    "lookup_unknown": {"type": "object", "additionalProperties": false, "required": ["kind", "reason"], "properties": {"kind": {"const": "unknown"}, "reason": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}}},
    "held": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "requestId", "prepareAttemptId", "state", "durability", "lookupExpiresAt"],
      "properties": {
        "kind": {"const": "held"},
        "requestId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "prepareAttemptId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "state": {"enum": ["waiting_checkpoint", "resuming", "ended"]},
        "durability": {"const": "durable"},
        "lookupExpiresAt": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "checkpoint": {"type": "object", "additionalProperties": false, "required": ["checkpointId", "checkpointCid", "kind", "expiresAt"], "properties": {"checkpointId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}, "checkpointCid": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "kind": {"enum": ["run_scope", "read_access", "data_egress", "cost_scope", "effect_set"]}, "expiresAt": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}}},
        "endReason": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "terminalErrorCode": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}
      }
    },
    "checkpoint_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpointId", "checkpointCid", "kind", "phase", "subject", "requiredArtifact", "reviewProjectionCid", "requirements", "createdAt", "expiresAt", "humanSummary"],
      "properties": {
        "checkpointId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "checkpointCid": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "kind": {"enum": ["run_scope", "read_access", "data_egress", "cost_scope", "effect_set"]},
        "phase": {"enum": ["preflight", "commit"]},
        "subject": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["kind", "prepareAttemptId", "requestId"], "properties": {"kind": {"const": "prepare_attempt"}, "prepareAttemptId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}, "requestId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}}},
          {"type": "object", "additionalProperties": false, "required": ["kind", "runId", "runDefinitionCid"], "properties": {"kind": {"const": "run_unit"}, "runId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}, "runDefinitionCid": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}
        ]},
        "requiredArtifact": {"type": "object", "additionalProperties": false, "required": ["type", "cid"], "properties": {"type": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}, "cid": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
        "reviewProjectionCid": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}},
        "createdAt": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "expiresAt": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "humanSummary": {"type": "string", "maxLength": 1024}
      }
    },
    "checkpoint_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "checkpointCid", "artifactCid", "byteLength", "contentBase64"],
      "properties": {
        "kind": {"const": "review"},
        "checkpointCid": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "artifactCid": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "byteLength": {"type": "integer", "minimum": 1},
        "contentBase64": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9+/]+={0,2}$"}
      }
    },
    "resolve_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpointCid", "resolutionWire", "approvalEvidenceWire"],
      "properties": {
        "checkpointCid": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "resolutionWire": {"type": "string", "minLength": 1, "maxLength": 16384},
        "approvalEvidenceWire": {"type": "string", "maxLength": 16384}
      }
    },
    "resolve_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpointCid", "status"],
      "properties": {
        "checkpointCid": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "status": {"enum": ["committed", "duplicate", "conflicting", "expired", "cancelled", "invalid"]},
        "decision": {"enum": ["approved", "rejected"]},
        "resolutionCid": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}
      }
    },
    "request_cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "kind"],
      "properties": {
        "requestId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "kind": {"enum": ["accepted", "already_requested", "already_terminal"]},
        "ref": {"type": "object", "additionalProperties": false, "required": ["tenantId", "authorityScopeCid", "runDefinitionCid"], "properties": {"tenantId": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}, "authorityScopeCid": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "runDefinitionCid": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
        "revision": {"type": "integer", "minimum": 0, "maximum": 2147483647}
      }
    },
    "resource_listing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceConnection", "observationCid", "resources", "snapshotComplete", "snapshotTruncated", "resultTruncated"],
      "properties": {
        "resourceConnection": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "observationCid": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "resources": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "outcome"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}, "outcome": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z_]+$"}}}},
        "snapshotComplete": {"type": "boolean"},
        "snapshotTruncated": {"type": "boolean"},
        "resultTruncated": {"type": "boolean"}
      }
    },
    "resource_inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceConnection", "resource", "observationCid", "status"],
      "properties": {
        "resourceConnection": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "resource": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "observationCid": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "status": {"enum": ["ready", "catalog_required"]},
        "reason": {"enum": ["listing_truncated", "not_visible", "not_observed", "not_found", "describe_unavailable"]},
        "summaryJson": {"type": "string", "minLength": 2, "maxLength": 1048576}
      }
    },
    "resource_peek": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceConnection", "resource", "observationCid", "fields", "rowsJson", "limited"],
      "properties": {
        "resourceConnection": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "resource": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"},
        "observationCid": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}},
        "rowsJson": {"type": "string", "minLength": 2, "maxLength": 4194304},
        "limited": {"type": "boolean"}
      }
    },
    "submit_preparation_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {"enum": [
          "ClientProgramInvalidInput",
          "ClientParametersInvalid",
          "ClientParametersTooLarge",
          "ClientProgramUnsupported",
          "ClientProgramNeedsInputs",
          "ClientProgramRejected"
        ]}
      }
    }
  }
}
