{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:actql:local-signing-credential-grant:0.1",
  "description": "Identity metadata only; not current permission, secret custody, a durable use claim or a signature.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "account_configuration_cid",
    "account_id",
    "attempt_id",
    "authority_scope_cid",
    "checkpoint_cid",
    "checkpoint_id",
    "checkpoint_kind",
    "expires_unix_ms",
    "host_adoption_cid",
    "issuer_authority",
    "key_configuration_cid",
    "key_generation_cid",
    "key_id",
    "key_public_key_cid",
    "max_uses",
    "preimage",
    "principal",
    "purpose",
    "request_cid",
    "request_scope_cid",
    "run_definition_cid",
    "run_invocation_cid",
    "submission_scope_cid",
    "unit_definition_cid",
    "version"
  ],
  "properties": {
    "account_configuration_cid": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "account_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "authority_scope_cid": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "checkpoint_cid": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "checkpoint_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "checkpoint_kind": {
      "enum": [
        "run_scope",
        "read_access",
        "data_egress",
        "cost_scope",
        "model_invocation",
        "effect_set"
      ]
    },
    "host_adoption_cid": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "key_configuration_cid": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "key_generation_cid": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "key_public_key_cid": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "preimage": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "principal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "request_cid": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "request_scope_cid": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "run_definition_cid": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "run_invocation_cid": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "submission_scope_cid": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "unit_definition_cid": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "purpose": {
      "enum": [
        "reviewer_proof",
        "host_attestation"
      ]
    },
    "issuer_authority": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "expires_unix_ms": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "max_uses": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "version": {
      "const": "actql-local-signing-credential-grant/0.1"
    }
  },
  "$comment": "Structural shape only. Canonical reader also enforces exact ordered bytes/CID, Int64 range and existing UTF-16 text bounds; this schema never supplies authority or custody."
}
