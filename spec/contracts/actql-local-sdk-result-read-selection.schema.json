{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:actql:local-sdk-result-read-selection:0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "connection",
    "data_policy_cids",
    "formats",
    "max_bytes",
    "max_uses",
    "principal",
    "purpose",
    "result_names",
    "run_policy_profile_cid",
    "sink",
    "version"
  ],
  "properties": {
    "connection": {
      "const": "local"
    },
    "formats": {
      "const": [
        "jsonl"
      ]
    },
    "max_bytes": {
      "const": 65536
    },
    "max_uses": {
      "const": 1
    },
    "principal": {
      "const": "local-cli"
    },
    "purpose": {
      "const": "python-local-read"
    },
    "result_names": {
      "const": [
        "answer"
      ]
    },
    "sink": {
      "const": "sdk-rows"
    },
    "version": {
      "const": "actql-local-sdk-result-read-selection/0.1"
    },
    "run_policy_profile_cid": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "data_policy_cids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    }
  }
}
