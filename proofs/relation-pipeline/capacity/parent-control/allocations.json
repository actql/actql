  "included": [
    {
      "id": "retained-parent-core",
      "objects": "aggregated RelationChainExecutionState; five scalar Refs; execution record and five callbacks; start_next environment; mutable reported_work; children and completed Array owners/backings; pending input/producer-read preparation and nullable output references",
      "phases": [
        "startup",
        "advance",
        "handoff",
        "cancel",
        "cleanup-pending",
        "cleanup-complete",
        "retained-owner-after-cleanup"
      ],
      "basis": "source/ABI core recipe with explicit Ref layout premise; backing slots from the input step-count contract; completed backing is fixed at the input step count, shares child-owned output payloads, and is reset only after all reverse child cleanup succeeds",
      "status": "current typed source census; historical ten-Ref Native layout is not applicable; current Native capture/lifetime correspondence is independently required"
    },
    {
      "id": "selected-step-context",
      "objects": "fresh GeneratedSequence record, selected_steps Int array, retained_ids reference array and result/option wrappers for each selected child; traversal ceilings Array owner/backing and (step, paths, rows) tuples in the original checked configuration",
      "phases": [
        "startup",
        "handoff",
        "cleanup-pending"
      ],
      "basis": "selected view copies shared context and traversal-ceiling references, but both newly constructed selection arrays and the record are separate allocations; traversal configuration starts with one empty Array, immutable updates copy its Array and tighten an existing occurrence or append one checked GraphTraverseStep, and old/new overlap and retained configurations remain in the census",
      "status": "complete source census; native size/lifetime bound pending"
    },
    {
      "id": "step-input-selection",
      "objects": "new Array[ManagedProviderInput] owner/backing; each new RelationInput variant; pending RelationChainInputPreparation record and probe/port state; external inputs and completed-output arrays are shared",
      "phases": [
        "startup",
        "handoff",
        "cleanup-pending"
      ],
      "basis": "port count and exact selected operation; one input in the approved unary pilot",
      "status": "native size/lifetime bound pending"
    },
    {
      "id": "internal-edge-binding",
      "objects": "ProducerBindingIdentity and BoundProducerInput records, consumer-step option and result wrappers; ProducerRead record and new column index array; pending ProducerReadPreparation record, borrowed name/offset state and temporary projection/metadata lookup wrappers; the index array is transferred rather than copied",
      "phases": [
        "handoff",
        "cleanup-pending"
      ],
      "basis": "receiving schema width, array growth and exact predecessor binding; output payload stays shared; long metadata remains owned through stop and cleanup; declared extra 512 bytes is not a proved Native bound",
      "status": "native size/lifetime bound pending"
    },
    {
      "id": "provider-selection",
      "objects": "all eleven providers and their callbacks, selection array/backing, constructor-owned helper closures/default arrays, selected execution-limits record",
      "phases": [
        "startup",
        "handoff"
      ],
      "basis": "the whole literal provider list is constructed before the first acceptance check; it is not just the returned provider",
      "status": "constructor transitive layout/capture bounds pending"
    },
    {
      "id": "poll-and-return-temporaries",
      "objects": "parent-created ManagedProviderPoll and Result wrappers, tuple/option/error adapters and initial replacement child_work_issue callback",
      "phases": [
        "startup",
        "advance",
        "handoff",
        "cancel",
        "cleanup-pending"
      ],
      "basis": "source branch-local lifetimes and one common-driver poll at a time; child-produced values retain their separate child obligation",
      "status": "allocation-count and simultaneous-live bounds pending"
    },
    {
      "id": "retirement-and-custody",
      "objects": "driver control Ref and immutable callbacks may remain reachable through LocalManagedDispatchOperations; its provider root is cleared only after stop and successful cleanup; separately retained parent execution references and accepted output and its upstream holdings; stored CompletedOutput occurrences and their original CompletedSequence.result_identity anchors until reverse cleanup; empty replacement owner overlaps the old completed container",
      "phases": [
        "cleanup-pending",
        "cleanup-complete",
        "retained-owner-after-cleanup"
      ],
      "basis": "cleanup does not destroy immutable callbacks or the control Ref; the actual driver caches final work then clears provider_execution only after stop and successful cleanup; external fixture references may still retain the parent; exact driver/common-owner source admission is checked separately and reservation retirement/custody correspondence must be demonstrated; the process-local completion identity is not a ledger holding generation; both remain distinct correspondence obligations",
      "status": "reservation retirement/custody correspondence pending; no physical-GC completion claim"
    }
