{
  "name": "@actql/explorer-ui",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "dependencies": {
    "@actql/client-wire": "0.0.0-development",
    "@base-ui/react": "1.8.0",
    "@xyflow/react": "12.12.0",
    "elkjs": "0.12.0",
    "lucide-react": "1.51.0"
  },
  "peerDependencies": {
    "@actql/sdk": "0.0.0-development",
    "react": ">=19.3.0 <20",
    "react-dom": ">=19.3.0 <20"
  },
  "exports": {
    "./read-model": {
      "types": "./read-model.d.ts",
      "default": "./read-model.mjs"
    },
    "./plan-explorer": {
      "types": "./plan-explorer.d.ts",
      "default": "./dist/plan-explorer.js"
    },
    "./styles.css": "./dist/plan-explorer.css",
    "./run-observation": {
      "types": "./run-observation.d.ts",
      "default": "./run-observation.mjs"
    },
    "./cancellation": {
      "types": "./cancellation.d.ts",
      "default": "./cancellation.mjs"
    },
    "./checkpoint-review": {
      "types": "./checkpoint-review.d.ts",
      "default": "./checkpoint-review.mjs"
    }
  },
  "files": [
    "read-model.mjs",
    "read-model.d.ts",
    "README.md",
    "dist",
    "plan-explorer.d.ts",
    "presentation-limits.mjs",
    "THIRD_PARTY_NOTICES.md",
    "ELKJS-LICENSE.md",
    "run-observation.mjs",
    "run-observation.d.ts",
    "run-inspector.d.ts",
    "cancellation-panel.d.ts",
    "cancellation-types.d.ts",
    "cancellation.mjs",
    "cancellation.d.ts",
    "checkpoint-review.mjs",
    "checkpoint-review.d.ts",
    "checkpoint-panel.d.ts"
  ],
  "scripts": {
    "build": "vite build --config vite.config.mts",
    "prepack": "npm run build"
  }
}
