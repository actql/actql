from collections.abc import AsyncIterator, Awaitable, Callable, Iterator, Mapping
from typing import Any, Generic, Literal, TypeAlias, TypeVar, overload
from ssl import SSLContext
from httpx import AsyncBaseTransport
from ._types import CheckOutcome, Profile, RunState, SubmissionLookup, CancellationAttempt, CancellationLookup

JSONValue: TypeAlias = None | bool | int | float | str | list["JSONValue"] | dict[str, "JSONValue"]
Scope: TypeAlias = Literal["template_only", "bound_input"]
SourceFormat: TypeAlias = Literal["sql", "aql-text", "aql-json", "aql-yaml", "json", "yaml"]
Token: TypeAlias = str | Callable[[], str | Awaitable[str]]
_T = TypeVar("_T")

class ClientError(Exception):
    code: str
    cleanup_client: AsyncClient | Client | None
    submission_ref: Mapping[str, Any] | None
    attempt_ref: Mapping[str, Any] | None
    cancel_ref: Mapping[str, Any] | None
    outcome: Observation[dict[str, Any]] | None
    signed: tuple[Mapping[str, Any], ...] | None
    attempt_id: str | None
    rows_yielded: int | None
    def __init__(self, code: str, **facts: Any) -> None: ...

class Observation(Mapping[str, Any], Generic[_T]):
    def __init__(self, value: _T) -> None: ...
    def __getitem__(self, key: str) -> Any: ...
    def __iter__(self) -> Iterator[str]: ...
    def __len__(self) -> int: ...
    def to_dict(self) -> _T: ...

class Signer:
    key_id: str
    reviewer_id: str
    sign: Callable[[bytes], bytes | str | Awaitable[bytes | str]]
    authority_scope_cid: str | None
    def __init__(self, key_id: str, reviewer_id: str, sign: Callable[[bytes], bytes | str | Awaitable[bytes | str]], authority_scope_cid: str | None = ...) -> None: ...

class AsyncClient:
    @classmethod
    async def connect(cls, endpoint: str, token: Token, *, workspace_id: str | None = ..., durability: Literal["durable", "volatile"] = ..., verify: bool | SSLContext = ..., timeout: float = ..., transport: AsyncBaseTransport | None = ...) -> AsyncClient: ...
    @property
    def profile(self) -> Mapping[str, Any]: ...
    async def __aenter__(self) -> AsyncClient: ...
    async def __aexit__(self, *exc: Any) -> None: ...
    async def aclose(self) -> None: ...
    def new_submission(self, *, nonce: str | None = ...) -> Mapping[str, Any]: ...
    def start(self, program: dict[str, JSONValue], *, submission_ref: Mapping[str, Any], parameters: dict[str, JSONValue] | None = ..., attempt_id: str | None = ...) -> Awaitable[AsyncExecution]: ...
    def start_source(self, text: str, *, format: SourceFormat, submission_ref: Mapping[str, Any], parameters: dict[str, JSONValue] | None = ..., parameter_declarations: dict[str, JSONValue] = ..., attempt_id: str | None = ...) -> Awaitable[AsyncExecution]: ...
    @overload
    def check(self, input: str, *, kind: Literal["text"], scope: Literal["template_only"], format: Literal["sql", "aql-text"], parameter_declarations: dict[str, JSONValue] = ...) -> Awaitable[Observation[CheckOutcome]]: ...
    @overload
    def check(self, input: str, *, kind: Literal["text"], scope: Literal["bound_input"], format: Literal["sql", "aql-text"], parameter_declarations: dict[str, JSONValue] = ..., parameters: dict[str, JSONValue] | None = ...) -> Awaitable[Observation[CheckOutcome]]: ...
    @overload
    def check(self, input: dict[str, JSONValue], *, kind: Literal["program"], scope: Literal["template_only"]) -> Awaitable[Observation[CheckOutcome]]: ...
    @overload
    def check(self, input: dict[str, JSONValue], *, kind: Literal["program"], scope: Literal["bound_input"], parameters: dict[str, JSONValue] | None = ...) -> Awaitable[Observation[CheckOutcome]]: ...
    def lookup_submission(self, reference: Mapping[str, Any]) -> Awaitable[Observation[SubmissionLookup]]: ...
    def attach(self, reference: Mapping[str, str]) -> Awaitable[AsyncExecution]: ...
    async def checkpoints(self, *, after: str = ..., limit: int = ...) -> Observation[dict[str, Any]]: ...
    def review_checkpoint(self, checkpoint: str | Mapping[str, Any], *, max_bytes: int = ...) -> Awaitable[Mapping[str, Any]]: ...
    def resolve_checkpoints(self, items: list[dict[str, Any]], *, signer: Signer | None = ...) -> Awaitable[Observation[dict[str, Any]]]: ...

class AsyncExecution:
    @property
    def ref(self) -> Mapping[str, str]: ...
    @property
    def submission(self) -> Observation[dict[str, Any]] | None: ...
    async def status(self) -> Observation[RunState]: ...
    async def wait(self, *, until: str | None = ...) -> Observation[RunState]: ...
    async def reconcile(self) -> Observation[RunState]: ...
    def cancel(self, *, cancel_id: str | None = ..., expected_revision: int | None = ..., attempt_id: str | None = ...) -> Awaitable[Observation[CancellationAttempt]]: ...
    def lookup_cancellation(self, reference: Mapping[str, Any]) -> Awaitable[Observation[CancellationLookup]]: ...
    def result(self, name: str) -> AsyncResult: ...

class AsyncResult:
    def rows(self, *, max_wire_bytes: int | None = ..., max_row_wire_bytes: int | None = ..., max_row_retained_value_bytes: int | None = ...) -> AsyncReader: ...
    async def all(self, *, max_rows: int | None = ..., max_retained_value_bytes: int | None = ..., max_wire_bytes: int | None = ..., max_row_wire_bytes: int | None = ..., max_row_retained_value_bytes: int | None = ...) -> list[dict[str, JSONValue]]: ...
    async def delivery_attempt(self, attempt_id: str) -> Observation[dict[str, Any]]: ...

class AsyncReader(AsyncIterator[dict[str, JSONValue]]):
    @property
    def attempt_id(self) -> str: ...
    @property
    def rows_yielded(self) -> int: ...
    async def __aenter__(self) -> AsyncReader: ...
    async def __aexit__(self, *exc: Any) -> None: ...
    def __aiter__(self) -> AsyncReader: ...
    async def __anext__(self) -> dict[str, JSONValue]: ...
    async def aclose(self) -> None: ...
    async def delivery_attempt(self) -> Observation[dict[str, Any]]: ...

class Client:
    @classmethod
    def connect(cls, endpoint: str, token: Token, *, workspace_id: str | None = ..., durability: Literal["durable", "volatile"] = ..., verify: bool | SSLContext = ..., timeout: float = ..., transport: AsyncBaseTransport | None = ...) -> Client: ...
    @property
    def profile(self) -> Mapping[str, Any]: ...
    def __enter__(self) -> Client: ...
    def __exit__(self, *exc: Any) -> None: ...
    def close(self) -> None: ...
    def new_submission(self, *, nonce: str | None = ...) -> Mapping[str, Any]: ...
    def start(self, program: dict[str, JSONValue], *, submission_ref: Mapping[str, Any], parameters: dict[str, JSONValue] | None = ..., attempt_id: str | None = ...) -> Execution: ...
    def start_source(self, text: str, *, format: SourceFormat, submission_ref: Mapping[str, Any], parameters: dict[str, JSONValue] | None = ..., parameter_declarations: dict[str, JSONValue] = ..., attempt_id: str | None = ...) -> Execution: ...
    @overload
    def check(self, input: str, *, kind: Literal["text"], scope: Literal["template_only"], format: Literal["sql", "aql-text"], parameter_declarations: dict[str, JSONValue] = ...) -> Observation[CheckOutcome]: ...
    @overload
    def check(self, input: str, *, kind: Literal["text"], scope: Literal["bound_input"], format: Literal["sql", "aql-text"], parameter_declarations: dict[str, JSONValue] = ..., parameters: dict[str, JSONValue] | None = ...) -> Observation[CheckOutcome]: ...
    @overload
    def check(self, input: dict[str, JSONValue], *, kind: Literal["program"], scope: Literal["template_only"]) -> Observation[CheckOutcome]: ...
    @overload
    def check(self, input: dict[str, JSONValue], *, kind: Literal["program"], scope: Literal["bound_input"], parameters: dict[str, JSONValue] | None = ...) -> Observation[CheckOutcome]: ...
    def lookup_submission(self, reference: Mapping[str, Any]) -> Observation[SubmissionLookup]: ...
    def attach(self, reference: Mapping[str, str]) -> Execution: ...
    def checkpoints(self, *, after: str = ..., limit: int = ...) -> Observation[dict[str, Any]]: ...
    def review_checkpoint(self, checkpoint: str | Mapping[str, Any], *, max_bytes: int = ...) -> Mapping[str, Any]: ...
    def resolve_checkpoints(self, items: list[dict[str, Any]], *, signer: Signer | None = ...) -> Observation[dict[str, Any]]: ...

class Execution:
    @property
    def ref(self) -> Mapping[str, str]: ...
    @property
    def submission(self) -> Observation[dict[str, Any]] | None: ...
    def status(self) -> Observation[RunState]: ...
    def wait(self, *, until: str | None = ...) -> Observation[RunState]: ...
    def reconcile(self) -> Observation[RunState]: ...
    def cancel(self, *, cancel_id: str | None = ..., expected_revision: int | None = ..., attempt_id: str | None = ...) -> Observation[CancellationAttempt]: ...
    def lookup_cancellation(self, reference: Mapping[str, Any]) -> Observation[CancellationLookup]: ...
    def result(self, name: str) -> Result: ...

class Result:
    def rows(self, *, max_wire_bytes: int | None = ..., max_row_wire_bytes: int | None = ..., max_row_retained_value_bytes: int | None = ...) -> Reader: ...
    def all(self, *, max_rows: int | None = ..., max_retained_value_bytes: int | None = ..., max_wire_bytes: int | None = ..., max_row_wire_bytes: int | None = ..., max_row_retained_value_bytes: int | None = ...) -> list[dict[str, JSONValue]]: ...
    def delivery_attempt(self, attempt_id: str) -> Observation[dict[str, Any]]: ...

class Reader(Iterator[dict[str, JSONValue]]):
    @property
    def attempt_id(self) -> str: ...
    @property
    def rows_yielded(self) -> int: ...
    def __enter__(self) -> Reader: ...
    def __exit__(self, *exc: Any) -> None: ...
    def __iter__(self) -> Reader: ...
    def __next__(self) -> dict[str, JSONValue]: ...
    def close(self) -> None: ...
    def delivery_attempt(self) -> Observation[dict[str, Any]]: ...

def get_submission_input(result: AsyncExecution | Execution | ClientError) -> Mapping[str, Any] | None: ...
def get_submission_check_observation(error: ClientError) -> Observation[CheckOutcome] | None: ...
def get_check_input(observation: Observation[CheckOutcome], document_id: str, revision: str | None = ...) -> Mapping[str, Any] | None: ...
def resolve_check_location(observation: Observation[CheckOutcome], location: Mapping[str, Any], current_input: Mapping[str, Any] | None = ...) -> Mapping[str, Any] | None: ...
def resolve_check_text_range(observation: Observation[CheckOutcome], location: Mapping[str, Any], current_input: Mapping[str, Any] | None = ...) -> Mapping[str, Any] | None: ...
def explain_check_reason(reason: Mapping[str, Any]) -> Mapping[str, str]: ...
def get_check_fixes(observation: Observation[CheckOutcome]) -> tuple[Mapping[str, Any], ...] | None: ...
