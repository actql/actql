from dataclasses import dataclass as _dataclass
from collections.abc import AsyncIterator, Awaitable, Callable, Iterator, Mapping
from typing import Any, Generic, Literal, Protocol, TypeAlias, TypeVar, overload
from ssl import SSLContext
from os import PathLike as _PathLike
from ._run_state import RunState as RunState
from ._check_observation import CheckReport as CheckReport, CheckReason as CheckReason
from httpx import AsyncBaseTransport
from ._types import CheckOutcome, Profile, SubmissionLookup, CancellationAttempt, CancellationLookup

JSONValue: TypeAlias = None | bool | int | float | str | list["JSONValue"] | dict[str, "JSONValue"]
Scope: TypeAlias = Literal["template_only", "bound_input"]
SourceFormat: TypeAlias = Literal["sql", "aql", "aql-text", "aql-json", "aql-yaml", "json", "yaml"]
Token: TypeAlias = str | Callable[[], str | Awaitable[str]]
_T = TypeVar("_T")
_T_co = TypeVar("_T_co", covariant=True)

class _RowModel(Protocol[_T_co]):
    def model_validate(self, value: Any, *, strict: Literal[True]) -> _T_co: ...

class _RowValidator(Protocol[_T_co]):
    def validate_python(self, value: Any, *, strict: Literal[True]) -> _T_co: ...

_RowSchema: TypeAlias = _RowModel[_T] | _RowValidator[_T]


class ClientError(Exception):
    code: str
    execution: AsyncExecution | None
    observation: RunState | None
    cleanup_client: AsyncClient | Client | None
    submission_ref: Mapping[str, Any] | None
    request_id: str | None
    attempt_ref: Mapping[str, Any] | None
    cancel_ref: Mapping[str, Any] | None
    outcome: Observation[dict[str, Any]] | None
    signed: tuple[Mapping[str, Any], ...] | None
    attempt_id: str | None
    rows_yielded: int | None
    original_error: BaseException | None
    cleanup_error: BaseException | None
    validation_error: Exception | None
    def __init__(self, code: str, **facts: Any) -> None: ...

class RequestConflict(ClientError):
    def __init__(self, **facts: Any) -> None: ...

class Observation(Mapping[str, Any], Generic[_T]):
    def __init__(self, value: _T) -> None: ...
    def __getitem__(self, key: str) -> Any: ...
    def __iter__(self) -> Iterator[str]: ...
    def __len__(self) -> int: ...
    def to_dict(self) -> _T: ...


@_dataclass(frozen=True, slots=True, eq=False, init=False)
class CheckObservation(Observation[CheckOutcome]):
    version: Literal["actql-check-outcome/0.1"]
    outcome: Literal["completed", "failed", "unavailable"]
    reason_schema_cid: str
    outcome_schema_cid: str
    report: CheckReport | None
    partial_report: CheckReport | None
    problem: Mapping[str, Any] | None
    correlation_ref: str | None
    def __init__(self, value: CheckOutcome) -> None: ...


class Signer:
    key_id: str
    reviewer_id: str
    sign: Callable[[bytes], bytes | str | Awaitable[bytes | str]]
    authority_scope_cid: str | None
    def __init__(self, key_id: str, reviewer_id: str, sign: Callable[[bytes], bytes | str | Awaitable[bytes | str]], authority_scope_cid: str | None = ...) -> None: ...

class AsyncClient:
    @classmethod
    async def open(cls, *, state_dir: str | _PathLike[str] | None = ..., signer: Signer | None = ...) -> AsyncClient: ...
    @classmethod
    @overload
    async def connect(cls, *, mode: Literal["local"], installation: str | _PathLike[str] | None = ..., signer: Signer | None = ...) -> AsyncClient: ...
    @classmethod
    @overload
    async def connect(cls, endpoint: str, token: Token = ..., *, mode: Literal["remote"] = ..., workspace_id: str | None = ..., durability: Literal["durable", "volatile"] = ..., verify: bool | SSLContext = ..., timeout: float = ..., transport: AsyncBaseTransport | None = ..., signer: Signer | None = ...) -> AsyncClient: ...
    @property
    def profile(self) -> Mapping[str, Any]: ...
    async def __aenter__(self) -> AsyncClient: ...
    async def __aexit__(self, *exc: Any) -> None: ...
    async def aclose(self) -> None: ...
    def new_submission(self, *, nonce: str | None = ...) -> Mapping[str, Any]: ...
    def start(self, program: dict[str, JSONValue], *, submission_ref: Mapping[str, Any] | None = ..., request_id: str | None = ..., parameters: dict[str, JSONValue] | None = ..., attempt_id: str | None = ..., stop_before: Literal["commit"] = ..., read_only: Literal[True] = ...) -> Awaitable[AsyncExecution]: ...
    def start_source(self, text: str, *, format: SourceFormat, submission_ref: Mapping[str, Any] | None = ..., request_id: str | None = ..., parameters: dict[str, JSONValue] | None = ..., parameter_declarations: dict[str, JSONValue] = ..., attempt_id: str | None = ..., stop_before: Literal["commit"] = ..., read_only: Literal[True] = ...) -> Awaitable[AsyncExecution]: ...
    @overload
    def check(self, input: str, *, kind: Literal["text"], scope: Literal["template_only"], format: Literal["sql", "aql", "aql-text"], parameter_declarations: dict[str, JSONValue] = ...) -> Awaitable[CheckObservation]: ...
    @overload
    def check(self, input: str, *, kind: Literal["text"], scope: Literal["bound_input"], format: Literal["sql", "aql", "aql-text"], parameter_declarations: dict[str, JSONValue] = ..., parameters: dict[str, JSONValue] | None = ...) -> Awaitable[CheckObservation]: ...
    @overload
    def check(self, input: dict[str, JSONValue], *, kind: Literal["program"], scope: Literal["template_only"]) -> Awaitable[CheckObservation]: ...
    @overload
    def check(self, input: dict[str, JSONValue], *, kind: Literal["program"], scope: Literal["bound_input"], parameters: dict[str, JSONValue] | None = ...) -> Awaitable[CheckObservation]: ...
    def lookup_submission(self, reference: Mapping[str, Any]) -> Awaitable[Observation[SubmissionLookup]]: ...
    def attach(self, reference: Mapping[str, str]) -> Awaitable[AsyncExecution]: ...
    async def checkpoints(self, *, after: str = ..., limit: int = ...) -> Observation[dict[str, Any]]: ...
    def review_checkpoint(self, checkpoint: str | Mapping[str, Any], *, max_bytes: int = ...) -> Awaitable[Mapping[str, Any]]: ...
    def resolve_checkpoints(self, items: list[dict[str, Any]], *, signer: Signer | None = ...) -> Awaitable[Observation[dict[str, Any]]]: ...
    def approve(self, checkpoint_id: str) -> Awaitable[Observation[dict[str, Any]]]: ...
    def reject(self, checkpoint_id: str) -> Awaitable[Observation[dict[str, Any]]]: ...

    def sql(self, text: str, parameters: dict[str, JSONValue] | None = ..., *, submission_ref: Mapping[str, Any] | None = ..., request_id: str | None = ..., attempt_id: str | None = ..., parameter_declarations: dict[str, JSONValue] = ..., result: str | None = ...) -> AsyncQuery: ...
    def aql(self, text: str, parameters: dict[str, JSONValue] | None = ..., *, submission_ref: Mapping[str, Any] | None = ..., request_id: str | None = ..., attempt_id: str | None = ..., parameter_declarations: dict[str, JSONValue] = ..., result: str | None = ...) -> AsyncQuery: ...

class AsyncExecution:
    @property
    def ref(self) -> Mapping[str, str]: ...
    @property
    def submission(self) -> Observation[dict[str, Any]] | None: ...
    async def status(self) -> RunState: ...
    async def wait(self, *, until: str | None = ..., since: int | None = ...) -> RunState: ...
    async def reconcile(self) -> RunState: ...
    def cancel(self, *, cancel_id: str | None = ..., expected_revision: int | None = ..., attempt_id: str | None = ...) -> Awaitable[Observation[CancellationAttempt]]: ...
    def lookup_cancellation(self, reference: Mapping[str, Any]) -> Awaitable[Observation[CancellationLookup]]: ...
    def result(self, name: str) -> AsyncResult: ...

class AsyncResult:
    @overload
    def rows(self, *, schema: _RowSchema[_T], max_wire_bytes: int | None = ..., max_row_wire_bytes: int | None = ..., max_row_retained_value_bytes: int | None = ...) -> AsyncReader[_T]: ...
    @overload
    def rows(self, *, schema: None = ..., max_wire_bytes: int | None = ..., max_row_wire_bytes: int | None = ..., max_row_retained_value_bytes: int | None = ...) -> AsyncReader[dict[str, JSONValue]]: ...
    @overload
    async def all(self, *, schema: _RowSchema[_T], max_rows: int | None = ..., max_retained_value_bytes: int | None = ..., max_wire_bytes: int | None = ..., max_row_wire_bytes: int | None = ..., max_row_retained_value_bytes: int | None = ...) -> list[_T]: ...
    @overload
    async def all(self, *, schema: None = ..., max_rows: int | None = ..., max_retained_value_bytes: int | None = ..., max_wire_bytes: int | None = ..., max_row_wire_bytes: int | None = ..., max_row_retained_value_bytes: int | None = ...) -> list[dict[str, JSONValue]]: ...
    async def delivery_attempt(self, attempt_id: str) -> Observation[dict[str, Any]]: ...

class AsyncReader(AsyncIterator[_T]):
    @property
    def attempt_id(self) -> str: ...
    @property
    def rows_yielded(self) -> int: ...
    async def __aenter__(self) -> AsyncReader[_T]: ...
    async def __aexit__(self, *exc: Any) -> None: ...
    def __aiter__(self) -> AsyncReader[_T]: ...
    async def __anext__(self) -> _T: ...
    async def aclose(self) -> None: ...
    async def delivery_attempt(self) -> Observation[dict[str, Any]]: ...

