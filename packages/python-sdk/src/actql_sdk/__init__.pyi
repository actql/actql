    def aql(self, text: str, parameters: dict[str, JSONValue] | None = ..., *, submission_ref: Mapping[str, Any] | None = ..., request_id: str | None = ..., attempt_id: str | None = ..., parameter_declarations: dict[str, JSONValue] = ..., result: str | None = ...) -> Query: ...

class Execution:
    @property
    def ref(self) -> Mapping[str, str]: ...
    @property
    def submission(self) -> Observation[dict[str, Any]] | None: ...
    def status(self) -> RunState: ...
    def wait(self, *, until: str | None = ..., since: int | None = ...) -> RunState: ...
    def reconcile(self) -> RunState: ...
    def cancel(self, *, cancel_id: str | None = ..., expected_revision: int | None = ..., attempt_id: str | None = ...) -> Observation[CancellationAttempt]: ...
    def lookup_cancellation(self, reference: Mapping[str, Any]) -> Observation[CancellationLookup]: ...
    def result(self, name: str) -> Result: ...

class Result:
    @overload
    def rows(self, *, schema: _RowSchema[_T], max_wire_bytes: int | None = ..., max_row_wire_bytes: int | None = ..., max_row_retained_value_bytes: int | None = ...) -> Reader[_T]: ...
    @overload
    def rows(self, *, schema: None = ..., max_wire_bytes: int | None = ..., max_row_wire_bytes: int | None = ..., max_row_retained_value_bytes: int | None = ...) -> Reader[dict[str, JSONValue]]: ...
    @overload
    def all(self, *, schema: _RowSchema[_T], max_rows: int | None = ..., max_retained_value_bytes: int | None = ..., max_wire_bytes: int | None = ..., max_row_wire_bytes: int | None = ..., max_row_retained_value_bytes: int | None = ...) -> list[_T]: ...
    @overload
    def all(self, *, schema: None = ..., max_rows: int | None = ..., max_retained_value_bytes: int | None = ..., max_wire_bytes: int | None = ..., max_row_wire_bytes: int | None = ..., max_row_retained_value_bytes: int | None = ...) -> list[dict[str, JSONValue]]: ...
    def delivery_attempt(self, attempt_id: str) -> Observation[dict[str, Any]]: ...

class Reader(Iterator[_T]):
    @property
    def attempt_id(self) -> str: ...
    @property
    def rows_yielded(self) -> int: ...
    def __enter__(self) -> Reader[_T]: ...
    def __exit__(self, *exc: Any) -> None: ...
    def __iter__(self) -> Reader[_T]: ...
    def __next__(self) -> _T: ...
    def close(self) -> None: ...
    def delivery_attempt(self) -> Observation[dict[str, Any]]: ...

