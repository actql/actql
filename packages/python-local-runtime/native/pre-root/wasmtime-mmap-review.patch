+
+// Review-only patch candidate. Rust heap/scratch routing is not implemented by
+// this mmap bridge; enabling the feature is not an adopted runtime recipe.
+#[cfg(feature = "actql-owned-capacity")]
+unsafe extern "C" {
+    fn actql_owned_current() -> *mut core::ffi::c_void;
+    fn actql_owned_allocate(lease: *mut core::ffi::c_void, bytes: usize,
+                            alignment: usize, out: *mut *mut core::ffi::c_void) -> i32;
+    fn actql_owned_retire(lease: *mut core::ffi::c_void,
+                          allocation: *mut core::ffi::c_void) -> i32;
+}
+
+#[cfg(feature = "actql-owned-capacity")]
+impl Mmap {
+    fn new_owned(size: HostAlignedByteCount, accessible: bool) -> Result<Self> {
+        let lease = unsafe { actql_owned_current() };
+        if lease.is_null() {
+            bail!("missing original native capacity lease");
+        }
+        let mut base = core::ptr::null_mut();
+        let status = unsafe {
+            actql_owned_allocate(lease, size.byte_count(),
+                                  crate::runtime::vm::host_page_size(), &mut base)
+        };
+        if status != 0 {
+            bail!("native capacity allocation failed: {status}");
+        }
+        let memory = std::ptr::slice_from_raw_parts_mut(base.cast(), size.byte_count());
+        let mapping = Self {
+            memory: SendSyncPtr::new(NonNull::new(memory).unwrap()),
+            owned_lease: Some(lease as usize),
+        };
+        if !accessible {
+            unsafe {
+                mprotect(base, size.byte_count(), MprotectFlags::empty())?;
+            }
+        }
+        Ok(mapping)
+    }
+}
