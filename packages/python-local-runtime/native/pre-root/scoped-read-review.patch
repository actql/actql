+#ifndef ACTQL_PRIVATE_SCOPED_READ_H
+#define ACTQL_PRIVATE_SCOPED_READ_H
+#include <stddef.h>
+#include "owned_capacity.h"
+/* Physical custody only. The existing Core supplier must first validate the
+ * original same-Ledger loan and backing borrow. DATA cannot issue this loan. */
+typedef struct actql_read_context actql_read_context;
+int actql_read_context_create(actql_owned_capacity *, actql_read_context **);
+int actql_read_context_retain(actql_read_context *);
+int actql_read_context_release_after_owner_ack(actql_read_context *);
+int actql_read_context_enter(actql_read_context *);
+int actql_read_context_leave(actql_read_context *);
+int actql_read_context_try_close(actql_read_context **);
+/* Existing managed allocations retain their original free route after leave.
+ * These are private runtime hooks, not user-facing allocation operations. */
+void *actql_native_moon_scoped_allocate(size_t);
+void actql_native_moon_scoped_free(void *);
+void *actql_native_file_scoped_allocate(size_t);
+void *actql_native_file_scoped_callocate(size_t, size_t);
+void actql_native_file_scoped_free(void *);
