+/* Derived selected-runtime read allocator, included once by the ORIGINAL
+ * owned_capacity.c. Selection still requires its source-bound recipe and
+ * original physical supplier. This is physical provenance
+ * inside that provider, not a new quota, permission registry or cleanup Owner. */
+#include "scoped_read.h"
+#include <stdlib.h>
+#include <errno.h>
+#if defined(__APPLE__)
+#include <malloc/malloc.h>
+#elif defined(__linux__) && defined(ACTQL_NATIVE_OWNED_LINUX_PROCESS_DOMAIN)
+/* The trusted selected caller must bind this finite metadata to its original
+ * initial-control envelope before loading the provider. There is no default
+ * normal cardinality and no dynamically growing stock-allocation history. */
+#if !defined(ACTQL_NATIVE_LINUX_STOCK_FILE_SLOTS) || ACTQL_NATIVE_LINUX_STOCK_FILE_SLOTS < 1
+#error "Selected Linux File allocation requires a source-bound finite stock slot count"
+#endif
+struct stock_file_record {
+    void *pointer;
+    size_t bytes;
+    unsigned family;
+};
+_Static_assert(ACTQL_NATIVE_LINUX_STOCK_FILE_SLOTS <= SIZE_MAX / sizeof(struct stock_file_record),
+               "Stock File metadata size overflow");
+static struct stock_file_record stock_files[ACTQL_NATIVE_LINUX_STOCK_FILE_SLOTS];
+/* PID identifies an inherited physical entry fence, never a permission. A
+ * fork made during an active stock call is unsupported and refuses before any
+ * record traversal. A quiescent copied table needs no inherited lock/reset. */
+static _Atomic uint64_t stock_file_entry;
+static bool enter_stock_files(void) {
+    uint64_t process = (uint64_t)getpid();
+    if (process == 0 || process > UINT64_MAX / 2) return false;
+    uint64_t before = atomic_load_explicit(&stock_file_entry, memory_order_acquire);
+    if (before & 1) return false; /* concurrent/reentrant/inherited active call */
+    return atomic_compare_exchange_strong_explicit(&stock_file_entry, &before,
+        process * 2 + 1, memory_order_acq_rel, memory_order_acquire);
+}
+static void leave_stock_files(void) {
+    atomic_store_explicit(&stock_file_entry, (uint64_t)getpid() * 2, memory_order_release);
+}
+static void *allocate_stock_file(size_t bytes, bool zero) {
+    if (!enter_stock_files()) return NULL;
+    size_t index = 0;
+    while (index < ACTQL_NATIVE_LINUX_STOCK_FILE_SLOTS && stock_files[index].pointer != NULL)
+        index++;
+    void *pointer = NULL;
+    if (index != ACTQL_NATIVE_LINUX_STOCK_FILE_SLOTS) {
+        /* Original allocator family, exact requested size and returned start.
+         * Metadata is separate static control, not a prefix guessed from p. */
+        pointer = zero ? calloc(1, bytes) : malloc(bytes);
+        if (pointer != NULL) stock_files[index] = (struct stock_file_record){
+            pointer, bytes, zero ? 2u : 1u};
+    }
+    leave_stock_files();
+    return pointer;
+}
+static bool known_stock_file(const void *pointer) {
+    if (!enter_stock_files()) return false;
+    bool known = false;
+    for (size_t index = 0; index < ACTQL_NATIVE_LINUX_STOCK_FILE_SLOTS; index++)
+        if (stock_files[index].pointer == pointer && stock_files[index].family != 0) {
+            known = true; break;
+        }
+    leave_stock_files();
+    return known;
+}
+static int release_stock_file(void *pointer) {
+    if (pointer == NULL) return ACTQL_OWNED_OK;
+    if (!enter_stock_files()) return ACTQL_OWNED_BUSY;
+    int status = ACTQL_OWNED_INVALID;
+    for (size_t index = 0; index < ACTQL_NATIVE_LINUX_STOCK_FILE_SLOTS; index++) {
+        if (stock_files[index].pointer != pointer || stock_files[index].family == 0) continue;
+        /* Exclusion spans reclamation: no traversal can retain freed metadata.
+         * Reentrant entry refuses, and a fork snapshot of this active call is
+         * unsupported. The original malloc pointer is the only free target. */
+        free(pointer);
+        stock_files[index] = (struct stock_file_record){0};
+        status = ACTQL_OWNED_OK;
+        break;
+    }
+    leave_stock_files();
+    return status;
+}
+#endif
+
+/* Pinned libmoonbitrun.o exposes mimalloc217 and this public v2 ABI. */
+extern bool mi_is_in_heap_region(const void *);
+
+extern void *mi_malloc(size_t);
+extern void mi_free(void *);
+extern void moonbit_panic(void);
+
+struct actql_read_context {
+    actql_owned_capacity *lease;
+    struct actql_read_context *next;
+    pid_t process;
+    size_t users;
+    size_t active;
+    uint64_t managed_serial, managed_generation;
+    /* Search hint only. Every use rechecks original extent provenance under
+     * both existing locks; retirement/reuse cannot turn this index into credit. */
+    size_t managed_page_hint;
+    /* Closed, one-shot constructor cohorts on the same context. Ordinary
+     * contexts do not select this mode. Counts are audited allocator calls,
+     * not a long-running payload quota or observed-free-memory credit. */
+    bool managed_prepared, managed_preparing, managed_cohort, managed_finishing;
+    size_t managed_remaining, managed_maximum;
+    bool closing;
+    /* Pure cleanup census is constructor-thread scoped; other existing Read
+     * operations retain their original concurrency contracts. */
+    pthread_t observation_thread;
+};
+
+/* Only contexts already retained in their original allocator are indexed.
+ * No heap allocation, pointer serialization, independent provider or authority
+ * lookup is introduced. A context allocation itself prevents lease retirement.
+ * Lock order: context index -> original capacity. No inverse acquisition. */
+static atomic_flag read_context_lock = ATOMIC_FLAG_INIT;
+static actql_read_context *read_contexts;
+static _Atomic pid_t read_process;
+static _Thread_local actql_read_context *read_current;
+static _Thread_local size_t read_depth;
+
+static bool lock_read_contexts(void) {
+    pid_t process = getpid();
+    pid_t origin = atomic_load_explicit(&read_process, memory_order_acquire);
+    if (origin == 0) {
+        atomic_compare_exchange_strong_explicit(&read_process, &origin, process,
+            memory_order_acq_rel, memory_order_acquire);
+        origin = atomic_load_explicit(&read_process, memory_order_acquire);
+    }
+    /* Reject before touching a possibly inherited locked flag after fork. */
+    if (origin != process) return false;
+    while (atomic_flag_test_and_set_explicit(&read_context_lock,
+                                            memory_order_acquire)) {}
+    return true;
+}
+static void unlock_read_contexts(void) {
+    atomic_flag_clear_explicit(&read_context_lock, memory_order_release);
+}
+static bool known_read_context(actql_read_context *context) {
+    if (read_process != getpid()) return false;
+    for (actql_read_context *item = read_contexts; item; item = item->next)
+        if (item == context) return true;
+    return false;
+}
+
+int actql_read_context_create(actql_owned_capacity *lease,
+                             actql_read_context **slot) {
+    if (lease == NULL || slot == NULL || *slot != NULL || read_current != NULL ||
+        actql_native_owned_current() != lease) return ACTQL_OWNED_INVALID;
+    if (!lock_read_contexts()) return ACTQL_OWNED_INVALID;
+    if (read_process != 0 && read_process != getpid()) {
+        unlock_read_contexts();
+        return ACTQL_OWNED_INVALID; /* No inherited-context adoption after fork. */
+    }
+    lock_capacity(lease);
+    bool current = lease->transferred && !lease->closing && !foreign_domain_process(lease) &&
+                   lease->read_context_count != SIZE_MAX;
+    unlock_capacity(lease);
+    if (!current) { unlock_read_contexts(); return ACTQL_OWNED_INVALID; }
+    void *memory = NULL;
+    int status = actql_native_owned_allocate(lease, sizeof(actql_read_context),
+                                             _Alignof(actql_read_context), &memory);
+    if (status != ACTQL_OWNED_OK) {
+        unlock_read_contexts();
+        return status;
+    }
+    actql_read_context *context = memory;
+    context->lease = lease;
+    context->next = read_contexts;
+    context->process = getpid();
+    context->observation_thread = pthread_self();
+    context->users = context->active = 0;
+    lock_capacity(lease);
+    bool usable = !lease->closing && !foreign_domain_process(lease);
+    lease->read_context_count++;
+    unlock_capacity(lease);
+    context->closing = !usable;
+    /* Publish the original partial carrier before later operations can fail. */
+    *slot = context;
+    read_contexts = context;
+    atomic_store_explicit(&read_process, getpid(), memory_order_release);
+    unlock_read_contexts();
+    return usable ? ACTQL_OWNED_OK : ACTQL_OWNED_BUSY;
+}
+
+int actql_read_context_retain(actql_read_context *context) {
+    if (!lock_read_contexts()) return ACTQL_OWNED_INVALID;
+    int status = ACTQL_OWNED_INVALID;
+    if (known_read_context(context) && !context->closing &&
+        context->users != SIZE_MAX) {
+        lock_capacity(context->lease);
+        bool current = context->lease->transferred && !context->lease->closing &&
+                       !foreign_domain_process(context->lease);
+        unlock_capacity(context->lease);
+        if (current) { context->users++; status = ACTQL_OWNED_OK; }
+    }
+    unlock_read_contexts();
+    return status;
+}
+
+/* Only the original Root/Reader Owner calls this after actual stop/close ACK.
+ * No Bool, process exit, cancellation request or successful read supplies ACK. */
+int actql_read_context_release_after_owner_ack(actql_read_context *context) {
+    if (!lock_read_contexts()) return ACTQL_OWNED_INVALID;
+    int status = ACTQL_OWNED_INVALID;
+    if (known_read_context(context) && context->users != 0) {
+        context->users--;
+        status = ACTQL_OWNED_OK;
+    }
+    unlock_read_contexts();
+    return status;
+}
+
+static int enter_read_context(actql_read_context *context, bool cleanup) {
+    if (!lock_read_contexts()) return ACTQL_OWNED_INVALID;
+    int status = ACTQL_OWNED_INVALID;
+    if (known_read_context(context) &&
+        ((!context->closing && context->users != 0) ||
+         (cleanup && context->closing && context->users == 0) ||
+         (cleanup && !context->closing && read_current == context && read_depth != 0)) &&
+        !context->managed_preparing && !context->managed_finishing &&
+        (!context->managed_prepared || context->managed_cohort) && context->active != SIZE_MAX &&
+        (read_current == NULL || read_current == context) && read_depth != SIZE_MAX &&
+        actql_native_owned_current() == context->lease) {
+        lock_capacity(context->lease);
+        bool current = !context->lease->closing && context->lease->transferred &&
+                       !foreign_domain_process(context->lease);
+        unlock_capacity(context->lease);
+        if (current) {
+            read_current = context;
+            read_depth++;
+            context->active++;
+            status = ACTQL_OWNED_OK;
+        }
+    }
+    unlock_read_contexts();
+    return status;
+}
+
+int actql_read_context_enter(actql_read_context *context) {
+    return enter_read_context(context, false);
+}
+/* Only the existing nominal Owner's stopped read-use enters this path. It
+ * borrows the SAME context/lease while its last aliases or retirement retry
+ * retain custody. It issues no user and cannot reopen an ordinary read. */
+int actql_read_context_enter_cleanup(actql_read_context *context) {
+    return enter_read_context(context, true);
+}
+
+int actql_read_context_leave(actql_read_context *context) {
+    if (!lock_read_contexts()) return ACTQL_OWNED_INVALID;
+    int status = ACTQL_OWNED_INVALID;
+    if (known_read_context(context) && read_current == context &&
+        read_depth != 0 && context->active != 0) {
+        context->active--;
+        if (--read_depth == 0) read_current = NULL;
+        status = ACTQL_OWNED_OK;
+    }
+    unlock_read_contexts();
+    return status;
+}
+
+/* Failure observations only, inside the declared original control envelope.
+ * No pointer/identity escapes, allocation fallback or cleanup acknowledgement. */
+static _Thread_local struct {
+    uint64_t requested, known, depth, active, current, occupied, peak, control, pages, page_bytes;
+    int status;
+} read_allocation_observation;
+
+static void report_read_allocation_failure(void) {
+    static const char *names[] = {"requested", "known", "depth", "active", "current",
+        "occupied", "peak", "control", "pages", "page_bytes", "status"};
+    uint64_t values[] = {read_allocation_observation.requested,
+        read_allocation_observation.known, read_allocation_observation.depth,
+        read_allocation_observation.active, read_allocation_observation.current,
+        read_allocation_observation.occupied, read_allocation_observation.peak,
+        read_allocation_observation.control, read_allocation_observation.pages,
+        read_allocation_observation.page_bytes,
+        (uint64_t)(read_allocation_observation.status < 0 ?
+            -(int64_t)read_allocation_observation.status : read_allocation_observation.status)};
+    char text[512]; size_t used = 0;
+    const char *prefix = "actql-scoped-allocation-failed";
+    while (*prefix) text[used++] = *prefix++;
+    for (size_t i = 0; i < sizeof(values) / sizeof(values[0]); i++) {
+        text[used++] = ' ';
+        const char *name = names[i];
+        while (*name) text[used++] = *name++;
+        text[used++] = '=';
+        if (i == 10 && read_allocation_observation.status < 0) text[used++] = '-';
+        char digits[20]; size_t count = 0; uint64_t value = values[i];
+        do { digits[count++] = (char)('0' + value % 10); value /= 10; } while (value);
+        while (count) text[used++] = digits[--count];
+    }
+    text[used++] = '\n';
+    int saved_errno = errno;
+    for (size_t sent = 0; sent < used;) {
+        ssize_t n = write(STDERR_FILENO, text + sent, used - sent);
+        if (n > 0) sent += (size_t)n;
+        else if (n < 0 && errno == EINTR) continue;
+        else break;
+    }
+    errno = saved_errno;
+}
+
+/* Private storage inside the original Read context. Every page and header
+ * belongs to that provider holding. Managed Moon and fallible native C blocks
+ * keep distinct free provenance. File buffers retain generic extents; private
+ * pages cannot be protected or lent, including multi-page C allocations. */
+enum read_allocation_family { READ_FILE, READ_MANAGED, READ_PRIVATE_C };
+struct read_heap_page { size_t live, free_offset; };
+struct read_heap_block { size_t capacity, requested; uint64_t serial;
+    enum read_allocation_family family; };
+static size_t read_heap_round(size_t bytes) {
+    size_t alignment = _Alignof(max_align_t);
+    return bytes > SIZE_MAX - alignment + 1 ? 0 :
+        (bytes + alignment - 1) & ~(alignment - 1);
+}
+static size_t read_heap_header(void) { return read_heap_round(sizeof(struct read_heap_block)); }
+static struct read_heap_block *read_heap_first(void *page) {
+    return (void *)((unsigned char *)page + read_heap_round(sizeof(struct read_heap_page)));
+}
+static void *read_heap_payload(struct read_heap_block *block) {
+    return (unsigned char *)block + read_heap_header();
+}
+static struct read_heap_block *read_heap_next(void *page, size_t page_bytes,
+                                              struct read_heap_block *block) {
+    unsigned char *next = (unsigned char *)read_heap_payload(block) + block->capacity;
+    return next < (unsigned char *)page + page_bytes ? (void *)next : NULL;
+}
+/* Called under the original capacity lock. Observe only the requested live
+ * allocation, never the adjacent slot, page metadata or unused tail. */
+static int read_heap_contains_locked(actql_owned_capacity *lease, size_t index,
+                                      const void *address, size_t bytes) {
+    if (!owned_extent(lease, index)->read_heap ||
+        owned_extent(lease, index)->read_process != getpid()) return ACTQL_OWNED_INVALID;
+    void *page = owned_page_address(lease, index);
+    uintptr_t value = (uintptr_t)address;
+    for (struct read_heap_block *block = read_heap_first(page); block;
+         block = read_heap_next(page, owned_extent(lease, index)->pages * lease->page_size, block)) {
+        uintptr_t begin = (uintptr_t)read_heap_payload(block);
+        if (block->serial && block->requested && value >= begin &&
+            value - begin < block->requested && bytes <= block->requested - (value - begin))
+            return ACTQL_OWNED_OK;
+    }
+    return ACTQL_OWNED_INVALID;
+}
+/* Only original block headers enter this helper. The page-local offset names
+ * a free block retained under the same locks; it changes search order only. */
+static bool allocate_read_heap_block_locked(actql_read_context *context,
+    size_t index, void *page, struct read_heap_block *block, size_t bytes,
+    size_t rounded, enum read_allocation_family family, void **output) {
+    if (block->requested || block->capacity < rounded) return false;
+    struct read_heap_page *header = page;
+    header->free_offset = 0;
+    if (block->capacity - rounded >= read_heap_header() + _Alignof(max_align_t)) {
+        struct read_heap_block *tail = (void *)((unsigned char *)read_heap_payload(block) + rounded);
+        *tail = (struct read_heap_block){.capacity = block->capacity - rounded - read_heap_header()};
+        block->capacity = rounded;
+        header->free_offset = (unsigned char *)tail - (unsigned char *)page;
+    }
+    block->requested = bytes; block->family = family;
+    block->serial = ++context->managed_serial;
+    header->live++;
+    *output = read_heap_payload(block);
+    memset(*output, 0, block->capacity);
+    context->managed_page_hint = index;
+    return true;
+}
+/* Candidate lookup never grants a page: exact context/process, live extent
+ * and a genuinely free fitting block are checked under the original locks.
+ * A failed offset hint still scans every original block. */
+static bool allocate_read_heap_page_locked(actql_read_context *context,
+    size_t index, size_t bytes, size_t rounded, enum read_allocation_family family,
+    void **output) {
+    actql_owned_capacity *lease = context->lease;
+    if (index >= lease->page_count || owned_control_page(lease, index)) return false;
+    struct extent *extent = owned_extent(lease, index);
+    if (!extent->read_heap || extent->read_context != context || extent->retired ||
+        extent->read_released || extent->read_process != getpid()) return false;
+    void *page = owned_page_address(lease, index);
+    struct read_heap_page *header = page;
+    size_t page_bytes = extent->pages * lease->page_size;
+    size_t offset = header->free_offset;
+    if (offset >= read_heap_round(sizeof(*header)) &&
+        offset <= page_bytes - read_heap_header()) {
+        struct read_heap_block *hint = (void *)((unsigned char *)page + offset);
+        if (allocate_read_heap_block_locked(context, index, page, hint,
+                                           bytes, rounded, family, output)) return true;
+    }
+    for (struct read_heap_block *block = read_heap_first(page); block;
+         block = read_heap_next(page, page_bytes, block)) {
+        if (allocate_read_heap_block_locked(context, index, page, block,
+                                           bytes, rounded, family, output)) return true;
+    }
+    return false;
+}
+/* Both original locks are held. An empty slab is still an acquired extent
+ * of this context, even before its first constructor. No separate page index. */
+static int prepare_read_heap_page_locked(actql_read_context *context,
+    size_t required, size_t *index_out) {
+    actql_owned_capacity *lease = context->lease;
+    void *page = NULL;
+    int status = allocate_storage_read_original_locked(lease, required,
+        lease->page_size, &page, false, NULL, context, true);
+    if (status != ACTQL_OWNED_OK) return status;
+    size_t logical_offset;
+    owned_pointer_offset(lease, page, &logical_offset);
+    size_t index = logical_offset / lease->page_size;
+    struct extent *extent = owned_extent(lease, index);
+    extent->read_heap = true; extent->read_context = context;
+    extent->read_process = getpid();
+    size_t overhead = read_heap_round(sizeof(struct read_heap_page)) + read_heap_header();
+    *read_heap_first(page) = (struct read_heap_block){
+        .capacity = extent->pages * lease->page_size - overhead};
+    ((struct read_heap_page *)page)->live = 0;
+    *index_out = index;
+    return ACTQL_OWNED_OK;
+}
+
+int actql_read_context_prepare_managed(actql_read_context *context,
+    size_t maximum, size_t requests) {
+    if (!lock_read_contexts()) return ACTQL_OWNED_INVALID;
+    int status = ACTQL_OWNED_INVALID;
+    if (!known_read_context(context) || context->closing || context->users == 0 ||
+        context->active != 0 || context->managed_preparing || context->managed_finishing ||
+        read_current != NULL ||
+        read_depth != 0 || actql_native_owned_current() != context->lease ||
+        !pthread_equal(context->observation_thread, pthread_self())) goto finished;
+    actql_owned_capacity *lease = context->lease;
+    lock_capacity(lease);
+    size_t rounded = read_heap_round(maximum);
+    size_t overhead = read_heap_round(sizeof(struct read_heap_page)) + read_heap_header();
+    if (lease->closing || !lease->transferred || foreign_domain_process(lease) ||
+        maximum == 0 || requests == 0 || maximum > lease->page_size / 2 ||
+        !rounded || overhead > lease->page_size || rounded > lease->page_size - overhead ||
+        (!context->managed_prepared && context->managed_serial != 0)) goto unlocked;
+    /* A new cohort cannot step past the existing domain acquisition receipt.
+     * Reconcile that same receipt first; free-looking pages grant no credit. */
+    if (lease->pending_growth_domain != NULL || lease->growth.state != OWNED_GROWTH_IDLE) {
+        status = ACTQL_OWNED_BUSY;
+        goto unlocked;
+    }
+    if (context->managed_generation == UINT64_MAX ||
+        requests > SIZE_MAX - context->managed_remaining ||
+        context->managed_remaining > UINT64_MAX - context->managed_serial ||
+        requests > UINT64_MAX - context->managed_serial - context->managed_remaining) {
+        status = ACTQL_OWNED_EXHAUSTED;
+        goto unlocked;
+    }
+    context->managed_generation++;
+    context->managed_prepared = true;
+    context->managed_cohort = true;
+    context->managed_preparing = true;
+    /* Publish partial custody before each fallible activation. Failure retains
+     * the original pending mode and every acquired slab for explicit close. */
+    for (size_t request = 0; request < requests; request++) {
+        size_t index;
+        status = prepare_read_heap_page_locked(context, rounded + overhead, &index);
+        if (status != ACTQL_OWNED_OK) goto unlocked;
+    }
+    context->managed_remaining += requests;
+    if (maximum > context->managed_maximum) context->managed_maximum = maximum;
+    context->managed_preparing = false;
+    status = ACTQL_OWNED_OK;
+unlocked:
+    unlock_capacity(lease);
+finished:
+    unlock_read_contexts();
+    return status;
+}
+
+/* This is receipt-only cleanup on the already owned context. It allocates
+ * no control object, grants no new Read user and never returns root mapping
+ * credit. A successful finish means no unused/empty/pending cohort storage,
+ * not that live managed aliases or the enclosing Resource claim have ended. */
+int actql_read_context_finish_managed(actql_read_context *context,
+    uint64_t generation) {
+    if (!lock_read_contexts()) return ACTQL_OWNED_INVALID;
+    int status = ACTQL_OWNED_INVALID;
+    if (!known_read_context(context) || !context->managed_prepared ||
+        generation == 0 || generation != context->managed_generation || context->closing || context->users == 0 || context->active != 0 ||
+        read_current != NULL || read_depth != 0 ||
+        actql_native_owned_current() != context->lease ||
+        !pthread_equal(context->observation_thread, pthread_self())) goto finished;
+    actql_owned_capacity *lease = context->lease;
+    lock_capacity(lease);
+    if (lease->closing || !lease->transferred || foreign_domain_process(lease)) goto unlocked;
+    if (lease->pending_growth_domain != NULL || lease->growth.state != OWNED_GROWTH_IDLE) {
+        status = ACTQL_OWNED_BUSY;
+        goto unlocked;
+    }
+    if (!context->managed_cohort && !context->managed_finishing) {
+        status = ACTQL_OWNED_OK;
+        goto unlocked;
+    }
+    /* Unused constructor permissions are cancelled, never recredited. The
+     * scalar serial remains monotone, including across later fresh cohorts. */
+    context->managed_finishing = true;
+    context->managed_cohort = false;
+    context->managed_remaining = 0;
+    context->managed_maximum = 0;
+    context->managed_page_hint = 0;
+    for (size_t index = lease->control_pages; index < lease->page_count; index++) {
+        struct extent *extent = owned_extent(lease, index);
+        if (extent->read_context != context || extent->read_process != getpid() ||
+            !extent->read_heap) continue;
+        /* A failed activation/retirement may already be PROT_NONE. Do not read
+         * any slab header until its original extent is known accessible. */
+        if (!extent->retired && !extent->read_released &&
+            ((struct read_heap_page *)owned_page_address(lease, index))->live != 0) continue;
+        extent->read_released = true;
+        extent->retired = true;
+        if (allocation_has_external_use(lease, index, false)) {
+            status = ACTQL_OWNED_BUSY;
+            goto unlocked;
+        }
+        status = clean_retired(lease, index);
+        if (status != ACTQL_OWNED_OK) goto unlocked;
+    }
+    context->managed_preparing = false;
+    context->managed_finishing = false;
+    status = ACTQL_OWNED_OK;
+unlocked:
+    unlock_capacity(lease);
+finished:
+    unlock_read_contexts();
+    return status;
+}
+
+/* Read index lock is already held; the provider's original lock serializes
+ * page contents against span observations and last-slot physical retirement. */
+static int allocate_read_heap_bytes(actql_read_context *context, size_t bytes,
+    enum read_allocation_family family, void **output) {
+    actql_owned_capacity *lease = context->lease;
+    lock_capacity(lease);
+    int status = ACTQL_OWNED_INVALID;
+    if (foreign_domain_process(lease) || lease->closing || !lease->transferred)
+        goto done;
+    if (context->managed_serial == UINT64_MAX) { status = ACTQL_OWNED_EXHAUSTED; goto done; }
+    size_t rounded = read_heap_round(bytes);
+    size_t overhead = read_heap_round(sizeof(struct read_heap_page)) + read_heap_header();
+    if (!rounded || rounded > SIZE_MAX - overhead) goto done;
+    size_t hint = context->managed_page_hint;
+    if (allocate_read_heap_page_locked(context, hint, bytes, rounded, family, output)) {
+        status = ACTQL_OWNED_OK;
+        goto done;
+    }
+    /* Continue after the same hint, wrapping once through every other original
+     * extent before requesting a new page. Restarting at the first slab would
+     * repeatedly traverse an already full live prefix in a retained cohort.
+     * This changes search order only: every candidate keeps its original
+     * process/context/current/free-block checks; no page or credit is skipped. */
+    size_t search_index = hint >= lease->control_pages && hint < lease->page_count
+        ? hint : lease->page_count - 1;
+    for (size_t visited = 0; visited < lease->page_count - lease->control_pages; visited++) {
+        search_index = search_index == lease->page_count - 1 ? lease->control_pages : search_index + 1;
+        if (search_index != hint &&
+            allocate_read_heap_page_locked(context, search_index, bytes, rounded, family, output)) {
+            status = ACTQL_OWNED_OK;
+            goto done;
+        }
+    }
+    /* A prepared cohort has already acquired all of its constructor pages.
+     * Exhaustion is a certificate violation, never a request for hidden growth. */
+    if (context->managed_prepared) { status = ACTQL_OWNED_EXHAUSTED; goto done; }
+    size_t index;
+    status = prepare_read_heap_page_locked(context, rounded + overhead, &index);
+    if (status == ACTQL_OWNED_OK &&
+        !allocate_read_heap_page_locked(context, index, bytes, rounded, family, output))
+        status = ACTQL_OWNED_INVALID;
+
+done:
+    unlock_capacity(lease);
+    return status;
+}
+/* Caller holds both original locks and has classified the containing page.
+ * Free follows original provenance after leave; current TLS is not reassigned. */
+static int release_read_heap_locked(actql_owned_capacity *lease, size_t index,
+    void *pointer, enum read_allocation_family family) {
+    struct extent *extent = owned_extent(lease, index);
+    if (extent->retired || extent->read_process != getpid()) return ACTQL_OWNED_INVALID;
+    void *page = owned_page_address(lease, index);
+    for (struct read_heap_block *block = read_heap_first(page); block;
+         block = read_heap_next(page, owned_extent(lease, index)->pages * lease->page_size, block)) {
+        if (read_heap_payload(block) != pointer) continue;
+        struct read_heap_page *header = page;
+        if (!block->requested || !block->serial || !header->live ||
+            block->family != family) return ACTQL_OWNED_INVALID;
+        block->requested = 0; block->serial = 0; header->live--;
+        if (header->live == 0 &&
+            !(extent->read_context->managed_cohort &&
+              !extent->read_context->managed_finishing &&
+              !extent->read_context->closing &&
+              !allocation_has_external_use(lease, index, false))) {
+            if (extent->read_context->managed_page_hint == index)
+                extent->read_context->managed_page_hint = 0;
+            extent->read_released = true; extent->retired = true;
+            if (extent->read_context->managed_prepared &&
+                allocation_has_external_use(lease, index, false)) return ACTQL_OWNED_BUSY;
+            return clean_retired(lease, index);
+        }
+        /* Reuse the just-freed original page before a whole-extent search.
+         * This remains a hint: allocation independently rechecks the extent. */
+        extent->read_context->managed_page_hint = index;
+        /* Coalescing can absorb the hinted header. Refresh only from surviving
+         * original free headers; no live allocation moves or changes. */
+        header->free_offset = 0;
+        for (struct read_heap_block *item = read_heap_first(page); item;) {
+            struct read_heap_block *next = read_heap_next(page, owned_extent(lease, index)->pages * lease->page_size, item);
+            if (!item->requested)
+                header->free_offset = (unsigned char *)item - (unsigned char *)page;
+            if (!item->requested && next && !next->requested)
+                item->capacity += read_heap_header() + next->capacity;
+            else item = next;
+        }
+        return ACTQL_OWNED_OK;
+    }
+    return ACTQL_OWNED_INVALID;
+}
+
+/* Raw File/large managed extents need the SAME pre-activation custody as
+ * slabs, but have no heap-page header. The caller holds the Read index lock;
+ * this helper takes only the existing capacity lock and never changes TLS. */
+static int allocate_read_extent_bytes(actql_read_context *context, size_t bytes,
+    void **output) {
+    actql_owned_capacity *lease = context->lease;
+    lock_capacity(lease);
+    int status = ACTQL_OWNED_INVALID;
+    if (foreign_domain_process(lease) || lease->closing)
+        status = ACTQL_OWNED_BUSY;
+    else if (lease->transferred)
+        status = allocate_storage_read_original_locked(lease, bytes,
+            _Alignof(max_align_t), output, false, NULL, context, false);
+    unlock_capacity(lease);
+    return status;
+}
+
+static void *allocate_read_bytes(size_t bytes, enum read_allocation_family family) {
+    void *output = NULL;
+    memset(&read_allocation_observation, 0, sizeof(read_allocation_observation));
+    read_allocation_observation.requested = bytes;
+    read_allocation_observation.status = ACTQL_OWNED_INVALID;
+    if (!lock_read_contexts()) return NULL;
+    actql_read_context *context = read_current;
+    bool known = known_read_context(context);
+    read_allocation_observation.known = known;
+    read_allocation_observation.depth = read_depth;
+    if (known) {
+        read_allocation_observation.active = context->active;
+        read_allocation_observation.current = actql_native_owned_current() == context->lease;
+    }
+    bool prepared_current = true;
+    if (known && context->managed_prepared) {
+        prepared_current = family == READ_MANAGED && !context->managed_preparing &&
+            context->managed_remaining != 0 && bytes <= context->managed_maximum;
+        /* Debit only a current construction. A refused foreign/inactive call
+         * must not consume an original cohort request. Failed allocation keeps
+         * its debit: an uncertain constructor never recreates reusable credit. */
+        if (prepared_current && read_depth != 0 && context->active != 0 &&
+            actql_native_owned_current() == context->lease)
+            context->managed_remaining--;
+    }
+    /* Closing cannot begin during an active ordinary frame. A closing active
+     * frame can therefore only be the original cleanup entry above. */
+    if (known_read_context(context) && prepared_current && read_depth != 0 &&
+        context->active != 0 && actql_native_owned_current() == context->lease &&
+        (read_allocation_observation.status = (family == READ_PRIVATE_C ||
+            (family == READ_MANAGED && bytes <= context->lease->page_size / 2))
+            ? allocate_read_heap_bytes(context, bytes ? bytes : 1, family, &output)
+            : allocate_read_extent_bytes(context, bytes ? bytes : 1, &output)) == ACTQL_OWNED_OK) {
+        lock_capacity(context->lease);
+        size_t logical_offset;
+        owned_pointer_offset(context->lease, output, &logical_offset);
+        size_t start = logical_offset / context->lease->page_size;
+        while (start > context->lease->control_pages &&
+               owned_extent(context->lease, start)->pages == SIZE_MAX) start--;
+        bool private_slot = family != READ_FILE && owned_extent(context->lease, start)->read_heap &&
+            owned_extent(context->lease, start)->read_context == context;
+        if (!private_slot && !allocation_start(context->lease, output, &start)) {
+            /* This would violate the same-provider allocator's own postcondition.
+             * Do not substitute a system allocation or detach the original lease. */
+            unlock_capacity(context->lease);
+            unlock_read_contexts();
+            moonbit_panic();
+            return NULL;
+        }
+        owned_extent(context->lease, start)->read_context = context;
+        owned_extent(context->lease, start)->read_process = getpid();
+        owned_extent(context->lease, start)->read_released = false;
+        unlock_capacity(context->lease);
+    }
+    if (known && output == NULL) {
+        lock_capacity(context->lease);
+        read_allocation_observation.occupied = context->lease->occupied_pages;
+        read_allocation_observation.peak = context->lease->peak_occupied_pages;
+        read_allocation_observation.control = owned_control_pages(context->lease);
+        read_allocation_observation.pages = context->lease->page_count;
+        read_allocation_observation.page_bytes = context->lease->page_size;
+        unlock_capacity(context->lease);
+    }
+    unlock_read_contexts();
+    return output;
+}
+
+/* Return 1 only for a pointer OUTSIDE all registered selected arenas. That is
+ * an original non-target allocation, not allocation fallback. Interior/foreign
+ * selected pointers refuse; pending cleanup remains in the same extent table. */
+static int release_read_bytes(void *pointer, enum read_allocation_family family) {
+    if (pointer == NULL) return 1;
+    pid_t origin = atomic_load_explicit(&read_process, memory_order_acquire);
+    if (origin != 0 && origin != getpid()) {
+        /* Never lock/dereference or re-adopt an inherited read context. Classify
+         * only against the ORIGINAL allocator, before the index PID guard.
+         * Both APIs safely reject addresses outside their own heap domain.
+         * This is not permission to free a selected arena or reset its index. */
+        if (family == READ_PRIVATE_C) return ACTQL_OWNED_INVALID;
+        if (family == READ_MANAGED) return mi_is_in_heap_region(pointer) ? 1 : ACTQL_OWNED_INVALID;
+        /* Our non-target file path uses default malloc/calloc, not arbitrary
+         * caller-installed zones. The allocator adapter uses the SDK zone size
+         * operation: zero means the pointer is outside that original zone.
+         * Do not use malloc_zone_from_ptr: its documented precondition already
+         * requires a malloc pointer, which cannot classify an arena pointer. */
+#if defined(__APPLE__)
+        malloc_zone_t *zone = malloc_default_zone();
+        return zone != NULL && zone->size != NULL && zone->size(zone, pointer) != 0
+            ? 1 : ACTQL_OWNED_INVALID;
+#else
+        return known_stock_file(pointer) ? 1 : ACTQL_OWNED_INVALID;
+#endif
+    }
+    if (!lock_read_contexts()) return ACTQL_OWNED_INVALID;
+    if (read_process != 0 && read_process != getpid()) {
+        unlock_read_contexts();
+        return ACTQL_OWNED_INVALID;
+    }
+    int status = 1;
+    for (actql_read_context *context = read_contexts; context; context = context->next) {
+        actql_owned_capacity *lease = context->lease;
+        size_t logical_offset;
+        lock_capacity(lease);
+        if (!owned_pointer_offset(lease, pointer, &logical_offset)) {
+            unlock_capacity(lease);
+            continue;
+        }
+        status = ACTQL_OWNED_INVALID;
+        size_t start = logical_offset / lease->page_size;
+        if (owned_control_page(lease, start)) {
+            unlock_capacity(lease);
+            break;
+        }
+        while (start > lease->control_pages && owned_extent(lease, start)->pages == SIZE_MAX) start--;
+        if (owned_extent(lease, start)->read_heap) {
+            bool original = owned_extent(lease, start)->read_context == context;
+            if (original && family != READ_FILE)
+                status = release_read_heap_locked(lease, start, pointer, family);
+            unlock_capacity(lease);
+            if (original) break;
+            continue;
+        }
+        bool selected = family != READ_PRIVATE_C && allocation_start(lease, pointer, &start) &&
+            owned_extent(lease, start)->read_context == context &&
+            owned_extent(lease, start)->read_process == getpid() && !owned_extent(lease, start)->read_released;
+        if (selected) owned_extent(lease, start)->read_released = true;
+        unlock_capacity(lease);
+        if (!selected) continue;
+        status = actql_native_owned_retire(lease, pointer);
+        break;
+    }
+    unlock_read_contexts();
+    return status;
+}
+
+int actql_read_context_try_close(actql_read_context **slot) {
+    if (slot == NULL) return ACTQL_OWNED_INVALID;
+    if (*slot == NULL) return ACTQL_OWNED_OK;
+    if (!lock_read_contexts()) return ACTQL_OWNED_INVALID;
+    actql_read_context *context = *slot;
+    if (!known_read_context(context)) {
+        unlock_read_contexts();
+        return ACTQL_OWNED_INVALID;
+    }
+    /* Root/Reader's original Owner already denies new work while closing.
+     * Do not fence the retained physical scope before those same users can
+     * perform their pending close/diagnostic calls and return the real ACK. */
+    if (context->users != 0 || context->active != 0) {
+        unlock_read_contexts();
+        return ACTQL_OWNED_BUSY;
+    }
+    context->closing = true;
+    actql_owned_capacity *lease = context->lease;
+    /* No new retry queue: inspect and retry only the original allocator's
+     * existing released extents. Live aliases keep their original reservation. */
+    for (size_t index = lease->control_pages; index < lease->page_count; index++) {
+        lock_capacity(lease);
+        bool selected = owned_extent(lease, index)->read_context == context &&
+                        owned_extent(lease, index)->read_process == getpid();
+        bool released = selected && owned_extent(lease, index)->read_released;
+        if (selected && context->managed_prepared &&
+            owned_extent(lease, index)->read_heap && !owned_extent(lease, index)->retired &&
+            ((struct read_heap_page *)owned_page_address(lease, index))->live == 0) {
+            /* An unused prepared slab has no aliases. Retire it through the
+             * same physical path; failed cleanup remains on this extent. */
+            owned_extent(lease, index)->read_released = true;
+            owned_extent(lease, index)->retired = true;
+            released = true;
+        }
+        if (selected && owned_extent(lease, index)->read_heap && released) {
+            int status = clean_retired(lease, index);
+            unlock_capacity(lease);
+            if (status != ACTQL_OWNED_OK) { unlock_read_contexts(); return status; }
+            continue;
+        }
+        unlock_capacity(lease);
+        if (!selected) continue;
+        if (!released) { unlock_read_contexts(); return ACTQL_OWNED_BUSY; }
+        int status = actql_native_owned_retire(lease,
+            owned_page_address(lease, index));
+        if (status != ACTQL_OWNED_OK) { unlock_read_contexts(); return status; }
+    }
+    actql_read_context **link = &read_contexts;
+    while (*link != context) link = &(*link)->next;
+    actql_read_context *next = context->next;
+    *link = next;
+    int status = actql_native_owned_retire(lease, context);
+    if (status == ACTQL_OWNED_OK) {
+        *slot = NULL;
+        lock_capacity(lease);
+        lease->read_context_count--;
+        unlock_capacity(lease);
+    } else {
+        /* Original retirement failed: the context page is still accessible.
+         * Keep the same closing carrier; no second acquire or replacement. */
+        context->next = read_contexts;
+        read_contexts = context;
+    }
+    unlock_read_contexts();
+    return status;
+}
+
+void *actql_native_moon_scoped_allocate(size_t bytes) {
+    if (read_current == NULL) return mi_malloc(bytes); /* Original control path. */
+    void *result = allocate_read_bytes(bytes, READ_MANAGED);
+    if (result == NULL) {
+        report_read_allocation_failure();
+        moonbit_panic(); /* Existing fail-stop, never fallback. */
+    }
+    return result;
+}
+void actql_native_moon_scoped_free(void *pointer) {
+    int status = release_read_bytes(pointer, READ_MANAGED);
+    if (status == 1) mi_free(pointer); /* Original non-target allocator. */
+    else if (status != ACTQL_OWNED_OK && status != ACTQL_OWNED_BUSY &&
+             status != ACTQL_OWNED_PHYSICAL_FAILURE) moonbit_panic();
+    /* BUSY/physical failure stays read_released in the original extent table. */
+}
+#if defined(__APPLE__)
+void *actql_native_file_scoped_allocate(size_t bytes) {
+    return read_current == NULL ? malloc(bytes) : allocate_read_bytes(bytes, READ_FILE);
+}
+void *actql_native_file_scoped_callocate(size_t count, size_t bytes) {
+    if (read_current == NULL) return calloc(count, bytes);
+    if (bytes && count > SIZE_MAX / bytes) return NULL;
+    return allocate_read_bytes(count * bytes, READ_FILE); /* Original arena is zeroed. */
+}
+void actql_native_file_scoped_free(void *pointer) {
+    int status = release_read_bytes(pointer, READ_FILE);
+    if (status == 1) free(pointer);
+    else if (status != ACTQL_OWNED_OK && status != ACTQL_OWNED_BUSY &&
+             status != ACTQL_OWNED_PHYSICAL_FAILURE) moonbit_panic();
+}
+#else
+void *actql_native_file_scoped_allocate(size_t bytes) {
+    if (read_current != NULL) return allocate_read_bytes(bytes, READ_FILE);
+    return allocate_stock_file(bytes, false);
+}
+void *actql_native_file_scoped_callocate(size_t count, size_t bytes) {
+    if (bytes && count > SIZE_MAX / bytes) return NULL;
+    if (read_current == NULL) {
+        return allocate_stock_file(count * bytes, true);
+    }
+    return allocate_read_bytes(count * bytes, READ_FILE); /* Original arena is zeroed. */
+}
+void actql_native_file_scoped_free(void *pointer) {
+    int status = release_read_bytes(pointer, READ_FILE);
+    if (status == 1) {
+        status = release_stock_file(pointer);
+        /* A busy stock free has not retired anything. Fail-stop retains that
+         * same record; it is not an extent retirement that may be forgotten. */
+        if (status != ACTQL_OWNED_OK) moonbit_panic();
+    } else if (status != ACTQL_OWNED_OK && status != ACTQL_OWNED_BUSY &&
+             status != ACTQL_OWNED_PHYSICAL_FAILURE) moonbit_panic();
+}
+#endif
+
+/* Native private hooks are fallible and require an already-current original
+ * Read. No absent/exhausted/foreign Read is replaced by a stock allocation. */
+void *actql_native_private_scoped_allocate(size_t bytes) {
+    return allocate_read_bytes(bytes, READ_PRIVATE_C);
+}
+void *actql_native_private_scoped_callocate(size_t count, size_t bytes) {
+    if (bytes && count > SIZE_MAX / bytes) return NULL;
+    return allocate_read_bytes(count * bytes, READ_PRIVATE_C);
+}
+int actql_native_private_scoped_free(void *pointer) {
+    if (pointer == NULL) return ACTQL_OWNED_OK;
+    int status = release_read_bytes(pointer, READ_PRIVATE_C);
+    return status == 1 ? ACTQL_OWNED_INVALID : status;
+}
+/* Before a C caller reads its own header, require the exact original private
+ * allocation start and requested bounds, never merely a containing live page.
+ * Read -> capacity lock order and current/fork fencing remain unchanged. */
+int actql_native_private_scoped_contains_allocation(actql_read_context *context,
+    actql_owned_capacity *lease, const void *pointer, size_t bytes) {
+    if (!pointer || !bytes || !lock_read_contexts()) return ACTQL_OWNED_INVALID;
+    int status = ACTQL_OWNED_INVALID;
+    if (!known_read_context(context) || read_current != context || read_depth == 0 ||
+        context->active == 0 || context->lease != lease ||
+        actql_native_owned_current() != lease) goto done;
+    lock_capacity(lease);
+    size_t logical_offset;
+    if (foreign_domain_process(lease) || lease->closing || !lease->transferred ||
+        !owned_pointer_offset(lease, pointer, &logical_offset)) goto capacity_done;
+    size_t index = logical_offset / lease->page_size;
+    if (owned_control_page(lease, index)) goto capacity_done;
+    while (index > lease->control_pages && owned_extent(lease, index)->pages == SIZE_MAX) index--;
+    struct extent *extent = owned_extent(lease, index);
+    if (owned_control_page(lease, index) || !extent->read_heap || extent->read_context != context ||
+        extent->read_process != getpid() || extent->read_released || extent->retired) goto capacity_done;
+    void *page = owned_page_address(lease, index);
+    for (struct read_heap_block *block = read_heap_first(page); block;
+         block = read_heap_next(page, extent->pages * lease->page_size, block)) {
+        if (read_heap_payload(block) == pointer && block->family == READ_PRIVATE_C &&
+            block->serial && block->requested >= bytes) { status = ACTQL_OWNED_OK; break; }
+    }
+capacity_done:
+    unlock_capacity(lease);
+done:
+    unlock_read_contexts();
+    return status;
+}
+
+actql_read_context *actql_read_context_current(void) {
+    if (!lock_read_contexts()) return NULL;
+    actql_read_context *context = read_current;
+    bool current = known_read_context(context) && context->active != 0 &&
+        read_depth != 0 && actql_native_owned_current() == context->lease;
+    unlock_read_contexts();
+    return current ? context : NULL;
+}
+
+int actql_read_context_control_scope_clear(void) {
+    if (!lock_read_contexts()) return 0;
+    bool clear = read_current == NULL && read_depth == 0 &&
+        actql_native_owned_control_scope_clear() == 1;
+    unlock_read_contexts();
+    return clear ? 1 : 0;
+}
+
+
+/* Identity-only early refusal before the typed caller allocates its fixed
+ * output. The snapshot repeats this check; this is not normal-use current. */
+int actql_read_context_cleanup_thread_current(actql_read_context *context) {
+    if (!lock_read_contexts()) return ACTQL_OWNED_INVALID;
+    int status = known_read_context(context) &&
+        pthread_equal(context->observation_thread, pthread_self())
+        ? ACTQL_OWNED_OK : ACTQL_OWNED_INVALID;
+    unlock_read_contexts();
+    return status;
+}
+
+/* Read-only metadata on one retained original. No payload/header guessing,
+ * pointer projection, allocation, scope change, retirement or capacity credit.
+ * Lock order and process/fork fencing are the existing Read -> capacity order.
+ * Sixteen initially-zero slots receive one complete atomic snapshot only. */
+int actql_read_context_cleanup_snapshot(actql_read_context *context,
+                                       uint64_t *output, size_t count) {
+    if (output == NULL || count != 16) return ACTQL_OWNED_INVALID;
+    for (size_t index = 0; index < count; index++)
+        if (output[index] != 0) return ACTQL_OWNED_INVALID;
+    if (!lock_read_contexts()) return ACTQL_OWNED_INVALID;
+    if (!known_read_context(context) ||
+        !pthread_equal(context->observation_thread, pthread_self())) {
+        unlock_read_contexts();
+        return ACTQL_OWNED_INVALID;
+    }
+    uint64_t values[16] = {0};
+    values[0] = context->users;
+    values[1] = context->active;
+    values[12] = context->closing ? 1 : 0;
+    values[13] = read_current == context ? 1 : 0;
+    values[14] = actql_native_owned_current() == context->lease ? 1 : 0;
+    values[15] = sizeof(*context);
+    actql_owned_capacity *lease = context->lease;
+    int status = ACTQL_OWNED_OK;
+    lock_capacity(lease);
+    if (foreign_domain_process(lease) || !lease->transferred) {
+        status = ACTQL_OWNED_INVALID;
+        goto done;
+    }
+    for (size_t index = lease->control_pages; index < lease->page_count; index++) {
+        struct extent *extent = owned_extent(lease, index);
+        if (extent->read_context != context || extent->read_process != getpid()) continue;
+        if (extent->pages == 0 || extent->pages == SIZE_MAX ||
+            extent->pages > lease->page_count - index) {
+            status = ACTQL_OWNED_INVALID;
+            goto done;
+        }
+        if (extent->read_released || extent->retired) {
+            values[8]++;
+            values[9] += extent->pages;
+            continue; /* Pending/retired payload is never inspected. */
+        }
+        if (!extent->read_heap) {
+            values[2]++;
+            values[3] += extent->pages;
+            continue; /* File/foreign payload is never inspected. */
+        }
+        if (extent->pages == 0 || extent->pages > lease->page_count - index) {
+            status = ACTQL_OWNED_INVALID;
+            goto done;
+        }
+        values[4] += extent->pages;
+        void *page = owned_page_address(lease, index);
+        uintptr_t end = (uintptr_t)page + extent->pages * lease->page_size;
+        uint64_t live = 0;
+        for (struct read_heap_block *block = read_heap_first(page); block;
+             block = read_heap_next(page, owned_extent(lease, index)->pages * lease->page_size, block)) {
+            uintptr_t start = (uintptr_t)block;
+            if (start > end || read_heap_header() > end - start ||
+                block->capacity > end - start - read_heap_header() ||
+                block->requested > block->capacity ||
+                (block->requested != 0 && block->serial == 0)) {
+                status = ACTQL_OWNED_INVALID;
+                goto done;
+            }
+            if (block->requested == 0) continue;
+            live++;
+            values[5]++;
+            values[6] += block->requested;
+            values[7] += block->capacity;
+            if (values[10] == 0 || block->requested < values[10])
+                values[10] = block->requested;
+            if (block->requested > values[11]) values[11] = block->requested;
+        }
+        if (live != ((struct read_heap_page *)page)->live) {
+            status = ACTQL_OWNED_INVALID;
+            goto done;
+        }
+    }
+    for (size_t index = 0; index < count; index++) {
+        if (values[index] > INT64_MAX) {
+            status = ACTQL_OWNED_INVALID;
+            goto done;
+        }
+    }
+    for (size_t index = 0; index < count; index++) output[index] = values[index];
+done:
+    unlock_capacity(lease);
+    unlock_read_contexts();
+    return status;
+}
