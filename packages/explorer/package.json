{
  "name": "@actql/explorer",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22"},
  "dependencies": {
    "@actql/client-wire": "0.0.0-development",
    "@actql/explorer-ui": "0.0.0-development",
    "@actql/node": "0.0.0-development",
    "@actql/sdk": "0.0.0-development",
    "hono": "4.13.13",
    "@hono/node-server": "2.1.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "bin": {"actql-explorer": "./cli.mjs"},
  "exports": {
    ".": {"types": "./gateway.d.ts", "default": "./gateway.mjs"},
